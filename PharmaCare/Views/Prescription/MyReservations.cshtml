@model IEnumerable<PharmaCare.Models.PrescriptionReservation>
@using System.Linq

@{
    ViewData["Title"] = "My Prescription Reservations";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.IsLoggedIn = true;
    var userName = Context.Session.GetString("UserName");
    ViewBag.UserName = !string.IsNullOrEmpty(userName) ? userName : "User";
    ViewBag.HideCategories = false;

    var reservations = Model?.OrderByDescending(r => r.ReservationDate).ToList() ?? new List<PharmaCare.Models.PrescriptionReservation>();
    var totalReservations = reservations.Count;
    var activeReservations = reservations.Count(r => (r.Status ?? "").Equals("Reserved", StringComparison.OrdinalIgnoreCase) && r.ExpiryDate >= DateTime.Now);
    var completedReservations = reservations.Count(r => (r.Status ?? "").Equals("Completed", StringComparison.OrdinalIgnoreCase));
}

@section Styles {
<style>
.res-page{--teal:#0f9d8f;--teal-dark:#0a5b54;--ink:#17212b;--muted:#71808d;--line:#dfe8ea;--danger:#d94352;background:linear-gradient(180deg,#f4fbfa 0,#fff 46%);padding:42px 0 72px;color:var(--ink)}
.res-shell{max-width:1180px;margin:0 auto;padding:0 22px}.res-top{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:22px}.res-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;background:#e6f7f4;color:#08776d;font-size:11px;font-weight:900;letter-spacing:.55px;text-transform:uppercase;margin-bottom:10px}.res-title{font-size:38px;font-weight:900;letter-spacing:-1.1px;margin:0 0 7px}.res-subtitle{margin:0;color:var(--muted);font-size:14px}.res-shop{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 17px;border-radius:12px;border:1px solid var(--line);background:#fff;color:var(--ink);font-weight:800;text-decoration:none;transition:.2s}.res-shop:hover{transform:translateY(-2px);border-color:#a8d9d2;color:var(--teal-dark);text-decoration:none;box-shadow:0 10px 24px rgba(15,23,42,.07)}
.res-notice{display:flex;gap:13px;align-items:flex-start;background:#eaf8fb;border:1px solid #c8e8ee;color:#255f68;border-radius:16px;padding:16px 18px;margin-bottom:20px}.res-notice-icon{width:36px;height:36px;border-radius:11px;background:#d9f3f7;display:grid;place-items:center;color:#0b8fa0;flex:none}.res-notice strong{display:block;color:#174951;margin-bottom:3px}.res-notice span{font-size:12px;line-height:1.6}
.res-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:22px}.res-stat{background:#fff;border:1px solid var(--line);border-radius:17px;padding:17px 18px;box-shadow:0 10px 30px rgba(15,23,42,.05);display:flex;align-items:center;gap:13px}.res-stat-icon{width:42px;height:42px;border-radius:13px;background:#e9f8f5;color:var(--teal);display:grid;place-items:center;font-size:17px}.res-stat strong{display:block;font-size:23px;line-height:1;font-weight:900}.res-stat span{display:block;color:var(--muted);font-size:11px;margin-top:5px}
.res-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 14px 38px rgba(15,23,42,.06);overflow:hidden}.res-card-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:15px}.res-card-head h2{margin:0;font-size:17px;font-weight:900}.res-count{font-size:11px;font-weight:800;color:#08776d;background:#e8f8f5;padding:7px 10px;border-radius:999px}.res-table-wrap{overflow-x:auto}.res-table{width:100%;border-collapse:collapse;min-width:900px}.res-table th{padding:13px 18px;background:#f8fbfb;color:#7d8992;font-size:10px;text-transform:uppercase;letter-spacing:.55px;text-align:left;border-bottom:1px solid var(--line)}.res-table td{padding:15px 18px;border-bottom:1px solid #edf2f3;font-size:13px;vertical-align:middle}.res-table tbody tr{transition:.18s}.res-table tbody tr:hover{background:#fbfefd}.res-table tbody tr:last-child td{border-bottom:0}.res-number{font-weight:900;white-space:nowrap}.res-product{display:flex;align-items:center;gap:11px}.res-product img{width:46px;height:46px;border-radius:10px;object-fit:contain;background:#f6f9fa;border:1px solid #e6edef;padding:4px}.res-product strong{font-size:12px}.res-date{color:#5f6c75;white-space:nowrap}.res-status{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:999px;font-size:10px;font-weight:900}.res-status:before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}.status-reserved{background:#fff4cf;color:#a66d00}.status-completed{background:#e7f8ed;color:#178447}.status-cancelled{background:#eef2f3;color:#66737b}.status-expired{background:#feecee;color:#bf3342}.cancel-res{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:0 12px;border-radius:10px;background:#fff;color:#c83b49;border:1px solid #f0b7be;font-size:11px;font-weight:900;cursor:pointer;transition:.2s}.cancel-res:hover{background:#fff1f3;border-color:#e7828d;transform:translateY(-1px)}.no-action{font-size:11px;color:#96a0a6;font-weight:800}.res-mobile{display:none}.mobile-res{padding:16px;border-bottom:1px solid var(--line)}.mobile-res:last-child{border-bottom:0}.mobile-res-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.mobile-res-number{font-size:12px;font-weight:900;overflow-wrap:anywhere}.mobile-res-meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.mobile-meta{background:#f8fbfb;border-radius:11px;padding:10px}.mobile-meta small{display:block;color:#8a969e;font-size:9px;text-transform:uppercase;font-weight:900;margin-bottom:4px}.mobile-meta strong{font-size:12px}.mobile-res-action{display:flex;justify-content:flex-end}
.res-empty{text-align:center;padding:60px 24px}.res-empty-icon{width:72px;height:72px;border-radius:22px;background:#e9f8f5;color:var(--teal);display:grid;place-items:center;font-size:28px;margin:0 auto 16px}.res-empty h2{font-size:22px;font-weight:900;margin-bottom:8px}.res-empty p{color:var(--muted);font-size:13px;margin-bottom:20px}.res-empty a{display:inline-flex;align-items:center;gap:8px;background:var(--teal);color:#fff;border-radius:12px;padding:12px 18px;font-weight:900;text-decoration:none}
.res-toast{margin-bottom:16px;border-radius:13px;padding:12px 14px;font-size:12px;font-weight:700}.res-toast.success{background:#e8f8ed;color:#16773d;border:1px solid #c8ead4}.res-toast.error{background:#fff0f1;color:#b73240;border:1px solid #f2c7cc}
.res-modal-backdrop{position:fixed;inset:0;background:rgba(8,20,23,.55);display:none;align-items:center;justify-content:center;z-index:9999;padding:18px}.res-modal-backdrop.show{display:flex}.res-modal{width:min(430px,100%);background:#fff;border-radius:20px;box-shadow:0 24px 70px rgba(0,0,0,.25);padding:22px;animation:resPop .18s ease-out}.res-modal-icon{width:48px;height:48px;border-radius:14px;background:#fff0f1;color:var(--danger);display:grid;place-items:center;font-size:20px;margin-bottom:14px}.res-modal h3{font-size:20px;font-weight:900;margin:0 0 7px}.res-modal p{font-size:13px;color:var(--muted);line-height:1.55;margin:0 0 18px}.res-modal-actions{display:flex;justify-content:flex-end;gap:10px}.modal-btn{min-height:42px;padding:0 15px;border-radius:11px;font-weight:900;font-size:12px;border:1px solid var(--line);cursor:pointer}.modal-close{background:#fff;color:var(--ink)}.modal-confirm{background:var(--danger);border-color:var(--danger);color:#fff}@keyframes resPop{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:none}}
.dark-mode .res-page{--ink:#edf5f4;--muted:#9ca8ad;--line:#2b3b3c;background:#111819}.dark-mode .res-card,.dark-mode .res-stat,.dark-mode .res-shop,.dark-mode .res-modal{background:#172122}.dark-mode .res-table th,.dark-mode .mobile-meta{background:#121c1d}.dark-mode .res-table td{border-color:#263637}.dark-mode .res-table tbody tr:hover{background:#1a2627}.dark-mode .res-notice{background:#123136;border-color:#205058;color:#a9d7dd}.dark-mode .res-notice strong{color:#d9f4f7}.dark-mode .cancel-res,.dark-mode .modal-close{background:#172122}.dark-mode .res-number{color:#edf5f4}
@@media(max-width:820px){.res-top{align-items:flex-start;flex-direction:column}.res-stats{grid-template-columns:1fr}.res-table-wrap{display:none}.res-mobile{display:block}.res-title{font-size:31px}.res-card-head{padding:16px}}
@@media(max-width:520px){.res-page{padding:30px 0 54px}.res-shell{padding:0 14px}.res-title{font-size:28px}.res-shop{width:100%}.mobile-res-meta{grid-template-columns:1fr}.res-modal-actions{flex-direction:column-reverse}.modal-btn{width:100%}}
</style>
}

<section class="res-page">
    <div class="res-shell">
        <div class="res-top">
            <div>
                <div class="res-kicker"><i class="fas fa-prescription-bottle-alt"></i> Prescription pickup</div>
                <h1 class="res-title">My reservations</h1>
                <p class="res-subtitle">Track medicines being held for you and manage active prescription pickups.</p>
            </div>
            <a class="res-shop" href="@Url.Action("Shop", "FrontEnd")"><i class="fas fa-store"></i> Browse medicines</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="res-toast success"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="res-toast error"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]</div>
        }

        <div class="res-notice">
            <div class="res-notice-icon"><i class="fas fa-info-circle"></i></div>
            <div><strong>Bring a valid prescription when you collect your medicine.</strong><span>Reservations are held for 3 days. If a reserved medicine is not collected in time, its stock is returned automatically.</span></div>
        </div>

        <div class="res-stats">
            <div class="res-stat"><div class="res-stat-icon"><i class="fas fa-clipboard-list"></i></div><div><strong>@totalReservations</strong><span>Total reservations</span></div></div>
            <div class="res-stat"><div class="res-stat-icon"><i class="fas fa-clock"></i></div><div><strong>@activeReservations</strong><span>Awaiting pickup</span></div></div>
            <div class="res-stat"><div class="res-stat-icon"><i class="fas fa-check-circle"></i></div><div><strong>@completedReservations</strong><span>Completed pickups</span></div></div>
        </div>

        <section class="res-card">
            <div class="res-card-head">
                <h2><i class="fas fa-history mr-2"></i> Reservation history</h2>
                <span class="res-count">@totalReservations @(totalReservations == 1 ? "reservation" : "reservations")</span>
            </div>

            @if (reservations.Any())
            {
                <div class="res-table-wrap">
                    <table class="res-table">
                        <thead><tr><th>Reservation</th><th>Medicine</th><th>Qty</th><th>Reserved</th><th>Expires</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var item in reservations)
                        {
                            var isExpired = item.ExpiryDate < DateTime.Now && (item.Status ?? "").Equals("Reserved", StringComparison.OrdinalIgnoreCase);
                            var status = isExpired ? "Expired" : (item.Status ?? "Unknown");
                            var statusClass = status.ToLower() switch { "reserved" => "status-reserved", "completed" => "status-completed", "cancelled" => "status-cancelled", "expired" => "status-expired", _ => "status-cancelled" };
                            var imageUrl = !string.IsNullOrEmpty(item.Product?.ImageUrl) ? item.Product.ImageUrl : "/images/product_01.png";
                            <tr>
                                <td><span class="res-number">@item.ReservationNumber</span></td>
                                <td><div class="res-product"><img src="@imageUrl" alt="@item.Product?.ProductName"><strong>@item.Product?.ProductName</strong></div></td>
                                <td>@item.Quantity</td>
                                <td class="res-date">@item.ReservationDate.ToString("MMM dd, yyyy")</td>
                                <td class="res-date">@item.ExpiryDate.ToString("MMM dd, yyyy")</td>
                                <td><span class="res-status @statusClass">@status</span></td>
                                <td>
                                    @if (!isExpired && (item.Status ?? "").Equals("Reserved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="cancel-res js-cancel-res" data-url="@Url.Action("CancelReservation", "Prescription", new { id = item.ReservationId })" data-number="@item.ReservationNumber"><i class="fas fa-times-circle"></i> Cancel</button>
                                    }
                                    else { <span class="no-action"><i class="fas fa-lock mr-1"></i> No action</span> }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="res-mobile">
                    @foreach (var item in reservations)
                    {
                        var isExpired = item.ExpiryDate < DateTime.Now && (item.Status ?? "").Equals("Reserved", StringComparison.OrdinalIgnoreCase);
                        var status = isExpired ? "Expired" : (item.Status ?? "Unknown");
                        var statusClass = status.ToLower() switch { "reserved" => "status-reserved", "completed" => "status-completed", "cancelled" => "status-cancelled", "expired" => "status-expired", _ => "status-cancelled" };
                        var imageUrl = !string.IsNullOrEmpty(item.Product?.ImageUrl) ? item.Product.ImageUrl : "/images/product_01.png";
                        <article class="mobile-res">
                            <div class="mobile-res-top"><div><div class="mobile-res-number">@item.ReservationNumber</div><div class="res-product mt-2"><img src="@imageUrl" alt="@item.Product?.ProductName"><strong>@item.Product?.ProductName</strong></div></div><span class="res-status @statusClass">@status</span></div>
                            <div class="mobile-res-meta"><div class="mobile-meta"><small>Quantity</small><strong>@item.Quantity</strong></div><div class="mobile-meta"><small>Expires</small><strong>@item.ExpiryDate.ToString("MMM dd")</strong></div></div>
                            <div class="mobile-res-action">@if (!isExpired && (item.Status ?? "").Equals("Reserved", StringComparison.OrdinalIgnoreCase)) { <button type="button" class="cancel-res js-cancel-res" data-url="@Url.Action("CancelReservation", "Prescription", new { id = item.ReservationId })" data-number="@item.ReservationNumber"><i class="fas fa-times-circle"></i> Cancel reservation</button> }</div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="res-empty"><div class="res-empty-icon"><i class="fas fa-prescription-bottle-alt"></i></div><h2>No reservations yet</h2><p>Prescription medicines you reserve for pickup will appear here.</p><a href="@Url.Action("Shop", "FrontEnd")"><i class="fas fa-store"></i> Browse medicines</a></div>
            }
        </section>
    </div>
</section>

<div class="res-modal-backdrop" id="cancelReservationModal" aria-hidden="true">
    <div class="res-modal" role="dialog" aria-modal="true" aria-labelledby="cancelReservationTitle">
        <div class="res-modal-icon"><i class="fas fa-trash-alt"></i></div>
        <h3 id="cancelReservationTitle">Cancel this reservation?</h3>
        <p id="cancelReservationText">The reserved quantity will be returned to pharmacy stock. This action cannot be undone.</p>
        <div class="res-modal-actions"><button type="button" class="modal-btn modal-close" id="cancelModalClose">Keep reservation</button><button type="button" class="modal-btn modal-confirm" id="cancelModalConfirm">Yes, cancel reservation</button></div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    const modal=document.getElementById('cancelReservationModal');
    const closeBtn=document.getElementById('cancelModalClose');
    const confirmBtn=document.getElementById('cancelModalConfirm');
    const text=document.getElementById('cancelReservationText');
    let targetUrl='';
    document.querySelectorAll('.js-cancel-res').forEach(btn=>btn.addEventListener('click',()=>{
        targetUrl=btn.dataset.url||'';
        const number=btn.dataset.number||'this reservation';
        text.textContent=`Cancel ${number}? The reserved quantity will be returned to pharmacy stock. This action cannot be undone.`;
        modal.classList.add('show'); modal.setAttribute('aria-hidden','false');
    }));
    const closeModal=()=>{modal.classList.remove('show');modal.setAttribute('aria-hidden','true');targetUrl='';};
    closeBtn.addEventListener('click',closeModal);
    modal.addEventListener('click',e=>{if(e.target===modal)closeModal();});
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('show'))closeModal();});
    confirmBtn.addEventListener('click',()=>{if(targetUrl){confirmBtn.disabled=true;confirmBtn.textContent='Cancelling...';window.location.href=targetUrl;}});
})();
</script>
}
