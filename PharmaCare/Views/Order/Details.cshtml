}

<div class="order-page-shell">
@if (!isStaff)
{
    <div class="order-page-head">
        <div>
            <span class="order-eyebrow"><i class="fas fa-box"></i> Order details</span>
            <h1>Your order</h1>
            <p>Track your order and review delivery, payment and item details.</p>
        </div>
        <a href="@Url.Action("Index","Order")" class="btn clear-btn back"><i class="fas fa-arrow-left"></i> Back to My Orders</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    }

    <section class="customer-order-hero">
        <div class="hero-top">
            <div>
                <div class="hero-order-no">Order #@Model.OrderNumber</div>
                <h1>@(Model.Status == "Delivered" ? "Your order has arrived." : Model.Status == "Cancelled" ? "This order was cancelled." : "Your order is in progress.")</h1>
                <p>Placed @Model.OrderDate.ToString("MMMM dd, yyyy 'at' HH:mm")</p>
            </div>
            <span class="customer-status-pill"><i class="fas fa-circle"></i> @Model.Status</span>
        </div>
        @if (Model.Status != "Cancelled")
        {
            <div class="customer-progress">
                <div class="workflow">
                    <div class="workflow-step @(statusStep > 1 ? "done" : statusStep == 1 ? "current" : "")"><span class="workflow-dot"></span>Pending</div>
                    <div class="workflow-step @(statusStep > 2 ? "done" : statusStep == 2 ? "current" : "")"><span class="workflow-dot"></span>Processing</div>
                    <div class="workflow-step @(statusStep > 3 ? "done" : statusStep == 3 ? "current" : "")"><span class="workflow-dot"></span>Shipped</div>
                    <div class="workflow-step @(statusStep == 4 ? "current" : "")"><span class="workflow-dot"></span>Delivered</div>
                </div>
            </div>
        }
        else
        {
            <div class="cancelled-banner"><i class="fas fa-info-circle mr-2"></i>This order is no longer being processed.</div>
        }
    </section>

    <div class="customer-grid">
        <div class="customer-main">
            <div class="order-card">
                <div class="order-card-header"><strong>Items in your order</strong><div class="muted-note">@(Model.OrderItems?.Sum(i => i.Quantity) ?? 0) item(s)</div></div>
                <div class="table-responsive">
                    <table class="table order-table mb-0">
                        <thead><tr><th>Product</th><th>Unit price</th><th>Qty</th><th class="text-right">Total</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.OrderItems ?? new List<PharmaCare.Models.OrderItem>())
                        {
                            <tr><td><strong>@item.ProductName</strong></td><td>$@item.Price.ToString("0.00")</td><td>@item.Quantity</td><td class="text-right"><strong>$@((item.Price * item.Quantity).ToString("0.00"))</strong></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="customer-info-grid">
                <div class="customer-info-card">
                    <div class="icon-box"><i class="fas fa-map-marker-alt"></i></div>
                    <h3>Delivery details</h3>
                    <div class="customer-info-line"><span>Address</span><span>@Model.ShippingAddress</span></div>
                    <div class="customer-info-line"><span>City</span><span>@Model.City</span></div>
                    <div class="customer-info-line"><span>Phone</span><span>@Model.PhoneNumber</span></div>
                </div>
                <div class="customer-info-card">
                    <div class="icon-box"><i class="fas fa-credit-card"></i></div>
                    <h3>Payment</h3>
                    <div class="customer-info-line"><span>Method</span><span>@Model.PaymentMethod</span></div>
                    <div class="customer-info-line"><span>Status</span><span class="@(Model.IsPaid ? "payment-paid" : "payment-unpaid")">@(Model.IsPaid ? "Paid" : "Not paid")</span></div>
                    @if (Model.PaidAt.HasValue)
                    {
                        <div class="customer-info-line"><span>Paid</span><span>@Model.PaidAt.Value.ToString("MMM dd, yyyy HH:mm")</span></div>
                    }
                </div>
            </div>
        </div>

        <aside class="customer-side">
            <div class="order-card order-summary-card">
                <div class="order-card-header"><strong>Order summary</strong><p>Final total for this order</p></div>
                <div class="summary-box">
                    <div class="summary-row"><span>Items subtotal</span><span>$@itemsSubtotal.ToString("0.00")</span></div>
                    <div class="summary-row"><span>Tax</span><span>$@tax.ToString("0.00")</span></div>
                    <div class="summary-row"><span>Shipping</span><span>@(shipping == 0 ? "FREE" : "$" + shipping.ToString("0.00"))</span></div>
                    <div class="summary-row total"><span>Total</span><span>$@Model.TotalAmount.ToString("0.00")</span></div>
                </div>
            </div>
            <div class="support-card">
                <h4><i class="fas fa-headset"></i>Need help with this order?</h4>
                <p>Contact the pharmacy team and keep your order number ready so we can help faster.</p>
            </div>
        </aside>
    </div>
}
else
{
    <div class="order-page-head">
        <div><h2>Order #@Model.OrderNumber</h2><p>Review fulfillment, payment, customer and delivery information.</p></div>
        <a href="@Url.Action("ManageOrders","Order")" class="btn clear-btn back"><i class="fas fa-arrow-left"></i> Back to Order Management</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    }

    <div class="order-card mb-4">
        <div class="order-card-header order-overview-bar">
            <div><strong>Order Overview</strong><div class="order-number-meta"><i class="far fa-calendar-alt mr-1"></i>Placed @Model.OrderDate.ToString("MMM dd, yyyy 'at' HH:mm") · Internal ID #@Model.OrderId</div></div>
            <div class="d-flex align-items-center"><span class="badge badge-@statusClass status-badge-lg mr-2">@Model.Status</span>@if (Model.Status != "Delivered" && Model.Status != "Cancelled"){<button class="btn clear-btn update" data-toggle="modal" data-target="#updateStatusModal"><i class="fas fa-sync-alt"></i> Change Order Status</button>}</div>
        </div>
        @if (Model.Status != "Cancelled")
        {
            <div class="order-card-body pb-3"><div class="workflow"><div class="workflow-step @(statusStep > 1 ? "done" : statusStep == 1 ? "current" : "")"><span class="workflow-dot"></span>Pending</div><div class="workflow-step @(statusStep > 2 ? "done" : statusStep == 2 ? "current" : "")"><span class="workflow-dot"></span>Processing</div><div class="workflow-step @(statusStep > 3 ? "done" : statusStep == 3 ? "current" : "")"><span class="workflow-dot"></span>Shipped</div><div class="workflow-step @(statusStep == 4 ? "current" : "")"><span class="workflow-dot"></span>Delivered</div></div></div>
        }
    </div>

    <div class="row mb-4">
        <div class="col-lg-4 mb-3 mb-lg-0"><div class="detail-tile"><div class="detail-title"><i class="fas fa-user mr-1"></i> Customer</div><div class="detail-row"><span class="label">Name</span><span class="value">@Model.User?.FirstName @Model.User?.LastName</span></div><div class="detail-row"><span class="label">Email</span><span class="value">@Model.User?.Email</span></div><div class="detail-row"><span class="label">Phone</span><span class="value">@Model.PhoneNumber</span></div></div></div>
        <div class="col-lg-4 mb-3 mb-lg-0"><div class="detail-tile"><div class="detail-title"><i class="fas fa-map-marker-alt mr-1"></i> Shipping</div><div class="detail-row"><span class="label">Address</span><span class="value">@Model.ShippingAddress</span></div><div class="detail-row"><span class="label">City</span><span class="value">@Model.City</span></div><div class="detail-row"><span class="label">Quantity</span><span class="value">@(Model.OrderItems?.Sum(i => i.Quantity) ?? 0) item(s)</span></div></div></div>
        <div class="col-lg-4"><div class="detail-tile"><div class="detail-title"><i class="fas fa-credit-card mr-1"></i> Payment</div><div class="detail-row"><span class="label">Method</span><span class="value">@Model.PaymentMethod</span></div><div class="detail-row"><span class="label">Status</span><span class="value @(Model.IsPaid ? "payment-paid" : "payment-unpaid")">@(Model.IsPaid ? "Paid" : "Not Paid")</span></div>@if (Model.PaidAt.HasValue){<div class="detail-row"><span class="label">Paid at</span><span class="value">@Model.PaidAt.Value.ToString("MMM dd, yyyy HH:mm")</span></div>}@if (Model.DeliveredAt.HasValue){<div class="detail-row"><span class="label">Delivered</span><span class="value">@Model.DeliveredAt.Value.ToString("MMM dd, yyyy HH:mm")</span></div>}</div></div>
    </div>

    <div class="order-card mb-4">
        <div class="order-card-header d-flex justify-content-between align-items-center"><div><strong>Order Items</strong><div class="muted-note">@(Model.OrderItems?.Count ?? 0) product line(s)</div></div><div class="font-weight-bold">$@Model.TotalAmount.ToString("0.00")</div></div>
        <div class="table-responsive"><table class="table order-table mb-0"><thead><tr><th>Product</th><th>Unit Price</th><th>Quantity</th><th class="text-right">Line Total</th></tr></thead><tbody>@foreach (var item in Model.OrderItems ?? new List<PharmaCare.Models.OrderItem>()){<tr><td><strong>@item.ProductName</strong></td><td>$@item.Price.ToString("0.00")</td><td>@item.Quantity</td><td class="text-right"><strong>$@((item.Price * item.Quantity).ToString("0.00"))</strong></td></tr>}</tbody></table></div>
        <div class="summary-box"><div class="summary-row"><span>Items subtotal</span><span>$@itemsSubtotal.ToString("0.00")</span></div><div class="summary-row"><span>Tax</span><span>$@tax.ToString("0.00")</span></div><div class="summary-row"><span>Shipping</span><span>@(shipping == 0 ? "Free" : "$" + shipping.ToString("0.00"))</span></div><div class="summary-row total"><span>Total</span><span>$@Model.TotalAmount.ToString("0.00")</span></div></div>
    </div>

    <div class="mb-4"><span class="muted-note"><i class="fas fa-shield-alt mr-1"></i>Administrative order view</span></div>
}
</div>

@if (isStaff && Model.Status != "Delivered" && Model.Status != "Cancelled")
{
    <div class="modal fade" id="updateStatusModal" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><form asp-controller="Order" asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<div class="modal-header"><div><h5 class="modal-title mb-0">Change Order Status</h5><small class="text-muted">Current status: @Model.Status</small></div><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input type="hidden" name="orderId" value="@Model.OrderId"/><input type="hidden" name="returnUrl" value="ManageOrders"/><div class="form-group mb-0"><label>Next Status</label><select name="status" class="form-control">@if (Model.Status == "Pending"){<option value="Processing">Processing</option><option value="Cancelled">Cancelled</option>}else if (Model.Status == "Processing"){<option value="Shipped">Shipped</option><option value="Cancelled">Cancelled</option>}else if (Model.Status == "Shipped"){<option value="Delivered">Delivered</option>}</select><small class="form-text text-muted">Status changes follow the normal fulfillment sequence.</small></div></div><div class="modal-footer"><button type="button" class="btn clear-btn cancel" data-dismiss="modal"><i class="fas fa-times"></i> Cancel</button><button type="submit" class="btn clear-btn confirm"><i class="fas fa-check"></i> Confirm Status Change</button></div></form></div></div></div>
}
