@model PharmacyStoreViewModel
@{
    ViewData["Title"] = Model.Pharmacy.Name;
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--sp:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a;--soft:#183531}.store-page{background:#f7fbfa;color:var(--ink);min-height:100vh}.dark-mode .store-page{background:#151a1d}.store-hero{padding:44px 0;background:linear-gradient(135deg,#0a4246,#0f766e);color:#fff}.store-top{display:flex;align-items:center;justify-content:space-between;gap:22px}.store-brand{display:flex;align-items:center;gap:16px}.store-logo{width:72px;height:72px;border-radius:20px;background:rgba(255,255,255,.12);display:grid;place-items:center;font-size:30px}.store-brand h1{font-size:30px;margin:0 0 6px}.store-brand p{margin:0;color:rgba(255,255,255,.75);font-size:12px}.store-badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.store-badge{padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.1);font-size:10px}.store-score{text-align:right}.store-score strong{font-size:28px;display:block}.store-score span{font-size:10px;color:rgba(255,255,255,.7)}.store-controls{padding:22px 0;background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}.store-filter{display:grid;grid-template-columns:1fr 230px 120px;gap:10px}.store-filter input,.store-filter select{height:46px;border:1px solid var(--line);border-radius:12px;padding:0 13px;background:var(--card);color:var(--ink)}.store-filter button{border:0;border-radius:12px;background:var(--sp);color:#fff;font-weight:700}.store-content{padding:36px 0 65px}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.product-card{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.25s}.product-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(20,60,65,.09)}.product-media{height:190px;background:#fff;display:grid;place-items:center;padding:18px;position:relative}.dark-mode .product-media{background:#252d31}.product-media img{max-width:100%;max-height:150px;object-fit:contain}.pill{position:absolute;top:11px;left:11px;padding:6px 8px;border-radius:999px;background:#e1f5fb;color:#087995;font-size:8px;font-weight:700}.product-body{padding:15px}.cat{font-size:8px;letter-spacing:.7px;text-transform:uppercase;color:var(--sp);font-weight:700}.product-body h3{font-size:14px;line-height:1.35;margin:6px 0 12px;min-height:38px}.price-row{display:flex;align-items:center;justify-content:space-between}.price{font-size:19px;font-weight:700}.stock{font-size:9px;color:var(--muted)}.card-actions{display:grid;grid-template-columns:1fr;gap:7px;margin-top:13px}.card-actions a{height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;background:var(--soft);color:var(--sp)}.empty{padding:35px;border:1px dashed var(--line);border-radius:18px;background:var(--card);color:var(--muted)}
@@media(max-width:991px){.product-grid{grid-template-columns:repeat(2,1fr)}.store-filter{grid-template-columns:1fr 180px 100px}}
@@media(max-width:575px){.store-top{align-items:flex-start;flex-direction:column}.store-score{text-align:left}.store-brand{align-items:flex-start}.store-logo{width:58px;height:58px}.store-brand h1{font-size:24px}.store-filter{grid-template-columns:1fr}.store-filter button{height:46px}.product-grid{grid-template-columns:1fr}.store-controls{position:static}}
</style>
}
<div class="store-page">
<section class="store-hero"><div class="container"><div class="store-top"><div class="store-brand"><div class="store-logo"><i class="fas fa-clinic-medical"></i></div><div><h1>@Model.Pharmacy.Name</h1><p><i class="fas fa-map-marker-alt"></i> @Model.Pharmacy.Address</p><div class="store-badges"><span class="store-badge"><i class="fas fa-check-circle"></i> Verified pharmacy</span><span class="store-badge"><i class="fas fa-bolt"></i> @Model.Pharmacy.EstimatedDeliveryMinutes min</span><span class="store-badge"><i class="fas fa-truck"></i> @(Model.Pharmacy.DeliveryFee==0?"Free delivery":"$"+Model.Pharmacy.DeliveryFee.ToString("0.00")+" delivery")</span><span class="store-badge">@(Model.Pharmacy.IsOpen?"Open now":"Closed")</span></div></div></div><div class="store-score"><strong>★ @Model.Pharmacy.Rating</strong><span>@Model.Pharmacy.RatingCount customer ratings</span></div></div></div></section>
<div class="store-controls"><div class="container"><form method="get" class="store-filter"><input name="q" value="@Model.Query" placeholder="Search this pharmacy..."/><select name="categoryId"><option value="">All categories</option>@foreach(var c in Model.Categories){<option value="@c.CategoryID" selected="@(Model.CategoryId==c.CategoryID)">@c.CategoryName</option>}</select><button>Search</button></form></div></div>
<section class="store-content"><div class="container"><div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:20px"><div><h2 style="margin:0;font-size:27px">Available now</h2><div style="font-size:11px;color:var(--muted);margin-top:5px">@Model.Offers.Count products with live pharmacy inventory</div></div><a href="/Marketplace" style="font-size:10px;font-weight:700;color:var(--sp)">← All pharmacies</a></div>
@if(Model.Offers.Any()){<div class="product-grid">@foreach(var o in Model.Offers){<article class="product-card"><a href="/Marketplace/Compare/@o.ProductId"><div class="product-media">@if(o.RequiresPrescription){<span class="pill"><i class="fas fa-prescription"></i> Prescription</span>}<img src="@o.ImageUrl" alt="@o.ProductName" loading="lazy"/></div></a><div class="product-body"><div class="cat">@o.CategoryName</div><h3>@o.ProductName</h3><div class="price-row"><span class="price">$@o.Price.ToString("0.00")</span><span class="stock">@o.Stock units</span></div><div class="card-actions"><a href="/Marketplace/Compare/@o.ProductId">@(o.RequiresPrescription?"Compare & reserve":"Compare pharmacy offers") →</a></div></div></article>}</div>}else{<div class="empty">No matching products are currently available at this pharmacy.</div>}</div></section>
</div>