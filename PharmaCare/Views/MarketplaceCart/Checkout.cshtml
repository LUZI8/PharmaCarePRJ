@model MarketplaceCheckoutViewModel
@{
    ViewData["Title"] = "Marketplace Checkout";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--c:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a;--soft:#183531}.checkout-page{background:#f7fbfa;color:var(--ink);min-height:100vh;padding:42px 0 70px}.dark-mode .checkout-page{background:#151a1d}.co-grid{display:grid;grid-template-columns:1.15fr .75fr;gap:22px}.co-card,.co-summary{background:var(--card);border:1px solid var(--line);border-radius:20px}.co-card{padding:22px}.co-summary{padding:22px;height:max-content;position:sticky;top:94px;background:linear-gradient(145deg,#0b4e4b,#0d625e);color:#fff}.co-card h1{font-size:28px;margin:0 0 5px}.sub{font-size:10px;color:var(--muted);margin-bottom:22px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field.full{grid-column:1/-1}.field label{display:block;font-size:9px;font-weight:700;margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px}.field input,.field textarea{width:100%;border:1px solid var(--line);border-radius:11px;background:var(--card);color:var(--ink);padding:12px;font-size:12px;outline:none}.field textarea{min-height:95px;resize:vertical}.validation{padding:12px;border-radius:11px;background:#fdeceb;color:#a13f3b;font-size:10px;margin-bottom:14px}.co-summary h2{font-size:18px;margin:0 0 18px}.sum-item{display:flex;justify-content:space-between;gap:10px;padding:8px 0;font-size:10px;color:rgba(255,255,255,.84)}.sum-row{display:flex;justify-content:space-between;padding:9px 0;font-size:11px}.sum-total{display:flex;justify-content:space-between;margin-top:10px;padding-top:14px;border-top:1px solid rgba(255,255,255,.18);font-size:20px;font-weight:700}.place{width:100%;height:50px;border:0;border-radius:12px;background:#22c1b4;color:#fff;font-weight:700;font-size:11px;margin-top:18px}.store-note{font-size:9px;color:rgba(255,255,255,.65);margin-top:10px;line-height:1.5}
@@media(max-width:800px){.co-grid{grid-template-columns:1fr}.co-summary{position:static}.fields{grid-template-columns:1fr}.field.full{grid-column:auto}}
</style>
}
<div class="checkout-page"><div class="container"><form method="post" action="/MarketplaceCart/PlaceOrder">@Html.AntiForgeryToken()<div class="co-grid"><section class="co-card"><h1>Complete your pharmacy order.</h1><div class="sub">Delivery from @Model.Basket.Pharmacy?.Name. Review your details before placing the order.</div>@if(!ViewData.ModelState.IsValid){<div class="validation">@Html.ValidationSummary(false)</div>}<div class="fields"><div class="field full"><label>Full shipping address</label><input asp-for="ShippingAddress" placeholder="Street, building, floor, apartment"/></div><div class="field"><label>City</label><input asp-for="City"/></div><div class="field"><label>Phone number</label><input asp-for="PhoneNumber"/></div><div class="field full"><label>Delivery notes (optional)</label><textarea asp-for="DeliveryNotes" placeholder="Landmark, gate, preferred instructions..."></textarea></div></div></section><aside class="co-summary"><h2>Your order</h2>@foreach(var item in Model.Basket.Items){<div class="sum-item"><span>@item.ProductName × @item.Quantity</span><strong>$@item.LineTotal.ToString("0.00")</strong></div>}<div style="margin:10px 0;border-top:1px solid rgba(255,255,255,.14)"></div><div class="sum-row"><span>Subtotal</span><strong>$@Model.Basket.Subtotal.ToString("0.00")</strong></div><div class="sum-row"><span>Delivery</span><strong>@(Model.Basket.DeliveryFee==0?"FREE":"$"+Model.Basket.DeliveryFee.ToString("0.00"))</strong></div><div class="sum-total"><span>Total</span><span>$@Model.Basket.Total.ToString("0.00")</span></div><button class="place" type="submit"><i class="fas fa-lock"></i> Place pharmacy order</button><div class="store-note">Cash on delivery. The pharmacy receives the order with the current live-stock allocation. Prescription-only medicines use the separate reservation and verification flow.</div></aside></div></form></div></div>