@{
    ViewData["Title"] = "Forgot Password - PharmaCare";
    Layout = null;
    var email = ViewBag.Email as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css?family=Rubik:400,700|Crimson+Text:400,400i" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/AccountViewStyles/Login.css" />
    <link rel="icon" href="~/assets/favicon-32x32.png" type="image/png">
</head>
<body class="dark-mode">
    <div class="header">
        <div class="logo">
            <a href="/">PHARMACARE</a>
        </div>
        <div class="theme-toggle">
            <button id="theme-toggle-btn">
                <span class="sun-icon">☀️</span>
                <span class="moon-icon" style="display: none;">🌙</span>
            </button>
        </div>
    </div>

    <div class="login-container">
        <h2 class="form-title">Forgot Password</h2>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""].Errors.Count > 0)
        {
            <div class="error-message">@ViewData.ModelState[""].Errors[0].ErrorMessage</div>
        }

        <p style="text-align:center;opacity:.8;margin-bottom:20px;">
            Confirm your identity and we'll email you a reset code.
        </p>

        <form method="post" action="@Url.Action("ForgotPassword", "Account")">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="Email">Email</label>
                <i class="fas fa-envelope form-icon"></i>
                <input type="email" class="form-control" id="Email" name="Email"
                       placeholder="Type your email" value="@email" required autofocus>
            </div>

            <div class="form-group">
                <label class="form-label" for="CurrentPassword">Last Remembered Password</label>
                <i class="fas fa-lock form-icon"></i>
                <input type="password" class="form-control" id="password-field" name="CurrentPassword"
                       placeholder="Your last remembered password" required>
                <span class="password-toggle" id="password-toggle">
                    <i class="fas fa-eye"></i>
                </span>
            </div>

            <button type="submit" class="btn">SEND RESET CODE</button>
        </form>

        <div style="text-align:center;margin-top:16px;">
            <a href="@Url.Action("Login", "Account")" class="forgot-password">Back to Sign In</a>
        </div>
    </div>

    <script src="~/assets/js/jquery-3.3.1.min.js"></script>
    <script src="~/assets/js/AccountViewScripts/Login.js "></script>
</body>
</html>
