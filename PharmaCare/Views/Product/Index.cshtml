@model IEnumerable<PharmaCare.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
    var products = Model?.ToList() ?? new List<PharmaCare.ViewModels.ProductViewModel>();
    var today = DateTime.Today;
    var expiryLimit = today.AddDays(90);
    var total = products.Count;
    var lowStock = products.Count(p => p.Stock > 0 && p.Stock <= p.ReorderLevel);
    var outOfStock = products.Count(p => p.Stock <= 0);
    var expiring = products.Count(p => p.ExpiryDate.Date >= today && p.ExpiryDate.Date <= expiryLimit);
}
@section Styles {
<style>
.inv-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:28px 0 18px}.inv-head h2{font-weight:750;margin:0}.inv-head p{color:#6c757d;margin:5px 0 0}.metric-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);height:100%}.metric-card .card-body{padding:17px 19px}.metric-label{font-size:11px;text-transform:uppercase;font-weight:750;color:#6c757d;letter-spacing:.5px}.metric-value{font-size:24px;font-weight:750;margin-top:3px}.inventory-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.inventory-toolbar{display:grid;grid-template-columns:minmax(260px,1fr) 150px 160px 150px;gap:9px;align-items:center;padding:14px 18px;border-bottom:1px solid #edf0f2}.search-wrap-inv{position:relative}.search-wrap-inv i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#8b949c}.search-wrap-inv input{padding-left:34px}.product-img{width:46px;height:46px;object-fit:contain;border:1px solid #e9ecef;border-radius:9px;background:#fff}.product-name{font-weight:750}.subtle{font-size:11px;color:#7a838b}.id-stack{line-height:1.45}.id-chip{display:inline-block;font-size:10px;background:#f2f5f7;border-radius:5px;padding:2px 6px;margin-top:3px;color:#65707a;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row-alert{background:rgba(255,193,7,.055)}.row-danger{background:rgba(220,53,69,.055)}.empty-products{padding:50px 20px;text-align:center;color:#6c757d}.status-chip{font-size:10px;padding:5px 7px;border-radius:7px}.table td,.table th{vertical-align:middle}.table thead th{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:#66707a;border-top:0;padding:12px 14px}.table td{padding:12px 14px}.inventory-footer{display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-top:1px solid #edf0f2}.toast-alert{display:flex;align-items:center;gap:10px;border:0;border-radius:10px;box-shadow:0 3px 12px rgba(0,0,0,.06);padding:13px 16px;margin-bottom:16px}.toast-alert .close{margin-left:auto}.inventory-actions{display:flex;justify-content:flex-end;gap:5px;white-space:nowrap}.inventory-actions .btn{border-radius:7px;padding:5px 8px;font-size:11px;font-weight:650}.storefront-view{border-color:#0d9488!important;color:#0d9488!important}.storefront-view:hover{background:#0d9488!important;border-color:#0d9488!important;color:#fff!important}.stock-number{font-weight:750}.stock-threshold{font-size:10px;color:#7a838b}.dark-mode .inventory-card,.dark-mode .metric-card{background:#1f1f1f}.dark-mode .inventory-toolbar,.dark-mode .inventory-footer{border-color:#333}.dark-mode .product-img{border-color:#444}.dark-mode .id-chip{background:#2c2c2c;color:#bbb}.dark-mode .table thead th{color:#c9c9c9}.dark-mode .storefront-view{color:#5eead4!important;border-color:#2dd4bf!important}.dark-mode .storefront-view:hover{color:#062c29!important;background:#5eead4!important}
@@media(max-width:1199px){.inventory-toolbar{grid-template-columns:1fr 1fr}.inventory-toolbar .search-wrap-inv{grid-column:1/-1}}
@@media(max-width:767px){.inv-head{align-items:flex-start;flex-direction:column}.inventory-toolbar{grid-template-columns:1fr}.inventory-toolbar .search-wrap-inv{grid-column:auto}.inventory-footer{flex-direction:column;gap:7px;align-items:flex-start}.inventory-actions{justify-content:flex-start}.table{min-width:1050px}}
</style>
}
<div class="inv-head">
  <div><h2>Product Inventory</h2><p>Track medicine identifiers, stock thresholds, expiry and availability.</p></div>
  <div class="d-flex" style="gap:7px"><a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index","Category")"><i class="fas fa-tags mr-1"></i> Categories</a><a class="btn btn-success btn-sm" href="@Url.Action("Create","Product")"><i class="fas fa-plus mr-1"></i> Add Product</a></div>
</div>
@if (TempData["SuccessMessage"] != null){<div class="alert alert-success alert-dismissible fade show toast-alert"><i class="fas fa-check-circle"></i><span>@TempData["SuccessMessage"]</span><button type="button" class="close" data-dismiss="alert">&times;</button></div>}
@if (TempData["ErrorMessage"] != null){<div class="alert alert-danger alert-dismissible fade show toast-alert"><i class="fas fa-exclamation-circle"></i><span>@TempData["ErrorMessage"]</span><button type="button" class="close" data-dismiss="alert">&times;</button></div>}
<div class="row mb-3">
  <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Total Products</div><div class="metric-value">@total</div><div class="subtle">Inventory records</div></div></div></div>
  <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-warning">Low Stock</div><div class="metric-value">@lowStock</div><div class="subtle">Based on each product threshold</div></div></div></div>
  <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-danger">Out of Stock</div><div class="metric-value">@outOfStock</div><div class="subtle">Needs replenishment</div></div></div></div>
  <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-info">Expiring Soon</div><div class="metric-value">@expiring</div><div class="subtle">Within 90 days</div></div></div></div>
</div>
<div class="card inventory-card">
 <div class="inventory-toolbar">
   <div class="search-wrap-inv"><i class="fas fa-search"></i><input id="productSearch" class="form-control form-control-sm" placeholder="Search name, SKU, barcode, manufacturer or category..." /></div>
   <select id="stockFilter" class="form-control form-control-sm"><option value="all">All stock</option><option value="low">Low stock</option><option value="out">Out of stock</option><option value="healthy">Healthy stock</option></select>
   <select id="expiryFilter" class="form-control form-control-sm"><option value="all">All expiry</option><option value="expiring">Expiring soon</option><option value="expired">Expired</option><option value="good">Good</option></select>
   <select id="rxFilter" class="form-control form-control-sm"><option value="all">All products</option><option value="rx">Prescription</option><option value="otc">OTC</option></select>
 </div>
 <div class="table-responsive">
 <table class="table table-hover mb-0" id="productTable"><thead><tr><th>Product</th><th>Inventory IDs</th><th>Price</th><th>Stock</th><th>Status</th><th>Expiry</th><th>Category</th><th class="text-right">Actions</th></tr></thead><tbody>
 @foreach(var p in products){
   var expired = p.ExpiryDate.Date < today;
   var expSoon = !expired && p.ExpiryDate.Date <= expiryLimit;
   var stockState = p.Stock <= 0 ? "out" : p.Stock <= p.ReorderLevel ? "low" : "healthy";
   var expiryState = expired ? "expired" : expSoon ? "expiring" : "good";
   var rxState = p.RequiresPrescription ? "rx" : "otc";
   var searchText = $"{p.ProductName} {p.SKU} {p.Barcode} {p.Manufacturer} {p.Category?.CategoryName}".ToLower();
   <tr class="product-row @(p.Stock<=0 || expired ? "row-danger" : (p.Stock<=p.ReorderLevel || expSoon ? "row-alert" : ""))" data-search="@searchText" data-stock="@stockState" data-expiry="@expiryState" data-rx="@rxState">
    <td><div class="d-flex align-items-center"><img class="product-img mr-3" src="@(string.IsNullOrWhiteSpace(p.ImageUrl)?"/images/product_01.png":p.ImageUrl)" alt="@p.ProductName"/><div><div class="product-name">@p.ProductName</div><div class="subtle">@(string.IsNullOrWhiteSpace(p.Manufacturer)?"Manufacturer not set":p.Manufacturer)</div></div></div></td>
    <td><div class="id-stack"><div class="subtle">ID #@p.ProductId</div>@if(!string.IsNullOrWhiteSpace(p.SKU)){<span class="id-chip" title="SKU @p.SKU">SKU: @p.SKU</span>}@if(!string.IsNullOrWhiteSpace(p.Barcode)){<div><span class="id-chip" title="Barcode @p.Barcode"><i class="fas fa-barcode mr-1"></i>@p.Barcode</span></div>}</div></td>
    <td><strong>$@p.Price.ToString("0.00")</strong></td>
    <td><div class="stock-number">@p.Stock</div><div class="stock-threshold">Alert at ≤ @p.ReorderLevel</div></td>
    <td>@if(!p.IsActive){<span class="badge badge-secondary status-chip">Inactive</span>}else if(p.Stock<=0){<span class="badge badge-danger status-chip">Out of stock</span>}else if(p.Stock<=p.ReorderLevel){<span class="badge badge-warning status-chip">Low stock</span>}else{<span class="badge badge-success status-chip">Active</span>} @if(p.RequiresPrescription){<span class="badge badge-info status-chip">Rx</span>}</td>
    <td>@if(expired){<span class="badge badge-danger status-chip">Expired</span>}else if(expSoon){<span class="badge badge-warning status-chip">Expiring soon</span>}else{<span class="badge badge-success status-chip">Good</span>}<div class="subtle mt-1">@p.ExpiryDate.ToString("MMM dd, yyyy")</div></td>
    <td>@(p.Category?.CategoryName ?? "Uncategorized")</td>
    <td><div class="inventory-actions"><a class="btn btn-outline-primary" href="@Url.Action("Edit","Product",new{id=p.ProductId})"><i class="fas fa-edit mr-1"></i>Edit</a><a class="btn storefront-view" href="@Url.Action("ShopSingle","FrontEnd",new{id=p.ProductId})" target="_blank" rel="noopener"><i class="fas fa-external-link-alt mr-1"></i>View Storefront</a><a class="btn btn-outline-danger" href="@Url.Action("Delete","Product",new{id=p.ProductId})"><i class="fas fa-trash-alt"></i></a></div></td>
   </tr>
 }
 </tbody></table></div>
 <div id="noMatches" class="empty-products" style="display:none"><i class="fas fa-search fa-2x mb-3"></i><div>No products match these filters.</div></div>
 <div class="inventory-footer"><span class="subtle"><span id="visibleCount">@total</span> of @total products shown</span><span class="subtle"><i class="fas fa-barcode mr-1"></i>Search accepts SKU and barcode values</span></div>
</div>
@section Scripts{
<script>
(function(){const rows=[...document.querySelectorAll('.product-row')],search=document.getElementById('productSearch'),stock=document.getElementById('stockFilter'),expiry=document.getElementById('expiryFilter'),rx=document.getElementById('rxFilter'),count=document.getElementById('visibleCount'),empty=document.getElementById('noMatches');function apply(){const q=search.value.toLowerCase().trim();let shown=0;rows.forEach(r=>{const ok=(!q||r.dataset.search.includes(q))&&(stock.value==='all'||r.dataset.stock===stock.value)&&(expiry.value==='all'||r.dataset.expiry===expiry.value)&&(rx.value==='all'||r.dataset.rx===rx.value);r.style.display=ok?'':'none';if(ok)shown++;});count.textContent=shown;empty.style.display=shown?'none':'block';}search.addEventListener('input',apply);[stock,expiry,rx].forEach(x=>x.addEventListener('change',apply));})();
</script>}
