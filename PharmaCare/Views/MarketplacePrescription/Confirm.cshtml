@model MarketplacePrescriptionConfirmViewModel
@{
    ViewData["Title"] = "Upload Prescription";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--rx:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a;--soft:#183531}.rx-page{background:#f7fbfa;color:var(--ink);min-height:100vh;padding:42px 0 70px}.dark-mode .rx-page{background:#151a1d}.rx-grid{display:grid;grid-template-columns:1fr .8fr;gap:22px}.rx-card,.rx-summary{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px}.rx-summary{height:max-content}.rx-card h1{font-size:28px;margin:0 0 5px}.sub{font-size:10px;color:var(--muted);margin-bottom:22px}.notice{padding:14px;border-radius:12px;background:#fff6dc;color:#7f5a00;font-size:10px;line-height:1.6;margin-bottom:18px}.field{margin-bottom:14px}.field label{display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}.field input,.field textarea{width:100%;border:1px solid var(--line);border-radius:11px;padding:12px;background:var(--card);color:var(--ink);font-size:12px}.field textarea{min-height:95px}.filebox{border:1px dashed #9dcfc9;border-radius:13px;padding:16px;background:var(--soft)}.filebox input{border:0;padding:0;background:transparent}.filebox p{font-size:9px;color:var(--muted);margin:8px 0 0}.summary-product{display:flex;gap:14px;align-items:center}.summary-product img{width:82px;height:82px;object-fit:contain;background:#fff;border-radius:13px}.summary-product h2{font-size:16px;margin:0 0 4px}.summary-product p{font-size:9px;color:var(--muted);margin:0}.meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}.mini{padding:12px;border-radius:11px;background:var(--soft)}.mini span{display:block;font-size:8px;color:var(--muted);text-transform:uppercase;margin-bottom:4px}.mini strong{font-size:11px}.submit{width:100%;height:48px;border:0;border-radius:12px;background:var(--rx);color:#fff;font-size:11px;font-weight:700;margin-top:18px}
@@media(max-width:760px){.rx-grid{grid-template-columns:1fr}.rx-page{padding-top:24px}.rx-card,.rx-summary{padding:17px}.rx-card h1{font-size:24px}}
</style>
}
<div class="rx-page"><div class="container"><div class="rx-grid"><section class="rx-card"><h1>Upload your prescription.</h1><div class="sub">Your request goes securely to @Model.Offer.Pharmacy.Name for pharmacist review.</div><div class="notice"><i class="fas fa-shield-alt"></i> Upload JPG, PNG or PDF up to 8 MB. The file is stored outside the public website and can only be opened by you, the assigned pharmacy pharmacist, or an administrator. Uploading does not guarantee dispensing.</div>@if(!ViewData.ModelState.IsValid){<div class="notice" style="background:#fdeceb;color:#a13f3b">@Html.ValidationSummary(false)</div>}<form method="post" enctype="multipart/form-data" action="/MarketplacePrescription/Submit?offerId=@Model.Offer.PharmacyProductId">@Html.AntiForgeryToken()<div class="field"><label>Prescription file</label><div class="filebox"><input asp-for="PrescriptionFile" type="file" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" required/><p>Use a clear photo or the original PDF. Do not upload unrelated documents.</p></div></div><div class="field"><label>Contact phone</label><input asp-for="ContactPhone"/></div><div class="field"><label>Requested quantity</label><input asp-for="Quantity" type="number" min="1" max="@Math.Min(5,Model.Offer.Stock)"/></div><div class="field"><label>Note to pharmacist (optional)</label><textarea asp-for="CustomerNote" placeholder="Add any relevant clarification for the pharmacy review..."></textarea></div><button class="submit" type="submit"><i class="fas fa-lock"></i> Upload & send for review</button></form></section><aside class="rx-summary"><div class="summary-product"><img src="@Model.Offer.Product.ImageUrl" alt="@Model.Offer.Product.ProductName"/><div><h2>@Model.Offer.Product.ProductName</h2><p>@Model.Offer.Pharmacy.Name</p></div></div><div class="meta"><div class="mini"><span>Price shown</span><strong>$@Model.Offer.Price.ToString("0.00")</strong></div><div class="mini"><span>Stock</span><strong>@Model.Offer.Stock units</strong></div><div class="mini"><span>Pharmacy</span><strong>★ @Model.Offer.Pharmacy.Rating</strong></div><div class="mini"><span>Review window</span><strong>Up to 3 days</strong></div></div></aside></div></div></div>