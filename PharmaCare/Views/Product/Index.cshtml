@model IEnumerable<PharmaCare.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
    var products = Model?.ToList() ?? new List<PharmaCare.ViewModels.ProductViewModel>();
    var today = DateTime.Today;
    var expiryLimit = today.AddDays(90);
    var total = products.Count;
    var lowStock = products.Count(p => p.Stock > 0 && p.Stock <= 10);
    var outOfStock = products.Count(p => p.Stock <= 0);
    var expiring = products.Count(p => p.ExpiryDate.Date >= today && p.ExpiryDate.Date <= expiryLimit);
}
@section Styles {
<style>
.inv-head{display:flex;justify-content:space-between;align-items:flex-end;margin:28px 0 18px}.inv-head h2{font-weight:700;margin:0}.inv-head p{color:#6c757d;margin:5px 0 0}.metric-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06)}.metric-card .card-body{padding:17px 19px}.metric-label{font-size:11px;text-transform:uppercase;font-weight:700;color:#6c757d;letter-spacing:.5px}.metric-value{font-size:24px;font-weight:700;margin-top:3px}.inventory-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06)}.inventory-card .card-header{background:transparent;padding:16px 18px}.filter-bar{display:flex;gap:8px;flex-wrap:wrap}.filter-bar .form-control{min-width:150px}.product-img{width:46px;height:46px;object-fit:contain;border:1px solid #e9ecef;border-radius:8px;background:#fff}.product-name{font-weight:700}.subtle{font-size:12px;color:#7a838b}.action-button{display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;border-radius:7px;margin-right:4px;text-decoration:none!important}.action-button:hover{background:#f2f4f6}.row-alert{background:rgba(255,193,7,.05)}.row-danger{background:rgba(220,53,69,.05)}.empty-products{padding:50px 20px;text-align:center;color:#6c757d}.status-chip{font-size:11px;padding:5px 7px;border-radius:8px}.table td,.table th{vertical-align:middle}.table thead th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#59616a;border-top:0}.inventory-footer{display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-top:1px solid #edf0f2}.toast-alert{display:flex;align-items:center;gap:10px;border:0;border-radius:10px;box-shadow:0 3px 12px rgba(0,0,0,.06);padding:13px 16px;margin-bottom:16px}.toast-alert .close{margin-left:auto;font-size:18px;line-height:1}@@media(max-width:768px){.inv-head{align-items:flex-start;flex-direction:column;gap:12px}.filter-bar>*{width:100%!important}.inventory-footer{flex-direction:column;gap:10px;align-items:flex-start}}
body.dark-mode .inventory-card,body.dark-mode .metric-card{background:#1f1f1f}.dark-mode .action-button:hover{background:#333}.dark-mode .table thead th{color:#c9c9c9}.dark-mode .inventory-footer{border-color:#333}.dark-mode .product-img{border-color:#444}
</style>
}
<div class="inv-head">
  <div><h2>Product Inventory</h2><p>Monitor stock, expiry, prescription status and product availability.</p></div>
  <div><a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index","Category")"><i class="fas fa-tags mr-1"></i> Categories</a> <a class="btn btn-success btn-sm" href="@Url.Action("Create","Product")"><i class="fas fa-plus mr-1"></i> Add Product</a></div>
</div>
@if (TempData["SuccessMessage"] != null)
{
  <div class="alert alert-success alert-dismissible fade show toast-alert" role="alert"><i class="fas fa-check-circle"></i><span>@TempData["SuccessMessage"]</span><button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
  <div class="alert alert-danger alert-dismissible fade show toast-alert" role="alert"><i class="fas fa-exclamation-circle"></i><span>@TempData["ErrorMessage"]</span><button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>
}
<div class="row mb-3">
  <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Total Products</div><div class="metric-value">@total</div></div></div></div>
  <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-warning">Low Stock</div><div class="metric-value">@lowStock</div><div class="subtle">1-10 units remaining</div></div></div></div>
  <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-danger">Out of Stock</div><div class="metric-value">@outOfStock</div></div></div></div>
  <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-info">Expiring Soon</div><div class="metric-value">@expiring</div><div class="subtle">Within 90 days</div></div></div></div>
</div>
<div class="card inventory-card">
 <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
   <strong>Inventory</strong>
   <div class="filter-bar mt-2 mt-md-0">
     <input id="productSearch" class="form-control form-control-sm" placeholder="Search products or categories..." />
     <select id="stockFilter" class="form-control form-control-sm"><option value="all">All stock</option><option value="low">Low stock</option><option value="out">Out of stock</option><option value="healthy">Healthy stock</option></select>
     <select id="expiryFilter" class="form-control form-control-sm"><option value="all">All expiry</option><option value="expiring">Expiring soon</option><option value="expired">Expired</option><option value="good">Good</option></select>
     <select id="rxFilter" class="form-control form-control-sm"><option value="all">All products</option><option value="rx">Prescription</option><option value="otc">OTC</option></select>
   </div>
 </div>
 <div class="table-responsive">
 <table class="table table-hover mb-0" id="productTable"><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th>Status</th><th>Expiry</th><th>Category</th><th class="text-right">Actions</th></tr></thead><tbody>
 @foreach(var p in products){
   var expired = p.ExpiryDate.Date < today;
   var expSoon = !expired && p.ExpiryDate.Date <= expiryLimit;
   var stockState = p.Stock <= 0 ? "out" : p.Stock <= 10 ? "low" : "healthy";
   var expiryState = expired ? "expired" : expSoon ? "expiring" : "good";
   var rxState = p.RequiresPrescription ? "rx" : "otc";
   <tr class="product-row @(p.Stock<=0 || expired ? "row-danger" : (p.Stock<=10 || expSoon ? "row-alert" : ""))" data-search="@((p.ProductName+" "+(p.Category?.CategoryName??"")).ToLower())" data-stock="@stockState" data-expiry="@expiryState" data-rx="@rxState">
    <td><div class="d-flex align-items-center"><img class="product-img mr-3" src="@(string.IsNullOrWhiteSpace(p.ImageUrl)?"/images/product_01.png":p.ImageUrl)" alt="@p.ProductName"/><div><div class="product-name">@p.ProductName</div><div class="subtle">ID #@p.ProductId</div></div></div></td>
    <td><strong>$@p.Price.ToString("0.00")</strong></td>
    <td><strong>@p.Stock</strong><div class="subtle">units</div></td>
    <td>@if(!p.IsActive){<span class="badge badge-secondary status-chip">Inactive</span>}else if(p.Stock<=0){<span class="badge badge-danger status-chip">Out of stock</span>}else if(p.Stock<=10){<span class="badge badge-warning status-chip">Low stock</span>}else{<span class="badge badge-success status-chip">Active</span>} @if(p.RequiresPrescription){<span class="badge badge-info status-chip">Rx</span>}</td>
    <td>@if(expired){<span class="badge badge-danger status-chip">Expired</span>}else if(expSoon){<span class="badge badge-warning status-chip">Expiring soon</span>}else{<span class="badge badge-success status-chip">Good</span>}<div class="subtle mt-1">@p.ExpiryDate.ToString("MMM dd, yyyy")</div></td>
    <td>@(p.Category?.CategoryName ?? "Uncategorized")</td>
    <td class="text-right"><a class="action-button text-primary" title="Edit" href="@Url.Action("Edit","Product",new{id=p.ProductId})"><i class="fas fa-edit"></i></a><a class="action-button text-info" title="Details" href="@Url.Action("Details","Product",new{id=p.ProductId})"><i class="fas fa-info-circle"></i></a><a class="action-button text-danger" title="Delete" href="@Url.Action("Delete","Product",new{id=p.ProductId})"><i class="fas fa-trash-alt"></i></a></td>
   </tr>
 }
 </tbody></table></div>
 <div id="noMatches" class="empty-products" style="display:none"><i class="fas fa-search fa-2x mb-3"></i><div>No products match these filters.</div></div>
 <div class="inventory-footer"><span class="subtle"><span id="visibleCount">@total</span> of @total products shown</span><span class="subtle">Low stock threshold: 10 units</span></div>
</div>
@section Scripts{
<script>
(function(){const rows=[...document.querySelectorAll('.product-row')],search=document.getElementById('productSearch'),stock=document.getElementById('stockFilter'),expiry=document.getElementById('expiryFilter'),rx=document.getElementById('rxFilter'),count=document.getElementById('visibleCount'),empty=document.getElementById('noMatches');function apply(){const q=search.value.toLowerCase().trim();let shown=0;rows.forEach(r=>{const ok=(!q||r.dataset.search.includes(q))&&(stock.value==='all'||r.dataset.stock===stock.value)&&(expiry.value==='all'||r.dataset.expiry===expiry.value)&&(rx.value==='all'||r.dataset.rx===rx.value);r.style.display=ok?'':'none';if(ok)shown++;});count.textContent=shown;empty.style.display=shown?'none':'block';}search.addEventListener('input',apply);[stock,expiry,rx].forEach(x=>x.addEventListener('change',apply));})();
</script>}
