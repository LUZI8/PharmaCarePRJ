@model MarketplaceOrderDetailsViewModel
@{
    ViewData["Title"] = "Track " + Model.Order.OrderNumber;
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--t:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#edf4f5;--muted:#99a7ac;--line:#303b40;--card:#20272a;--soft:#183531}.track-page{min-height:100vh;background:#f7fbfa;color:var(--ink);padding:38px 0 70px}.dark-mode .track-page{background:#151a1d}.track-grid{display:grid;grid-template-columns:1fr 340px;gap:18px}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:20px}.head{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;margin-bottom:20px}.head h1{font-size:26px;margin:0}.muted{font-size:10px;color:var(--muted)}.status{padding:8px 11px;border-radius:99px;background:var(--soft);color:var(--t);font-size:9px;font-weight:700}.timeline{position:relative;padding-left:30px}.timeline:before{content:"";position:absolute;left:9px;top:12px;bottom:12px;width:2px;background:var(--line)}.event{position:relative;padding:0 0 23px}.event:last-child{padding-bottom:0}.dot{position:absolute;left:-30px;top:2px;width:20px;height:20px;border-radius:50%;background:var(--card);border:5px solid var(--t);z-index:2}.event h3{font-size:13px;margin:0 0 4px}.event p{font-size:9px;color:var(--muted);margin:0;line-height:1.55}.items{margin-top:18px}.item{display:grid;grid-template-columns:1fr auto;gap:12px;padding:11px 0;border-top:1px solid var(--line);font-size:10px}.summary-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-top:1px solid var(--line);font-size:10px}.summary-row.total{font-size:13px;font-weight:700}.pharmacy{padding:14px;border-radius:14px;background:var(--soft);margin-bottom:15px}.pharmacy strong{font-size:12px}.back{display:inline-block;margin-bottom:15px;font-size:10px;font-weight:700;color:var(--t)}
@@media(max-width:850px){.track-grid{grid-template-columns:1fr}}
@@media(max-width:520px){.track-page{padding-top:22px}.card{padding:16px}.head{flex-direction:column}.head h1{font-size:22px}}
</style>
}
<div class="track-page"><div class="container"><a class="back" href="/MarketplaceOrders">← All marketplace orders</a><div class="track-grid">
<section class="card"><div class="head"><div><div class="muted">ORDER TRACKING</div><h1>@Model.Order.OrderNumber</h1><div class="muted" style="margin-top:5px">Placed @Model.Order.OrderDate.ToString("MMM d, yyyy · HH:mm")</div></div><span class="status">@Model.Order.Status</span></div>
<div class="timeline">@foreach(var h in Model.History){<div class="event"><span class="dot"></span><h3>@h.Status</h3><p>@h.ChangedAt.ToString("MMM d, HH:mm")@if(!string.IsNullOrWhiteSpace(h.Notes)){<text> · @h.Notes</text>}</p></div>}</div>
<div class="items"><h2 style="font-size:16px;margin:0 0 8px">Order items</h2>@foreach(var i in Model.Order.Items){<div class="item"><div><strong>@i.ProductName</strong><div class="muted">Qty @i.Quantity × $@i.UnitPrice.ToString("0.00")</div></div><strong>$@i.LineTotal.ToString("0.00")</strong></div>}</div>
</section>
<aside class="card"><div class="pharmacy"><div class="muted">FULFILLED BY</div><strong>@Model.Order.Pharmacy.Name</strong><div class="muted" style="margin-top:4px">@Model.Order.Pharmacy.Address</div></div><h2 style="font-size:16px">Delivery details</h2><div class="muted" style="line-height:1.7">@Model.Order.ShippingAddress<br/>@Model.Order.City<br/>@Model.Order.PhoneNumber@if(!string.IsNullOrWhiteSpace(Model.Order.DeliveryNotes)){<br/><br/><strong>Instructions:</strong><br/>@Model.Order.DeliveryNotes}</div><div style="margin-top:20px"><div class="summary-row"><span>Subtotal</span><strong>$@Model.Order.Subtotal.ToString("0.00")</strong></div><div class="summary-row"><span>Delivery</span><strong>@(Model.Order.DeliveryFee==0?"FREE":"$"+Model.Order.DeliveryFee.ToString("0.00"))</strong></div><div class="summary-row total"><span>Total</span><strong>$@Model.Order.TotalAmount.ToString("0.00")</strong></div></div></aside>
</div></div></div>