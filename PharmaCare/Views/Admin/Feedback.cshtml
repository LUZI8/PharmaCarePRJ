@model IEnumerable<PharmaCare.Models.ContactMessage>
@{
    ViewData["Title"] = "Feedback & Contact";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var messages = Model?.ToList() ?? new List<PharmaCare.Models.ContactMessage>();
    var registeredCount = messages.Count(x => x.UserId.HasValue);
    var guestCount = messages.Count - registeredCount;
    var todayCount = messages.Count(x => x.DateSubmitted.Date == DateTime.Today);
}

@section Styles {
<style>
.feedback-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:28px 0 18px}.feedback-head h2{font-weight:750;margin:0}.feedback-head p{margin:5px 0 0;color:#6c757d}.metric-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);height:100%}.metric-card .card-body{padding:17px 18px}.metric-label{font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;color:#6c757d}.metric-value{font-size:24px;font-weight:700;margin-top:3px}.subtle{font-size:12px;color:#7a838b}.feedback-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.feedback-card .card-header{background:transparent;padding:16px 18px}.filter-bar{display:flex;gap:9px;flex-wrap:wrap}.filter-bar .form-control{min-width:190px}.sender-cell{min-width:190px}.sender-name{font-weight:700}.subject-text{font-weight:650;max-width:320px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.action-btn{display:inline-flex;align-items:center;gap:6px;border-radius:8px;font-weight:700}.message-box{border:1px solid #e9ecef;border-radius:10px;padding:14px;background:#fafbfc}.message-content{white-space:pre-wrap;overflow-wrap:anywhere;max-height:320px;overflow:auto}.empty-state{padding:56px 20px;text-align:center;color:#6c757d}.table thead th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#59616a;border-top:0}.table td,.table th{vertical-align:middle}.dark-mode .metric-card,.dark-mode .feedback-card,.dark-mode .message-box{background:#1f1f1f}.dark-mode .message-box{border-color:#3a3a3a}.dark-mode .table thead th{color:#c9c9c9}.dark-mode .form-control{background:#262626;color:#eee;border-color:#444}.dark-mode .modal-content{background:#1f1f1f;color:#eee;border-color:#333}.dark-mode .modal-header,.dark-mode .modal-footer{border-color:#333}@@media(max-width:768px){.feedback-head{align-items:flex-start;flex-direction:column}.filter-bar>*{width:100%!important}.subject-text{max-width:180px}}
</style>
}

<div class="feedback-head">
    <div>
        <h2>Feedback & Contact</h2>
        <p>Review customer questions, feedback and contact requests from one inbox.</p>
    </div>
    <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left mr-1"></i> Dashboard
    </a>
</div>

<div class="row mb-3">
    <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Total Messages</div><div class="metric-value">@messages.Count</div><div class="subtle">All contact submissions</div></div></div></div>
    <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-success">Registered Users</div><div class="metric-value">@registeredCount</div><div class="subtle">Messages linked to accounts</div></div></div></div>
    <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-info">Guest Messages</div><div class="metric-value">@guestCount</div><div class="subtle">Visitors without accounts</div></div></div></div>
    <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-warning">Today</div><div class="metric-value">@todayCount</div><div class="subtle">Received today</div></div></div></div>
</div>

<div class="card feedback-card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <strong>Message Inbox</strong>
            <div class="subtle">Customer messages currently stored in the system</div>
        </div>
        <div class="filter-bar mt-2 mt-md-0">
            <input type="text" class="form-control form-control-sm" id="messageSearch" placeholder="Search name, email or subject..." />
            <select class="form-control form-control-sm" id="senderFilter">
                <option value="all">All senders</option>
                <option value="registered">Registered users</option>
                <option value="guest">Guests</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0" id="feedbackTable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Sender</th>
                    <th>Subject</th>
                    <th>Type</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var message in messages)
            {
                var senderType = message.UserId.HasValue ? "registered" : "guest";
                var fullName = $"{message.FirstName} {message.LastName}".Trim();
                var subject = string.IsNullOrWhiteSpace(message.Subject) ? "No subject" : message.Subject;
                var search = $"{fullName} {message.Email} {subject} {message.Message}".ToLower();
                <tr class="message-row" data-sender="@senderType" data-search="@search">
                    <td>
                        <div class="font-weight-bold">@message.DateSubmitted.ToString("MMM dd, yyyy")</div>
                        <div class="subtle">@message.DateSubmitted.ToString("HH:mm")</div>
                    </td>
                    <td class="sender-cell">
                        <div class="sender-name">@(string.IsNullOrWhiteSpace(fullName) ? "Unknown sender" : fullName)</div>
                        <div class="subtle"><i class="fas fa-envelope mr-1"></i>@message.Email</div>
                    </td>
                    <td><div class="subject-text" title="@subject">@subject</div></td>
                    <td>
                        @if (message.UserId.HasValue)
                        {
                            <span class="badge badge-success">Registered</span>
                            <div class="subtle mt-1">User #@message.UserId</div>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Guest</span>
                        }
                    </td>
                    <td class="text-right">
                        <button type="button" class="btn btn-info btn-sm action-btn view-message"
                                data-toggle="modal" data-target="#messageModal"
                                data-name="@(string.IsNullOrWhiteSpace(fullName) ? "Unknown sender" : fullName)"
                                data-email="@message.Email"
                                data-subject="@subject"
                                data-message="@message.Message"
                                data-date="@message.DateSubmitted.ToString("MMM dd, yyyy HH:mm")"
                                data-userid="@(message.UserId?.ToString() ?? "guest")">
                            <i class="fas fa-eye"></i> View Message
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (!messages.Any())
    {
        <div class="empty-state">
            <i class="fas fa-comments fa-3x mb-3"></i>
            <h5>No messages yet</h5>
            <p class="mb-0">Customer feedback and contact requests will appear here automatically.</p>
        </div>
    }
    <div class="empty-state" id="noMessageMatches" style="display:none">
        <i class="fas fa-search fa-2x mb-3"></i>
        <h6>No messages match these filters</h6>
        <div class="subtle">Try another name, email, subject or sender type.</div>
    </div>
</div>

<div class="modal fade" id="messageModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1">Message Details</h5>
                    <div class="subtle" id="modal-date"></div>
                </div>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="message-box"><div class="subtle text-uppercase font-weight-bold">Sender</div><div class="font-weight-bold mt-1" id="modal-name"></div><div class="subtle mt-1" id="modal-email"></div></div>
                    </div>
                    <div class="col-md-6">
                        <div class="message-box"><div class="subtle text-uppercase font-weight-bold">Account Type</div><div class="mt-2" id="modal-userid"></div></div>
                    </div>
                </div>
                <div class="message-box mb-3"><div class="subtle text-uppercase font-weight-bold">Subject</div><div class="font-weight-bold mt-1" id="modal-subject"></div></div>
                <div class="message-box"><div class="subtle text-uppercase font-weight-bold mb-2">Message</div><div class="message-content" id="modal-message"></div></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Close</button>
                <a id="reply-email" href="#" class="btn btn-primary"><i class="fas fa-reply mr-1"></i> Reply by Email</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    const rows=[...document.querySelectorAll('.message-row')];
    const search=document.getElementById('messageSearch');
    const sender=document.getElementById('senderFilter');
    const empty=document.getElementById('noMessageMatches');

    function applyFilters(){
        const q=(search.value||'').toLowerCase().trim();
        let visible=0;
        rows.forEach(row=>{
            const okSearch=!q || row.dataset.search.includes(q);
            const okSender=sender.value==='all' || row.dataset.sender===sender.value;
            const show=okSearch && okSender;
            row.style.display=show?'':'none';
            if(show) visible++;
        });
        empty.style.display=(rows.length && visible===0)?'block':'none';
    }

    search.addEventListener('input',applyFilters);
    sender.addEventListener('change',applyFilters);

    $('.view-message').on('click',function(){
        const name=$(this).data('name');
        const email=$(this).data('email');
        const subject=$(this).data('subject');
        const message=$(this).data('message');
        const date=$(this).data('date');
        const userId=$(this).data('userid');

        $('#modal-name').text(name);
        $('#modal-email').text(email);
        $('#modal-subject').text(subject);
        $('#modal-message').text(message);
        $('#modal-date').text(date);

        if(String(userId)==='guest'){
            $('#modal-userid').html('<span class="badge badge-secondary">Guest</span>');
        }else{
            $('#modal-userid').html('<span class="badge badge-success">Registered User</span><div class="subtle mt-1">User #'+userId+'</div>');
        }

        $('#reply-email').attr('href','mailto:'+email+'?subject='+encodeURIComponent('Re: '+subject));
    });
})();
</script>
}
