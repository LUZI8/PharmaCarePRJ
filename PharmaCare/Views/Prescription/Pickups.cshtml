@model IEnumerable<PharmaCare.Models.PrescriptionReservation>
@{
    ViewData["Title"] = "Prescription Pickups";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
    var pickups = Model?.ToList() ?? new List<PharmaCare.Models.PrescriptionReservation>();
    var now = DateTime.Now;
    var reservedCount = pickups.Count(x => x.Status == "Reserved" && x.ExpiryDate >= now);
    var completedCount = pickups.Count(x => x.Status == "Completed");
    var cancelledCount = pickups.Count(x => x.Status == "Cancelled");
    var expiredCount = pickups.Count(x => x.Status == "Expired" || (x.Status == "Reserved" && x.ExpiryDate < now));
}

@section Styles {
<style>
.pickups-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:28px 0 18px}.pickups-head h2{font-weight:700;margin:0}.pickups-head p{color:#6c757d;margin:5px 0 0}.metric-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);height:100%}.metric-card .card-body{padding:17px 18px}.metric-label{font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;color:#6c757d}.metric-value{font-size:24px;font-weight:700;margin-top:3px}.pickups-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.pickups-card .card-header{background:transparent;padding:16px 18px}.filter-bar{display:flex;gap:9px;flex-wrap:wrap}.filter-bar .form-control{min-width:170px}.pickup-img{width:48px;height:48px;object-fit:contain;border:1px solid #e8ecef;border-radius:8px;background:#fff}.reservation-no{font-weight:700}.subtle{font-size:12px;color:#7a838b}.status-chip{font-size:11px;padding:5px 8px;border-radius:8px}.pickup-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.pickup-actions form{margin:0}.pickup-action-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:96px;height:34px;padding:0 11px;border-radius:8px;font-size:12px;font-weight:700}.expired-row{background:rgba(220,53,69,.05)}.empty-state{padding:50px 20px;text-align:center;color:#6c757d}.table thead th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#59616a;border-top:0}.table td,.table th{vertical-align:middle}.modal-content{border:0;border-radius:14px;overflow:hidden}.cancel-summary{border:1px solid #eceff1;border-radius:10px;padding:14px;background:#fafbfc}.cancel-summary-row{display:flex;justify-content:space-between;gap:18px;padding:6px 0}.cancel-summary-row span:first-child{color:#7a838b}.cancel-warning{display:flex;gap:12px;align-items:flex-start;padding:13px 14px;border-radius:10px;background:rgba(220,53,69,.08);color:#a71d2a}.dark-mode .metric-card,.dark-mode .pickups-card,.dark-mode .modal-content{background:#1f1f1f}.dark-mode .table thead th{color:#c9c9c9}.dark-mode .pickup-img{border-color:#444}.dark-mode .form-control{background:#262626;color:#eee;border-color:#444}.dark-mode .cancel-summary{background:#242424;border-color:#3a3a3a}.dark-mode .cancel-summary-row span:first-child{color:#aaa}@@media(max-width:768px){.pickups-head{align-items:flex-start;flex-direction:column}.filter-bar>*{width:100%!important}.pickup-actions{justify-content:flex-start}}
</style>
}

<div class="pickups-head">
    <div>
        <h2>Prescription Pickups</h2>
        <p>Manage reserved prescription medicines and customer pickup status.</p>
    </div>
    <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left mr-1"></i> Dashboard
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
}

<div class="row mb-3">
    <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">All Reservations</div><div class="metric-value">@pickups.Count</div></div></div></div>
    <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-warning">Reserved</div><div class="metric-value">@reservedCount</div><div class="subtle">Awaiting pickup</div></div></div></div>
    <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-success">Completed</div><div class="metric-value">@completedCount</div></div></div></div>
    <div class="col-xl-3 col-sm-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-danger">Expired / Cancelled</div><div class="metric-value">@(expiredCount + cancelledCount)</div></div></div></div>
</div>

<div class="card pickups-card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <div><strong>Pickup Queue</strong><div class="subtle">Prescription reservations currently in the system</div></div>
        <div class="filter-bar mt-2 mt-md-0">
            <input type="text" class="form-control form-control-sm" placeholder="Search reservation, customer or medicine..." id="searchInput" />
            <select class="form-control form-control-sm" id="statusFilter">
                <option value="all">All statuses</option>
                <option value="Reserved">Reserved</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
                <option value="Expired">Expired</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0" id="pickupsTable">
            <thead>
                <tr>
                    <th>Reservation</th>
                    <th>Customer</th>
                    <th>Medicine</th>
                    <th>Qty</th>
                    <th>Reserved</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in pickups)
            {
                var expired = (item.Status == "Reserved" && now > item.ExpiryDate) || item.Status == "Expired";
                var displayStatus = expired ? "Expired" : item.Status;
                var statusClass = displayStatus switch { "Reserved" => "warning", "Completed" => "success", "Cancelled" => "secondary", "Expired" => "danger", _ => "info" };
                var imageUrl = !string.IsNullOrWhiteSpace(item.Product?.ImageUrl) ? item.Product.ImageUrl : "/images/product_01.png";
                var searchText = $"{item.ReservationNumber} {item.User?.FirstName} {item.User?.LastName} {item.User?.PhoneNumber} {item.Product?.ProductName}".ToLower();
                <tr class="pickup-row @(expired ? "expired-row" : "")" data-status="@displayStatus" data-search="@searchText">
                    <td><div class="reservation-no">@item.ReservationNumber</div><div class="subtle">ID #@item.ReservationId</div></td>
                    <td><div class="font-weight-bold">@item.User?.FirstName @item.User?.LastName</div><div class="subtle"><i class="fas fa-phone mr-1"></i>@item.User?.PhoneNumber</div></td>
                    <td><div class="d-flex align-items-center"><img class="pickup-img mr-2" src="@imageUrl" alt="@item.Product?.ProductName"/><div><div class="font-weight-bold">@item.Product?.ProductName</div><div class="subtle">Prescription item</div></div></div></td>
                    <td><strong>@item.Quantity</strong></td>
                    <td>@item.ReservationDate.ToString("MMM dd, yyyy")<div class="subtle">@item.ReservationDate.ToString("HH:mm")</div></td>
                    <td>@item.ExpiryDate.ToString("MMM dd, yyyy")<div class="subtle">@item.ExpiryDate.ToString("HH:mm")</div></td>
                    <td><span class="badge badge-@statusClass status-chip">@displayStatus</span></td>
                    <td class="text-right">
                        @if (item.Status == "Reserved" && !expired)
                        {
                            <div class="pickup-actions">
                                <form asp-action="UpdateReservationStatus" asp-controller="Prescription" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ReservationId" />
                                    <input type="hidden" name="status" value="Completed" />
                                    <button type="submit" class="btn btn-success btn-sm pickup-action-btn" title="Mark this prescription as picked up">
                                        <i class="fas fa-check-circle"></i> Complete
                                    </button>
                                </form>
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm pickup-action-btn cancel-pickup-btn"
                                        data-toggle="modal"
                                        data-target="#cancelPickupModal"
                                        data-id="@item.ReservationId"
                                        data-reservation="@item.ReservationNumber"
                                        data-customer="@($"{item.User?.FirstName} {item.User?.LastName}")"
                                        data-product="@item.Product?.ProductName"
                                        data-quantity="@item.Quantity">
                                    <i class="fas fa-times-circle"></i> Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="subtle"><i class="fas fa-lock mr-1"></i>No actions</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (!pickups.Any())
    {
        <div class="empty-state"><i class="fas fa-prescription-bottle-alt fa-2x mb-3"></i><div class="font-weight-bold">No prescription pickups available</div><div class="subtle mt-1">New reservations will appear here automatically.</div></div>
    }
    <div id="noMatches" class="empty-state" style="display:none"><i class="fas fa-search fa-2x mb-3"></i><div>No pickups match these filters.</div></div>
</div>

<div class="modal fade" id="cancelPickupModal" tabindex="-1" role="dialog" aria-labelledby="cancelPickupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form asp-action="CancelReservationAdmin" asp-controller="Prescription" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-1" id="cancelPickupModalLabel">Cancel Prescription Reservation</h5>
                        <div class="subtle">Review the reservation before cancelling it.</div>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="cancelReservationId" name="id" />
                    <div class="cancel-summary mb-3">
                        <div class="cancel-summary-row"><span>Reservation</span><strong id="cancelReservationNumber">-</strong></div>
                        <div class="cancel-summary-row"><span>Customer</span><strong id="cancelCustomer">-</strong></div>
                        <div class="cancel-summary-row"><span>Medicine</span><strong id="cancelProduct">-</strong></div>
                        <div class="cancel-summary-row"><span>Quantity</span><strong id="cancelQuantity">-</strong></div>
                    </div>
                    <div class="cancel-warning">
                        <i class="fas fa-exclamation-triangle mt-1"></i>
                        <div><strong>This will cancel the reservation.</strong><div class="small mt-1">The reserved quantity will be returned to inventory automatically.</div></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Keep Reservation</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-times-circle mr-1"></i> Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    const rows=[...document.querySelectorAll('.pickup-row')], search=document.getElementById('searchInput'), status=document.getElementById('statusFilter'), empty=document.getElementById('noMatches');
    function apply(){const q=search.value.toLowerCase().trim();let shown=0;rows.forEach(r=>{const ok=(!q||r.dataset.search.includes(q))&&(status.value==='all'||r.dataset.status===status.value);r.style.display=ok?'':'none';if(ok)shown++;});empty.style.display=(rows.length&&shown===0)?'block':'none';}
    search.addEventListener('input',apply);status.addEventListener('change',apply);

    document.querySelectorAll('.cancel-pickup-btn').forEach(btn=>btn.addEventListener('click',function(){
        document.getElementById('cancelReservationId').value=this.dataset.id;
        document.getElementById('cancelReservationNumber').textContent=this.dataset.reservation || '-';
        document.getElementById('cancelCustomer').textContent=this.dataset.customer || '-';
        document.getElementById('cancelProduct').textContent=this.dataset.product || '-';
        document.getElementById('cancelQuantity').textContent=this.dataset.quantity || '-';
    }));
})();
</script>
}
