@{
    ViewData["Title"] = "Forgot Password - PharmaCare";
    Layout = null;
    var email = ViewBag.Email as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css?family=Rubik:400,500,600,700" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="icon" href="~/assets/favicon-32x32.png" type="image/png" />
    <style>
        :root{--accent:#0f9f92;--accent2:#0b7f75;--ink:#132129;--muted:#71818b;--line:#e3eaed;--surface:#fff;--page:#f2f7f7;--soft:#eaf7f5;--danger:#d9534f;--shadow:0 30px 80px rgba(15,47,55,.14)}
        *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:'Rubik',sans-serif}body{background:var(--page);color:var(--ink);transition:.25s;color-scheme:light}body.dark-mode{--ink:#edf4f4;--muted:#96a5ab;--line:#303a3e;--surface:#202629;--page:#111719;--soft:#17302d;--shadow:0 32px 90px rgba(0,0,0,.38);color-scheme:dark}a{text-decoration:none}
        .shell{min-height:100vh;display:grid;grid-template-columns:minmax(410px,.82fr) minmax(0,1.18fr);overflow:hidden;background:var(--page)}
        .visual{position:relative;padding:42px 52px;background:linear-gradient(150deg,#103237,#0a756d 70%,#0b9185);color:#fff;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.visual:before,.visual:after{content:"";position:absolute;border-radius:50%;opacity:.14;animation:float 9s ease-in-out infinite}.visual:before{width:430px;height:430px;background:#fff;left:-200px;top:-170px}.visual:after{width:340px;height:340px;background:#6ce9dc;right:-150px;bottom:-120px;animation-delay:-4.5s}.visual-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(to bottom,transparent,black 18%,black 82%,transparent)}
        @@keyframes float{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(18px,-16px) scale(1.06)}}@@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}@@keyframes pulseRing{0%{box-shadow:0 0 0 0 rgba(255,255,255,.16)}70%{box-shadow:0 0 0 18px rgba(255,255,255,0)}100%{box-shadow:0 0 0 0 rgba(255,255,255,0)}}
        .brand,.hero,.foot{position:relative;z-index:2}.brand{display:flex;align-items:center;gap:12px;color:#fff;font-weight:700;font-size:20px}.brand-icon{width:43px;height:43px;border-radius:13px;display:grid;place-items:center;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.17);backdrop-filter:blur(10px)}.hero{max-width:530px;animation:rise .65s ease both}.mini{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;opacity:.72;margin-bottom:17px}.hero h1{font-size:clamp(38px,4.4vw,58px);line-height:1.06;letter-spacing:-1.3px;margin:0 0 18px}.hero p{font-size:16px;line-height:1.75;color:rgba(255,255,255,.82);margin:0}.recovery-steps{margin-top:34px;display:grid;gap:12px}.recovery-step{display:flex;gap:14px;align-items:flex-start;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.12)}.recovery-step:last-child{border-bottom:0}.step-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:rgba(255,255,255,.12);animation:pulseRing 3s ease-in-out infinite}.recovery-step strong{display:block;font-size:13px;margin-bottom:3px}.recovery-step span{font-size:11px;line-height:1.45;color:rgba(255,255,255,.68)}.foot{font-size:11px;color:rgba(255,255,255,.6)}
        .form-side{min-width:0;min-height:100vh;padding:30px 40px;display:flex;flex-direction:column}.topbar{display:flex;justify-content:flex-end;gap:10px}.top-link,.theme{height:42px;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:12px;display:inline-flex;align-items:center;justify-content:center;transition:.2s}.top-link{padding:0 14px;gap:8px;font-size:12px;font-weight:600}.theme{width:42px;cursor:pointer}.top-link:hover,.theme:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}
        .card{width:100%;max-width:520px;margin:auto;animation:rise .6s .08s ease both}.chip{display:inline-flex;align-items:center;gap:8px;background:var(--soft);color:var(--accent);padding:8px 11px;border-radius:999px;font-size:11px;font-weight:700;margin-bottom:17px}.card h2{font-size:36px;line-height:1.1;letter-spacing:-.8px;margin:0 0 9px}.lead{font-size:14px;line-height:1.65;color:var(--muted);margin:0 0 28px}.notice{padding:12px 14px;border-radius:12px;margin-bottom:16px;font-size:12px;line-height:1.5;background:rgba(217,83,79,.09);border:1px solid rgba(217,83,79,.18);color:var(--danger)}
        .label{font-size:12px;font-weight:600;margin-bottom:8px;display:block}.input-wrap{position:relative}.icon{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:#8f9da4}.control{width:100%;height:54px;border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--ink);padding:0 46px 0 43px;font:inherit;font-size:13px;outline:none;transition:.2s}.control::placeholder{color:#a1abb0}.control:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(15,159,146,.1);transform:translateY(-1px)}
        .primary{margin-top:20px;width:100%;height:54px;border:0;border-radius:14px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-weight:700;cursor:pointer;box-shadow:0 12px 28px rgba(15,159,146,.25);transition:.22s}.primary:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(15,159,146,.3)}.primary i{margin-left:8px}.safe-note{margin-top:18px;padding:14px;border:1px solid var(--line);border-radius:13px;background:var(--surface);display:flex;gap:11px;color:var(--muted);font-size:11px;line-height:1.55}.safe-note i{color:var(--accent);margin-top:2px}.bottom{text-align:center;margin-top:20px;font-size:12px;color:var(--muted)}.bottom a{color:var(--accent);font-weight:700}.footer{text-align:center;color:var(--muted);font-size:10px;padding-top:18px}
        @@media(max-width:1100px){.shell{grid-template-columns:1fr}.visual{display:none}.form-side{padding:24px}.card{max-width:560px}.topbar{margin-bottom:18px}}@@media(max-width:575px){.form-side{padding:18px 15px}.card h2{font-size:30px}.top-link span{display:none}}
    </style>
</head>
<body>
<div class="shell">
    <section class="visual">
        <div class="visual-grid"></div>
        <a href="/" class="brand"><span class="brand-icon"><i class="fas fa-prescription-bottle-alt"></i></span><span>PHARMACARE</span></a>
        <div class="hero">
            <div class="mini">Secure account recovery</div>
            <h1>Reset access without the old password.</h1>
            <p>Enter your email and we’ll send a temporary six-digit code. No password guessing, no security questions, no unnecessary steps.</p>
            <div class="recovery-steps">
                <div class="recovery-step"><div class="step-icon"><i class="fas fa-envelope"></i></div><div><strong>1. Enter your email</strong><span>Use the address linked to your PharmaCare account.</span></div></div>
                <div class="recovery-step"><div class="step-icon"><i class="fas fa-shield-alt"></i></div><div><strong>2. Check for your secure code</strong><span>The six-digit code is valid for 15 minutes.</span></div></div>
                <div class="recovery-step"><div class="step-icon"><i class="fas fa-key"></i></div><div><strong>3. Choose a new password</strong><span>Set a strong password and sign back in securely.</span></div></div>
            </div>
        </div>
        <div class="foot">Password recovery · PharmaCare</div>
    </section>

    <section class="form-side">
        <div class="topbar">
            <a class="top-link" href="@Url.Action("Login","Account")"><i class="fas fa-arrow-left"></i><span>Back to sign in</span></a>
            <button id="theme-toggle" class="theme" type="button" aria-label="Toggle theme"><i class="fas fa-moon"></i></button>
        </div>

        <div class="card">
            <div class="chip"><i class="fas fa-unlock-alt"></i> Account recovery</div>
            <h2>Forgot your password?</h2>
            <p class="lead">Enter your email address. If an account exists, we’ll send a secure reset code right away.</p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""].Errors.Count > 0)
            {
                <div class="notice"><i class="fas fa-exclamation-circle"></i> @ViewData.ModelState[""].Errors[0].ErrorMessage</div>
            }

            <form method="post" action="@Url.Action("ForgotPassword","Account")">
                @Html.AntiForgeryToken()
                <label class="label" for="Email">Email address</label>
                <div class="input-wrap">
                    <i class="fas fa-envelope icon"></i>
                    <input class="control" id="Email" name="Email" type="email" placeholder="name@example.com" value="@email" autocomplete="email" required autofocus />
                </div>
                <button class="primary" type="submit">Send secure code <i class="fas fa-arrow-right"></i></button>
            </form>

            <div class="safe-note"><i class="fas fa-user-shield"></i><span>For privacy, PharmaCare uses the same recovery response whether or not an email is registered. We will never ask for your previous password on this page.</span></div>
            <div class="bottom">Remembered it? <a href="@Url.Action("Login","Account")">Return to sign in</a></div>
        </div>
        <div class="footer">© @DateTime.Now.Year PharmaCare. Secure account recovery.</div>
    </section>
</div>
<script>
(function(){const body=document.body,btn=document.getElementById('theme-toggle');const saved=localStorage.getItem('pharmacare-theme');if(saved==='dark'||(!saved&&matchMedia('(prefers-color-scheme: dark)').matches))body.classList.add('dark-mode');function sync(){btn.innerHTML=body.classList.contains('dark-mode')?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>'}sync();btn.addEventListener('click',()=>{body.classList.toggle('dark-mode');localStorage.setItem('pharmacare-theme',body.classList.contains('dark-mode')?'dark':'light');sync()})})();
</script>
</body>
</html>
