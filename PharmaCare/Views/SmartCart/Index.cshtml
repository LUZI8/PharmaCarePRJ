@model SmartCartPageViewModel
@{
    ViewData["Title"] = "Smart Cart";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--sc:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#eef4f5;--muted:#9aa8ad;--line:#303b40;--card:#20272a;--soft:#183531}.smart-page{min-height:100vh;background:#f7fbfa;color:var(--ink);padding:42px 0 70px}.dark-mode .smart-page{background:#151a1d}.smart-hero{background:linear-gradient(135deg,#0b3d42,#0d9488);color:#fff;border-radius:24px;padding:30px;margin-bottom:20px}.smart-hero h1{font-size:32px;margin:0 0 8px}.smart-hero p{font-size:12px;color:rgba(255,255,255,.78);max-width:700px;margin:0}.smart-grid{display:grid;grid-template-columns:1fr .9fr;gap:18px}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:20px}.card h2{font-size:18px;margin:0 0 15px}.pick-row{display:grid;grid-template-columns:1fr 90px;gap:9px;margin-bottom:9px}.pick-row select,.pick-row input,.city{height:44px;border:1px solid var(--line);border-radius:11px;padding:0 12px;background:var(--card);color:var(--ink);font-size:11px}.city-wrap{display:flex;gap:9px;margin-bottom:14px}.city{flex:1}.analyze{width:100%;height:46px;border:0;border-radius:12px;background:var(--sc);color:#fff;font-weight:700;font-size:11px}.result-card{border:1px solid var(--line);border-radius:15px;padding:15px;margin-bottom:10px}.result-card.best{border-color:#87d7cf;background:var(--soft)}.result-top{display:flex;justify-content:space-between;gap:12px}.result-card h3{font-size:14px;margin:0}.tag{font-size:8px;font-weight:700;padding:5px 8px;border-radius:99px;background:#dff6e8;color:#17804a}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.metric span{font-size:8px;color:var(--muted);display:block}.metric strong{font-size:11px}.empty{font-size:11px;color:var(--muted);padding:20px 0}.note{font-size:9px;color:var(--muted);line-height:1.6;margin-top:12px}.validation-summary-errors{font-size:10px;color:#b8403c;margin-bottom:10px}
@@media(max-width:850px){.smart-grid{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}}
@@media(max-width:520px){.smart-page{padding-top:22px}.smart-hero{border-radius:17px;padding:22px}.smart-hero h1{font-size:27px}.card{padding:15px}.pick-row{grid-template-columns:1fr 72px}}
</style>
}
<div class="smart-page"><div class="container">
<section class="smart-hero"><div style="font-size:9px;font-weight:700;letter-spacing:1px;margin-bottom:8px">SMART PHARMACY MATCHING</div><h1>Find one pharmacy for your whole list.</h1><p>Add the products you need and PharmaCare checks pharmacy stock, product prices, delivery fees and estimated delivery time before suggesting the best match. It never splits your order without your approval.</p></section>
<div class="smart-grid">
<section class="card"><h2>Your shopping list</h2><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><div class="city-wrap"><input class="city" name="City" value="@Model.City" placeholder="City"/></div>
@for(var i=0;i<Model.Selections.Count;i++){<div class="pick-row"><select name="Selections[@i].ProductId"><option value="0">Choose a product...</option>@foreach(var p in Model.Products){if(Model.Selections[i].ProductId==p.ProductId){<option selected value="@p.ProductId">@p.ProductName</option>}else{<option value="@p.ProductId">@p.ProductName</option>}}</select><input type="number" min="1" max="20" name="Selections[@i].Quantity" value="@(Model.Selections[i].Quantity<=0?1:Model.Selections[i].Quantity)"/></div>}
<button class="analyze" type="submit"><i class="fas fa-magic"></i> Find best pharmacy</button></form><p class="note">Prescription products may appear in availability analysis, but they still follow pharmacist verification before fulfillment.</p></section>
<section class="card"><h2>Recommendation</h2>
@if(Model.Result==null){<div class="empty">Choose products and run Smart Cart to see the best single-pharmacy option and alternatives.</div>}
else if(Model.Result.BestSinglePharmacy!=null){var b=Model.Result.BestSinglePharmacy;<div class="result-card best"><div class="result-top"><div><h3>@b.PharmacyName</h3><div style="font-size:9px;color:var(--muted);margin-top:4px">Has all @b.RequestedProducts requested products</div></div><span class="tag">BEST MATCH</span></div><div class="metrics"><div class="metric"><span>Products</span><strong>@b.MatchedProducts/@b.RequestedProducts</strong></div><div class="metric"><span>Items + delivery</span><strong>$@b.EstimatedTotal.ToString("0.00")</strong></div><div class="metric"><span>Delivery</span><strong>@b.EstimatedDeliveryMinutes min</strong></div><div class="metric"><span>Rating</span><strong>★ @b.Rating</strong></div></div><div style="margin-top:12px"><a href="/Marketplace/Pharmacy/@b.PharmacyId" style="font-size:9px;font-weight:700;color:var(--sc)">Open pharmacy →</a></div></div>}
else{<div class="result-card"><h3>No single pharmacy has everything</h3><div style="font-size:9px;color:var(--muted);margin-top:5px">We found a combination that covers @(Model.Result.AllProductsCanBeCovered?"the full list":"part of the list"). You stay in control of whether to create separate orders.</div></div>@foreach(var p in Model.Result.SuggestedCombination){<div class="result-card"><div class="result-top"><h3>@p.PharmacyName</h3><span class="tag">@p.MatchedProducts/@p.RequestedProducts items</span></div><div class="metrics"><div class="metric"><span>Matched</span><strong>@p.MatchedProducts</strong></div><div class="metric"><span>Est. total</span><strong>$@p.EstimatedTotal.ToString("0.00")</strong></div><div class="metric"><span>ETA</span><strong>@p.EstimatedDeliveryMinutes min</strong></div><div class="metric"><span>Rating</span><strong>★ @p.Rating</strong></div></div></div>}}
</section></div></div></div>