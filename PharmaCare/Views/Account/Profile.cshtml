@model PharmaCare.Models.User
@{
    ViewData["Title"] = "My Account";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.IsLoggedIn = true;
    ViewBag.UserName = Model.FirstName + " " + Model.LastName;
    ViewBag.HideCategories = false;
    var initials = $"{(string.IsNullOrWhiteSpace(Model.FirstName) ? "" : Model.FirstName.Substring(0,1))}{(string.IsNullOrWhiteSpace(Model.LastName) ? "" : Model.LastName.Substring(0,1))}".ToUpper();
}

@section Styles {
<style>
.account-page{--teal:#0f9d8f;--teal-dark:#0a655c;--ink:#17212b;--muted:#71808d;--line:#dfe8ea;background:linear-gradient(180deg,#f4fbfa 0,#fff 44%);padding:42px 0 72px;color:var(--ink)}
.account-shell{max-width:1180px;margin:0 auto;padding:0 22px}.account-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:22px}.account-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;background:#e7f8f5;color:#08776d;font-size:11px;font-weight:900;letter-spacing:.55px;text-transform:uppercase;margin-bottom:10px}.account-title{font-size:38px;font-weight:900;letter-spacing:-1.1px;margin:0 0 7px}.account-subtitle{margin:0;color:var(--muted);font-size:14px}.account-grid{display:grid;grid-template-columns:280px minmax(0,1fr);gap:22px;align-items:start}
.account-nav,.account-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 14px 38px rgba(15,23,42,.06);overflow:hidden}.account-nav-head{padding:19px 18px;background:linear-gradient(135deg,#0b756c,#0f9d8f);color:#fff}.account-nav-head strong{display:block;font-size:17px}.account-nav-head span{display:block;font-size:11px;opacity:.8;margin-top:3px}.account-nav-links{padding:10px}.account-nav-links a{display:flex;align-items:center;gap:11px;min-height:46px;padding:0 13px;border-radius:12px;color:#44515b;text-decoration:none;font-size:13px;font-weight:800;transition:.2s}.account-nav-links a i{width:18px;text-align:center;color:#78858d}.account-nav-links a:hover{background:#f2f8f7;color:var(--teal-dark);transform:translateX(2px)}.account-nav-links a.active{background:#e8f8f5;color:#08776d}.account-nav-links a.active i{color:var(--teal)}
.account-card-head{padding:22px 24px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:18px}.profile-hero{display:flex;align-items:center;gap:15px}.profile-avatar{width:58px;height:58px;border-radius:17px;display:grid;place-items:center;background:linear-gradient(135deg,#daf4ef,#edf9f7);color:#08776d;font-size:20px;font-weight:900;border:1px solid #cbeae4}.profile-name{font-size:22px;font-weight:900;margin:0}.profile-email{color:var(--muted);font-size:12px;margin-top:3px}.account-edit{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:0 15px;border-radius:11px;background:var(--teal);color:#fff;text-decoration:none;font-weight:900;font-size:12px;box-shadow:0 8px 18px rgba(15,157,143,.18);transition:.2s}.account-edit:hover{background:#0b887d;color:#fff;text-decoration:none;transform:translateY(-1px)}
.account-details{padding:22px 24px 25px}.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.detail-item{padding:15px 16px;border:1px solid #e7edef;border-radius:14px;background:#fbfdfd}.detail-label{display:flex;align-items:center;gap:7px;color:#859199;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}.detail-label i{color:var(--teal)}.detail-value{font-size:13px;font-weight:800;overflow-wrap:anywhere}.account-note{margin-top:16px;padding:14px 16px;border-radius:14px;background:#edf9f7;color:#376b66;font-size:12px;line-height:1.55}.account-toast{margin-bottom:18px;border-radius:13px;padding:12px 14px;font-size:12px;font-weight:800;background:#fff0f1;color:#b73240;border:1px solid #f2c7cc}
.dark-mode .account-page{--ink:#edf5f4;--muted:#9ca8ad;--line:#2b3b3c;background:#111819}.dark-mode .account-nav,.dark-mode .account-card{background:#172122}.dark-mode .account-nav-links a{color:#d7e0df}.dark-mode .account-nav-links a:hover{background:#1d2b2c}.dark-mode .account-nav-links a.active{background:#143331;color:#7de0d4}.dark-mode .detail-item{background:#121c1d;border-color:#263637}.dark-mode .account-note{background:#12312e;color:#a8d9d3}
@@media(max-width:860px){.account-grid{grid-template-columns:1fr}.account-nav-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.account-nav-head{display:none}.account-nav-links a{justify-content:center;text-align:center}.account-nav-links a:hover{transform:none}}
@@media(max-width:620px){.account-page{padding:30px 0 54px}.account-shell{padding:0 14px}.account-title{font-size:30px}.account-head{align-items:flex-start}.account-nav-links{grid-template-columns:1fr 1fr}.account-card-head{align-items:flex-start;flex-direction:column}.account-edit{width:100%}.detail-grid{grid-template-columns:1fr}.profile-avatar{width:52px;height:52px}.profile-name{font-size:19px}}
</style>
}

<section class="account-page">
    <div class="account-shell">
        <header class="account-head">
            <div>
                <div class="account-kicker"><i class="fas fa-user-circle"></i> Account center</div>
                <h1 class="account-title">My account</h1>
                <p class="account-subtitle">Manage your personal details, security, orders and prescription reservations.</p>
            </div>
        </header>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="account-toast"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]</div>
        }

        <div class="account-grid">
            <aside class="account-nav">
                <div class="account-nav-head"><strong>Account menu</strong><span>Everything in one place</span></div>
                <nav class="account-nav-links">
                    <a class="active" href="@Url.Action("Profile", "Account")"><i class="fas fa-user"></i><span>Profile</span></a>
                    <a href="@Url.Action("EditProfile", "Account")"><i class="fas fa-user-edit"></i><span>Edit profile</span></a>
                    <a href="@Url.Action("ChangePassword", "Account")"><i class="fas fa-key"></i><span>Password</span></a>
                    <a href="@Url.Action("Index", "Order")"><i class="fas fa-shopping-bag"></i><span>My orders</span></a>
                    <a href="@Url.Action("MyReservations", "Prescription")"><i class="fas fa-prescription-bottle-alt"></i><span>Reservations</span></a>
                </nav>
            </aside>

            <main class="account-card">
                <div class="account-card-head">
                    <div class="profile-hero">
                        <div class="profile-avatar">@initials</div>
                        <div>
                            <h2 class="profile-name">@Model.FirstName @Model.LastName</h2>
                            <div class="profile-email">@Model.Email</div>
                        </div>
                    </div>
                    <a class="account-edit" href="@Url.Action("EditProfile", "Account")"><i class="fas fa-edit"></i> Edit profile</a>
                </div>

                <div class="account-details">
                    <div class="detail-grid">
                        <div class="detail-item"><div class="detail-label"><i class="fas fa-user"></i> Full name</div><div class="detail-value">@Model.FirstName @Model.LastName</div></div>
                        <div class="detail-item"><div class="detail-label"><i class="fas fa-envelope"></i> Email</div><div class="detail-value">@Model.Email</div></div>
                        <div class="detail-item"><div class="detail-label"><i class="fas fa-phone"></i> Phone</div><div class="detail-value">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</div></div>
                        <div class="detail-item"><div class="detail-label"><i class="fas fa-city"></i> City</div><div class="detail-value">@(string.IsNullOrEmpty(Model.City) ? "Not provided" : Model.City)</div></div>
                        <div class="detail-item"><div class="detail-label"><i class="fas fa-map-marker-alt"></i> Address</div><div class="detail-value">@(string.IsNullOrEmpty(Model.Address) ? "Not provided" : Model.Address)</div></div>
                        <div class="detail-item"><div class="detail-label"><i class="fas fa-calendar-check"></i> Member since</div><div class="detail-value">@Model.DateCreated.ToString("MMMM dd, yyyy")</div></div>
                    </div>
                    <div class="account-note"><i class="fas fa-shield-alt mr-2"></i>Your account details are used for order fulfillment, prescription reservations and customer support.</div>
                </div>
            </main>
        </div>
    </div>
</section>