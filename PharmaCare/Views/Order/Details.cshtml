d{color:#edf2f3}.dark-mode .order-table thead th{background:#232a2d;color:#aeb8bd;border-color:#343d40}.dark-mode .order-table td{color:#e9eff1;border-color:#343d40}.dark-mode .clear-btn.back{background:#222a2d;color:#e3eaec;border-color:#3c474b}.dark-mode .support-card p{color:#a2adb3}@@media(max-width:991px){.customer-grid{grid-template-columns:1fr}.customer-side{grid-template-columns:1fr 1fr}.order-summary-card{grid-column:1}.support-card{grid-column:2}.customer-info-grid{grid-template-columns:1fr 1fr}}@@media(max-width:767px){.order-page-shell{padding:22px 12px 36px}.order-page-head{align-items:flex-start;flex-direction:column}.order-page-head .clear-btn{width:100%}.customer-order-hero{padding:21px 17px;border-radius:18px}.customer-order-hero h1{font-size:24px}.customer-order-hero .hero-top{display:block}.customer-status-pill{margin-top:16px}.customer-progress{padding:15px 8px 5px}.workflow-step{font-size:10px;padding-top:34px}.customer-grid,.customer-info-grid,.customer-side{grid-template-columns:1fr}.support-card{grid-column:auto}.order-card-header,.order-card-body{padding:17px}.order-table td,.order-table th{padding:13px 12px;white-space:nowrap}.summary-box{width:100%;padding:17px}.detail-row{grid-template-columns:1fr}.detail-row .value{text-align:left}.clear-btn{width:100%}.order-overview-bar>div:last-child{width:100%;display:flex;gap:8px;flex-wrap:wrap}.customer-info-line{display:block}.customer-info-line span{display:block}.customer-info-line span:last-child{text-align:left;margin-top:4px}}
