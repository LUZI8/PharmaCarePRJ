@model MarketplaceThankYouViewModel
@{
    ViewData["Title"] = "Order confirmed";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--t:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a}.ty-page{background:#f7fbfa;color:var(--ink);min-height:100vh;padding:58px 0 78px}.dark-mode .ty-page{background:#151a1d}.ty-shell{max-width:850px;margin:auto}.check{width:68px;height:68px;border-radius:22px;background:#e5f8ef;color:#1b9a57;display:grid;place-items:center;font-size:29px;margin:0 auto 17px}.ty-head{text-align:center}.ty-head h1{font-size:34px;margin:0 0 8px}.ty-head p{font-size:12px;color:var(--muted)}.ty-card{margin-top:28px;background:var(--card);border:1px solid var(--line);border-radius:22px;padding:24px}.order-id{display:flex;justify-content:space-between;gap:15px;align-items:center;padding-bottom:18px;border-bottom:1px solid var(--line)}.order-id strong{font-size:16px}.status{padding:7px 10px;border-radius:999px;background:#fff2d7;color:#a46a00;font-size:9px;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}.mini{padding:16px;border-radius:14px;background:#f6faf9}.dark-mode .mini{background:#252d31}.mini span{display:block;font-size:8px;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:5px}.mini strong{font-size:12px}.items{margin-top:18px}.item{display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-top:1px solid var(--line);font-size:11px}.total{display:flex;justify-content:space-between;margin-top:12px;padding-top:15px;border-top:1px solid var(--line);font-size:19px;font-weight:700}.actions{display:flex;gap:10px;justify-content:center;margin-top:22px}.actions a{height:45px;padding:0 16px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;background:var(--t);color:#fff}.actions a.alt{background:transparent;border:1px solid var(--line);color:var(--ink)}
@@media(max-width:575px){.ty-page{padding-top:35px}.grid{grid-template-columns:1fr}.actions{flex-direction:column}.actions a{width:100%}.order-id{align-items:flex-start;flex-direction:column}}
</style>
}
<div class="ty-page"><div class="container"><div class="ty-shell"><div class="ty-head"><div class="check"><i class="fas fa-check"></i></div><h1>Order received.</h1><p>@Model.Order.Pharmacy.Name is preparing to review your marketplace order.</p></div><section class="ty-card"><div class="order-id"><div><div style="font-size:9px;color:var(--muted);margin-bottom:4px">ORDER NUMBER</div><strong>@Model.Order.OrderNumber</strong></div><span class="status">@Model.Order.Status</span></div><div class="grid"><div class="mini"><span>Pharmacy</span><strong>@Model.Order.Pharmacy.Name</strong></div><div class="mini"><span>Estimated delivery</span><strong>@Model.Order.Pharmacy.EstimatedDeliveryMinutes minutes</strong></div><div class="mini"><span>Deliver to</span><strong>@Model.Order.ShippingAddress, @Model.Order.City</strong></div><div class="mini"><span>Payment</span><strong>@Model.Order.PaymentMethod</strong></div></div><div class="items">@foreach(var item in Model.Order.Items){<div class="item"><span>@item.ProductName × @item.Quantity</span><strong>$@item.LineTotal.ToString("0.00")</strong></div>}</div><div class="total"><span>Total</span><span>$@Model.Order.TotalAmount.ToString("0.00")</span></div></section><div class="actions"><a href="/Marketplace">Continue shopping</a><a class="alt" href="/MarketplaceOrders">Track marketplace orders</a></div></div></div></div>