@model PharmaCare.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Create Product";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
}
@section Styles{
<style>
.form-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:28px 0 18px}.form-head h2{font-weight:750;margin:0}.form-head p{color:#6c757d;margin:5px 0 0}.form-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.form-card .card-header{background:transparent;padding:16px 20px;font-weight:750}.form-card .card-body{padding:22px}.section-title{font-size:11px;text-transform:uppercase;letter-spacing:.65px;color:#6c757d;font-weight:750;margin-bottom:15px}.form-control{border-radius:8px}.switch-row{display:flex;justify-content:space-between;align-items:center;padding:14px;border:1px solid #e7e9ec;border-radius:10px;margin-bottom:12px}.switch-row .meta{font-size:12px;color:#6c757d}.switch{position:relative;display:inline-block;width:44px;height:24px}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#ccc;border-radius:30px;cursor:pointer;transition:.2s}.slider:before{content:"";position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:#0d9488}.switch input:checked+.slider:before{transform:translateX(20px)}.image-drop{border:2px dashed #d6dbe0;border-radius:12px;padding:18px;min-height:260px;display:flex;flex-direction:column;justify-content:center;transition:.2s}.image-drop.dragover{border-color:#0d9488;background:rgba(13,148,136,.05)}.gallery-previews{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0}.gallery-preview-item{position:relative;border:1px solid #e4e8ec;border-radius:10px;background:#fff;padding:8px;min-height:120px;display:flex;align-items:center;justify-content:center}.gallery-preview-item img{max-width:100%;height:110px;object-fit:contain;border-radius:7px}.gallery-preview-item.primary:after{content:"Primary";position:absolute;left:8px;top:8px;background:#0d9488;color:#fff;font-size:10px;font-weight:700;padding:3px 7px;border-radius:999px}.gallery-count{font-size:12px;color:#6c757d}.help-card{border:0;border-radius:12px;background:#f8f9fa}.help-card li{margin-bottom:8px}.required:after{content:" *";color:#dc3545}.rx-note{display:none}.rx-note.show{display:block}.field-help{font-size:11px;color:#7a838b;margin-top:4px}.dark-mode .form-card,.dark-mode .help-card{background:#1f1f1f}.dark-mode .switch-row,.dark-mode .image-drop{border-color:#3b3b3b}.dark-mode .form-control{background:#262626;color:#eee;border-color:#444}.dark-mode .help-card{color:#ddd}.dark-mode .gallery-preview-item{background:#262626;border-color:#444}
@@media(max-width:767px){.form-head{align-items:flex-start;flex-direction:column}.image-drop{min-height:220px}.gallery-previews{grid-template-columns:1fr 1fr}}
</style>}
<div class="form-head"><div><h2>Create Product</h2><p>Add a medicine or pharmacy item with complete inventory identifiers.</p></div><a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> Back to Inventory</a></div>
<form asp-action="Create" method="post" enctype="multipart/form-data" id="productForm">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row"><div class="col-lg-8">
<div class="card form-card mb-4"><div class="card-header">Product Information</div><div class="card-body">
<div class="section-title">Basic information</div>
<div class="form-group"><label asp-for="ProductName" class="required">Product Name</label><input asp-for="ProductName" class="form-control" placeholder="e.g. Paracetamol 500mg Tablets"/><span asp-validation-for="ProductName" class="text-danger small"></span></div>
<div class="form-row"><div class="form-group col-md-6"><label asp-for="Manufacturer">Manufacturer</label><input asp-for="Manufacturer" class="form-control" placeholder="e.g. Hikma Pharmaceuticals"/><span asp-validation-for="Manufacturer" class="text-danger small"></span></div><div class="form-group col-md-6"><label asp-for="CategoryID" class="required">Category</label><select asp-for="CategoryID" asp-items="Model.ListOfCategories" class="form-control"><option value="">Select category</option></select><span asp-validation-for="CategoryID" class="text-danger small"></span></div></div>
<div class="form-group"><label asp-for="Description">Description</label><textarea asp-for="Description" rows="5" class="form-control" placeholder="Dosage form, strength, use, warnings and relevant product information."></textarea></div>
<hr/><div class="section-title">Inventory identification</div>
<div class="form-row"><div class="form-group col-md-6"><label asp-for="SKU">SKU</label><input asp-for="SKU" class="form-control" placeholder="e.g. MED-PARA-500-001"/><div class="field-help">Internal unique stock code.</div><span asp-validation-for="SKU" class="text-danger small"></span></div><div class="form-group col-md-6"><label asp-for="Barcode">Barcode</label><div class="input-group"><div class="input-group-prepend"><span class="input-group-text"><i class="fas fa-barcode"></i></span></div><input asp-for="Barcode" class="form-control" placeholder="Scan or enter barcode"/></div><div class="field-help">Unique barcode / GTIN if available.</div><span asp-validation-for="Barcode" class="text-danger small"></span></div></div>
<hr/><div class="section-title">Pricing, stock & safety</div>
<div class="form-row"><div class="form-group col-md-4"><label asp-for="Price" class="required">Unit Price</label><div class="input-group"><div class="input-group-prepend"><span class="input-group-text">$</span></div><input asp-for="Price" type="number" min="0.01" step="0.01" class="form-control"/></div><span asp-validation-for="Price" class="text-danger small"></span></div><div class="form-group col-md-4"><label asp-for="Stock" class="required">Starting Stock</label><div class="input-group"><input asp-for="Stock" type="number" min="0" class="form-control"/><div class="input-group-append"><span class="input-group-text">units</span></div></div><span asp-validation-for="Stock" class="text-danger small"></span></div><div class="form-group col-md-4"><label asp-for="ReorderLevel">Low Stock Alert</label><div class="input-group"><input asp-for="ReorderLevel" type="number" min="0" class="form-control"/><div class="input-group-append"><span class="input-group-text">units</span></div></div><div class="field-help">Warn when stock reaches this level.</div><span asp-validation-for="ReorderLevel" class="text-danger small"></span></div></div>
<div class="form-group"><label asp-for="ExpiryDate" class="required">Expiry Date</label><input asp-for="ExpiryDate" type="date" class="form-control"/><span asp-validation-for="ExpiryDate" class="text-danger small"></span><small class="form-text text-muted"><i class="fas fa-shield-alt text-warning mr-1"></i>Verify the date directly from manufacturer packaging.</small></div>
</div></div>
<div class="card form-card mb-4"><div class="card-header">Pharmacy Controls</div><div class="card-body"><div class="switch-row"><div><strong>Active Product</strong><div class="meta">Visible and available to customers when stock and expiry permit.</div></div><label class="switch"><input type="checkbox" name="IsActive" value="true" checked/><span class="slider"></span></label></div><div class="switch-row"><div><strong>Requires Prescription</strong><div class="meta">Use for prescription-only medicine.</div></div><label class="switch"><input type="checkbox" name="RequiresPrescription" value="true" id="rxToggle"/><span class="slider"></span></label></div><div class="form-group rx-note" id="rxNote"><label asp-for="PrescriptionNote">Prescription Instructions</label><textarea asp-for="PrescriptionNote" class="form-control" rows="3" placeholder="Optional instructions shown to customers."></textarea><span asp-validation-for="PrescriptionNote" class="text-danger small"></span></div></div></div>
</div>
<div class="col-lg-4"><div class="card form-card mb-4"><div class="card-header">Product Gallery</div><div class="card-body"><div class="image-drop" id="imageDrop"><div class="text-center"><i class="fas fa-images fa-2x text-muted mb-2"></i><div class="font-weight-bold mb-1">Upload up to 5 product images</div><div class="small text-muted mb-2">The first image becomes the primary image. JPG or PNG.</div><div class="gallery-count mb-3"><span id="imageCount">0</span>/5 selected</div></div><input name="galleryFiles" id="galleryInput" type="file" accept="image/png,image/jpeg" multiple class="form-control-file"/><div id="galleryPreviews" class="gallery-previews"></div></div></div></div><div class="card help-card mb-4"><div class="card-body"><strong><i class="fas fa-lightbulb text-warning mr-2"></i>Inventory checklist</strong><ul class="small mt-3 pl-3"><li>Use 2-5 clear product photos where possible.</li><li>The first selected image is used as the primary image.</li><li>SKU should be unique and easy for staff to recognize.</li><li>Scan the barcode when available to avoid typing errors.</li><li>Verify expiry directly from the package.</li></ul></div></div><button type="submit" class="btn btn-success btn-block"><i class="fas fa-save mr-1"></i> Create Product</button><a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary btn-block">Cancel</a></div></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(function(){const rx=document.getElementById('rxToggle'),note=document.getElementById('rxNote'),input=document.getElementById('galleryInput'),previews=document.getElementById('galleryPreviews'),count=document.getElementById('imageCount'),drop=document.getElementById('imageDrop');function syncRx(){note.classList.toggle('show',rx.checked);}rx.addEventListener('change',syncRx);syncRx();function renderFiles(files){previews.innerHTML='';const list=Array.from(files||[]).slice(0,5);count.textContent=list.length;list.forEach((file,index)=>{const wrap=document.createElement('div');wrap.className='gallery-preview-item'+(index===0?' primary':'');const img=document.createElement('img');img.alt='Product image '+(index+1);wrap.appendChild(img);previews.appendChild(wrap);const reader=new FileReader();reader.onload=e=>img.src=e.target.result;reader.readAsDataURL(file);});if((files||[]).length>5){alert('You can upload up to 5 images per product. Only the first 5 will be used.');}}input.addEventListener('change',()=>renderFiles(input.files));['dragenter','dragover'].forEach(evt=>drop.addEventListener(evt,e=>{e.preventDefault();drop.classList.add('dragover');}));['dragleave','drop'].forEach(evt=>drop.addEventListener(evt,e=>{e.preventDefault();drop.classList.remove('dragover');}));drop.addEventListener('drop',e=>{if(!e.dataTransfer.files.length)return;const dt=new DataTransfer();Array.from(e.dataTransfer.files).filter(f=>f.type==='image/png'||f.type==='image/jpeg').slice(0,5).forEach(f=>dt.items.add(f));input.files=dt.files;renderFiles(input.files);});})();</script>}
