@model PharmaCare.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.HideCategories = true;
    var itemCount = Model.OrderItems?.Sum(x => x.Quantity) ?? 0;
}

@section Styles {
<style>
.ty-page{--a:#0f9d8f;--ad:#0b5a54;--ink:#17212b;--muted:#71808d;--line:#e1e9ec;background:linear-gradient(180deg,#f3fbfa 0,#fff 52%);padding:46px 0 72px;color:var(--ink)}
.ty-shell{max-width:1160px;margin:auto;padding:0 22px}.ty-hero{text-align:center;max-width:760px;margin:0 auto 28px}.ty-check{width:82px;height:82px;border-radius:26px;margin:0 auto 18px;display:grid;place-items:center;background:linear-gradient(135deg,#20bfaa,#0f9d8f);color:#fff;font-size:34px;box-shadow:0 14px 34px rgba(15,157,143,.24)}
.ty-kicker{display:inline-flex;gap:7px;align-items:center;background:#e8f8f5;color:#08776d;border-radius:999px;padding:7px 12px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.5px}.ty-hero h1{font-size:44px;font-weight:900;letter-spacing:-1px;margin:12px 0 8px}.ty-hero p{color:var(--muted);font-size:15px;margin:0}.ty-ref{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin-top:18px}.ty-pill{background:#fff;border:1px solid var(--line);border-radius:12px;padding:9px 12px;font-size:12px;box-shadow:0 6px 18px rgba(15,23,42,.04)}
.ty-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(310px,.7fr);gap:22px;align-items:start}.ty-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 12px 34px rgba(15,23,42,.06);overflow:hidden;margin-bottom:18px}.ty-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;align-items:center}.ty-head h2{font-size:17px;font-weight:900;margin:0}.ty-status{background:#fff3c9;color:#836200;border-radius:999px;padding:6px 10px;font-size:11px;font-weight:900}.ty-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:18px 20px}.ty-box{background:#fbfdfd;border:1px solid #e8eef0;border-radius:14px;padding:14px}.ty-box small{display:block;color:#8996a0;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}.ty-box strong{font-size:14px;overflow-wrap:anywhere}.ty-lines{padding:4px 20px 16px}.ty-line{display:grid;grid-template-columns:minmax(0,1fr) 70px 90px 100px;gap:10px;align-items:center;padding:13px 0;border-bottom:1px solid #edf1f3}.ty-line.head{font-size:10px;font-weight:900;color:#8b98a2;text-transform:uppercase}.ty-line .right{text-align:right}.ty-total{display:flex;justify-content:flex-end;gap:24px;padding:17px 0 2px;font-weight:900}.ty-total strong{color:var(--a);font-size:22px}
.ty-next{position:sticky;top:96px;background:#0b4a45;color:#fff;border-radius:20px;padding:22px;box-shadow:0 18px 44px rgba(11,74,69,.2);overflow:hidden}.ty-next h2{font-size:20px;font-weight:900;margin:0 0 7px}.ty-next>p{color:#bdd3d0;font-size:12px;line-height:1.5}.ty-steps{display:grid;gap:8px;margin:18px 0}.ty-step{display:grid;grid-template-columns:38px minmax(0,1fr);gap:11px;align-items:center;padding:8px 0}.ty-step-number{width:34px;height:34px;min-width:34px;border-radius:10px;background:rgba(94,234,212,.14);color:#64eadb;display:grid;place-items:center;text-align:center;font-size:12px;font-weight:900;line-height:1;margin:0;padding:0}.ty-step strong{display:block;font-size:13px;margin-bottom:2px}.ty-step span{display:block;color:#bdd3d0;font-size:10.5px;line-height:1.4}.ty-actions{display:grid;gap:9px;margin-top:15px}.ty-btn{min-height:48px;border-radius:11px;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;font-size:13px;font-weight:900;transition:.2s}.ty-btn.primary{background:#20bfaa;color:#fff}.ty-btn.secondary{border:1px solid rgba(255,255,255,.28);color:#fff}.ty-btn:hover{transform:translateY(-2px);text-decoration:none;color:#fff}.ty-note{color:#bcd1ce;font-size:10px;margin-top:13px}
.dark-mode .ty-page{--ink:#edf5f4;--muted:#9eaaae;--line:#2c3a3b;background:#111819}.dark-mode .ty-card,.dark-mode .ty-pill{background:#172122}.dark-mode .ty-box{background:#121c1d;border-color:#2d3b3c}
@@media(max-width:991px){.ty-layout{grid-template-columns:1fr}.ty-next{position:static}}@@media(max-width:767px){.ty-page{padding:34px 0 52px}.ty-shell{padding:0 15px}.ty-hero h1{font-size:34px}.ty-grid{grid-template-columns:1fr}.ty-line{grid-template-columns:minmax(0,1fr) 48px 82px}.ty-line.head span:nth-child(3),.ty-line:not(.head) .price{display:none}.ty-line.head span:nth-child(4){grid-column:3}.ty-line .right{grid-column:3}}
</style>
}

<section class="ty-page">
<div class="ty-shell">
    <div class="ty-hero">
        <div class="ty-check"><i class="fas fa-check"></i></div>
        <div class="ty-kicker"><i class="fas fa-shield-alt"></i> Order confirmed</div>
        <h1>Thank you for your order.</h1>
        <p>Your order was placed successfully. Track its progress any time from My Orders.</p>
        <div class="ty-ref">
            <div class="ty-pill"><strong>#@Model.OrderNumber</strong></div>
            <div class="ty-pill">@Model.OrderDate.ToString("MMM dd, yyyy")</div>
            <div class="ty-pill">@itemCount item@(itemCount == 1 ? "" : "s")</div>
        </div>
    </div>

    <div class="ty-layout">
        <div>
            <section class="ty-card">
                <div class="ty-head"><h2>Order summary</h2><span class="ty-status">@Model.Status</span></div>
                <div class="ty-grid">
                    <div class="ty-box"><small>Order number</small><strong>@Model.OrderNumber</strong></div>
                    <div class="ty-box"><small>Placed</small><strong>@Model.OrderDate.ToString("MMMM dd, yyyy")</strong></div>
                    <div class="ty-box"><small>Payment method</small><strong>@Model.PaymentMethod</strong></div>
                    <div class="ty-box"><small>Order total</small><strong>$@Model.TotalAmount.ToString("0.00")</strong></div>
                    <div class="ty-box"><small>Shipping address</small><strong>@Model.ShippingAddress</strong></div>
                    <div class="ty-box"><small>Contact</small><strong>@Model.City · @Model.PhoneNumber</strong></div>
                </div>
            </section>

            <section class="ty-card">
                <div class="ty-head"><h2>Items in this order</h2><span>@itemCount item@(itemCount == 1 ? "" : "s")</span></div>
                <div class="ty-lines">
                    <div class="ty-line head"><span>Product</span><span>Qty</span><span>Price</span><span class="right">Total</span></div>
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="ty-line">
                            <strong>@item.ProductName</strong><span>@item.Quantity</span><span class="price">$@item.Price.ToString("0.00")</span><strong class="right">$@((item.Price * item.Quantity).ToString("0.00"))</strong>
                        </div>
                    }
                    <div class="ty-total"><span>Order total</span><strong>$@Model.TotalAmount.ToString("0.00")</strong></div>
                </div>
            </section>
        </div>

        <aside class="ty-next">
            <h2>What happens next?</h2>
            <p>Your order is confirmed. Here’s what to expect from this point.</p>
            <div class="ty-steps">
                <div class="ty-step"><span class="ty-step-number">1</span><div><strong>We review your order</strong><span>The pharmacy checks the order and available stock.</span></div></div>
                <div class="ty-step"><span class="ty-step-number">2</span><div><strong>Your order is prepared</strong><span>Status updates as the order moves through fulfillment.</span></div></div>
                <div class="ty-step"><span class="ty-step-number">3</span><div><strong>Payment on delivery</strong><span>Pay the delivery person when your order arrives.</span></div></div>
            </div>
            <div class="ty-actions">
                <a class="ty-btn primary" href="@Url.Action("Index", "Order")"><i class="fas fa-box-open"></i> View my orders <i class="fas fa-arrow-right"></i></a>
                <a class="ty-btn secondary" href="@Url.Action("Shop", "FrontEnd")"><i class="fas fa-shopping-bag"></i> Continue shopping</a>
            </div>
            <div class="ty-note"><i class="fas fa-shield-alt"></i> Keep your order number for reference.</div>
        </aside>
    </div>
</div>
</section>