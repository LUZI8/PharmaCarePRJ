@model IEnumerable<PharmaCare.Models.Order>
@using System.Linq

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    bool isAdmin = ViewBag.UserRole == "Admin";
    ViewBag.IsLoggedIn = true;
    var userName = Context.Session.GetString("UserName");
    ViewBag.UserName = !string.IsNullOrEmpty(userName) ? userName : "User";
    ViewBag.HideCategories = false;

    var orders = Model?.OrderByDescending(o => o.OrderDate).ToList() ?? new List<PharmaCare.Models.Order>();
    var totalOrders = orders.Count;
    var activeOrders = orders.Count(o => new[] { "pending", "processing", "shipped" }.Contains((o.Status ?? "").ToLower()));
    var deliveredOrders = orders.Count(o => (o.Status ?? "").Equals("Delivered", StringComparison.OrdinalIgnoreCase));
}

@section Styles {
<style>
.orders-page{--teal:#0f9d8f;--teal-dark:#0b5a54;--ink:#17212b;--muted:#71808d;--line:#dfe9eb;background:linear-gradient(180deg,#f4fbfa 0,#fff 48%);padding:42px 0 72px;color:var(--ink)}
.orders-shell{max-width:1180px;margin:0 auto;padding:0 22px}
.orders-top{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:24px}
.orders-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;background:#e6f7f4;color:#08776d;font-size:11px;font-weight:900;letter-spacing:.55px;text-transform:uppercase;margin-bottom:10px}
.orders-title{font-size:38px;font-weight:900;letter-spacing:-1.1px;margin:0 0 7px}.orders-subtitle{margin:0;color:var(--muted);font-size:14px}
.orders-cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 17px;border-radius:12px;border:1px solid var(--line);background:#fff;color:var(--ink);font-weight:800;text-decoration:none;transition:.2s}.orders-cta:hover{transform:translateY(-2px);border-color:#a8d9d2;color:var(--teal-dark);text-decoration:none;box-shadow:0 10px 24px rgba(15,23,42,.07)}
.orders-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:22px}.orders-stat{background:#fff;border:1px solid var(--line);border-radius:17px;padding:17px 18px;box-shadow:0 10px 30px rgba(15,23,42,.05);display:flex;align-items:center;gap:13px}.orders-stat-icon{width:42px;height:42px;border-radius:13px;background:#e9f8f5;color:var(--teal);display:grid;place-items:center;font-size:17px}.orders-stat strong{display:block;font-size:23px;line-height:1;font-weight:900}.orders-stat span{display:block;color:var(--muted);font-size:11px;margin-top:5px}
.orders-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 14px 38px rgba(15,23,42,.06);overflow:hidden}.orders-card-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:15px}.orders-card-head h2{margin:0;font-size:17px;font-weight:900}.orders-count{font-size:11px;font-weight:800;color:#08776d;background:#e8f8f5;padding:7px 10px;border-radius:999px}
.orders-table-wrap{overflow-x:auto}.orders-table{width:100%;border-collapse:collapse;min-width:780px}.orders-table th{padding:13px 18px;background:#f8fbfb;color:#7d8992;font-size:10px;text-transform:uppercase;letter-spacing:.55px;text-align:left;border-bottom:1px solid var(--line)}.orders-table td{padding:16px 18px;border-bottom:1px solid #edf2f3;font-size:13px;vertical-align:middle}.orders-table tbody tr{transition:.18s}.orders-table tbody tr:hover{background:#fbfefd}.orders-table tbody tr:last-child td{border-bottom:0}.order-no{font-weight:900;color:#1e2a35;white-space:nowrap}.order-date,.order-customer{color:#5f6c75}.order-total{font-weight:900}
.order-status{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:999px;font-size:10px;font-weight:900}.order-status:before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}.status-pending{background:#fff4cf;color:#a66d00}.status-processing{background:#e6f8fb;color:#087d92}.status-shipped{background:#e9f1ff;color:#1769c2}.status-delivered{background:#e7f8ed;color:#178447}.status-cancelled{background:#feecee;color:#bf3342}.status-default{background:#eef2f3;color:#66737b}
.view-order{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:0 12px;border-radius:10px;background:#e8f8f5;color:#08776d;font-size:11px;font-weight:900;text-decoration:none;border:1px solid #cceae5;transition:.2s}.view-order:hover{background:var(--teal);border-color:var(--teal);color:#fff;text-decoration:none;transform:translateY(-1px)}
.orders-mobile{display:none}.mobile-order{padding:16px;border-bottom:1px solid var(--line)}.mobile-order:last-child{border-bottom:0}.mobile-order-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.mobile-order-no{font-size:13px;font-weight:900;overflow-wrap:anywhere}.mobile-order-date{font-size:10px;color:var(--muted);margin-top:4px}.mobile-order-meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}.mobile-meta{background:#f8fbfb;border-radius:11px;padding:10px}.mobile-meta small{display:block;color:#8a969e;font-size:9px;text-transform:uppercase;font-weight:900;margin-bottom:4px}.mobile-meta strong{font-size:12px}.mobile-order-actions{display:flex;justify-content:space-between;align-items:center;gap:10px}
.orders-empty{text-align:center;padding:60px 24px}.orders-empty-icon{width:72px;height:72px;border-radius:22px;background:#e9f8f5;color:var(--teal);display:grid;place-items:center;font-size:28px;margin:0 auto 16px}.orders-empty h2{font-size:22px;font-weight:900;margin-bottom:8px}.orders-empty p{color:var(--muted);font-size:13px;margin-bottom:20px}.orders-empty a{display:inline-flex;align-items:center;gap:8px;background:var(--teal);color:#fff;border-radius:12px;padding:12px 18px;font-weight:900;text-decoration:none}
.dark-mode .orders-page{--ink:#edf5f4;--muted:#9ca8ad;--line:#2b3b3c;background:#111819}.dark-mode .orders-card,.dark-mode .orders-stat,.dark-mode .orders-cta{background:#172122}.dark-mode .orders-table th,.dark-mode .mobile-meta{background:#121c1d}.dark-mode .orders-table td{border-color:#263637}.dark-mode .orders-table tbody tr:hover{background:#1a2627}.dark-mode .order-no{color:#edf5f4}
@@media(max-width:820px){.orders-top{align-items:flex-start;flex-direction:column}.orders-stats{grid-template-columns:1fr}.orders-table-wrap{display:none}.orders-mobile{display:block}.orders-card-head{padding:16px}.orders-title{font-size:31px}}
@@media(max-width:520px){.orders-page{padding:30px 0 54px}.orders-shell{padding:0 14px}.orders-title{font-size:28px}.orders-cta{width:100%}.mobile-order-meta{grid-template-columns:1fr}.mobile-order-actions{align-items:flex-start;flex-direction:column}.view-order{width:100%}}
</style>
}

<section class="orders-page">
    <div class="orders-shell">
        <div class="orders-top">
            <div>
                <div class="orders-kicker"><i class="fas fa-receipt"></i> @(isAdmin ? "Order history" : "Your purchases")</div>
                <h1 class="orders-title">@(isAdmin ? "All orders" : "My orders")</h1>
                <p class="orders-subtitle">@(isAdmin ? "Review customer orders and their current fulfillment status." : "Track every order from confirmation through delivery.")</p>
            </div>
            <a class="orders-cta" href="@Url.Action("Shop", "FrontEnd")"><i class="fas fa-store"></i> Continue shopping</a>
        </div>

        <div class="orders-stats">
            <div class="orders-stat"><div class="orders-stat-icon"><i class="fas fa-shopping-bag"></i></div><div><strong>@totalOrders</strong><span>Total orders</span></div></div>
            <div class="orders-stat"><div class="orders-stat-icon"><i class="fas fa-truck"></i></div><div><strong>@activeOrders</strong><span>In progress</span></div></div>
            <div class="orders-stat"><div class="orders-stat-icon"><i class="fas fa-check-circle"></i></div><div><strong>@deliveredOrders</strong><span>Delivered</span></div></div>
        </div>

        <section class="orders-card">
            <div class="orders-card-head">
                <h2><i class="fas fa-history mr-2"></i> Order history</h2>
                <span class="orders-count">@totalOrders @(totalOrders == 1 ? "order" : "orders")</span>
            </div>

            @if (orders.Any())
            {
                <div class="orders-table-wrap">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                @if (isAdmin) { <th>Customer</th> }
                                <th>Date</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in orders)
                            {
                                var status = (order.Status ?? "").ToLower();
                                var statusClass = status switch
                                {
                                    "pending" => "status-pending",
                                    "processing" => "status-processing",
                                    "shipped" => "status-shipped",
                                    "delivered" => "status-delivered",
                                    "cancelled" => "status-cancelled",
                                    _ => "status-default"
                                };
                                <tr>
                                    <td><span class="order-no">#@order.OrderNumber</span></td>
                                    @if (isAdmin) { <td class="order-customer">@order.User?.FirstName @order.User?.LastName</td> }
                                    <td class="order-date">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="order-total">$@order.TotalAmount.ToString("0.00")</td>
                                    <td><span class="order-status @statusClass">@order.Status</span></td>
                                    <td><a class="view-order" href="@Url.Action("Details", "Order", new { id = order.OrderId })">View order <i class="fas fa-arrow-right"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="orders-mobile">
                    @foreach (var order in orders)
                    {
                        var status = (order.Status ?? "").ToLower();
                        var statusClass = status switch
                        {
                            "pending" => "status-pending",
                            "processing" => "status-processing",
                            "shipped" => "status-shipped",
                            "delivered" => "status-delivered",
                            "cancelled" => "status-cancelled",
                            _ => "status-default"
                        };
                        <article class="mobile-order">
                            <div class="mobile-order-top">
                                <div><div class="mobile-order-no">#@order.OrderNumber</div><div class="mobile-order-date">@order.OrderDate.ToString("MMM dd, yyyy")</div></div>
                                <span class="order-status @statusClass">@order.Status</span>
                            </div>
                            <div class="mobile-order-meta">
                                @if (isAdmin) { <div class="mobile-meta"><small>Customer</small><strong>@order.User?.FirstName @order.User?.LastName</strong></div> }
                                <div class="mobile-meta"><small>Total</small><strong>$@order.TotalAmount.ToString("0.00")</strong></div>
                            </div>
                            <div class="mobile-order-actions"><span class="mobile-order-date">Order details and fulfillment timeline</span><a class="view-order" href="@Url.Action("Details", "Order", new { id = order.OrderId })">View order <i class="fas fa-arrow-right"></i></a></div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="orders-empty">
                    <div class="orders-empty-icon"><i class="fas fa-shopping-bag"></i></div>
                    <h2>No orders yet</h2>
                    <p>Your completed purchases will appear here with their status and delivery progress.</p>
                    <a href="@Url.Action("Shop", "FrontEnd")"><i class="fas fa-store"></i> Browse products</a>
                </div>
            }
        </section>
    </div>
</section>