@model PharmaCare.Models.DashboardViewModel
@using System.Linq
@{
    ViewData["Title"] = "Operations Dashboard";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
}

@section Styles {
<style>
.dashboard-head{display:flex;justify-content:space-between;align-items:flex-end;margin:28px 0 20px}.dashboard-head h2{font-weight:700;margin:0}.dashboard-head p{margin:5px 0 0;color:#6c757d}.kpi-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.07);height:100%}.kpi-card .card-body{padding:20px}.kpi-icon{width:46px;height:46px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px}.kpi-label{font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:#6c757d;font-weight:700}.kpi-value{font-size:25px;font-weight:700;margin-top:4px}.section-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.section-card .card-header{background:#fff;padding:17px 20px;border-bottom:1px solid #edf0f2}.section-title{font-weight:700;color:#222;background:transparent!important}.section-link{color:#0d9488!important;background:transparent!important;text-decoration:none!important;font-weight:600}.quick-link{border:1px solid #e6e9ec;border-radius:10px;padding:14px;text-decoration:none!important;color:inherit;display:block;height:100%;transition:.15s;background:#fff}.quick-link:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.07)}.alert-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #eee;gap:12px}.alert-row:last-child{border:0}.alert-name{font-weight:600;color:#222;background:transparent!important;word-break:break-word}.metric-note{font-size:12px;color:#7b838b;background:transparent!important}.table td,.table th{vertical-align:middle}.empty-state{color:#7b838b;text-align:center;padding:28px 10px}.stock-badge{min-width:62px;text-align:center}.section-card a,.section-card span,.section-card div{box-decoration-break:clone}
body.dark-mode .section-card .card-header,body.dark-mode .quick-link{background:#1e1e1e!important}.dark-mode .section-title,.dark-mode .alert-name{color:#f0f0f0}.dark-mode .section-link{color:#2dd4bf!important}
</style>
}

<div class="dashboard-head">
    <div><h2>Pharmacy Operations</h2><p>Inventory, orders, customers and prescription activity at a glance.</p></div>
    <div class="text-muted small"><i class="far fa-clock mr-1"></i>@DateTime.Now.ToString("ddd, MMM dd yyyy")</div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 mb-4"><div class="card kpi-card"><div class="card-body d-flex justify-content-between"><div><div class="kpi-label">Revenue</div><div class="kpi-value">$@Model.TotalRevenue.ToString("N2")</div><div class="metric-note">Today: $@Model.RevenueToday.ToString("N2")</div></div><div class="kpi-icon bg-success text-white"><i class="fas fa-dollar-sign"></i></div></div></div></div>
    <div class="col-xl-3 col-md-6 mb-4"><div class="card kpi-card"><div class="card-body d-flex justify-content-between"><div><div class="kpi-label">Orders</div><div class="kpi-value">@Model.OrderCount</div><div class="metric-note">@Model.OrdersToday placed today</div></div><div class="kpi-icon bg-primary text-white"><i class="fas fa-shopping-bag"></i></div></div></div></div>
    <div class="col-xl-3 col-md-6 mb-4"><div class="card kpi-card"><div class="card-body d-flex justify-content-between"><div><div class="kpi-label">Customers</div><div class="kpi-value">@Model.CustomerCount</div><div class="metric-note">Active customer accounts</div></div><div class="kpi-icon bg-info text-white"><i class="fas fa-users"></i></div></div></div></div>
    <div class="col-xl-3 col-md-6 mb-4"><div class="card kpi-card"><div class="card-body d-flex justify-content-between"><div><div class="kpi-label">Inventory</div><div class="kpi-value">@Model.InventoryCount</div><div class="metric-note">@Model.OutOfStockCount out of stock</div></div><div class="kpi-icon bg-warning text-dark"><i class="fas fa-boxes"></i></div></div></div></div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 mb-4"><div class="card kpi-card"><div class="card-body"><div class="kpi-label text-warning">Low Stock</div><div class="kpi-value">@Model.LowStockCount</div><div class="metric-note">10 units or fewer</div></div></div></div>
    <div class="col-xl-3 col-md-6 mb-4"><div class="card kpi-card"><div class="card-body"><div class="kpi-label text-danger">Expiring Soon</div><div class="kpi-value">@Model.ExpiringSoonCount</div><div class="metric-note">Within the next 90 days</div></div></div></div>
    <div class="col-xl-3 col-md-6 mb-4"><div class="card kpi-card"><div class="card-body"><div class="kpi-label text-info">Reserved Pickups</div><div class="kpi-value">@Model.PendingPickupCount</div><div class="metric-note">Awaiting pharmacy action</div></div></div></div>
    <div class="col-xl-3 col-md-6 mb-4"><div class="card kpi-card"><div class="card-body"><div class="kpi-label">Feedback</div><div class="kpi-value">@Model.FeedbackCount</div><div class="metric-note">Customer messages</div></div></div></div>
</div>

<div class="card section-card mb-4"><div class="card-header"><span class="section-title">Quick Actions</span></div><div class="card-body"><div class="row">
<div class="col-lg-3 col-6 mb-3"><a class="quick-link" href="@Url.Action("Create","Product")"><i class="fas fa-plus-circle text-success mr-2"></i><span class="section-title">Add Product</span><div class="metric-note mt-1">Create inventory item</div></a></div>
<div class="col-lg-3 col-6 mb-3"><a class="quick-link" href="@Url.Action("ManageOrders","Order")"><i class="fas fa-clipboard-list text-primary mr-2"></i><span class="section-title">Manage Orders</span><div class="metric-note mt-1">Review order workflow</div></a></div>
<div class="col-lg-3 col-6 mb-3"><a class="quick-link" href="@Url.Action("Pickups","Prescription")"><i class="fas fa-prescription-bottle-alt text-info mr-2"></i><span class="section-title">Prescription Pickups</span><div class="metric-note mt-1">Process reservations</div></a></div>
<div class="col-lg-3 col-6 mb-3"><a class="quick-link" href="@Url.Action("Feedback","Admin")"><i class="fas fa-comments text-warning mr-2"></i><span class="section-title">Customer Messages</span><div class="metric-note mt-1">Review feedback</div></a></div>
</div></div></div>

<div class="row">
<div class="col-lg-7 mb-4"><div class="card section-card h-100"><div class="card-header d-flex justify-content-between"><span class="section-title">Recent Orders</span><a class="section-link" href="@Url.Action("ManageOrders","Order")">View all</a></div><div class="card-body p-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Status</th></tr></thead><tbody>
@if(Model.RecentOrders.Any()){foreach(var order in Model.RecentOrders){<tr><td><span class="alert-name">#@order.OrderNumber</span></td><td>@order.CustomerName</td><td>@order.ItemCount</td><td><span class="badge badge-@order.StatusClass">@order.Status</span></td></tr>}}else{<tr><td colspan="4" class="empty-state">No orders yet.</td></tr>}
</tbody></table></div></div></div></div>
<div class="col-lg-5 mb-4"><div class="card section-card h-100"><div class="card-header"><span class="section-title">Order Pipeline</span></div><div class="card-body">
@if(ViewBag.OrderStatistics != null){
<div class="alert-row"><span>Pending</span><span class="badge badge-warning">@ViewBag.OrderStatistics["Pending"]</span></div>
<div class="alert-row"><span>Processing</span><span class="badge badge-info">@ViewBag.OrderStatistics["Processing"]</span></div>
<div class="alert-row"><span>Shipped</span><span class="badge badge-primary">@ViewBag.OrderStatistics["Shipped"]</span></div>
<div class="alert-row"><span>Delivered</span><span class="badge badge-success">@ViewBag.OrderStatistics["Delivered"]</span></div>
<div class="alert-row"><span>Cancelled</span><span class="badge badge-danger">@ViewBag.OrderStatistics["Cancelled"]</span></div>}
</div></div></div>
</div>

<div class="row">
<div class="col-lg-6 mb-4"><div class="card section-card h-100"><div class="card-header d-flex justify-content-between align-items-center"><span class="section-title"><i class="fas fa-exclamation-triangle text-warning mr-2"></i>Inventory Attention</span><a class="section-link" href="@Url.Action("Index","Product")">Inventory</a></div><div class="card-body">
@if(Model.LowStockProducts.Any()){foreach(var p in Model.LowStockProducts){<div class="alert-row"><div><div class="alert-name">@p.ProductName</div><div class="metric-note">Current stock</div></div><span class="badge stock-badge @(p.Stock <= 0 ? "badge-danger" : "badge-warning")">@p.Stock units</span></div>}}else{<div class="empty-state">Stock levels look healthy.</div>}
</div></div></div>
<div class="col-lg-6 mb-4"><div class="card section-card h-100"><div class="card-header"><span class="section-title"><i class="far fa-calendar-times text-danger mr-2"></i>Expiry Watch</span></div><div class="card-body">
@if(Model.ExpiringProducts.Any()){foreach(var p in Model.ExpiringProducts){<div class="alert-row"><div><div class="alert-name">@p.ProductName</div><div class="metric-note">@p.Stock units in stock</div></div><span class="badge badge-danger">@p.ExpiryDate.ToString("MMM dd, yyyy")</span></div>}}else{<div class="empty-state">No products expire in the next 90 days.</div>}
</div></div></div>
</div>
