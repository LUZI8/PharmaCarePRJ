@model PharmaCare.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    var hasItems = Model?.Items != null && Model.Items.Any();
    var itemCount = Model?.Items?.Sum(x => x.Quantity) ?? 0;
}

@section Styles {
<style>
.cart-page{--cart-accent:#0f9d8f;--cart-accent-dark:#08776d;--cart-ink:#17212b;--cart-muted:#71808d;--cart-line:#e3eaee;--cart-soft:#f4f8f8;--cart-card:#fff;--cart-danger:#dc3545;position:relative;overflow:hidden;background:linear-gradient(180deg,#f6fbfb 0,#fff 300px);padding:42px 0 72px;color:var(--cart-ink)}
.cart-page:before{content:"";position:absolute;top:-180px;right:-160px;width:430px;height:430px;border-radius:50%;background:radial-gradient(circle,rgba(15,157,143,.12),rgba(15,157,143,0) 68%);pointer-events:none}
.cart-shell{max-width:1240px;margin:0 auto;padding:0 22px;position:relative;z-index:1}
.cart-breadcrumb{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--cart-muted);margin-bottom:20px}.cart-breadcrumb a{color:var(--cart-muted);text-decoration:none}.cart-breadcrumb a:hover{color:var(--cart-accent)}
.cart-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px;animation:cartFadeUp .45s ease both}.cart-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border:1px solid rgba(15,157,143,.2);border-radius:999px;background:#eaf8f6;color:var(--cart-accent-dark);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.55px;margin-bottom:12px}.cart-kicker i{width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;line-height:1}.cart-title{font-size:42px;line-height:1.08;font-weight:850;margin:0 0 10px;letter-spacing:-1.2px}.cart-subtitle{margin:0;color:var(--cart-muted);font-size:15px;max-width:650px}.cart-count-pill{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--cart-line);box-shadow:0 8px 24px rgba(15,23,42,.06);border-radius:14px;padding:12px 15px;white-space:nowrap}.cart-count-pill>i{width:36px;height:36px;border-radius:10px;background:#eaf8f6;color:var(--cart-accent);display:flex;align-items:center;justify-content:center;line-height:1;font-size:15px;flex:none}.cart-count-pill strong{display:block;font-size:15px}.cart-count-pill span{display:block;font-size:11px;color:var(--cart-muted)}
.cart-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(320px,.72fr);gap:22px;align-items:start}.cart-card{background:var(--cart-card);border:1px solid var(--cart-line);border-radius:20px;box-shadow:0 14px 38px rgba(15,23,42,.065);overflow:hidden;animation:cartFadeUp .5s .05s ease both}.cart-card-head{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:18px 20px;border-bottom:1px solid var(--cart-line)}.cart-card-head h2{font-size:17px;font-weight:800;margin:0}.cart-card-head p{font-size:12px;color:var(--cart-muted);margin:3px 0 0}.cart-clear{border:0;background:transparent;color:#a74a53;font-size:12px;font-weight:750;padding:8px 10px;border-radius:9px;transition:.2s;display:inline-flex;align-items:center;gap:6px}.cart-clear i{width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;line-height:1}.cart-clear:hover{background:#fff1f2;color:var(--cart-danger)}
.cart-items{padding:4px 20px 8px}.cart-item{display:grid;grid-template-columns:88px minmax(0,1fr) 140px 115px 42px;gap:18px;align-items:center;padding:18px 0;border-bottom:1px solid #edf1f3;transition:.2s}.cart-item:last-child{border-bottom:0}.cart-item:hover{transform:translateX(3px)}.cart-thumb{width:88px;height:88px;border-radius:14px;background:#f6f9fa;border:1px solid #edf1f3;display:grid;place-items:center;overflow:hidden}.cart-thumb img{width:100%;height:100%;object-fit:contain;padding:7px}.cart-product-name{font-size:16px;font-weight:800;color:var(--cart-ink);text-decoration:none;display:inline-block;margin-bottom:6px}.cart-product-name:hover{color:var(--cart-accent)}.cart-unit{font-size:13px;color:var(--cart-muted)}.cart-price-mobile{display:none;font-weight:800;color:var(--cart-accent-dark);margin-top:7px}.qty-label,.line-label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.55px;color:#94a0aa;font-weight:800;margin-bottom:7px}.qty-control{display:grid;grid-template-columns:40px 54px 40px;align-items:stretch;border:1px solid #d9e2e7;border-radius:12px;overflow:hidden;background:#fff;width:max-content;height:40px;box-shadow:0 2px 7px rgba(15,23,42,.025)}.qty-control button{appearance:none;-webkit-appearance:none;width:40px;height:40px;margin:0;padding:0;border:0!important;outline:0!important;box-shadow:none!important;background:#fff;color:var(--cart-accent-dark);font-family:Arial,sans-serif;font-weight:700;font-size:19px;line-height:1;display:flex;align-items:center;justify-content:center;position:relative;transition:background .16s ease,color .16s ease,transform .12s ease}.qty-control .js-btn-minus{border-right:1px solid #e4eaee!important}.qty-control .js-btn-plus{border-left:1px solid #e4eaee!important}.qty-control button:hover{background:#ecfaf8;color:#06796f}.qty-control button:active{background:#dff6f2;transform:scale(.94)}.qty-control button:focus{outline:0!important;box-shadow:none!important}.qty-control button:focus-visible{z-index:2;box-shadow:inset 0 0 0 2px rgba(15,157,143,.35)!important}.qty-control input{appearance:none;-webkit-appearance:none;height:40px;width:54px;margin:0;padding:0;border:0!important;text-align:center;font-weight:800;font-size:15px;line-height:40px;color:var(--cart-ink);outline:0!important;box-shadow:none!important;background:#fff}.line-total strong{font-size:17px}.remove-item{width:38px;height:38px;border:1px solid #f0cfd3;border-radius:10px;background:#fff;color:#c93d4a;display:flex;align-items:center;justify-content:center;transition:.18s;text-decoration:none;line-height:1}.remove-item i{display:block;line-height:1;font-size:14px}.remove-item:hover{background:#fff0f2;color:#b42331;transform:scale(1.05)}
.cart-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 20px 20px}.continue-btn{display:inline-flex;align-items:center;gap:8px;color:var(--cart-accent-dark);font-weight:800;text-decoration:none;padding:11px 13px;border-radius:10px}.continue-btn i{width:15px;display:inline-flex;align-items:center;justify-content:center;line-height:1}.continue-btn:hover{background:#eaf8f6;color:var(--cart-accent-dark);text-decoration:none}
.summary-card{position:sticky;top:96px;background:#0b3d3b;color:#fff;border-radius:20px;padding:22px;box-shadow:0 18px 42px rgba(5,63,60,.18);animation:cartFadeUp .55s .08s ease both;overflow:hidden}.summary-card:before{content:"";position:absolute;width:210px;height:210px;border-radius:50%;right:-90px;top:-100px;background:rgba(45,212,191,.12)}.summary-title{position:relative;font-size:19px;font-weight:850;margin:0 0 5px}.summary-copy{position:relative;font-size:12px;color:#b9d4d2;margin-bottom:20px}.summary-row{position:relative;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:10px 0;color:#d8e7e6;font-size:13px}.summary-row strong{color:#fff;font-size:14px}.summary-row.shipping{border-bottom:1px solid rgba(255,255,255,.12);padding-bottom:17px}.summary-row.total{padding:18px 0 16px;font-size:16px}.summary-row.total strong{font-size:27px;color:#5eead4}.free-shipping{color:#5eead4!important;font-weight:800}.checkout-btn{position:relative;width:100%;border:0;border-radius:12px;background:#19b7a8;color:#fff;min-height:52px;font-weight:850;font-size:14px;display:flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;box-shadow:0 9px 22px rgba(25,183,168,.24);transition:.2s}.checkout-btn i{width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;line-height:1}.checkout-btn:hover{background:#23c9b9;color:#fff;text-decoration:none;transform:translateY(-2px)}.summary-trust{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}.summary-trust span{font-size:10px;color:#bdd3d1;display:flex;align-items:center;gap:6px}.summary-trust i{color:#5eead4;width:12px;display:inline-flex;align-items:center;justify-content:center;line-height:1}
.cart-perks{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}.perk{display:flex;align-items:flex-start;gap:12px;padding:15px;background:#fff;border:1px solid var(--cart-line);border-radius:15px;box-shadow:0 6px 20px rgba(15,23,42,.04);min-height:82px}.perk-icon{width:40px;height:40px;border-radius:11px;background:#eaf8f6;color:var(--cart-accent);display:flex;align-items:center;justify-content:center;flex:0 0 40px;line-height:1;margin-top:1px}.perk-icon i{display:block;line-height:1;font-size:14px}.perk>div{min-width:0;padding-top:1px}.perk strong{display:block;font-size:12px;line-height:1.35}.perk span{display:block;font-size:10px;line-height:1.5;color:var(--cart-muted);margin-top:3px}
.empty-cart{background:#fff;border:1px solid var(--cart-line);border-radius:22px;padding:64px 24px;text-align:center;box-shadow:0 14px 38px rgba(15,23,42,.06);animation:cartFadeUp .45s ease both}.empty-icon{width:82px;height:82px;border-radius:24px;background:#eaf8f6;color:var(--cart-accent);display:grid;place-items:center;margin:0 auto 20px;font-size:30px}.empty-cart h2{font-weight:850;font-size:26px}.empty-cart p{color:var(--cart-muted);max-width:480px;margin:8px auto 22px}.empty-shop-btn{display:inline-flex;align-items:center;gap:8px;padding:13px 20px;background:var(--cart-accent);color:#fff;border-radius:11px;font-weight:800;text-decoration:none}.empty-shop-btn:hover{background:var(--cart-accent-dark);color:#fff;text-decoration:none}
.cart-toast{position:fixed;right:24px;bottom:24px;z-index:9999;background:#132b2a;color:#fff;border-radius:12px;padding:12px 15px;box-shadow:0 12px 34px rgba(0,0,0,.2);font-size:12px;font-weight:700;transform:translateY(20px);opacity:0;pointer-events:none;transition:.25s}.cart-toast.show{transform:translateY(0);opacity:1}
.clear-confirm{display:none;padding:12px 20px 18px;background:#fff8f8;border-top:1px solid #f7d9dc}.clear-confirm.show{display:flex;align-items:center;justify-content:space-between;gap:12px}.clear-confirm span{font-size:12px;color:#8b3a43}.clear-confirm-actions{display:flex;gap:7px}.clear-confirm-actions button{border-radius:9px;font-weight:750;font-size:11px;padding:7px 11px}
.cart-item.is-updating{opacity:.58;pointer-events:none}.cart-item.is-removing{transform:translateX(18px);opacity:0}
@@keyframes cartFadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.dark-mode .cart-page{--cart-ink:#eef4f4;--cart-muted:#9ba8ad;--cart-line:#2c3b3c;--cart-soft:#172425;--cart-card:#172122;background:linear-gradient(180deg,#101819,#121718 320px)}.dark-mode .cart-count-pill,.dark-mode .perk,.dark-mode .empty-cart{background:#172122}.dark-mode .cart-thumb{background:#121a1b;border-color:#2a3839}.dark-mode .qty-control,.dark-mode .qty-control button,.dark-mode .qty-control input{background:#141d1e;color:#eaf4f3;border-color:#344445}.dark-mode .qty-control .js-btn-minus{border-right-color:#344445!important}.dark-mode .qty-control .js-btn-plus{border-left-color:#344445!important}.dark-mode .qty-control button:hover{background:#203536;color:#7ee0d5}.dark-mode .cart-clear:hover,.dark-mode .remove-item:hover{background:#321c20}.dark-mode .remove-item{background:#172122}.dark-mode .clear-confirm{background:#25191b;border-color:#4c2d31}
@@media(max-width:991px){.cart-layout{grid-template-columns:1fr}.summary-card{position:static}.cart-perks{grid-template-columns:1fr 1fr 1fr}.cart-item{grid-template-columns:78px minmax(0,1fr) 130px 105px 40px}.cart-thumb{width:78px;height:78px}}
@@media(max-width:767px){.cart-page{padding:26px 0 48px}.cart-shell{padding:0 15px}.cart-hero{align-items:flex-start;flex-direction:column}.cart-title{font-size:32px}.cart-count-pill{width:100%}.cart-items{padding:0 15px}.cart-item{grid-template-columns:72px minmax(0,1fr) 36px;gap:12px;padding:16px 0}.cart-thumb{width:72px;height:72px}.cart-product-info{min-width:0}.cart-product-name{font-size:14px;line-height:1.35}.cart-unit{font-size:11px}.cart-price-mobile{display:block}.cart-quantity{grid-column:2/3}.line-total{display:none}.remove-wrap{grid-column:3;grid-row:1/3;align-self:center}.qty-label{display:none}.qty-control{grid-template-columns:36px 48px 36px;height:36px}.qty-control button{width:36px;height:36px;font-size:18px}.qty-control input{width:48px;height:36px;line-height:36px}.cart-actions{padding:12px 15px 16px}.cart-clear{font-size:11px}.summary-card{border-radius:17px}.cart-perks{grid-template-columns:1fr}.clear-confirm.show{align-items:flex-start;flex-direction:column}.clear-confirm-actions{width:100%}.clear-confirm-actions button{flex:1}}
@@media(max-width:420px){.cart-title{font-size:29px}.cart-subtitle{font-size:13px}.cart-card-head{padding:15px}.cart-card-head p{display:none}.cart-item{grid-template-columns:62px minmax(0,1fr) 34px}.cart-thumb{width:62px;height:62px}.continue-btn{font-size:12px;padding-left:0}.summary-trust{grid-template-columns:1fr}.cart-breadcrumb{display:none}}
</style>
}

<section class="cart-page">
    <div class="cart-shell">
        <div class="cart-breadcrumb"><a href="@Url.Action("Index","FrontEnd")">Home</a><i class="fas fa-chevron-right" style="font-size:8px"></i><span>Shopping cart</span></div>

        <header class="cart-hero">
            <div>
                <div class="cart-kicker"><i class="fas fa-shopping-bag"></i> Your order</div>
                <h1 class="cart-title">Review your cart.</h1>
                <p class="cart-subtitle">Check quantities and order totals before moving to secure checkout.</p>
            </div>
            @if(hasItems)
            {
                <div class="cart-count-pill"><i class="fas fa-shopping-cart"></i><div><strong id="cartPageCount">@itemCount item@(itemCount == 1 ? "" : "s")</strong><span>Ready to checkout</span></div></div>
            }
        </header>

        @if(hasItems)
        {
            <div class="cart-layout">
                <div>
                    <section class="cart-card">
                        <div class="cart-card-head">
                            <div><h2>Cart items</h2><p>Quantity changes update your totals automatically.</p></div>
                            <button type="button" class="cart-clear js-show-clear"><i class="far fa-trash-alt mr-1"></i> Clear cart</button>
                        </div>

                        <div class="clear-confirm" id="clearConfirm">
                            <span><i class="fas fa-exclamation-circle mr-1"></i> Remove every item from your cart?</span>
                            <div class="clear-confirm-actions"><button type="button" class="btn btn-light js-cancel-clear">Keep items</button><button type="button" class="btn btn-danger clear-cart">Clear cart</button></div>
                        </div>

                        <div class="cart-items" id="cartItems">
                            @foreach(var item in Model.Items)
                            {
                                <article class="cart-item" data-product-id="@item.ProductId">
                                    <a class="cart-thumb" href="@Url.Action("ShopSingle","FrontEnd",new{id=item.ProductId})">
                                        <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? Url.Content("~/assets/images/no-image.png") : item.ImageUrl)" alt="@item.ProductName" />
                                    </a>
                                    <div class="cart-product-info">
                                        <a class="cart-product-name" href="@Url.Action("ShopSingle","FrontEnd",new{id=item.ProductId})">@item.ProductName</a>
                                        <div class="cart-unit">$@item.Price.ToString("0.00") each</div>
                                        <div class="cart-price-mobile product-total"><strong>$@((item.Price * item.Quantity).ToString("0.00"))</strong></div>
                                    </div>
                                    <div class="cart-quantity">
                                        <span class="qty-label">Quantity</span>
                                        <div class="qty-control">
                                            <button class="js-btn-minus" type="button" data-product-id="@item.ProductId" aria-label="Decrease quantity">−</button>
                                            <input type="text" class="quantity-input" value="@item.Quantity" inputmode="numeric" aria-label="Quantity" />
                                            <button class="js-btn-plus" type="button" data-product-id="@item.ProductId" aria-label="Increase quantity">+</button>
                                        </div>
                                    </div>
                                    <div class="line-total product-total"><span class="line-label">Line total</span><strong>$@((item.Price * item.Quantity).ToString("0.00"))</strong></div>
                                    <div class="remove-wrap"><a href="#" class="remove-item" data-product-id="@item.ProductId" aria-label="Remove @item.ProductName"><i class="fas fa-trash-alt"></i></a></div>
                                </article>
                            }
                        </div>

                        <div class="cart-actions"><a href="@Url.Action("Shop","FrontEnd")" class="continue-btn"><i class="fas fa-arrow-left"></i> Continue shopping</a><span class="text-muted small"><i class="fas fa-sync-alt mr-1"></i> Totals update instantly</span></div>
                    </section>

                    <div class="cart-perks">
                        <div class="perk"><span class="perk-icon"><i class="fas fa-lock"></i></span><div><strong>Secure checkout</strong><span>Your account and order data stay protected.</span></div></div>
                        <div class="perk"><span class="perk-icon"><i class="fas fa-box"></i></span><div><strong>Pharmacy managed</strong><span>Stock and expiry are controlled by PharmaCare.</span></div></div>
                        <div class="perk"><span class="perk-icon"><i class="fas fa-headset"></i></span><div><strong>Need help?</strong><span>Contact our pharmacy team before ordering.</span></div></div>
                    </div>
                </div>

                <aside class="summary-card">
                    <h2 class="summary-title">Order summary</h2>
                    <div class="summary-copy">Final review before checkout</div>
                    <div class="summary-row"><span>Subtotal</span><strong id="subtotal">$@Model.SubTotal.ToString("0.00")</strong></div>
                    <div class="summary-row"><span>Tax</span><strong id="tax">$@Model.Tax.ToString("0.00")</strong></div>
                    <div class="summary-row shipping"><span>Shipping</span><strong id="shipping">@if(Model.ShippingCost == 0){<span class="free-shipping">FREE</span>}else{<span>$@Model.ShippingCost.ToString("0.00")</span>}</strong></div>
                    <div class="summary-row total"><span>Total</span><strong id="total">$@Model.Total.ToString("0.00")</strong></div>
                    <a href="@Url.Action("Checkout","Order")" class="checkout-btn"><i class="fas fa-lock"></i> Continue to checkout <i class="fas fa-arrow-right"></i></a>
                    <div class="summary-trust"><span><i class="fas fa-shield-alt"></i> Secure checkout</span><span><i class="fas fa-check-circle"></i> Live stock verified</span></div>
                </aside>
            </div>
        }
        else
        {
            <div class="empty-cart">
                <div class="empty-icon"><i class="fas fa-shopping-basket"></i></div>
                <h2>Your cart is ready for something good.</h2>
                <p>Browse pharmacy essentials and add the products you need. Your cart will keep everything together here.</p>
                <a href="@Url.Action("Shop","FrontEnd")" class="empty-shop-btn">Browse products <i class="fas fa-arrow-right"></i></a>
            </div>
        }
    </div>
</section>
<div class="cart-toast" id="cartToast"></div>

@section Scripts {
<script>
(function($){
    const cartUrl='@Url.Action("Cart","FrontEnd")';
    const shopUrl='@Url.Action("Shop","FrontEnd")';
    const $toast=$('#cartToast');
    let toastTimer;

    function toast(message){clearTimeout(toastTimer);$toast.text(message).addClass('show');toastTimer=setTimeout(()=>$toast.removeClass('show'),1800);}
    function setBusy($row,busy){$row.toggleClass('is-updating',busy);}
    function updateHeaderCount(count){
        $('#cartPageCount').text(count+' item'+(count===1?'':'s'));
        const badge=document.querySelector('.cart-count, .site-cart-count, [data-cart-count]');
        if(badge) badge.textContent=count;
    }
    function updateCartTotals(response){
        $('#subtotal').text('$'+response.subtotal);
        $('#tax').text('$'+response.tax);
        $('#shipping').html(parseFloat(response.shipping)===0?'<span class="free-shipping">FREE</span>':'<span>$'+response.shipping+'</span>');
        $('#total').text('$'+response.total);
        updateHeaderCount(parseInt(response.cartCount)||0);
    }
    function updateCartQuantity(productId,quantity,$input){
        quantity=Math.max(1,parseInt(quantity)||1);
        const $row=$input.closest('.cart-item');
        setBusy($row,true);
        $.ajax({url:'@Url.Action("UpdateCart","Cart")',type:'POST',data:{productId,quantity}})
        .done(function(response){
            if(!response.success){toast(response.message||'Could not update quantity.');return;}
            if((parseInt(response.cartCount)||0)<=0){window.location.href=cartUrl;return;}
            $input.val(quantity);
            const price=parseFloat($row.find('.cart-unit').text().replace(/[^0-9.]/g,''))||0;
            const line='$'+(price*quantity).toFixed(2);
            $row.find('.product-total strong').text(line);
            updateCartTotals(response);
            toast('Cart updated');
        })
        .fail(()=>toast('Could not update your cart. Please try again.'))
        .always(()=>setBusy($row,false));
    }
    function removeFromCart(productId,$row){
        setBusy($row,true);
        $.ajax({url:'@Url.Action("RemoveFromCart","Cart")',type:'POST',data:{productId}})
        .done(function(response){
            if(!response.success){setBusy($row,false);toast(response.message||'Could not remove item.');return;}
            $row.addClass('is-removing');
            setTimeout(function(){
                $row.remove();
                if((parseInt(response.cartCount)||0)<=0){window.location.href=cartUrl;return;}
                updateCartTotals(response);toast('Item removed');
            },220);
        })
        .fail(function(){setBusy($row,false);toast('Could not remove item. Please try again.');});
    }

    $(document).on('click','.js-btn-plus',function(){const $input=$(this).siblings('.quantity-input');updateCartQuantity($(this).data('product-id'),(parseInt($input.val())||1)+1,$input);});
    $(document).on('click','.js-btn-minus',function(){const $input=$(this).siblings('.quantity-input');updateCartQuantity($(this).data('product-id'),Math.max(1,(parseInt($input.val())||1)-1,$input);});
    $(document).on('change','.quantity-input',function(){updateCartQuantity($(this).closest('.cart-item').data('product-id'),$(this).val(),$(this));});
    $(document).on('click','.remove-item',function(e){e.preventDefault();const $row=$(this).closest('.cart-item');removeFromCart($(this).data('product-id'),$row);});
    $('.js-show-clear').on('click',()=>$('#clearConfirm').addClass('show'));
    $('.js-cancel-clear').on('click',()=>$('#clearConfirm').removeClass('show'));
    $('.clear-cart').on('click',function(){
        const $btn=$(this);$btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Clearing');
        $.ajax({url:'@Url.Action("ClearCart","Cart")',type:'POST'})
        .done(response=>{if(response.success)window.location.href=cartUrl;else{toast(response.message||'Could not clear cart.');$btn.prop('disabled',false).text('Clear cart');}})
        .fail(()=>{$btn.prop('disabled',false).text('Clear cart');toast('Could not clear cart. Please try again.');});
    });
})(jQuery);
</script>
}