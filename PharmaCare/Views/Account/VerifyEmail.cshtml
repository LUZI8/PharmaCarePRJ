@{
    ViewData["Title"] = "Verify Email - PharmaCare";
    Layout = null;
    var email = ViewBag.Email as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css?family=Rubik:400,500,600,700" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="icon" href="~/assets/favicon-32x32.png" type="image/png" />
    <style>
        :root{--accent:#0f9f92;--accent2:#0b7f75;--ink:#132129;--muted:#71818b;--line:#e3eaed;--surface:#fff;--page:#f2f7f7;--soft:#eaf7f5;--danger:#d9534f;--info:#2f6fce;--shadow:0 30px 80px rgba(15,47,55,.14)}
        *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:'Rubik',sans-serif}body{background:var(--page);color:var(--ink);transition:.25s;color-scheme:light}body.dark-mode{--ink:#edf4f4;--muted:#96a5ab;--line:#303a3e;--surface:#202629;--page:#111719;--soft:#17302d;--shadow:0 32px 90px rgba(0,0,0,.38);color-scheme:dark}a{text-decoration:none}
        .shell{min-height:100vh;display:grid;grid-template-columns:minmax(410px,.82fr) minmax(0,1.18fr);overflow:hidden;background:var(--page)}.visual{position:relative;padding:42px 52px;background:linear-gradient(150deg,#102f34,#0b756e 72%,#0d8f84);color:#fff;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.visual:before,.visual:after{content:"";position:absolute;border-radius:50%;opacity:.14;animation:float 9s ease-in-out infinite}.visual:before{width:430px;height:430px;background:#fff;right:-190px;top:-160px}.visual:after{width:350px;height:350px;background:#6de7db;left:-155px;bottom:-120px;animation-delay:-4s}.visual-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(to bottom,transparent,black 18%,black 82%,transparent)}@@keyframes float{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(16px,-18px) scale(1.06)}}@@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}@@keyframes glow{0%,100%{box-shadow:0 0 0 0 rgba(15,159,146,.12)}50%{box-shadow:0 0 0 9px rgba(15,159,146,0)}}
        .brand,.hero,.foot{position:relative;z-index:2}.brand{display:flex;align-items:center;gap:12px;color:#fff;font-weight:700;font-size:20px}.brand-icon{width:43px;height:43px;border-radius:13px;display:grid;place-items:center;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.17);backdrop-filter:blur(10px)}.hero{max-width:530px;animation:rise .65s ease both}.mini{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;opacity:.72;margin-bottom:17px}.hero h1{font-size:clamp(38px,4.4vw,58px);line-height:1.06;letter-spacing:-1.3px;margin:0 0 18px}.hero p{font-size:16px;line-height:1.75;color:rgba(255,255,255,.82);margin:0}.security-points{margin-top:32px;display:grid;gap:12px}.security-point{display:flex;gap:13px;align-items:center;padding:13px 14px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.07);border-radius:14px;backdrop-filter:blur(9px)}.security-point i{width:30px;height:30px;display:grid;place-items:center;border-radius:9px;background:rgba(255,255,255,.11)}.security-point strong{display:block;font-size:12px;margin-bottom:2px}.security-point span{font-size:10px;color:rgba(255,255,255,.67)}.foot{font-size:11px;color:rgba(255,255,255,.6)}
        .form-side{min-width:0;min-height:100vh;padding:30px 40px;display:flex;flex-direction:column}.topbar{display:flex;justify-content:flex-end;gap:10px}.top-link,.theme{height:42px;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:12px;display:inline-flex;align-items:center;justify-content:center;transition:.2s}.top-link{padding:0 14px;gap:8px;font-size:12px;font-weight:600}.theme{width:42px;cursor:pointer}.top-link:hover,.theme:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}
        .card{width:100%;max-width:560px;margin:auto;animation:rise .6s .08s ease both}.chip{display:inline-flex;align-items:center;gap:8px;background:var(--soft);color:var(--accent);padding:8px 11px;border-radius:999px;font-size:11px;font-weight:700;margin-bottom:17px}.card h2{font-size:36px;line-height:1.1;letter-spacing:-.8px;margin:0 0 9px}.lead{font-size:14px;line-height:1.65;color:var(--muted);margin:0 0 20px}.email-pill{display:flex;align-items:center;gap:10px;width:max-content;max-width:100%;padding:9px 12px;border-radius:11px;background:var(--surface);border:1px solid var(--line);font-size:12px;color:var(--ink);margin-bottom:22px}.email-pill i{color:var(--accent)}.email-pill span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:380px}.notice{padding:12px 14px;border-radius:12px;margin-bottom:16px;font-size:12px;line-height:1.5}.notice.info{background:rgba(47,111,206,.09);border:1px solid rgba(47,111,206,.18);color:var(--info)}.notice.error{background:rgba(217,83,79,.09);border:1px solid rgba(217,83,79,.18);color:var(--danger)}
        .code-label{font-size:12px;font-weight:600;margin-bottom:10px;display:block}.otp{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-bottom:18px}.digit{width:100%;height:58px;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--ink);font-size:22px;font-weight:700;text-align:center;outline:none;transition:.2s;caret-color:var(--accent)}.digit:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(15,159,146,.1);transform:translateY(-1px);animation:glow 1.4s ease-in-out infinite}.digit.filled{border-color:rgba(15,159,146,.5);background:var(--soft)}
        .primary{width:100%;height:54px;border:0;border-radius:14px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-weight:700;cursor:pointer;box-shadow:0 12px 28px rgba(15,159,146,.25);transition:.22s}.primary:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(15,159,146,.3)}.secondary{width:100%;height:50px;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--ink);font-weight:600;cursor:pointer;transition:.2s;margin-top:10px}.secondary:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}.resend-note{text-align:center;color:var(--muted);font-size:10px;margin-top:9px}.bottom{text-align:center;margin-top:20px;font-size:12px;color:var(--muted)}.bottom a{color:var(--accent);font-weight:700}.footer{text-align:center;color:var(--muted);font-size:10px;padding-top:18px}
        @@media(max-width:1100px){.shell{grid-template-columns:1fr}.visual{display:none}.form-side{padding:24px}.card{max-width:600px}.topbar{margin-bottom:18px}}@@media(max-width:575px){.form-side{padding:18px 15px}.card h2{font-size:30px}.otp{gap:6px}.digit{height:52px;font-size:19px}.top-link span{display:none}}
    </style>
</head>
<body>
<div class="shell">
    <section class="visual">
        <div class="visual-grid"></div>
        <a href="/" class="brand"><span class="brand-icon"><i class="fas fa-prescription-bottle-alt"></i></span><span>PHARMACARE</span></a>
        <div class="hero">
            <div class="mini">One final security check</div>
            <h1>Verify your email. Keep your account protected.</h1>
            <p>Enter the six-digit code sent to your inbox. This confirms that the email belongs to you before PharmaCare activates access.</p>
            <div class="security-points">
                <div class="security-point"><i class="fas fa-clock"></i><div><strong>15-minute code lifetime</strong><span>Expired codes cannot be reused.</span></div></div>
                <div class="security-point"><i class="fas fa-shield-alt"></i><div><strong>Account protection</strong><span>Verification prevents unauthorized account activation.</span></div></div>
                <div class="security-point"><i class="fas fa-envelope-open-text"></i><div><strong>Check spam if needed</strong><span>The message should arrive within a few moments.</span></div></div>
            </div>
        </div>
        <div class="foot">Email verification · PharmaCare</div>
    </section>

    <section class="form-side">
        <div class="topbar">
            <a class="top-link" href="@Url.Action("Login","Account")"><i class="fas fa-arrow-left"></i><span>Back to sign in</span></a>
            <button id="theme-toggle" class="theme" type="button" aria-label="Toggle theme"><i class="fas fa-moon"></i></button>
        </div>

        <div class="card">
            <div class="chip"><i class="fas fa-user-check"></i> Email verification</div>
            <h2>Check your inbox</h2>
            <p class="lead">Enter the six-digit verification code we sent to:</p>
            <div class="email-pill"><i class="fas fa-envelope"></i><span>@email</span></div>

            @if (ViewBag.InfoMessage != null)
            {
                <div class="notice info"><i class="fas fa-info-circle"></i> @ViewBag.InfoMessage</div>
            }
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""].Errors.Count > 0)
            {
                <div class="notice error"><i class="fas fa-exclamation-circle"></i> @ViewData.ModelState[""].Errors[0].ErrorMessage</div>
            }

            <form id="verify-form" method="post" action="@Url.Action("VerifyEmail","Account")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Email" value="@email" />
                <input type="hidden" id="Code" name="Code" />
                <label class="code-label">Verification code</label>
                <div class="otp" aria-label="6 digit verification code">
                    @for (var i = 0; i < 6; i++)
                    {
                        <input class="digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="one-time-code" aria-label="Digit @(i + 1)" />
                    }
                </div>
                <button class="primary" type="submit">Verify email <i class="fas fa-check ml-1"></i></button>
            </form>

            <form method="post" action="@Url.Action("ResendVerificationCode","Account")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Email" value="@email" />
                <button class="secondary" id="resend-btn" type="submit"><i class="fas fa-redo-alt"></i> Send a new code</button>
            </form>
            <div class="resend-note" id="resend-note">You can request another code if the first one did not arrive.</div>
            <div class="bottom">Wrong account? <a href="@Url.Action("Login","Account")">Return to sign in</a></div>
        </div>
        <div class="footer">© @DateTime.Now.Year PharmaCare. Secure email verification.</div>
    </section>
</div>
<script>
(function(){
 const body=document.body,theme=document.getElementById('theme-toggle'),digits=[...document.querySelectorAll('.digit')],hidden=document.getElementById('Code'),form=document.getElementById('verify-form'),resend=document.getElementById('resend-btn'),note=document.getElementById('resend-note');
 const saved=localStorage.getItem('pharmacare-theme');if(saved==='dark'||(!saved&&matchMedia('(prefers-color-scheme: dark)').matches))body.classList.add('dark-mode');function syncTheme(){theme.innerHTML=body.classList.contains('dark-mode')?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>'}syncTheme();theme.addEventListener('click',()=>{body.classList.toggle('dark-mode');localStorage.setItem('pharmacare-theme',body.classList.contains('dark-mode')?'dark':'light');syncTheme()});
 function syncCode(){hidden.value=digits.map(x=>x.value).join('');digits.forEach(x=>x.classList.toggle('filled',!!x.value))}
 digits.forEach((input,i)=>{input.addEventListener('input',e=>{input.value=input.value.replace(/\D/g,'').slice(0,1);syncCode();if(input.value&&i<digits.length-1)digits[i+1].focus()});input.addEventListener('keydown',e=>{if(e.key==='Backspace'&&!input.value&&i>0)digits[i-1].focus();if(e.key==='ArrowLeft'&&i>0)digits[i-1].focus();if(e.key==='ArrowRight'&&i<digits.length-1)digits[i+1].focus()});input.addEventListener('paste',e=>{const v=(e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'').slice(0,6);if(v.length){e.preventDefault();v.split('').forEach((c,j)=>{if(digits[j])digits[j].value=c});syncCode();digits[Math.min(v.length,6)-1].focus()}})});
 form.addEventListener('submit',e=>{syncCode();if(hidden.value.length!==6){e.preventDefault();digits.find(x=>!x.value)?.focus()}});digits[0]?.focus();
 let sec=30;resend.disabled=true;const timer=setInterval(()=>{sec--;note.textContent=sec>0?`You can request another code in ${sec}s.`:'Didn’t receive it? You can send a new code now.';if(sec<=0){clearInterval(timer);resend.disabled=false}},1000);
})();
</script>
</body>
</html>
