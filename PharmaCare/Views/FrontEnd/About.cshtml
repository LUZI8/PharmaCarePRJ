@{
    ViewData["Title"] = "About PharmaCare";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

@section Styles {
<style>
    .about-page{background:#f6faf9;color:#142129;overflow:hidden}
    .about-shell{width:min(1180px,calc(100% - 40px));margin:0 auto}
    .about-hero{position:relative;min-height:560px;display:flex;align-items:center;background:linear-gradient(90deg,rgba(5,55,57,.94),rgba(8,91,91,.76)),url('/assets/Images/bg_3.jpg') center/cover no-repeat;color:#fff;isolation:isolate}
    .about-hero:before,.about-hero:after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.14);pointer-events:none}
    .about-hero:before{width:420px;height:420px;right:-120px;top:-130px}
    .about-hero:after{width:250px;height:250px;left:-80px;bottom:-110px}
    .about-hero-content{position:relative;z-index:2;max-width:760px;padding:88px 0}
    .about-eyebrow{display:inline-flex;align-items:center;gap:9px;padding:9px 14px;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);font-size:12px;font-weight:800;letter-spacing:.75px;text-transform:uppercase;margin-bottom:22px}
    .about-hero h1{font-size:clamp(42px,6vw,76px);line-height:.98;letter-spacing:-2.4px;font-weight:850;max-width:760px;margin:0 0 24px}
    .about-hero p{font-size:19px;line-height:1.8;color:rgba(255,255,255,.86);max-width:670px;margin:0 0 32px}
    .about-actions{display:flex;gap:12px;flex-wrap:wrap}
    .about-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:50px;padding:0 20px;border-radius:13px;font-weight:800;text-decoration:none;transition:.2s ease}
    .about-btn.primary{background:#18b7a8;color:#fff;box-shadow:0 12px 28px rgba(24,183,168,.25)}
    .about-btn.primary:hover{transform:translateY(-2px);background:#12a697;color:#fff}
    .about-btn.ghost{border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.08);color:#fff}
    .about-btn.ghost:hover{background:rgba(255,255,255,.14);color:#fff}
    .about-stats{position:relative;z-index:4;margin-top:-52px}
    .about-stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
    .about-stat{background:#fff;border:1px solid #e3ecea;border-radius:18px;padding:22px 24px;box-shadow:0 18px 45px rgba(15,74,72,.08)}
    .about-stat strong{display:block;font-size:28px;line-height:1;color:#0c9487;margin-bottom:8px}
    .about-stat span{font-size:13px;color:#6d7b83;font-weight:650}
    .about-section{padding:92px 0}
    .about-section.soft{background:#eef7f5}
    .about-story-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
    .about-image-card{position:relative;border-radius:26px;overflow:hidden;min-height:520px;box-shadow:0 24px 60px rgba(25,63,62,.13)}
    .about-image-card img{width:100%;height:100%;min-height:520px;object-fit:cover;display:block;transition:transform .65s ease}
    .about-image-card:hover img{transform:scale(1.035)}
    .about-image-badge{position:absolute;left:22px;bottom:22px;background:rgba(8,58,59,.9);backdrop-filter:blur(10px);color:#fff;padding:16px 18px;border-radius:16px;max-width:270px}
    .about-image-badge strong{display:block;font-size:17px;margin-bottom:4px}.about-image-badge span{font-size:12px;color:#c6e7e2}
    .section-kicker{font-size:12px;text-transform:uppercase;letter-spacing:1.2px;font-weight:850;color:#0c9487;margin-bottom:12px}
    .section-title{font-size:clamp(32px,4vw,48px);line-height:1.07;letter-spacing:-1.4px;font-weight:850;margin:0 0 18px;color:#122128}
    .section-copy{font-size:17px;line-height:1.85;color:#5d6c74;margin-bottom:18px}
    .story-points{display:grid;gap:12px;margin:28px 0 0;padding:0;list-style:none}
    .story-point{display:flex;align-items:flex-start;gap:12px;padding:14px 15px;border-radius:14px;background:#fff;border:1px solid #e4eceb}
    .story-icon,.value-icon,.service-icon{width:40px;height:40px;flex:0 0 40px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:#e8f8f5;color:#0c9487}
    .story-point strong{display:block;margin-bottom:3px;font-size:15px}.story-point span{display:block;font-size:13px;color:#6f7d84;line-height:1.55}
    .values-head{text-align:center;max-width:720px;margin:0 auto 38px}.values-head .section-copy{margin-bottom:0}
    .values-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .value-card{background:#fff;border:1px solid #dfeae7;border-radius:20px;padding:26px;box-shadow:0 12px 35px rgba(18,71,68,.055);transition:.25s ease}
    .value-card:hover{transform:translateY(-5px);box-shadow:0 20px 42px rgba(18,71,68,.09)}
    .value-icon{width:48px;height:48px;border-radius:14px;margin-bottom:18px}
    .value-card h3{font-size:19px;font-weight:800;margin:0 0 9px}.value-card p{font-size:14px;line-height:1.7;color:#6a7880;margin:0}
    .care-banner{display:grid;grid-template-columns:1.05fr .95fr;background:#073b3c;border-radius:28px;overflow:hidden;box-shadow:0 22px 58px rgba(7,59,60,.16)}
    .care-copy{padding:52px;color:#fff}.care-copy .section-kicker{color:#51d7c8}.care-copy .section-title{color:#fff;margin-bottom:16px}.care-copy .section-copy{color:#c6dcda;margin-bottom:25px}.care-list{display:grid;gap:12px}.care-line{display:flex;align-items:center;gap:10px;font-size:14px;color:#e7f2f0}.care-line i{color:#4fd6c6}
    .care-visual{min-height:420px;background:linear-gradient(rgba(3,40,40,.1),rgba(3,40,40,.22)),url('/assets/images/pharmacistconsult.png') center/cover no-repeat}
    .team-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:30px}.team-head .section-title{margin-bottom:0}.team-note{max-width:430px;font-size:14px;line-height:1.7;color:#6f7d84}
    .team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .team-card{background:#fff;border:1px solid #dfe9e7;border-radius:22px;padding:26px;text-align:left;transition:.25s ease}
    .team-card:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgba(20,63,61,.08)}
    .team-avatar{width:74px;height:74px;border-radius:20px;background:#edf4f3;overflow:hidden;margin-bottom:18px}.team-avatar img{width:100%;height:100%;object-fit:cover;display:block}
    .team-role{display:inline-block;font-size:11px;letter-spacing:.7px;text-transform:uppercase;font-weight:850;color:#0c9487;margin-bottom:8px}.team-card h3{font-size:20px;font-weight:800;margin:0 0 8px}.team-card p{font-size:14px;color:#6b7880;line-height:1.65;margin:0}
    .about-cta{padding:0 0 92px}.about-cta-card{display:flex;justify-content:space-between;align-items:center;gap:28px;background:linear-gradient(135deg,#11988c,#0c756f);color:#fff;border-radius:24px;padding:36px 40px;box-shadow:0 20px 50px rgba(13,117,111,.2)}
    .about-cta-card h3{font-size:28px;font-weight:850;margin:0 0 8px}.about-cta-card p{color:#d6f0ec;margin:0;max-width:650px}.about-cta-card .about-btn{background:#fff;color:#0b7770;white-space:nowrap}.about-cta-card .about-btn:hover{transform:translateY(-2px);color:#075f59}
    .dark-mode .about-page{background:#151b1d;color:#f3f7f6}.dark-mode .about-stat,.dark-mode .value-card,.dark-mode .team-card,.dark-mode .story-point{background:#20282a;border-color:#303b3d}.dark-mode .section-title,.dark-mode .team-card h3,.dark-mode .value-card h3,.dark-mode .story-point strong{color:#f5f7f7}.dark-mode .section-copy,.dark-mode .team-note,.dark-mode .team-card p,.dark-mode .value-card p,.dark-mode .story-point span,.dark-mode .about-stat span{color:#aeb9bc}.dark-mode .about-section.soft{background:#192224}.dark-mode .team-avatar{background:#2a3436}
    @@keyframes aboutFadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
    .about-reveal{animation:aboutFadeUp .65s ease both}
    .about-reveal.delay-1{animation-delay:.08s}.about-reveal.delay-2{animation-delay:.16s}.about-reveal.delay-3{animation-delay:.24s}
    @@media(max-width:991px){.about-stats-grid{grid-template-columns:repeat(2,1fr)}.about-story-grid,.care-banner{grid-template-columns:1fr}.care-visual{min-height:330px}.values-grid,.team-grid{grid-template-columns:1fr 1fr}.team-head{align-items:flex-start;flex-direction:column}.about-hero{min-height:500px}}
    @@media(max-width:767px){.about-shell{width:min(100% - 28px,1180px)}.about-hero{min-height:auto}.about-hero-content{padding:68px 0 82px}.about-hero h1{font-size:44px;letter-spacing:-1.4px}.about-hero p{font-size:16px}.about-actions{display:grid;grid-template-columns:1fr}.about-btn{width:100%}.about-stats{margin-top:-36px}.about-stats-grid{grid-template-columns:1fr 1fr;gap:10px}.about-stat{padding:18px}.about-stat strong{font-size:24px}.about-section{padding:68px 0}.about-story-grid{gap:34px}.about-image-card,.about-image-card img{min-height:360px}.values-grid,.team-grid{grid-template-columns:1fr}.care-copy{padding:34px 26px}.care-visual{min-height:270px}.about-cta{padding-bottom:68px}.about-cta-card{padding:28px 24px;flex-direction:column;align-items:flex-start}.about-cta-card .about-btn{width:100%}}
    @@media(max-width:480px){.about-stats-grid{grid-template-columns:1fr}.about-hero h1{font-size:38px}.about-image-card,.about-image-card img{min-height:300px}.section-title{font-size:32px}.about-image-badge{left:14px;right:14px;bottom:14px;max-width:none}}
</style>
}

<div class="about-page">
    <section class="about-hero">
        <div class="about-shell">
            <div class="about-hero-content about-reveal">
                <div class="about-eyebrow"><i class="fas fa-shield-alt"></i> Pharmacy care, built around people</div>
                <h1>Care you can trust, from shelf to doorstep.</h1>
                <p>PharmaCare combines dependable pharmacy service, carefully managed inventory and a simpler digital experience for everyday healthcare needs.</p>
                <div class="about-actions">
                    <a href="@Url.Action("Shop", "FrontEnd")" class="about-btn primary"><i class="fas fa-shopping-bag"></i> Explore our store</a>
                    <a href="@Url.Action("Contact", "FrontEnd")" class="about-btn ghost"><i class="far fa-comments"></i> Talk to our team</a>
                </div>
            </div>
        </div>
    </section>

    <div class="about-stats">
        <div class="about-shell">
            <div class="about-stats-grid">
                <div class="about-stat about-reveal"><strong>2010</strong><span>Serving our community since</span></div>
                <div class="about-stat about-reveal delay-1"><strong>3-day</strong><span>Prescription reservation window</span></div>
                <div class="about-stat about-reveal delay-2"><strong>Live</strong><span>Stock and expiry visibility</span></div>
                <div class="about-stat about-reveal delay-3"><strong>Secure</strong><span>Account and order experience</span></div>
            </div>
        </div>
    </div>

    <section class="about-section">
        <div class="about-shell">
            <div class="about-story-grid">
                <div class="about-image-card about-reveal">
                    <img src="~/assets/images/Pharmapic.jpg" alt="Inside PharmaCare pharmacy" />
                    <div class="about-image-badge"><strong>Local roots, modern service</strong><span>Built in Amman and designed around practical, reliable pharmacy care.</span></div>
                </div>
                <div class="about-reveal delay-1">
                    <div class="section-kicker">Our story</div>
                    <h2 class="section-title">From neighborhood pharmacy to connected care.</h2>
                    <p class="section-copy">PharmaCare began with a simple goal: make dependable pharmacy service feel personal, clear and easy to access. As our community grew, we brought that same standard online.</p>
                    <p class="section-copy">Today, customers can browse products, track availability, reserve prescription medicines and manage orders from one secure place—without losing the human support behind the pharmacy.</p>
                    <ul class="story-points">
                        <li class="story-point"><span class="story-icon"><i class="fas fa-box-open"></i></span><span><strong>Carefully managed inventory</strong><span>Stock and expiry are managed directly by the pharmacy.</span></span></li>
                        <li class="story-point"><span class="story-icon"><i class="fas fa-prescription-bottle-alt"></i></span><span><strong>Prescription-aware service</strong><span>Prescription medicines follow a clear reservation and pickup flow.</span></span></li>
                        <li class="story-point"><span class="story-icon"><i class="fas fa-user-shield"></i></span><span><strong>Secure customer access</strong><span>Your account, orders and reservation history stay together.</span></span></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="about-section soft">
        <div class="about-shell">
            <div class="values-head">
                <div class="section-kicker">Why PharmaCare</div>
                <h2 class="section-title">A pharmacy experience designed to remove friction.</h2>
                <p class="section-copy">Useful information, dependable fulfillment and clear pharmacy controls—without turning healthcare shopping into a complicated process.</p>
            </div>
            <div class="values-grid">
                <article class="value-card"><div class="value-icon"><i class="fas fa-check-circle"></i></div><h3>Trusted inventory</h3><p>Customers can clearly see stock status and product availability before ordering.</p></article>
                <article class="value-card"><div class="value-icon"><i class="fas fa-truck"></i></div><h3>Clear fulfillment</h3><p>Orders move through visible statuses so customers can follow what happens next.</p></article>
                <article class="value-card"><div class="value-icon"><i class="fas fa-prescription"></i></div><h3>Prescription controls</h3><p>Prescription products are separated from normal checkout and handled through reservation.</p></article>
                <article class="value-card"><div class="value-icon"><i class="fas fa-lock"></i></div><h3>Secure accounts</h3><p>Customer profiles, password management and order history stay inside a dedicated account area.</p></article>
                <article class="value-card"><div class="value-icon"><i class="fas fa-headset"></i></div><h3>Human support</h3><p>Customers can reach the pharmacy team when they need help with an order or product.</p></article>
                <article class="value-card"><div class="value-icon"><i class="fas fa-mobile-alt"></i></div><h3>Built for every screen</h3><p>The storefront is designed to stay usable and clear on desktop, tablet and mobile.</p></article>
            </div>
        </div>
    </section>

    <section class="about-section">
        <div class="about-shell">
            <div class="care-banner">
                <div class="care-copy">
                    <div class="section-kicker">Professional care</div>
                    <h2 class="section-title">Technology supports the pharmacy. It never replaces it.</h2>
                    <p class="section-copy">Our digital tools are here to make ordering, reservations and account management easier. Medication guidance and prescription verification still belong with qualified pharmacy professionals.</p>
                    <div class="care-list">
                        <div class="care-line"><i class="fas fa-check-circle"></i> Clear prescription pickup requirements</div>
                        <div class="care-line"><i class="fas fa-check-circle"></i> Product availability and expiry controls</div>
                        <div class="care-line"><i class="fas fa-check-circle"></i> Customer support when you need it</div>
                    </div>
                </div>
                <div class="care-visual" role="img" aria-label="Professional pharmacy consultation"></div>
            </div>
        </div>
    </section>

    <section class="about-section soft">
        <div class="about-shell">
            <div class="team-head">
                <div><div class="section-kicker">People behind the service</div><h2 class="section-title">Meet the team.</h2></div>
                <div class="team-note">A pharmacy storefront works best when the technology, inventory and customer service all support the same goal: dependable care.</div>
            </div>
            <div class="team-grid">
                <article class="team-card"><div class="team-avatar"><img src="~/assets/images/Noprofile.webp" alt="Dr. Ali Mohammad" /></div><span class="team-role">Chief Pharmacist</span><h3>Dr. Ali Mohammad</h3><p>Leads pharmacy operations and clinical standards with a focus on safe, practical patient care.</p></article>
                <article class="team-card"><div class="team-avatar"><img src="~/assets/images/Noprofile.webp" alt="Ahmad Suleiman" /></div><span class="team-role">Senior Pharmacy Assistant</span><h3>Ahmad Suleiman</h3><p>Supports customers with product guidance, order preparation and day-to-day pharmacy service.</p></article>
                <article class="team-card"><div class="team-avatar"><img src="~/assets/images/Noprofile.webp" alt="Omar Faris" /></div><span class="team-role">IT Systems Manager</span><h3>Omar Faris</h3><p>Maintains the digital storefront and the systems that connect customers with pharmacy operations.</p></article>
            </div>
        </div>
    </section>

    <section class="about-cta">
        <div class="about-shell">
            <div class="about-cta-card">
                <div><h3>Ready to find what you need?</h3><p>Browse the store or contact PharmaCare if you need help before ordering or reserving a prescription medicine.</p></div>
                <a href="@Url.Action("Shop", "FrontEnd")" class="about-btn">Browse products <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </section>
</div>