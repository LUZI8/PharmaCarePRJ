@model PharmaCare.Models.User
@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
<style>
.edit-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:28px 0 18px}.edit-head h2{font-weight:750;margin:0}.edit-head p{margin:5px 0 0;color:#6c757d}.edit-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.edit-card .card-header{background:transparent;padding:17px 18px}.edit-card .card-body{padding:20px}.section-title{font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:750;color:#7a838b;margin-bottom:13px}.form-label{font-size:12px;font-weight:700}.form-control{border-radius:8px}.status-tile{border:1px solid #e8ecef;border-radius:10px;padding:14px}.status-row{display:flex;justify-content:space-between;align-items:center;gap:12px}.subtle{font-size:12px;color:#7a838b}.profile-side{display:grid;gap:12px}.side-box{border:1px solid #e8ecef;border-radius:10px;padding:14px}.dark-mode .edit-card,.dark-mode .status-tile,.dark-mode .side-box{background:#1f1f1f}.dark-mode .status-tile,.dark-mode .side-box{border-color:#383838}.dark-mode .form-control{background:#262626;color:#eee;border-color:#444}@@media(max-width:767px){.edit-head{align-items:flex-start;flex-direction:column}}
</style>
}

<div class="edit-head">
    <div><h2>Edit User</h2><p>Update profile information, role and account access.</p></div>
    <a href="@Url.Action("Details","Users",new{id=Model.UserId})" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> User Details</a>
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card edit-card">
            <div class="card-header"><strong>@Model.FirstName @Model.LastName</strong><div class="subtle">User ID #@Model.UserId</div></div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="UserId" />
                    <div class="section-title">Personal Information</div>
                    <div class="row">
                        <div class="col-md-6"><div class="form-group"><label asp-for="FirstName" class="form-label">First Name</label><input asp-for="FirstName" class="form-control"/><span asp-validation-for="FirstName" class="text-danger small"></span></div></div>
                        <div class="col-md-6"><div class="form-group"><label asp-for="LastName" class="form-label">Last Name</label><input asp-for="LastName" class="form-control"/><span asp-validation-for="LastName" class="text-danger small"></span></div></div>
                    </div>
                    <div class="form-group"><label asp-for="Email" class="form-label">Email Address</label><input asp-for="Email" class="form-control" type="email"/><span asp-validation-for="Email" class="text-danger small"></span></div>
                    <div class="form-group"><label asp-for="PhoneNumber" class="form-label">Phone Number</label><input asp-for="PhoneNumber" class="form-control"/><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div>

                    <hr class="my-4"/><div class="section-title">Address & Location</div>
                    <div class="row">
                        <div class="col-md-7"><div class="form-group"><label asp-for="Address" class="form-label">Address</label><input asp-for="Address" class="form-control"/><span asp-validation-for="Address" class="text-danger small"></span></div></div>
                        <div class="col-md-5"><div class="form-group"><label asp-for="City" class="form-label">City</label><input asp-for="City" class="form-control"/><span asp-validation-for="City" class="text-danger small"></span></div></div>
                    </div>

                    <hr class="my-4"/><div class="section-title">Permissions & Access</div>
                    <div class="form-group"><label asp-for="Role" class="form-label">Role</label><select asp-for="Role" class="form-control"><option value="Customer">Customer</option><option value="Pharmacist">Pharmacist</option><option value="Admin">Admin</option></select><small class="form-text text-muted">Changing the role changes what this account can access.</small><span asp-validation-for="Role" class="text-danger small"></span></div>
                    <div class="status-tile mt-3"><div class="status-row"><div><div class="font-weight-bold">Account Active</div><div class="subtle">Inactive users cannot use their account normally.</div></div><div class="custom-control custom-switch"><input asp-for="IsActive" class="custom-control-input" id="activeSwitch"/><label class="custom-control-label" for="activeSwitch"></label></div></div></div>
                    <input asp-for="DateCreated" type="hidden" />

                    <div class="d-flex flex-wrap mt-4" style="gap:8px"><button type="submit" class="btn btn-success"><i class="fas fa-save mr-1"></i> Save Changes</button><a href="@Url.Action("Details","Users",new{id=Model.UserId})" class="btn btn-outline-secondary">Cancel</a></div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-4">
        <div class="card edit-card"><div class="card-header"><strong>Account Summary</strong></div><div class="card-body profile-side">
            <div class="side-box"><div class="subtle">Current Role</div><div class="font-weight-bold mt-1">@Model.Role</div></div>
            <div class="side-box"><div class="subtle">Account Status</div><div class="mt-1"><span class="badge badge-@(Model.IsActive?"success":"secondary")">@(Model.IsActive?"Active":"Inactive")</span></div></div>
            <div class="side-box"><div class="subtle">Account Created</div><div class="font-weight-bold mt-1">@Model.DateCreated.ToString("MMM dd, yyyy")</div></div>
            <div class="alert alert-info mb-0"><i class="fas fa-info-circle mr-1"></i><small>Use the dedicated Reset Password page for password changes. Account creation date is kept read-only.</small></div>
        </div></div>
    </div>
</div>

@section Scripts {@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }}
