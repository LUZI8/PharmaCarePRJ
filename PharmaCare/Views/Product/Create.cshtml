@model PharmaCare.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Create Product";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
}
@section Styles{
<style>
.form-head{display:flex;justify-content:space-between;align-items:flex-end;margin:28px 0 18px}.form-head h2{font-weight:700;margin:0}.form-head p{color:#6c757d;margin:5px 0 0}.form-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06)}.form-card .card-header{background:transparent;padding:16px 20px;font-weight:700}.form-card .card-body{padding:22px}.section-title{font-size:12px;text-transform:uppercase;letter-spacing:.6px;color:#6c757d;font-weight:700;margin-bottom:15px}.form-control{border-radius:8px}.switch-row{display:flex;justify-content:space-between;align-items:center;padding:14px;border:1px solid #e7e9ec;border-radius:10px;margin-bottom:12px}.switch-row .meta{font-size:12px;color:#6c757d}.switch{position:relative;display:inline-block;width:44px;height:24px}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#ccc;border-radius:30px;cursor:pointer;transition:.2s}.slider:before{content:"";position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:#0d9488}.switch input:checked+.slider:before{transform:translateX(20px)}.image-drop{border:2px dashed #d6dbe0;border-radius:12px;padding:22px;text-align:center}.image-preview{width:120px;height:120px;object-fit:contain;border-radius:10px;border:1px solid #e9ecef;display:none;margin:0 auto 14px;background:#fff}.help-card{border:0;border-radius:12px;background:#f8f9fa}.help-card li{margin-bottom:8px}.required:after{content:" *";color:#dc3545}.rx-note{display:none}.rx-note.show{display:block}.dark-mode .form-card,.dark-mode .help-card{background:#1f1f1f}.dark-mode .switch-row,.dark-mode .image-drop{border-color:#3b3b3b}.dark-mode .form-control{background:#262626;color:#eee;border-color:#444}.dark-mode .help-card{color:#ddd}
</style>}
<div class="form-head"><div><h2>Create Product</h2><p>Add a medicine or pharmacy item to inventory.</p></div><a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> Back to Inventory</a></div>
<form asp-action="Create" method="post" enctype="multipart/form-data" id="productForm">
@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row"><div class="col-lg-8"><div class="card form-card mb-4"><div class="card-header">Product Information</div><div class="card-body"><div class="section-title">Basic information</div>
<div class="form-group"><label asp-for="ProductName" class="required">Product Name</label><input asp-for="ProductName" class="form-control" placeholder="e.g. Paracetamol 500mg Tablets"/><span asp-validation-for="ProductName" class="text-danger small"></span></div>
<div class="form-group"><label asp-for="Description">Description</label><textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the product, dosage form, use and relevant information."></textarea></div>
<div class="form-row"><div class="form-group col-md-6"><label asp-for="CategoryID" class="required">Category</label><select asp-for="CategoryID" asp-items="Model.ListOfCategories" class="form-control"><option value="">Select category</option></select><span asp-validation-for="CategoryID" class="text-danger small"></span></div><div class="form-group col-md-6"><label asp-for="ExpiryDate" class="required">Expiry Date</label><input asp-for="ExpiryDate" type="date" class="form-control"/><span asp-validation-for="ExpiryDate" class="text-danger small"></span><small class="form-text text-muted"><i class="fas fa-shield-alt text-warning mr-1"></i>Expired products cannot be sold.</small></div></div><hr/><div class="section-title">Pricing & stock</div>
<div class="form-row"><div class="form-group col-md-6"><label asp-for="Price" class="required">Unit Price</label><div class="input-group"><div class="input-group-prepend"><span class="input-group-text">$</span></div><input asp-for="Price" type="number" min="0.01" step="0.01" class="form-control"/></div><span asp-validation-for="Price" class="text-danger small"></span></div><div class="form-group col-md-6"><label asp-for="Stock" class="required">Starting Stock</label><div class="input-group"><input asp-for="Stock" type="number" min="0" class="form-control"/><div class="input-group-append"><span class="input-group-text">units</span></div></div><span asp-validation-for="Stock" class="text-danger small"></span></div></div></div></div>
<div class="card form-card mb-4"><div class="card-header">Pharmacy Controls</div><div class="card-body"><div class="switch-row"><div><strong>Active Product</strong><div class="meta">Visible and available to customers when stock and expiry permit.</div></div><label class="switch"><input type="checkbox" name="IsActive" value="true" checked/><span class="slider"></span></label></div><div class="switch-row"><div><strong>Requires Prescription</strong><div class="meta">Use for prescription-only medicine.</div></div><label class="switch"><input type="checkbox" name="RequiresPrescription" value="true" id="rxToggle"/><span class="slider"></span></label></div><div class="form-group rx-note" id="rxNote"><label asp-for="PrescriptionNote">Prescription Instructions</label><textarea asp-for="PrescriptionNote" class="form-control" rows="3" placeholder="Optional instructions shown to customers."></textarea><span asp-validation-for="PrescriptionNote" class="text-danger small"></span></div></div></div></div>
<div class="col-lg-4"><div class="card form-card mb-4"><div class="card-header">Product Image</div><div class="card-body"><div class="image-drop"><img id="preview" class="image-preview" alt="Product preview"/><i id="uploadIcon" class="fas fa-cloud-upload-alt fa-2x text-muted mb-2"></i><div class="font-weight-bold mb-1">Upload product image</div><div class="small text-muted mb-3">JPG or PNG. Square image recommended.</div><input asp-for="File" id="imageInput" type="file" accept="image/png,image/jpeg" class="form-control-file"/></div></div></div><div class="card help-card mb-4"><div class="card-body"><strong><i class="fas fa-lightbulb text-warning mr-2"></i>Product checklist</strong><ul class="small mt-3 pl-3"><li>Use a clear medicine name and strength.</li><li>Confirm stock quantity before publishing.</li><li>Verify expiry date from manufacturer packaging.</li><li>Enable prescription control where required.</li><li>Use a clear front-facing product image.</li></ul></div></div><button type="submit" class="btn btn-success btn-block"><i class="fas fa-save mr-1"></i> Create Product</button><a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary btn-block">Cancel</a></div></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(function(){const rx=document.getElementById('rxToggle'),note=document.getElementById('rxNote'),input=document.getElementById('imageInput'),preview=document.getElementById('preview'),icon=document.getElementById('uploadIcon');function syncRx(){note.classList.toggle('show',rx.checked);}rx.addEventListener('change',syncRx);syncRx();input.addEventListener('change',function(){const f=this.files&&this.files[0];if(!f)return;const reader=new FileReader();reader.onload=e=>{preview.src=e.target.result;preview.style.display='block';icon.style.display='none';};reader.readAsDataURL(f);});})();</script>}
