@model PharmaCare.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
    var lowStock = Model.Stock > 0 && Model.Stock <= Model.ReorderLevel;
    var statusClass = !Model.IsActive ? "secondary" : Model.Stock <= 0 ? "danger" : lowStock ? "warning" : "success";
    var statusText = !Model.IsActive ? "Inactive" : Model.Stock <= 0 ? "Out of Stock" : lowStock ? "Low Stock" : "Active";
}
@section Styles{
<style>
.product-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:28px 0 18px}.product-head h2{font-weight:750;margin:0}.product-head p{color:#6c757d;margin:5px 0 0}.details-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.details-card .card-header{background:transparent;padding:16px 20px}.details-card .card-body{padding:20px}.hero{display:grid;grid-template-columns:180px 1fr;gap:24px;align-items:start}.product-image{width:180px;height:180px;object-fit:contain;border:1px solid #e8ecef;border-radius:12px;background:#fff}.meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.meta-box{border:1px solid #e8ecef;border-radius:10px;padding:13px}.meta-label{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:#78828b;font-weight:750}.meta-value{font-weight:650;margin-top:5px;overflow-wrap:anywhere}.identifier{font-family:monospace}.description-box{background:#f8f9fa;border-radius:10px;padding:16px;white-space:pre-wrap;line-height:1.6}.stock-meter{height:10px;border-radius:20px;background:#edf0f2;overflow:hidden}.stock-fill{height:100%;border-radius:20px}.side-stat{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid #edf0f2}.side-stat:last-child{border-bottom:0}.dark-mode .details-card,.dark-mode .meta-box,.dark-mode .description-box{background:#1f1f1f}.dark-mode .meta-box,.dark-mode .product-image,.dark-mode .side-stat{border-color:#383838}.dark-mode .description-box{background:#252525}.dark-mode .stock-meter{background:#383838}
@@media(max-width:767px){.product-head{align-items:flex-start;flex-direction:column}.hero{grid-template-columns:1fr}.product-image{width:150px;height:150px}.meta-grid{grid-template-columns:1fr}}
</style>}
<div class="product-head"><div><h2>@Model.ProductName</h2><p>Inventory, identification and pharmacy details.</p></div><div class="d-flex" style="gap:7px"><a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> Inventory</a><a href="@Url.Action("Edit","Product",new{id=Model.ProductId})" class="btn btn-primary btn-sm"><i class="fas fa-edit mr-1"></i> Edit Product</a></div></div>
<div class="row"><div class="col-lg-8 mb-4"><div class="card details-card"><div class="card-header d-flex justify-content-between align-items-center"><strong>Product Overview</strong><div><span class="badge badge-@statusClass">@statusText</span>@if(Model.RequiresPrescription){<span class="badge badge-info ml-1">Prescription</span>}<span class="badge @Model.ExpiryBadgeClass ml-1">@Model.ExpiryDisplayText</span></div></div><div class="card-body"><div class="hero"><img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl)?"/images/product_01.png":Model.ImageUrl)" class="product-image" alt="@Model.ProductName"/><div class="meta-grid"><div class="meta-box"><div class="meta-label">Manufacturer</div><div class="meta-value">@(string.IsNullOrWhiteSpace(Model.Manufacturer)?"Not set":Model.Manufacturer)</div></div><div class="meta-box"><div class="meta-label">Category</div><div class="meta-value">@(Model.Category?.CategoryName ?? "Uncategorized")</div></div><div class="meta-box"><div class="meta-label">SKU</div><div class="meta-value identifier">@(string.IsNullOrWhiteSpace(Model.SKU)?"Not set":Model.SKU)</div></div><div class="meta-box"><div class="meta-label">Barcode</div><div class="meta-value identifier"><i class="fas fa-barcode mr-1"></i>@(string.IsNullOrWhiteSpace(Model.Barcode)?"Not set":Model.Barcode)</div></div><div class="meta-box"><div class="meta-label">Unit Price</div><div class="meta-value">$@Model.Price.ToString("0.00")</div></div><div class="meta-box"><div class="meta-label">Product ID</div><div class="meta-value">#@Model.ProductId</div></div></div></div><div class="mt-4"><div class="meta-label mb-2">Description</div><div class="description-box">@(string.IsNullOrWhiteSpace(Model.Description)?"No description available.":Model.Description)</div></div>@if(Model.RequiresPrescription && !string.IsNullOrWhiteSpace(Model.PrescriptionNote)){<div class="mt-4 alert alert-info mb-0"><strong><i class="fas fa-prescription mr-1"></i> Prescription instructions</strong><div class="mt-1">@Model.PrescriptionNote</div></div>}</div></div></div>
<div class="col-lg-4 mb-4"><div class="card details-card mb-3"><div class="card-header"><strong>Inventory Status</strong></div><div class="card-body"><div class="side-stat"><span>Current stock</span><strong>@Model.Stock units</strong></div><div class="side-stat"><span>Low-stock threshold</span><strong>@Model.ReorderLevel units</strong></div><div class="mt-3 stock-meter"><div class="stock-fill bg-@statusClass" style="width:@(Math.Min(100, Model.ReorderLevel <= 0 ? 100 : (int)Math.Round((double)Model.Stock / Math.Max(Model.ReorderLevel * 2,1) * 100)))%"></div></div>@if(Model.Stock<=0){<div class="alert alert-danger mt-3 mb-0 py-2 small"><i class="fas fa-exclamation-triangle mr-1"></i>Replenishment required.</div>}else if(lowStock){<div class="alert alert-warning mt-3 mb-0 py-2 small"><i class="fas fa-box-open mr-1"></i>Stock is at or below its reorder level.</div>}</div></div><div class="card details-card"><div class="card-header"><strong>Safety & Dates</strong></div><div class="card-body"><div class="side-stat"><span>Expiry</span><strong>@Model.ExpiryDate.ToString("MMM dd, yyyy")</strong></div><div class="side-stat"><span>Created</span><strong>@Model.CreatedAt.ToString("MMM dd, yyyy")</strong></div><div class="side-stat"><span>Updated</span><strong>@(Model.UpdatedAt?.ToString("MMM dd, yyyy") ?? "Never")</strong></div>@if(Model.IsExpired){<div class="alert alert-danger mt-3 mb-0 py-2 small"><i class="fas fa-ban mr-1"></i>Expired product: remove from sale.</div>}else if(Model.ExpiryStatus!="good"){<div class="alert alert-warning mt-3 mb-0 py-2 small"><i class="fas fa-clock mr-1"></i>@Model.ExpiryDisplayText.</div>}</div></div></div></div>
