@model MarketplacePrescriptionCompleteViewModel
@{
    ViewData["Title"] = "Prescription Request Received";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--r:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a}.done{background:#f7fbfa;color:var(--ink);min-height:100vh;padding:60px 0 80px}.dark-mode .done{background:#151a1d}.shell{max-width:760px;margin:auto;text-align:center}.icon{width:70px;height:70px;border-radius:22px;background:#e5f8ef;color:#1d9857;display:grid;place-items:center;font-size:29px;margin:0 auto 16px}.shell h1{font-size:32px;margin:0 0 7px}.shell>p{font-size:11px;color:var(--muted)}.card{margin-top:26px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px}.rowx{display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-top:1px solid var(--line);font-size:11px}.rowx:first-child{border-top:0}.rowx span{color:var(--muted)}.warning{margin-top:16px;padding:14px;border-radius:12px;background:#fff5d9;color:#805b08;font-size:10px;line-height:1.6}.actions{display:flex;gap:10px;justify-content:center;margin-top:22px}.actions a{height:44px;padding:0 15px;border-radius:11px;background:var(--r);color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700}.actions .alt{background:transparent;border:1px solid var(--line);color:var(--ink)}
@@media(max-width:575px){.done{padding-top:38px}.actions{flex-direction:column}.actions a{width:100%}.rowx{flex-direction:column;gap:4px}}
</style>
}
<div class="done"><div class="container"><div class="shell"><div class="icon"><i class="fas fa-check"></i></div><h1>Request sent to the pharmacy.</h1><p>@Model.Request.Pharmacy.Name will review your prescription request before fulfillment.</p><div class="card"><div class="rowx"><span>Request number</span><strong>@Model.Request.RequestNumber</strong></div><div class="rowx"><span>Medicine</span><strong>@Model.Request.Product.ProductName</strong></div><div class="rowx"><span>Quantity</span><strong>@Model.Request.Quantity</strong></div><div class="rowx"><span>Status</span><strong>@Model.Request.Status</strong></div><div class="rowx"><span>Expires</span><strong>@Model.Request.ExpiresAt.ToString("MMM d, yyyy HH:mm")</strong></div><div class="warning"><i class="fas fa-exclamation-triangle"></i> Bring a valid prescription. The pharmacy must verify it before pickup, payment or medicine fulfillment.</div></div><div class="actions"><a href="/MarketplacePrescription/MyRequests">View my requests</a><a class="alt" href="/Marketplace">Continue browsing</a></div></div></div></div>