@model MarketplaceBasketViewModel
@{
    ViewData["Title"] = "Marketplace Basket";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--b:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a;--soft:#183531}.basket-page{background:#f7fbfa;color:var(--ink);min-height:100vh;padding:42px 0 70px}.dark-mode .basket-page{background:#151a1d}.basket-grid{display:grid;grid-template-columns:1.5fr .7fr;gap:22px}.basket-card,.summary{background:var(--card);border:1px solid var(--line);border-radius:20px}.basket-card{padding:20px}.summary{padding:22px;height:max-content;position:sticky;top:94px}.basket-head{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:12px}.basket-head h1{font-size:28px;margin:0}.store-chip{font-size:10px;color:var(--b);font-weight:700}.line{display:grid;grid-template-columns:74px 1fr auto auto;gap:14px;align-items:center;padding:16px 0;border-top:1px solid var(--line)}.line img{width:70px;height:70px;object-fit:contain;background:#fff;border-radius:12px}.line h3{font-size:14px;margin:0 0 5px}.line-meta{font-size:9px;color:var(--muted)}.qty{display:flex;align-items:center;gap:6px}.qty input{width:55px;height:38px;border:1px solid var(--line);border-radius:9px;text-align:center;background:var(--card);color:var(--ink)}.qty button{height:38px;border:0;border-radius:9px;background:var(--soft);color:var(--b);font-weight:700}.price{font-size:16px;font-weight:700}.summary h2{font-size:18px;margin:0 0 18px}.sum-row{display:flex;justify-content:space-between;padding:9px 0;font-size:11px}.sum-total{display:flex;justify-content:space-between;margin-top:10px;padding-top:14px;border-top:1px solid var(--line);font-size:19px;font-weight:700}.checkout{margin-top:18px;height:48px;border-radius:12px;background:var(--b);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700}.checkout:hover{color:#fff;background:#0f766e}.clear{border:0;background:transparent;color:#bd4a47;font-size:9px;font-weight:700}.message{padding:12px 14px;border-radius:12px;background:#e8f8f4;color:#136d63;font-size:10px;margin-bottom:14px}.error{background:#fdeceb;color:#a53f3b}.empty{padding:70px 20px;text-align:center}.empty i{font-size:36px;color:var(--b)}.empty h2{font-size:23px;margin:14px 0 7px}.empty p{font-size:11px;color:var(--muted)}.empty a{display:inline-flex;margin-top:12px;height:44px;padding:0 15px;border-radius:11px;background:var(--b);color:#fff;align-items:center;font-size:10px;font-weight:700}
@@media(max-width:800px){.basket-grid{grid-template-columns:1fr}.summary{position:static}.line{grid-template-columns:64px 1fr}.qty,.price{grid-column:2}.price{text-align:left}}
</style>
}
<div class="basket-page"><div class="container">
@if(TempData["MarketplaceMessage"] is string msg){<div class="message">@msg</div>}
@if(TempData["MarketplaceError"] is string err){<div class="message error">@err</div>}
@if(Model.Items.Any() && Model.Pharmacy!=null){<div class="basket-grid"><section class="basket-card"><div class="basket-head"><div><div class="store-chip"><i class="fas fa-clinic-medical"></i> @Model.Pharmacy.Name</div><h1>Your basket</h1></div><form method="post" action="/MarketplaceCart/Clear">@Html.AntiForgeryToken()<button class="clear">Clear basket</button></form></div>
@foreach(var item in Model.Items){<div class="line"><img src="@item.ImageUrl" alt="@item.ProductName"/><div><h3>@item.ProductName</h3><div class="line-meta">$@item.UnitPrice.ToString("0.00") each · @item.AvailableStock available</div></div><form class="qty" method="post" action="/MarketplaceCart/Update">@Html.AntiForgeryToken()<input type="hidden" name="pharmacyProductId" value="@item.PharmacyProductId"/><input type="number" min="0" max="@item.AvailableStock" name="quantity" value="@item.Quantity"/><button>Update</button></form><div class="price">$@item.LineTotal.ToString("0.00")</div></div>}
</section><aside class="summary"><h2>Order summary</h2><div class="sum-row"><span>Subtotal</span><strong>$@Model.Subtotal.ToString("0.00")</strong></div><div class="sum-row"><span>Delivery</span><strong>@(Model.DeliveryFee==0?"FREE":"$"+Model.DeliveryFee.ToString("0.00"))</strong></div><div class="sum-total"><span>Total</span><span>$@Model.Total.ToString("0.00")</span></div><a class="checkout" href="/MarketplaceCart/Checkout">Continue to checkout <i class="fas fa-arrow-right" style="margin-left:7px"></i></a><div style="font-size:8px;color:var(--muted);margin-top:10px;text-align:center">One pharmacy per order keeps stock, delivery and fulfillment accurate.</div></aside></div>}
else{<div class="basket-card empty"><i class="fas fa-shopping-basket"></i><h2>Your marketplace basket is empty</h2><p>Choose a pharmacy offer to start an order.</p><a href="/Marketplace">Browse pharmacies</a></div>}
</div></div>