@model IEnumerable<PharmaCare.Models.Order>
@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
    var orders = Model?.ToList() ?? new List<PharmaCare.Models.Order>();
    var totalRevenue = orders.Where(o => !string.Equals(o.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)).Sum(o => o.TotalAmount);
}

@section Styles {
<style>
.orders-head{display:flex;justify-content:space-between;align-items:flex-end;margin:28px 0 18px}.orders-head h2{font-weight:700;margin:0}.orders-head p{margin:5px 0 0;color:#6c757d}.metric-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);height:100%}.metric-card .card-body{padding:17px 18px}.metric-label{font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;color:#6c757d}.metric-value{font-size:24px;font-weight:700;margin-top:3px}.orders-card,.filters-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06)}.orders-card .card-header,.filters-card .card-header{background:transparent;padding:16px 18px}.filter-grid{display:grid;grid-template-columns:180px 180px minmax(240px,1fr) auto;gap:10px;align-items:end}.table thead th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#59616a;border-top:0}.table td,.table th{vertical-align:middle}.order-number{font-weight:700}.muted{font-size:12px;color:#7a838b}.status-chip{font-size:11px;padding:5px 8px;border-radius:8px}.action-btn{display:inline-flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:8px;text-decoration:none!important;margin-left:3px}.action-btn:hover{background:#f1f3f5}.toggle-details{cursor:pointer;width:42px;text-align:center}.detail-panel{display:none;background:#fafbfc}.detail-box{border:1px solid #edf0f2;border-radius:10px;padding:14px;height:100%}.detail-label{font-size:11px;color:#7a838b;text-transform:uppercase;font-weight:700;letter-spacing:.4px}.detail-value{font-weight:600;margin-top:3px;word-break:break-word}.empty-state{padding:50px 20px;text-align:center;color:#6c757d}.modal-content{border:0;border-radius:12px;overflow:hidden}.status-note{font-size:12px;color:#6c757d;margin-top:8px}.dark-mode .metric-card,.dark-mode .orders-card,.dark-mode .filters-card,.dark-mode .modal-content{background:#1f1f1f}.dark-mode .action-btn:hover{background:#333}.dark-mode .detail-panel{background:#1b1b1b}.dark-mode .detail-box{border-color:#383838}.dark-mode .table thead th{color:#c9c9c9}.dark-mode .form-control{background:#262626;color:#eee;border-color:#444}@@media(max-width:992px){.filter-grid{grid-template-columns:1fr 1fr}.filter-grid .search-col{grid-column:1 / -1}.filter-grid .filter-btn{grid-column:1 / -1}}@@media(max-width:576px){.orders-head{align-items:flex-start;flex-direction:column;gap:12px}.filter-grid{grid-template-columns:1fr}}
</style>
}

<div class="orders-head">
    <div>
        <h2>Order Management</h2>
        <p>Track customer orders, payment status and fulfilment progress.</p>
    </div>
    <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> Dashboard</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
}

<div class="row mb-3">
    <div class="col-xl-2 col-md-4 col-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Total Orders</div><div class="metric-value">@ViewBag.OrderStatistics["Total"]</div></div></div></div>
    <div class="col-xl-2 col-md-4 col-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-warning">Pending</div><div class="metric-value">@ViewBag.OrderStatistics["Pending"]</div></div></div></div>
    <div class="col-xl-2 col-md-4 col-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-info">Processing</div><div class="metric-value">@ViewBag.OrderStatistics["Processing"]</div></div></div></div>
    <div class="col-xl-2 col-md-4 col-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-primary">Shipped</div><div class="metric-value">@ViewBag.OrderStatistics["Shipped"]</div></div></div></div>
    <div class="col-xl-2 col-md-4 col-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label text-success">Delivered</div><div class="metric-value">@ViewBag.OrderStatistics["Delivered"]</div></div></div></div>
    <div class="col-xl-2 col-md-4 col-6 mb-3"><div class="card metric-card"><div class="card-body"><div class="metric-label">Revenue</div><div class="metric-value">$@totalRevenue.ToString("N2")</div></div></div></div>
</div>

<div class="card filters-card mb-4">
    <div class="card-header"><strong><i class="fas fa-filter mr-2 text-muted"></i>Filters</strong></div>
    <div class="card-body">
        <div class="filter-grid">
            <div><label class="small font-weight-bold" for="orderStatus">Status</label><select id="orderStatus" class="form-control form-control-sm"><option value="">All statuses</option><option>Pending</option><option>Processing</option><option>Shipped</option><option>Delivered</option><option>Cancelled</option></select></div>
            <div><label class="small font-weight-bold" for="dateRange">Date</label><select id="dateRange" class="form-control form-control-sm"><option value="">All time</option><option value="today">Today</option><option value="week">This week</option><option value="month">This month</option><option value="year">This year</option></select></div>
            <div class="search-col"><label class="small font-weight-bold" for="searchOrder">Search</label><input id="searchOrder" class="form-control form-control-sm" placeholder="Order number, customer or email" /></div>
            <div class="filter-btn"><button id="filterOrders" class="btn btn-success btn-sm btn-block"><i class="fas fa-search mr-1"></i> Apply</button></div>
        </div>
    </div>
</div>

<div class="card orders-card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center"><strong>Orders</strong><span class="muted"><span id="visibleOrders">@orders.Count</span> shown</span></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="ordersTable">
            <thead><tr><th></th><th>Order</th><th>Customer</th><th>Date</th><th>Items</th><th>Total</th><th>Payment</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
            @foreach (var order in orders)
            {
                var statusClass = order.Status?.ToLower() switch { "pending" => "warning", "processing" => "info", "shipped" => "primary", "delivered" => "success", "cancelled" => "danger", _ => "secondary" };
                var paymentClass = order.IsPaid ? "success" : "warning";
                <tr class="order-row" data-order-id="@order.OrderId" data-status="@order.Status" data-date="@order.OrderDate.ToString("yyyy-MM-dd")" data-search="@($"{order.OrderNumber} {order.User?.FirstName} {order.User?.LastName} {order.User?.Email}".ToLower())">
                    <td class="toggle-details"><i class="fas fa-chevron-down text-muted"></i></td>
                    <td><div class="order-number">#@order.OrderNumber</div><div class="muted">ID @order.OrderId</div></td>
                    <td><div class="font-weight-bold">@order.User?.FirstName @order.User?.LastName</div><div class="muted">@order.User?.Email</div></td>
                    <td>@order.OrderDate.ToString("MMM dd, yyyy")<div class="muted">@order.OrderDate.ToString("HH:mm")</div></td>
                    <td>@order.OrderItems.Count</td>
                    <td><strong>$@order.TotalAmount.ToString("0.00")</strong></td>
                    <td><span class="badge badge-@paymentClass status-chip">@(order.IsPaid ? "Paid" : "Not paid")</span></td>
                    <td><span class="badge badge-@statusClass status-chip status-badge">@order.Status</span></td>
                    <td class="text-right">
                        <a class="action-btn text-info" href="@Url.Action("Details","Order",new{id=order.OrderId})" title="View details"><i class="fas fa-eye"></i></a>
                        @if (!string.Equals(order.Status, "Delivered", StringComparison.OrdinalIgnoreCase) && !string.Equals(order.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="#" class="action-btn text-primary update-status-btn" data-order-id="@order.OrderId" data-current-status="@order.Status" data-toggle="modal" data-target="#updateStatusModal" title="Update status"><i class="fas fa-edit"></i></a>
                        }
                    </td>
                </tr>
                <tr class="detail-panel" id="details-@order.OrderId">
                    <td colspan="9">
                        <div class="row py-2">
                            <div class="col-lg-4 mb-3"><div class="detail-box"><div class="detail-label">Shipping</div><div class="detail-value">@order.ShippingAddress</div><div class="muted mt-1">@order.City · @order.PhoneNumber</div></div></div>
                            <div class="col-lg-4 mb-3"><div class="detail-box"><div class="detail-label">Payment</div><div class="detail-value">@order.PaymentMethod</div><div class="muted mt-1">@(order.IsPaid ? "Payment completed" : "Awaiting payment")</div></div></div>
                            <div class="col-lg-4 mb-3"><div class="detail-box"><div class="detail-label">Items</div>@foreach(var item in order.OrderItems.Take(3)){<div class="d-flex justify-content-between mt-2"><span>@item.ProductName</span><strong>x@item.Quantity</strong></div>}@if(order.OrderItems.Count>3){<div class="muted mt-2">+ @(order.OrderItems.Count-3) more item(s)</div>}</div></div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div id="ordersEmpty" class="empty-state" style="display:none"><i class="fas fa-clipboard-list fa-2x mb-3"></i><div>No orders match these filters.</div></div>
</div>

<div class="modal fade" id="updateStatusModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content">
        <div class="modal-header"><div><h5 class="modal-title mb-1">Update Order Status</h5><div class="muted">Move the order through the fulfilment workflow.</div></div><button type="button" class="close" data-dismiss="modal">&times;</button></div>
        <form asp-controller="Order" asp-action="UpdateStatus" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <input type="hidden" id="modalOrderId" name="orderId" />
                <input type="hidden" name="returnUrl" value="ManageOrders" />
                <div class="form-group"><label for="modalOrderStatus">New status</label><select id="modalOrderStatus" name="status" class="form-control"></select><div class="status-note" id="statusNote"></div></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success"><i class="fas fa-check mr-1"></i> Update Status</button></div>
        </form>
    </div></div>
</div>

@section Scripts {
<script>
(function(){
    const rows=[...document.querySelectorAll('.order-row')], status=document.getElementById('orderStatus'), date=document.getElementById('dateRange'), search=document.getElementById('searchOrder'), visible=document.getElementById('visibleOrders'), empty=document.getElementById('ordersEmpty');
    function dateMatches(value,mode){if(!mode)return true;const d=new Date(value+'T00:00:00'),now=new Date();if(mode==='today')return d.toDateString()===now.toDateString();if(mode==='week'){const start=new Date(now);start.setDate(now.getDate()-now.getDay());start.setHours(0,0,0,0);return d>=start;}if(mode==='month')return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear();if(mode==='year')return d.getFullYear()===now.getFullYear();return true;}
    function apply(){const q=search.value.toLowerCase().trim();let shown=0;rows.forEach(r=>{const ok=(!status.value||r.dataset.status===status.value)&&dateMatches(r.dataset.date,date.value)&&(!q||r.dataset.search.includes(q));r.style.display=ok?'':'none';const detail=document.getElementById('details-'+r.dataset.orderId);if(detail&&!ok)detail.style.display='none';if(ok)shown++;});visible.textContent=shown;empty.style.display=shown?'none':'block';}
    document.getElementById('filterOrders').addEventListener('click',apply);search.addEventListener('input',apply);status.addEventListener('change',apply);date.addEventListener('change',apply);
    document.querySelectorAll('.toggle-details').forEach(cell=>cell.addEventListener('click',function(){const row=this.closest('.order-row'),detail=document.getElementById('details-'+row.dataset.orderId),icon=this.querySelector('i');const open=detail.style.display==='table-row';detail.style.display=open?'none':'table-row';icon.className=open?'fas fa-chevron-down text-muted':'fas fa-chevron-up text-muted';}));
    const workflow={Pending:['Processing','Cancelled'],Processing:['Shipped','Cancelled'],Shipped:['Delivered']};
    document.querySelectorAll('.update-status-btn').forEach(btn=>btn.addEventListener('click',function(){const current=this.dataset.currentStatus,select=document.getElementById('modalOrderStatus'),next=workflow[current]||[];document.getElementById('modalOrderId').value=this.dataset.orderId;select.innerHTML='';next.forEach(s=>{const o=document.createElement('option');o.value=s;o.textContent=s;select.appendChild(o);});document.getElementById('statusNote').textContent=next.length?'Current status: '+current+'. Available next step'+(next.length>1?'s':'')+': '+next.join(' or ')+'.':'This order is final and cannot be changed.';}));
})();
</script>
}
