@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.IsLoggedIn = true;
    var userName = Context.Session.GetString("UserName");
    ViewBag.UserName = !string.IsNullOrEmpty(userName) ? userName : "User";
    ViewBag.HideCategories = false;
}

@section Styles {
<style>
.account-page{--teal:#0f9d8f;--teal-dark:#0a655c;--ink:#17212b;--muted:#71808d;--line:#dfe8ea;background:linear-gradient(180deg,#f4fbfa 0,#fff 44%);padding:42px 0 72px;color:var(--ink)}
.account-shell{max-width:1180px;margin:0 auto;padding:0 22px}.account-head{margin-bottom:22px}.account-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;background:#e7f8f5;color:#08776d;font-size:11px;font-weight:900;letter-spacing:.55px;text-transform:uppercase;margin-bottom:10px}.account-title{font-size:38px;font-weight:900;letter-spacing:-1.1px;margin:0 0 7px}.account-subtitle{margin:0;color:var(--muted);font-size:14px}.account-grid{display:grid;grid-template-columns:280px minmax(0,1fr);gap:22px;align-items:start}.account-nav,.account-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 14px 38px rgba(15,23,42,.06);overflow:hidden}.account-nav-head{padding:19px 18px;background:linear-gradient(135deg,#0b756c,#0f9d8f);color:#fff}.account-nav-head strong{display:block;font-size:17px}.account-nav-head span{display:block;font-size:11px;opacity:.8;margin-top:3px}.account-nav-links{padding:10px}.account-nav-links a{display:flex;align-items:center;gap:11px;min-height:46px;padding:0 13px;border-radius:12px;color:#44515b;text-decoration:none;font-size:13px;font-weight:800;transition:.2s}.account-nav-links a i{width:18px;text-align:center;color:#78858d}.account-nav-links a:hover{background:#f2f8f7;color:var(--teal-dark);text-decoration:none}.account-nav-links a.active{background:#e8f8f5;color:#08776d}.account-nav-links a.active i{color:var(--teal)}
.account-card-head{padding:22px 24px;border-bottom:1px solid var(--line)}.account-card-head h2{margin:0 0 5px;font-size:23px;font-weight:900}.account-card-head p{margin:0;color:var(--muted);font-size:12px}.account-form{padding:24px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:16px}.field label{font-size:11px;font-weight:900;color:#52606a;text-transform:uppercase;letter-spacing:.45px}.password-wrap{position:relative}.password-wrap .form-control{min-height:48px;border:1px solid #d9e3e5;border-radius:12px;padding:10px 46px 10px 13px;background:#fff;color:var(--ink);box-shadow:none;transition:.2s}.password-wrap .form-control:focus{border-color:#6bc9be;box-shadow:0 0 0 3px rgba(15,157,143,.1)}.password-toggle{position:absolute;right:13px;top:50%;transform:translateY(-50%);width:30px;height:30px;border-radius:9px;display:grid;place-items:center;color:#71808d;cursor:pointer;transition:.2s}.password-toggle:hover{background:#edf7f5;color:var(--teal)}.password-requirements{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px}.password-req{padding:10px 11px;border:1px solid #e6edef;border-radius:11px;background:#fafcfc;color:#7c8991;font-size:10px;font-weight:800}.password-req i{margin-right:5px}.password-req.valid{background:#eaf8ed;border-color:#ccebd5;color:#218047}.form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}.btn-save,.btn-cancel{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 17px;border-radius:11px;font-size:12px;font-weight:900;text-decoration:none;border:1px solid transparent;transition:.2s}.btn-save{background:var(--teal);color:#fff;box-shadow:0 8px 18px rgba(15,157,143,.18)}.btn-save:hover{background:#0b887d;color:#fff;transform:translateY(-1px)}.btn-cancel{background:#fff;color:#56636d;border-color:#ccd8db}.btn-cancel:hover{background:#f6f9fa;color:#27333b;text-decoration:none}.account-toast{margin-bottom:16px;border-radius:13px;padding:12px 14px;font-size:12px;font-weight:800}.account-toast.success{background:#e8f8ed;color:#16773d;border:1px solid #c8ead4}.account-toast.error{background:#fff0f1;color:#b73240;border:1px solid #f2c7cc}.security-note{display:flex;gap:12px;align-items:flex-start;padding:14px 15px;border-radius:14px;background:#edf9f7;color:#376b66;font-size:12px;line-height:1.55;margin-bottom:18px}.security-note i{color:var(--teal);margin-top:2px}
.dark-mode .account-page{--ink:#edf5f4;--muted:#9ca8ad;--line:#2b3b3c;background:#111819}.dark-mode .account-nav,.dark-mode .account-card{background:#172122}.dark-mode .account-nav-links a{color:#d7e0df}.dark-mode .account-nav-links a:hover{background:#1d2b2c}.dark-mode .account-nav-links a.active{background:#143331;color:#7de0d4}.dark-mode .field label{color:#b9c3c6}.dark-mode .password-wrap .form-control{background:#121c1d;border-color:#2b3b3c;color:#edf5f4}.dark-mode .password-toggle:hover{background:#1e2d2e}.dark-mode .password-req{background:#121c1d;border-color:#2b3b3c}.dark-mode .security-note{background:#12312e;color:#a8d9d3}.dark-mode .btn-cancel{background:#172122;border-color:#425153;color:#d7e0df}
@@media(max-width:860px){.account-grid{grid-template-columns:1fr}.account-nav-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.account-nav-head{display:none}.account-nav-links a{justify-content:center;text-align:center}}
@@media(max-width:620px){.account-page{padding:30px 0 54px}.account-shell{padding:0 14px}.account-title{font-size:30px}.account-nav-links{grid-template-columns:1fr 1fr}.account-form,.account-card-head{padding:18px}.password-requirements{grid-template-columns:1fr}.form-actions{flex-direction:column}.btn-save,.btn-cancel{width:100%}}
</style>
}

<section class="account-page">
    <div class="account-shell">
        <header class="account-head">
            <div class="account-kicker"><i class="fas fa-shield-alt"></i> Security</div>
            <h1 class="account-title">Change password</h1>
            <p class="account-subtitle">Update your password and keep your PharmaCare account protected.</p>
        </header>

        @if (TempData["SuccessMessage"] != null){<div class="account-toast success"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]</div>}
        @if (TempData["ErrorMessage"] != null){<div class="account-toast error"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]</div>}

        <div class="account-grid">
            <aside class="account-nav">
                <div class="account-nav-head"><strong>Account menu</strong><span>Everything in one place</span></div>
                <nav class="account-nav-links">
                    <a href="@Url.Action("Profile", "Account")"><i class="fas fa-user"></i><span>Profile</span></a>
                    <a href="@Url.Action("EditProfile", "Account")"><i class="fas fa-user-edit"></i><span>Edit profile</span></a>
                    <a class="active" href="@Url.Action("ChangePassword", "Account")"><i class="fas fa-key"></i><span>Password</span></a>
                    <a href="@Url.Action("Index", "Order")"><i class="fas fa-shopping-bag"></i><span>My orders</span></a>
                    <a href="@Url.Action("MyReservations", "Prescription")"><i class="fas fa-prescription-bottle-alt"></i><span>Reservations</span></a>
                </nav>
            </aside>

            <main class="account-card">
                <div class="account-card-head"><h2>Secure your account</h2><p>Use a strong password you do not reuse on other websites.</p></div>
                <form asp-action="ChangePassword" asp-controller="Account" method="post" id="change-password-form" class="account-form">
                    @Html.AntiForgeryToken()
                    <div class="security-note"><i class="fas fa-lock"></i><div>Your current password is required before a new password can be saved. This helps protect your account from unauthorized changes.</div></div>

                    <div class="field">
                        <label for="currentPassword">Current password</label>
                        <div class="password-wrap"><input type="password" id="currentPassword" name="currentPassword" class="form-control" required autocomplete="current-password" /><span class="password-toggle" onclick="togglePasswordVisibility('currentPassword')"><i class="fas fa-eye"></i></span></div>
                        <div id="current-password-error" class="text-danger" style="display:none;"></div>
                    </div>

                    <div class="field">
                        <label for="newPassword">New password</label>
                        <div class="password-wrap"><input type="password" id="newPassword" name="newPassword" class="form-control" required autocomplete="new-password" /><span class="password-toggle" onclick="togglePasswordVisibility('newPassword')"><i class="fas fa-eye"></i></span></div>
                        <div id="new-password-error" class="text-danger" style="display:none;"></div>
                        <div class="password-requirements">
                            <div id="length-req" class="password-req"><i class="fas fa-circle"></i> 8+ characters</div>
                            <div id="uppercase-req" class="password-req"><i class="fas fa-circle"></i> Uppercase letter</div>
                            <div id="special-req" class="password-req"><i class="fas fa-circle"></i> Special character</div>
                        </div>
                    </div>

                    <div class="field">
                        <label for="confirmPassword">Confirm new password</label>
                        <div class="password-wrap"><input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required autocomplete="new-password" /><span class="password-toggle" onclick="togglePasswordVisibility('confirmPassword')"><i class="fas fa-eye"></i></span></div>
                        <div id="confirm-password-error" class="text-danger" style="display:none;"></div>
                    </div>

                    <div class="form-actions"><a href="@Url.Action("Profile", "Account")" class="btn-cancel"><i class="fas fa-times"></i> Cancel</a><button type="submit" class="btn-save" id="change-password-btn"><i class="fas fa-key"></i> Change password</button></div>
                </form>
            </main>
        </div>
    </div>
</section>

<script src="~/assets/js/AccountViewScripts/ChangePassword.js"></script>