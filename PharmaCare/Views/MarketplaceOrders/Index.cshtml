@model List<MarketplaceOrder>
@{
    ViewData["Title"] = "Marketplace Orders";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--o:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a}.orders-page{background:#f7fbfa;color:var(--ink);min-height:100vh;padding:42px 0 70px}.dark-mode .orders-page{background:#151a1d}.orders-head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:22px}.orders-head h1{font-size:29px;margin:0}.orders-head p{font-size:10px;color:var(--muted);margin:5px 0 0}.order-card{display:block;background:var(--card);border:1px solid var(--line);border-radius:19px;padding:19px;margin-bottom:13px;color:var(--ink);transition:.2s}.order-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(25,67,72,.08);color:var(--ink)}.order-top{display:flex;justify-content:space-between;align-items:start;gap:15px}.order-no{font-size:13px;font-weight:700}.pharmacy{font-size:10px;color:var(--o);margin-top:4px}.status{padding:7px 10px;border-radius:999px;background:#fff2d7;color:#9b6500;font-size:8px;font-weight:700}.order-meta{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:17px;padding-top:15px;border-top:1px solid var(--line)}.meta span{display:block;font-size:8px;text-transform:uppercase;color:var(--muted);margin-bottom:4px}.meta strong{font-size:11px}.progress{height:5px;background:#edf1f2;border-radius:99px;margin-top:17px;overflow:hidden}.progress span{display:block;height:100%;background:var(--o);border-radius:99px}.track-hint{font-size:8px;color:var(--o);font-weight:700;margin-top:10px}.empty{padding:60px;text-align:center;background:var(--card);border:1px dashed var(--line);border-radius:20px;color:var(--muted)}
@@media(max-width:575px){.orders-head{flex-direction:column;align-items:flex-start}.order-meta{grid-template-columns:1fr 1fr}.order-top{flex-direction:column}}
</style>
}
<div class="orders-page"><div class="container"><div class="orders-head"><div><h1>Marketplace orders</h1><p>Track pharmacy acceptance, preparation, delivery and completion.</p></div><a href="/Marketplace" style="font-size:10px;font-weight:700;color:var(--o)">Browse pharmacies →</a></div>
@if(Model.Any()){@foreach(var o in Model){var progress=o.Status switch{"Delivered"=>100,"Out for Delivery"=>82,"Ready for Pickup"=>68,"Preparing"=>52,"Accepted"=>30,_=>12};<a class="order-card" href="/MarketplaceOrders/Details/@o.MarketplaceOrderId"><div class="order-top"><div><div class="order-no">@o.OrderNumber</div><div class="pharmacy"><i class="fas fa-clinic-medical"></i> @o.Pharmacy.Name</div></div><span class="status">@o.Status</span></div><div class="order-meta"><div class="meta"><span>Placed</span><strong>@o.OrderDate.ToString("MMM d, HH:mm")</strong></div><div class="meta"><span>Items</span><strong>@o.Items.Sum(x=>x.Quantity)</strong></div><div class="meta"><span>Total</span><strong>$@o.TotalAmount.ToString("0.00")</strong></div><div class="meta"><span>Delivery</span><strong>@o.Pharmacy.EstimatedDeliveryMinutes min est.</strong></div></div><div class="progress"><span style="width:@progress%"></span></div><div class="track-hint">View live timeline →</div></a>}}else{<div class="empty"><i class="fas fa-receipt" style="font-size:32px;color:var(--o)"></i><h2 style="font-size:20px;color:var(--ink);margin:12px 0 5px">No marketplace orders yet</h2><div style="font-size:10px">Your pharmacy marketplace orders will appear here.</div></div>}
</div></div>