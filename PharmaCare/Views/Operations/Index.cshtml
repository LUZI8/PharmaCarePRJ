@model PharmaCare.Controllers.OperationsViewModel
@{
    ViewData["Title"] = "Operations Center";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
}
@section Styles {
<style>
.ops{padding:4px 0 42px}.ops-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:22px}.ops-head h1{font-size:30px;margin:0;color:#1f2937}.ops-muted{color:#718087;font-size:12px}.ops-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.ops-kpi,.ops-card{background:#fff;border:1px solid #e3ebed;border-radius:18px}.ops-kpi{padding:20px;box-shadow:0 8px 24px rgba(15,23,42,.04)}.ops-kpi i{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:#eaf8f6;color:#0d9488;margin-bottom:14px}.ops-kpi strong{font-size:25px;display:block;color:#1f2937}.ops-kpi span{font-size:11px;color:#718087}.ops-two{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.ops-card{padding:20px;overflow:hidden}.ops-card h2{font-size:16px;margin:0 0 15px;color:#1f2937}.ops-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 0;border-top:1px solid #edf1f2;font-size:12px}.ops-row:first-of-type{border-top:0}.ops-badge{padding:5px 8px;border-radius:999px;background:#eaf8f6;color:#0d766e;font-size:9px;font-weight:700;white-space:nowrap}.ops-badge.warn{background:#fff3d9;color:#9b6500}.ops-badge.danger{background:#fde9e8;color:#b8403c}.ops-empty{padding:18px 0;color:#849198;font-size:12px}.ops-link{color:#0d9488;font-weight:700;font-size:11px}.ops-ai{margin-top:16px;background:linear-gradient(135deg,#102a30,#0d625e);color:#fff;border:0;position:relative;overflow:hidden}.ops-ai:after{content:"AI";position:absolute;right:22px;top:-45px;font-size:150px;font-weight:700;color:rgba(255,255,255,.045)}.ops-ai h2{color:#fff}.ops-ai .ops-muted{color:rgba(255,255,255,.7)}.ops-ai-toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;position:relative;z-index:2}.ops-ai-btn{border:0;border-radius:10px;background:#fff;color:#0d625e;padding:11px 15px;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap}.ops-ai-btn:disabled{opacity:.65;cursor:wait}.ops-ai-result{display:none;margin-top:16px;padding:15px;border:1px solid rgba(255,255,255,.14);border-radius:13px;background:rgba(255,255,255,.06);white-space:pre-wrap;font-size:12px;line-height:1.75;position:relative;z-index:2}.dark-mode .ops-kpi,.dark-mode .ops-card{background:#202428;border-color:#31383e}.dark-mode .ops-head h1,.dark-mode .ops-kpi strong,.dark-mode .ops-card h2{color:#f2f4f5}.dark-mode .ops-row{border-color:#30363c}.dark-mode .ops-kpi i{background:#183531}.dark-mode .ops-muted,.dark-mode .ops-kpi span{color:#9ba9ad}.dark-mode .ops-ai{background:linear-gradient(135deg,#0c252b,#0c514e)}
@@media(max-width:900px){.ops-grid{grid-template-columns:1fr 1fr}.ops-two{grid-template-columns:1fr}.ops-head{align-items:flex-start;flex-direction:column}.ops-ai-toolbar{align-items:flex-start;flex-direction:column}}
@@media(max-width:520px){.ops-grid{grid-template-columns:1fr 1fr;gap:9px}.ops-kpi{padding:15px}.ops-kpi strong{font-size:21px}.ops-card{padding:16px}.ops-row{align-items:flex-start}.ops-head h1{font-size:25px}.ops-ai-btn{width:100%}}
</style>
}
<div class="ops">
 <div class="ops-head"><div><div class="ops-muted">PHARMACY INTELLIGENCE</div><h1>Operations Center</h1><div class="ops-muted">Orders, prescriptions, inventory and customer attention in one operational view.</div></div><div class="ops-muted">Updated @Model.GeneratedAt.ToString("MMM d, HH:mm")</div></div>
 <div class="ops-grid">
  <div class="ops-kpi"><i class="fas fa-shopping-bag"></i><strong>@Model.OrdersToday</strong><span>Orders today</span></div>
  <div class="ops-kpi"><i class="fas fa-coins"></i><strong>$@Model.RevenueToday.ToString("0.00")</strong><span>Revenue today</span></div>
  <div class="ops-kpi"><i class="fas fa-hourglass-half"></i><strong>@Model.PendingOrders</strong><span>Orders needing attention</span></div>
  <div class="ops-kpi"><i class="fas fa-prescription"></i><strong>@Model.PendingPrescriptions</strong><span>Prescription pickups</span></div>
 </div>

 <section class="ops-card ops-ai">
  <div class="ops-ai-toolbar">
   <div><h2><i class="fas fa-sparkles"></i> PharmaCare AI Operations Copilot</h2><div class="ops-muted">Generate a prioritized internal briefing from live order, inventory, prescription and support signals. No clinical prescribing decisions are made here.</div></div>
   <form id="aiBriefForm" method="post">@Html.AntiForgeryToken()<button id="aiBriefBtn" class="ops-ai-btn" type="submit"><i class="fas fa-bolt"></i> Generate AI brief</button></form>
  </div>
  <div id="aiBriefResult" class="ops-ai-result"></div>
 </section>

 <div class="ops-two">
  <section class="ops-card"><h2>Inventory attention</h2>
   @foreach(var p in Model.OutOfStock){<div class="ops-row"><div><b>@p.ProductName</b><div class="ops-muted">Out of stock</div></div><span class="ops-badge danger">0 units</span></div>}
   @foreach(var p in Model.LowStock){<div class="ops-row"><div><b>@p.ProductName</b><div class="ops-muted">Reorder level @p.ReorderLevel</div></div><span class="ops-badge warn">@p.Stock units</span></div>}
   @if(!Model.OutOfStock.Any()&&!Model.LowStock.Any()){<div class="ops-empty">Inventory levels look healthy.</div>}
   <a class="ops-link" href="@Url.Action("Index","Product")">Open inventory →</a>
  </section>
  <section class="ops-card"><h2>Expiring within 90 days</h2>
   @foreach(var p in Model.ExpiringSoon){<div class="ops-row"><div><b>@p.ProductName</b><div class="ops-muted">@p.Stock units in stock</div></div><span class="ops-badge warn">@p.ExpiryDate.ToString("MMM d")</span></div>}
   @if(!Model.ExpiringSoon.Any()){<div class="ops-empty">No active products are nearing expiry.</div>}
  </section>
 </div>
 <div class="ops-two">
  <section class="ops-card"><h2>Prescription queue</h2>
   @foreach(var r in Model.Reservations.Where(x=>x.Status=="Reserved").Take(8)){<div class="ops-row"><div><b>@r.Product?.ProductName</b><div class="ops-muted">@r.ReservationNumber · qty @r.Quantity</div></div><span class="ops-badge">Reserved</span></div>}
   @if(!Model.Reservations.Any(x=>x.Status=="Reserved")){<div class="ops-empty">No prescriptions waiting for pickup.</div>}
   <a class="ops-link" href="@Url.Action("Pickups","Prescription")">Manage prescriptions →</a>
  </section>
  <section class="ops-card"><h2>Recent orders</h2>
   @foreach(var o in Model.RecentOrders.Take(8)){<div class="ops-row"><div><b>@o.OrderNumber</b><div class="ops-muted">@o.OrderDate.ToString("MMM d, HH:mm")</div></div><span class="ops-badge">@o.Status</span></div>}
   @if(!Model.RecentOrders.Any()){<div class="ops-empty">No recent orders.</div>}
   <a class="ops-link" href="@Url.Action("ManageOrders","Order")">Manage orders →</a>
  </section>
 </div>
 <div class="ops-two">
  <section class="ops-card"><h2>Customer support pulse</h2>
   @foreach(var m in Model.RecentFeedback.Take(7)){<div class="ops-row"><div><b>@(string.IsNullOrWhiteSpace(m.Subject)?"Customer message":m.Subject)</b><div class="ops-muted">@m.DateSubmitted.ToString("MMM d, HH:mm")</div></div><span class="ops-badge">Support</span></div>}
   @if(!Model.RecentFeedback.Any()){<div class="ops-empty">No support messages.</div>}
   <a class="ops-link" href="@Url.Action("Feedback","Admin")">Open support inbox →</a>
  </section>
  <section class="ops-card"><h2>Recommended actions</h2>
   @if(Model.OutOfStock.Any()){<div class="ops-row"><div><b>Restock unavailable products</b><div class="ops-muted">@Model.OutOfStock.Count products currently unavailable.</div></div><span class="ops-badge danger">High</span></div>}
   @if(Model.LowStock.Any()){<div class="ops-row"><div><b>Prepare replenishment</b><div class="ops-muted">@Model.LowStock.Count products reached their reorder zone.</div></div><span class="ops-badge warn">Medium</span></div>}
   @if(Model.PendingPrescriptions>0){<div class="ops-row"><div><b>Review prescription queue</b><div class="ops-muted">Confirm pickup readiness and verification workflow.</div></div><span class="ops-badge">Action</span></div>}
   @if(Model.ExpiringSoon.Any()){<div class="ops-row"><div><b>Review near-expiry inventory</b><div class="ops-muted">Prioritize safe stock management.</div></div><span class="ops-badge warn">Review</span></div>}
   @if(!Model.OutOfStock.Any()&&!Model.LowStock.Any()&&Model.PendingPrescriptions==0&&!Model.ExpiringSoon.Any()){<div class="ops-empty">No urgent operational actions detected.</div>}
  </section>
 </div>
</div>
@section Scripts {
<script>
(function(){
 const form=document.getElementById('aiBriefForm'); const btn=document.getElementById('aiBriefBtn'); const box=document.getElementById('aiBriefResult');
 if(!form)return;
 form.addEventListener('submit',async function(e){
  e.preventDefault(); btn.disabled=true; btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Analyzing live operations...'; box.style.display='block'; box.textContent='Building your current operations brief...';
  try{
   const token=form.querySelector('input[name="__RequestVerificationToken"]').value;
   const res=await fetch('@Url.Action("OperationsBrief","AdminAI")',{method:'POST',headers:{'RequestVerificationToken':token}});
   const data=await res.json();
   box.textContent=data.message||'Unable to generate the briefing right now.';
  }catch(err){box.textContent='The AI briefing could not be generated. Please try again.';}
  finally{btn.disabled=false;btn.innerHTML='<i class="fas fa-bolt"></i> Refresh AI brief';}
 });
})();
</script>
}
