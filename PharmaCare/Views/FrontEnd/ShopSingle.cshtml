@model ProductViewModel
@{
    ViewData["Title"] = Model.ProductName + " | PharmaCare";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";

    var images = Model.GalleryImages.ToList();
    if (!images.Any())
    {
        images.Add(Url.Content("~/assets/images/no-image.png"));
    }

    var daysRemaining = (Model.ExpiryDate.Date - DateTime.Now.Date).Days;
    var relatedSource = ViewBag.RelatedProducts as IEnumerable<ProductViewModel> ?? Enumerable.Empty<ProductViewModel>();

    // Keep OTC recommendations OTC and prescription recommendations prescription-only.
    // This prevents a normal product page from unexpectedly promoting Rx-only medicine.
    var related = relatedSource
        .Where(x => x.ProductId != Model.ProductId)
        .Where(x => x.RequiresPrescription == Model.RequiresPrescription)
        .Take(3)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/FrontEndViewStyles/ShopSingle.css" asp-append-version="true" />
    <style>
        /* Critical layout fallback so product images can never expand to their natural size
           even if the browser still has an old stylesheet cached. */
        .product-hero-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);gap:44px}
        .gallery-stage{height:500px;display:flex;align-items:center;justify-content:center;overflow:hidden}
        .gallery-stage>img{width:88%;height:88%;max-width:100%;max-height:100%;object-fit:contain}
        .gallery-thumb img,.related-image img{max-width:100%;max-height:100%;object-fit:contain}
        .related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
        @@media(max-width:991px){.product-hero-card{grid-template-columns:1fr;gap:24px}.gallery-stage{height:430px}}
        @@media(max-width:575px){.gallery-stage{height:330px}.related-grid{grid-template-columns:1fr}}
    </style>
}

<main class="product-page">
    <div class="container product-container-shell">
        <nav class="product-breadcrumb" aria-label="Breadcrumb">
            <a href="@Url.Action("Index","FrontEnd")">Home</a><i class="fas fa-chevron-right"></i>
            <a href="@Url.Action("Shop","FrontEnd")">Store</a><i class="fas fa-chevron-right"></i>
            @if (Model.Category != null)
            {
                <a href="@Url.Action("Shop","FrontEnd",new{category=Model.CategoryID})">@Model.Category.CategoryName</a><i class="fas fa-chevron-right"></i>
            }
            <span>@Model.ProductName</span>
        </nav>

        <section class="product-hero-card">
            <div class="product-gallery" data-gallery>
                <div class="gallery-stage">
                    @if (Model.RequiresPrescription)
                    {
                        <span class="gallery-badge rx"><i class="fas fa-prescription"></i> Prescription</span>
                    }
                    @if (Model.IsExpiringSoon && !Model.IsExpired)
                    {
                        <span class="gallery-badge expiry"><i class="far fa-clock"></i> Expiring soon</span>
                    }
                    <button type="button" class="gallery-zoom" aria-label="Open image preview"><i class="fas fa-search-plus"></i></button>
                    <img id="mainProductImage" src="@images[0]" alt="@Model.ProductName" />
                </div>

                <div class="gallery-thumbs" aria-label="Product images">
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <button type="button" class="gallery-thumb @(i == 0 ? "active" : "")" data-image="@images[i]" aria-label="View product image @(i + 1)">
                            <img src="@images[i]" alt="@Model.ProductName image @(i + 1)" />
                        </button>
                    }
                    @if (images.Count < 4)
                    {
                        <div class="gallery-more-hint"><i class="far fa-images"></i><span>More product<br />photos can be added</span></div>
                    }
                </div>
            </div>

            <div class="product-purchase-panel">
                <div class="product-eyebrow">
                    <span>@(Model.Category?.CategoryName ?? "Pharmacy product")</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Manufacturer))
                    {
                        <span>• @Model.Manufacturer</span>
                    }
                </div>

                <h1>@Model.ProductName</h1>

                <div class="product-price-row">
                    <strong class="product-price">$@Model.Price.ToString("0.00")</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.SKU))
                    {
                        <span class="product-sku">SKU: @Model.SKU</span>
                    }
                </div>

                <div class="status-strip @(Model.IsExpired ? "danger" : Model.IsExpiringSoon ? "warning" : "success")">
                    <span class="status-icon"><i class="fas @(Model.IsExpired ? "fa-times" : Model.IsExpiringSoon ? "fa-clock" : "fa-check")"></i></span>
                    <div>
                        <strong>@(Model.IsExpired ? "Expired product" : Model.IsExpiringSoon ? "Expiry approaching" : "Fresh inventory")</strong>
                        <small>@(Model.IsExpired ? $"Expired {Model.ExpiryDate:MMM dd, yyyy}" : $"Expires {Model.ExpiryDate:MMM dd, yyyy}")</small>
                    </div>
                </div>

                <div class="availability-row">
                    @if (Model.Stock > 0 && !Model.IsExpired)
                    {
                        <span class="availability in-stock"><i class="fas fa-check-circle"></i> In stock</span>
                        <span class="availability-copy">@Model.Stock unit@(Model.Stock == 1 ? "" : "s") available</span>
                    }
                    else
                    {
                        <span class="availability out-stock"><i class="fas fa-times-circle"></i> @(Model.IsExpired ? "Unavailable" : "Out of stock")</span>
                    }
                </div>

                @if (Model.RequiresPrescription)
                {
                    <div class="rx-card">
                        <div class="rx-card-icon"><i class="fas fa-prescription-bottle-alt"></i></div>
                        <div>
                            <strong>Prescription required</strong>
                            <p>@(string.IsNullOrWhiteSpace(Model.PrescriptionNote) ? "Reserve this medicine online, then bring a valid prescription when you collect it from the pharmacy." : Model.PrescriptionNote)</p>
                        </div>
                    </div>
                }

                <div class="purchase-controls">
                    <div class="quantity-block">
                        <label>Quantity</label>
                        @if (Model.RequiresPrescription)
                        {
                            <div class="quantity-control locked"><input type="text" id="quantity-input" value="1" readonly aria-label="Quantity" /></div>
                            <small>Prescription reservations are limited to one unit.</small>
                        }
                        else
                        {
                            <div class="quantity-control">
                                <button class="quantity-minus" type="button" aria-label="Decrease quantity"><i class="fas fa-minus"></i></button>
                                <input type="text" id="quantity-input" value="1" inputmode="numeric" aria-label="Quantity" />
                                <button class="quantity-plus" type="button" aria-label="Increase quantity"><i class="fas fa-plus"></i></button>
                            </div>
                        }
                    </div>

                    <div class="primary-action-wrap">
                        @if (Model.IsExpired)
                        {
                            <button class="product-primary-btn disabled" disabled><i class="fas fa-ban"></i> Product unavailable</button>
                        }
                        else if (Model.RequiresPrescription)
                        {
                            @if (Model.Stock > 0)
                            {
                                <a href="@Url.Action("Confirm","Prescription",new{id=Model.ProductId})" id="reserve-pickup-btn" class="product-primary-btn reserve"><i class="fas fa-bookmark"></i><span>Reserve for pickup<small>Prescription checked at collection</small></span></a>
                            }
                            else
                            {
                                <button class="product-primary-btn disabled" disabled><i class="fas fa-ban"></i> Out of stock</button>
                            }
                        }
                        else if (Model.Stock > 0)
                        {
                            <button id="add-to-cart-btn" class="product-primary-btn" data-product-id="@Model.ProductId"><i class="fas fa-shopping-bag"></i><span>Add to cart<small>Secure checkout</small></span></button>
                        }
                        else
                        {
                            <button class="product-primary-btn disabled" disabled><i class="fas fa-ban"></i> Out of stock</button>
                        }
                    </div>
                </div>

                <div class="purchase-trust-grid">
                    <div><i class="fas fa-shield-alt"></i><span><strong>Pharmacy managed</strong><small>Stock & expiry controlled</small></span></div>
                    <div><i class="fas fa-box"></i><span><strong>Careful fulfillment</strong><small>Order status tracked</small></span></div>
                    <div><i class="fas fa-headset"></i><span><strong>Need help?</strong><small>Contact our pharmacy team</small></span></div>
                </div>
            </div>
        </section>

        <section class="product-information-card">
            <div class="product-tabs" role="tablist">
                <button class="product-tab active" data-tab="overview" type="button">Overview</button>
                <button class="product-tab" data-tab="details" type="button">Product details</button>
                <button class="product-tab" data-tab="expiry" type="button">Expiry & safety</button>
            </div>

            <div class="product-tab-panel active" data-panel="overview">
                <div class="info-grid">
                    <div class="description-panel">
                        <span class="section-kicker">About this product</span>
                        <h2>Product overview</h2>
                        <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Product information is being prepared by the pharmacy team." : Model.Description)</p>
                    </div>
                    <aside class="quick-facts">
                        <h3>Quick facts</h3>
                        <div><span>Category</span><strong>@(Model.Category?.CategoryName ?? "N/A")</strong></div>
                        <div><span>Stock</span><strong>@Model.Stock units</strong></div>
                        <div><span>Prescription</span><strong>@(Model.RequiresPrescription ? "Required" : "Not required")</strong></div>
                        <div><span>Expiry</span><strong>@Model.ExpiryDate.ToString("MMM dd, yyyy")</strong></div>
                    </aside>
                </div>
            </div>

            <div class="product-tab-panel" data-panel="details">
                <div class="detail-spec-grid">
                    <div><span>Product ID</span><strong>#@Model.ProductId</strong></div>
                    <div><span>Price</span><strong>$@Model.Price.ToString("0.00")</strong></div>
                    <div><span>Category</span><strong>@(Model.Category?.CategoryName ?? "N/A")</strong></div>
                    <div><span>Manufacturer</span><strong>@(string.IsNullOrWhiteSpace(Model.Manufacturer) ? "Not specified" : Model.Manufacturer)</strong></div>
                    <div><span>SKU</span><strong>@(string.IsNullOrWhiteSpace(Model.SKU) ? "Not specified" : Model.SKU)</strong></div>
                    <div><span>Barcode</span><strong>@(string.IsNullOrWhiteSpace(Model.Barcode) ? "Not specified" : Model.Barcode)</strong></div>
                </div>
            </div>

            <div class="product-tab-panel" data-panel="expiry">
                <div class="expiry-layout">
                    <div class="expiry-stat"><i class="far fa-calendar-alt"></i><span>Expiry date<strong>@Model.ExpiryDate.ToString("MMM dd, yyyy")</strong></span></div>
                    <div class="expiry-stat"><i class="far fa-clock"></i><span>Time remaining<strong class="@(daysRemaining < 0 ? "danger-text" : daysRemaining <= 30 ? "warning-text" : "success-text")">@(daysRemaining < 0 ? $"Expired {Math.Abs(daysRemaining)} days ago" : $"{daysRemaining} days")</strong></span></div>
                    <div class="safety-note"><i class="fas fa-info-circle"></i><p><strong>Medicine safety:</strong> Do not use pharmaceutical products after their expiry date. If packaging is damaged or product condition looks unusual, contact the pharmacy before use.</p></div>
                </div>
            </div>
        </section>

        @if (related.Any())
        {
            <section class="related-section">
                <div class="related-heading">
                    <div><span class="section-kicker">More from this selection</span><h2>Related products</h2></div>
                    <a href="@Url.Action("Shop","FrontEnd",new{category=Model.CategoryID})">View category <i class="fas fa-arrow-right"></i></a>
                </div>
                <div class="related-grid">
                    @foreach (var item in related)
                    {
                        <a class="related-card" href="@Url.Action("ShopSingle","FrontEnd",new{id=item.ProductId})">
                            <div class="related-image"><img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? Url.Content("~/assets/images/no-image.png") : item.ImageUrl)" alt="@item.ProductName" loading="lazy" /></div>
                            <div class="related-body">
                                <span>@(item.RequiresPrescription ? "Prescription" : (item.Category?.CategoryName ?? "Pharmacy"))</span>
                                <h3>@item.ProductName</h3>
                                <strong>$@item.Price.ToString("0.00")</strong>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
</main>

<div class="image-lightbox" id="productLightbox" aria-hidden="true">
    <button type="button" class="lightbox-close" aria-label="Close preview"><i class="fas fa-times"></i></button>
    <img src="@images[0]" alt="@Model.ProductName preview" />
</div>

@section Scripts {
<script>
window.shopSingleData = {
    addToCartUrl: '@Url.Action("AddToCart","Cart")',
    productId: @Model.ProductId,
    productName: @Html.Raw(Json.Serialize(Model.ProductName)),
    maxStock: @Model.Stock,
    requiresPrescription: @Model.RequiresPrescription.ToString().ToLower(),
    isExpired: @Model.IsExpired.ToString().ToLower()
};
</script>
<script src="~/assets/js/FrontEndViewScripts/ShopSingle.js" asp-append-version="true"></script>
}