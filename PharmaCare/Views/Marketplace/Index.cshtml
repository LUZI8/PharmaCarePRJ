@model MarketplaceHomeViewModel
@{
    var ar = Context.Request.Cookies["pc-culture"] == "ar";
    ViewData["Title"] = ar ? "PharmaCare | سوق الصيدليات" : "PharmaCare Marketplace";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--mk:#0d9488;--mk2:#0f766e;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a;--soft:#183531}.market{background:#f7fbfa;color:var(--ink);min-height:100vh}.dark-mode .market{background:#151a1d}.mk-hero{padding:72px 0 84px;background:linear-gradient(135deg,#073f45,#0d9488 58%,#2bb6ad);color:#fff;position:relative;overflow:hidden}.mk-hero:after{content:"";position:absolute;width:560px;height:560px;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-150px;top:-280px}.mk-kicker{font-size:11px;font-weight:700;letter-spacing:1.1px;margin-bottom:13px}.mk-hero h1{font-size:clamp(40px,6vw,72px);max-width:820px;line-height:1.04;letter-spacing:-2px;margin:0 0 18px}.mk-hero p{max-width:700px;font-size:15px;color:rgba(255,255,255,.84);line-height:1.8}.mk-search{margin-top:30px;background:#fff;border-radius:18px;padding:9px;display:grid;grid-template-columns:170px 1fr 150px 120px;gap:8px;max-width:1050px;box-shadow:0 20px 45px rgba(0,0,0,.17);position:relative;z-index:2}.mk-search input,.mk-search select{border:0;outline:0;background:#f6f9f9;border-radius:12px;padding:0 14px;height:52px;font-size:12px;color:#26343a}.mk-search button{border:0;border-radius:12px;background:#0d9488;color:#fff;font-weight:700;font-size:11px}.mk-location{background:#e9f8f5!important;color:#0d766e!important}.mk-trust{display:flex;gap:18px;flex-wrap:wrap;margin-top:23px;font-size:11px;color:rgba(255,255,255,.84)}.mk-section{padding:48px 0}.mk-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:22px}.mk-head h2{font-size:29px;margin:0}.mk-head p{font-size:11px;color:var(--muted);margin:5px 0 0}.mk-pills{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:20px}.mk-pill{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:var(--card);color:var(--ink);font-size:9px;font-weight:700}.pharmacies{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.pharmacy-card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:18px;transition:.25s;display:block;color:var(--ink)}.pharmacy-card:hover{transform:translateY(-5px);box-shadow:0 20px 40px rgba(25,67,72,.1);color:var(--ink)}.pharmacy-top{display:flex;gap:13px;align-items:center}.ph-logo{width:56px;height:56px;border-radius:16px;background:var(--soft);display:grid;place-items:center;color:var(--mk);font-size:23px}.pharmacy-card h3{font-size:16px;margin:0 0 4px}.ph-meta{font-size:10px;color:var(--muted)}.ph-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}.ph-stat strong{display:block;font-size:11px}.ph-stat span{font-size:8px;color:var(--muted)}.open{color:#17864d}.closed{color:#c54d47}.offers{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.offer{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.25s}.offer:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgba(25,67,72,.09)}.offer-media{height:190px;background:#fff;display:grid;place-items:center;padding:18px;position:relative}.dark-mode .offer-media{background:#252d31}.offer-media img{max-width:100%;max-height:150px;object-fit:contain}.offer-rx{position:absolute;top:12px;left:12px;border-radius:999px;padding:6px 9px;background:#dff4fa;color:#087a96;font-size:8px;font-weight:700}.offer-body{padding:15px}.offer-store{font-size:9px;color:var(--mk);font-weight:700;text-transform:uppercase}.offer h3{font-size:14px;line-height:1.35;margin:6px 0}.offer-price{font-size:18px;font-weight:700}.offer-old{font-size:10px;color:#9aa5a8;text-decoration:line-through;margin-left:5px}.offer-foot{display:flex;align-items:center;justify-content:space-between;margin-top:12px}.offer-foot span{font-size:9px;color:var(--muted)}.compare{font-size:9px;font-weight:700;color:var(--mk)}.empty{padding:35px;background:var(--card);border:1px dashed var(--line);border-radius:18px;color:var(--muted)}.pc-rtl .mk-hero,.pc-rtl .mk-head,.pc-rtl .pharmacy-card,.pc-rtl .offer-body{text-align:right}.pc-rtl .offer-rx{left:auto;right:12px}
@@media(max-width:991px){.pharmacies{grid-template-columns:1fr 1fr}.offers{grid-template-columns:1fr 1fr}.mk-search{grid-template-columns:1fr 1fr}.mk-search input{grid-column:1/-1}}
@@media(max-width:575px){.mk-hero{padding:48px 0 60px}.mk-hero h1{font-size:38px}.mk-search{grid-template-columns:1fr}.mk-search input{grid-column:auto}.mk-search button{height:48px}.pharmacies,.offers{grid-template-columns:1fr}.mk-section{padding:38px 0}.mk-head{align-items:flex-start;flex-direction:column}.ph-stats{grid-template-columns:1fr 1fr}}
</style>
}
<div class="market">
<section class="mk-hero"><div class="container"><div style="position:relative;z-index:2">
<div class="mk-kicker">@(ar ? "دواؤك من صيدليات موثوقة" : "ONE SEARCH · MULTIPLE PHARMACIES")</div>
<h1>@(ar ? "صيدليتك أقرب مما تتوقع." : "Your pharmacy, delivered.")</h1>
<p>@(ar ? "ابحث عن الدواء مرة واحدة، وقارن السعر والتوفر ووقت التوصيل بين الصيدليات الموثوقة، ثم اختر العرض الأنسب لك." : "Search once and compare live price, availability and delivery estimates across trusted pharmacies before you choose.")</p>
<form class="mk-search" method="get" action="/Marketplace">
<select name="city" aria-label="City">@foreach(var city in Model.Cities){if(city==Model.City){<option selected>@city</option>}else{<option>@city</option>}}</select>
<input name="q" value="@Model.Query" placeholder="@(ar?"ابحث عن دواء، منتج، فئة أو صيدلية...":"Search medicine, product, category or pharmacy...")" autocomplete="off"/>
<select name="sort"><option value="recommended" selected="@(Model.Sort=="recommended")">@(ar?"مقترح":"Recommended")</option><option value="cheapest" selected="@(Model.Sort=="cheapest")">@(ar?"الأرخص":"Cheapest")</option><option value="fastest" selected="@(Model.Sort=="fastest")">@(ar?"الأسرع":"Fastest")</option><option value="nearest" selected="@(Model.Sort=="nearest")">@(ar?"الأقرب":"Nearest")</option><option value="rating" selected="@(Model.Sort=="rating")">@(ar?"الأعلى تقييماً":"Top rated")</option></select>
<input type="hidden" name="lat" id="mk-lat" value="@Model.Latitude"/><input type="hidden" name="lng" id="mk-lng" value="@Model.Longitude"/>
<button type="submit"><i class="fas fa-search"></i> @(ar?"بحث":"Search")</button>
</form>
<div style="margin-top:10px"><button class="mk-location" id="mk-use-location" type="button" style="border:0;border-radius:10px;padding:9px 12px;font-size:10px;font-weight:700"><i class="fas fa-location-arrow"></i> @(ar?"استخدم موقعي لترتيب الأقرب":"Use my location for nearest results")</button></div>
<div class="mk-trust"><span><i class="fas fa-check-circle"></i> @(ar?"صيدليات موثقة":"Verified pharmacies")</span><span><i class="fas fa-box-open"></i> @(ar?"مخزون مباشر":"Live pharmacy stock")</span><span><i class="fas fa-prescription"></i> @(ar?"مراجعة وصفات آمنة":"Secure prescription review")</span><span><i class="fas fa-truck"></i> @(ar?"تقدير وقت التوصيل":"Delivery estimates")</span></div>
</div></div></section>

<section class="mk-section"><div class="container">
<div class="mk-head"><div><h2>@(ar?"الصيدليات المتاحة":"Available pharmacies")</h2><p>@(ar?$"اختر من الصيدليات الموثقة في {Model.City}.":$"Compare verified pharmacies serving {Model.City}.")</p></div><span style="font-size:11px;color:var(--muted)">@Model.Pharmacies.Count @(ar?"صيدلية":"pharmacies")</span></div>
<div class="mk-pills">@foreach(var cat in Model.Categories.Take(10)){<a class="mk-pill" href="/Marketplace?q=@Uri.EscapeDataString(cat.CategoryName)&city=@Uri.EscapeDataString(Model.City)">@cat.CategoryName</a>}</div>
<div class="pharmacies">@foreach(var p in Model.Pharmacies){<a class="pharmacy-card" href="/Marketplace/Pharmacy/@p.PharmacyId"><div class="pharmacy-top"><div class="ph-logo"><i class="fas fa-clinic-medical"></i></div><div><h3>@p.Name</h3><div class="ph-meta"><i class="fas fa-map-marker-alt"></i> @p.Address</div></div></div><div class="ph-stats"><div class="ph-stat"><strong>★ @p.Rating</strong><span>@p.RatingCount @(ar?"تقييم":"ratings")</span></div><div class="ph-stat"><strong>@p.DeliveryMinutes min</strong><span>@(ar?"توصيل":"delivery")</span></div><div class="ph-stat"><strong>@(p.DeliveryFee==0?(ar?"مجاني":"FREE"):CurrencyFormatter.Format(p.DeliveryFee))</strong><span class="@(p.IsOpen?"open":"closed")">@(p.IsOpen?(ar?"مفتوح":"Open"):(ar?"مغلق":"Closed"))</span></div><div class="ph-stat"><strong>@(p.DistanceKm.HasValue?$"{p.DistanceKm:0.0} km":"—")</strong><span>@(ar?"المسافة":"distance")</span></div></div></a>}</div>
@if(!Model.Pharmacies.Any()){<div class="empty">@(ar?"لا توجد صيدليات متاحة في هذه المدينة حالياً.":"No verified pharmacies are available in this city yet.")</div>}
</div></section>

<section class="mk-section" style="padding-top:6px"><div class="container">
<div class="mk-head"><div><h2>@(string.IsNullOrWhiteSpace(Model.Query)?(ar?"منتجات شائعة قربك":"Popular products near you"):(ar?$"نتائج البحث عن «{Model.Query}»":$"Results for “{Model.Query}”"))</h2><p>@(ar?"نعرض منتجاً متنوعاً مع أفضل عرض متاح؛ افتح المنتج لمقارنة جميع الصيدليات.":"A varied catalog using the best current offer; open a product to compare every pharmacy.")</p></div><a href="/SmartCart" class="compare"><i class="fas fa-magic"></i> @(ar?"السلة الذكية":"Smart Cart")</a></div>
@if(Model.PopularOffers.Any()){<div class="offers">@foreach(var o in Model.PopularOffers){<div class="offer"><a href="/Marketplace/Compare/@o.ProductId"><div class="offer-media">@if(o.RequiresPrescription){<span class="offer-rx"><i class="fas fa-prescription"></i> @(ar?"وصفة":"Prescription")</span>}<img src="@o.ImageUrl" alt="@o.ProductName" loading="lazy"/></div></a><div class="offer-body"><div class="offer-store">@o.PharmacyName</div><h3>@o.ProductName</h3><div><span class="offer-price">@CurrencyFormatter.Format(o.Price)</span>@if(o.CompareAtPrice.HasValue){<span class="offer-old">@CurrencyFormatter.Format(o.CompareAtPrice.Value)</span>}</div><div class="offer-foot"><span><i class="fas fa-bolt"></i> @o.DeliveryMinutes min · @o.Stock @(ar?"متوفر":"in stock")</span><a class="compare" href="/Marketplace/Compare/@o.ProductId">@(ar?"قارن":"Compare") →</a></div></div></div>}</div>}
else{<div class="empty">@(ar?$"لم نجد نتائج مطابقة في {Model.City}. جرّب اسماً أقصر أو فئة مختلفة.":$"No matching products found in {Model.City}. Try a shorter medicine name or another category.")</div>}
</div></section></div>
@section Scripts{
<script>
(function(){
 const btn=document.getElementById('mk-use-location');
 if(!btn)return;
 btn.addEventListener('click',function(){
   if(!navigator.geolocation){alert('@(ar?"المتصفح لا يدعم تحديد الموقع.":"Location is not supported by this browser.")');return;}
   btn.disabled=true;
   navigator.geolocation.getCurrentPosition(function(pos){
     document.getElementById('mk-lat').value=pos.coords.latitude.toFixed(6);
     document.getElementById('mk-lng').value=pos.coords.longitude.toFixed(6);
     const form=btn.closest('.mk-hero').querySelector('form');
     const sort=form.querySelector('[name=sort]'); sort.value='nearest'; form.submit();
   },function(){btn.disabled=false;alert('@(ar?"تعذر الوصول إلى موقعك. يمكنك اختيار المدينة يدوياً.":"We could not access your location. You can still choose your city manually.")');},{enableHighAccuracy:false,timeout:8000,maximumAge:300000});
 });
})();
</script>
}