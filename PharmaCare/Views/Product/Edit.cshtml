@model PharmaCare.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
}
@section Styles{
<style>
.form-head{display:flex;justify-content:space-between;align-items:flex-end;margin:28px 0 18px}.form-head h2{font-weight:700;margin:0}.form-head p{color:#6c757d;margin:5px 0 0}.form-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06)}.form-card .card-header{background:transparent;padding:16px 20px;font-weight:700}.form-card .card-body{padding:22px}.section-title{font-size:12px;text-transform:uppercase;letter-spacing:.6px;color:#6c757d;font-weight:700;margin-bottom:15px}.form-control{border-radius:8px}.switch-row{display:flex;justify-content:space-between;align-items:center;padding:14px;border:1px solid #e7e9ec;border-radius:10px;margin-bottom:12px}.switch-row .meta{font-size:12px;color:#6c757d}.switch{position:relative;display:inline-block;width:44px;height:24px}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#ccc;border-radius:30px;cursor:pointer;transition:.2s}.slider:before{content:"";position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:#0d9488}.switch input:checked+.slider:before{transform:translateX(20px)}.image-drop{border:2px dashed #d6dbe0;border-radius:12px;padding:20px;text-align:center}.image-preview{width:140px;height:140px;object-fit:contain;border-radius:10px;border:1px solid #e9ecef;margin:0 auto 14px;background:#fff}.rx-note{display:none}.rx-note.show{display:block}.dark-mode .form-card{background:#1f1f1f}.dark-mode .switch-row,.dark-mode .image-drop{border-color:#3b3b3b}.dark-mode .form-control{background:#262626;color:#eee;border-color:#444}
</style>}
<div class="form-head"><div><h2>Edit Product</h2><p>Update inventory information for <strong>@Model.ProductName</strong>.</p></div><a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> Back to Inventory</a></div>
<form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data">
@Html.AntiForgeryToken()<input asp-for="ProductId" type="hidden"/>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row"><div class="col-lg-8">
<div class="card form-card mb-4"><div class="card-header">Product Information</div><div class="card-body">
<div class="form-group"><label asp-for="ProductName">Product Name</label><input asp-for="ProductName" class="form-control"/><span asp-validation-for="ProductName" class="text-danger small"></span></div>
<div class="form-group"><label asp-for="Description">Description</label><textarea asp-for="Description" rows="4" class="form-control"></textarea></div>
<div class="form-row"><div class="form-group col-md-6"><label asp-for="CategoryID">Category</label><select asp-for="CategoryID" asp-items="Model.ListOfCategories" class="form-control"></select><span asp-validation-for="CategoryID" class="text-danger small"></span></div><div class="form-group col-md-6"><label asp-for="ExpiryDate">Expiry Date</label><input asp-for="ExpiryDate" type="date" class="form-control"/><span asp-validation-for="ExpiryDate" class="text-danger small"></span></div></div>
<hr/><div class="form-row"><div class="form-group col-md-6"><label asp-for="Price">Unit Price</label><div class="input-group"><div class="input-group-prepend"><span class="input-group-text">$</span></div><input asp-for="Price" type="number" min="0.01" step="0.01" class="form-control"/></div><span asp-validation-for="Price" class="text-danger small"></span></div><div class="form-group col-md-6"><label asp-for="Stock">Stock</label><div class="input-group"><input asp-for="Stock" type="number" min="0" class="form-control"/><div class="input-group-append"><span class="input-group-text">units</span></div></div><span asp-validation-for="Stock" class="text-danger small"></span></div></div>
</div></div>
<div class="card form-card mb-4"><div class="card-header">Pharmacy Controls</div><div class="card-body"><div class="switch-row"><div><strong>Active Product</strong><div class="meta">Controls customer visibility and availability.</div></div><label class="switch"><input asp-for="IsActive"/><span class="slider"></span></label></div><div class="switch-row"><div><strong>Requires Prescription</strong><div class="meta">Enable for prescription-only medication.</div></div><label class="switch"><input asp-for="RequiresPrescription" id="rxToggle"/><span class="slider"></span></label></div><div class="form-group rx-note" id="rxNote"><label asp-for="PrescriptionNote">Prescription Instructions</label><textarea asp-for="PrescriptionNote" rows="3" class="form-control"></textarea></div></div></div>
</div><div class="col-lg-4"><div class="card form-card mb-4"><div class="card-header">Product Image</div><div class="card-body"><div class="image-drop"><img id="preview" class="image-preview" src="@(string.IsNullOrWhiteSpace(Model.ImageUrl)?"/images/product_01.png":Model.ImageUrl)" alt="@Model.ProductName"/><div class="small text-muted mb-3">Choose a new image only if you want to replace the current one.</div><input asp-for="File" id="imageInput" type="file" accept="image/png,image/jpeg" class="form-control-file"/></div></div></div><div class="card form-card mb-4"><div class="card-body"><div class="small text-muted">Created</div><strong>@Model.CreatedAt.ToString("MMM dd, yyyy")</strong>@if(Model.UpdatedAt.HasValue){<div class="small text-muted mt-3">Last updated</div><strong>@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</strong>}</div></div><button class="btn btn-success btn-block" type="submit"><i class="fas fa-save mr-1"></i> Save Changes</button><a href="@Url.Action("Details","Product",new{id=Model.ProductId})" class="btn btn-outline-info btn-block">View Details</a><a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary btn-block">Cancel</a></div></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(function(){const rx=document.getElementById('rxToggle'),note=document.getElementById('rxNote'),input=document.getElementById('imageInput'),preview=document.getElementById('preview');function sync(){note.classList.toggle('show',rx.checked);}rx.addEventListener('change',sync);sync();input.addEventListener('change',function(){const f=this.files&&this.files[0];if(!f)return;const r=new FileReader();r.onload=e=>preview.src=e.target.result;r.readAsDataURL(f);});})();</script>}
