@model PharmaCare.Models.User
@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var roleClass = Model.Role == "Admin" ? "danger" : Model.Role == "Pharmacist" ? "warning" : "info";
    var initials = $"{(string.IsNullOrWhiteSpace(Model.FirstName) ? "U" : Model.FirstName.Substring(0,1))}{(string.IsNullOrWhiteSpace(Model.LastName) ? "" : Model.LastName.Substring(0,1))}".ToUpper();
}

@section Styles {
<style>
.user-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:28px 0 18px}.user-head h2{font-weight:750;margin:0}.user-head p{margin:5px 0 0;color:#6c757d}.details-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.details-card .card-header{background:transparent;padding:17px 18px}.details-card .card-body{padding:20px}.profile-hero{display:flex;align-items:center;gap:16px}.avatar-lg{width:74px;height:74px;border-radius:18px;background:#edf8f7;color:#0d9488;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:750}.profile-name{font-size:21px;font-weight:750}.subtle{font-size:12px;color:#7a838b}.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.info-box{border:1px solid #e9ecef;border-radius:10px;padding:14px}.info-label{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#7a838b;font-weight:700}.info-value{margin-top:5px;font-weight:650;overflow-wrap:anywhere}.quick-actions{display:grid;gap:9px}.quick-actions .btn{display:flex;align-items:center;justify-content:center;gap:8px;border-radius:9px;min-height:40px;font-weight:700}.status-modal-icon{width:58px;height:58px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:22px;margin:0 auto 14px}.dark-mode .details-card,.dark-mode .info-box,.dark-mode .modal-content{background:#1f1f1f}.dark-mode .info-box{border-color:#383838}.dark-mode .avatar-lg{background:#173634;color:#33c6b8}@@media(max-width:767px){.user-head{align-items:flex-start;flex-direction:column}.info-grid{grid-template-columns:1fr}}
</style>
}

<div class="user-head">
    <div><h2>User Details</h2><p>Review account information, permissions and access status.</p></div>
    <div class="d-flex" style="gap:8px"><a href="@Url.Action("Index","Users")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> Users</a><a href="@Url.Action("Edit","Users",new{id=Model.UserId})" class="btn btn-primary btn-sm"><i class="fas fa-edit mr-1"></i> Edit User</a></div>
</div>

@if (TempData["SuccessMessage"] != null){<div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>}
@if (TempData["ErrorMessage"] != null){<div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>}

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card details-card h-100">
            <div class="card-header"><div class="profile-hero"><div class="avatar-lg">@initials</div><div><div class="profile-name">@Model.FirstName @Model.LastName</div><div class="mt-2"><span class="badge badge-@roleClass mr-1">@Model.Role</span><span class="badge badge-@(Model.IsActive?"success":"secondary")">@(Model.IsActive?"Active":"Inactive")</span></div><div class="subtle mt-2">User ID #@Model.UserId</div></div></div></div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-box"><div class="info-label"><i class="fas fa-envelope mr-1"></i>Email</div><div class="info-value">@Model.Email</div></div>
                    <div class="info-box"><div class="info-label"><i class="fas fa-phone mr-1"></i>Phone</div><div class="info-value">@Model.PhoneNumber</div></div>
                    <div class="info-box"><div class="info-label"><i class="fas fa-map-marker-alt mr-1"></i>Address</div><div class="info-value">@Model.Address</div></div>
                    <div class="info-box"><div class="info-label"><i class="fas fa-city mr-1"></i>City</div><div class="info-value">@Model.City</div></div>
                    <div class="info-box"><div class="info-label"><i class="far fa-calendar-alt mr-1"></i>Joined</div><div class="info-value">@Model.DateCreated.ToString("MMM dd, yyyy")</div></div>
                    <div class="info-box"><div class="info-label"><i class="fas fa-shield-alt mr-1"></i>Account Access</div><div class="info-value @(Model.IsActive?"text-success":"text-muted")">@(Model.IsActive?"Enabled":"Disabled")</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-4">
        <div class="card details-card">
            <div class="card-header"><strong>Account Actions</strong><div class="subtle">Administrative controls for this account</div></div>
            <div class="card-body quick-actions">
                <a href="@Url.Action("Edit","Users",new{id=Model.UserId})" class="btn btn-primary"><i class="fas fa-user-edit"></i> Edit Account</a>
                <a href="@Url.Action("ResetPassword","Users",new{id=Model.UserId})" class="btn btn-outline-warning"><i class="fas fa-key"></i> Reset Password</a>
                <button type="button" class="btn @(Model.IsActive?"btn-outline-danger":"btn-outline-success")" data-toggle="modal" data-target="#statusModal"><i class="fas @(Model.IsActive?"fa-user-slash":"fa-user-check")"></i> @(Model.IsActive?"Deactivate User":"Activate User")</button>
                <a href="@Url.Action("Delete","Users",new{id=Model.UserId})" class="btn btn-outline-danger"><i class="fas fa-trash-alt"></i> Delete User</a>
                <a href="@Url.Action("Index","Users")" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to Users</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 rounded-lg">
            <form asp-action="ToggleStatus" asp-controller="Users" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <div class="modal-body text-center p-4">
                    <div class="status-modal-icon @(Model.IsActive?"bg-danger text-white":"bg-success text-white")"><i class="fas @(Model.IsActive?"fa-user-slash":"fa-user-check")"></i></div>
                    <h5 class="font-weight-bold">@(Model.IsActive?"Deactivate this user?":"Activate this user?")</h5>
                    <p class="text-muted mb-0">@(Model.IsActive ? "This account will no longer be able to sign in until it is activated again." : "This account will regain access and will be able to sign in again.")</p>
                </div>
                <div class="modal-footer border-0 d-flex justify-content-center pb-4">
                    <button type="button" class="btn btn-outline-secondary px-4" data-dismiss="modal">Keep Current Status</button>
                    <button type="submit" class="btn @(Model.IsActive?"btn-danger":"btn-success") px-4"><i class="fas @(Model.IsActive?"fa-user-slash":"fa-user-check") mr-1"></i> @(Model.IsActive?"Confirm Deactivate":"Confirm Activate")</button>
                </div>
            </form>
        </div>
    </div>
</div>
