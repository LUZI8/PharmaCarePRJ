@model MarketplaceHomeViewModel
@{
    ViewData["Title"] = "PharmaCare Marketplace";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--mk:#0d9488;--mk2:#0f766e;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a;--soft:#183531}.market{background:#f7fbfa;color:var(--ink);min-height:100vh}.dark-mode .market{background:#151a1d}.mk-hero{padding:68px 0 92px;background:linear-gradient(135deg,#073f45,#0d9488 55%,#2bb6ad);color:#fff;position:relative;overflow:hidden}.mk-hero:after{content:"";position:absolute;width:520px;height:520px;border:1px solid rgba(255,255,255,.13);border-radius:50%;right:-120px;top:-250px}.mk-hero h1{font-size:clamp(42px,6vw,74px);max-width:820px;line-height:1.02;letter-spacing:-2px;margin:0 0 18px}.mk-hero p{max-width:650px;font-size:16px;color:rgba(255,255,255,.82);line-height:1.7}.mk-search{margin-top:30px;background:#fff;border-radius:18px;padding:9px;display:grid;grid-template-columns:190px 1fr 130px;gap:8px;max-width:900px;box-shadow:0 20px 45px rgba(0,0,0,.17);position:relative;z-index:2}.mk-search input,.mk-search select{border:0;outline:0;background:#f6f9f9;border-radius:12px;padding:0 15px;height:52px;font-size:13px}.mk-search button{border:0;border-radius:12px;background:#0d9488;color:#fff;font-weight:700}.mk-trust{display:flex;gap:18px;flex-wrap:wrap;margin-top:24px;font-size:11px;color:rgba(255,255,255,.84)}.mk-section{padding:54px 0}.mk-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:22px}.mk-head h2{font-size:30px;margin:0}.mk-head p{font-size:12px;color:var(--muted);margin:5px 0 0}.pharmacies{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.pharmacy-card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:18px;transition:.25s;display:block;color:var(--ink)}.pharmacy-card:hover{transform:translateY(-5px);box-shadow:0 20px 40px rgba(25,67,72,.1);color:var(--ink)}.pharmacy-top{display:flex;gap:13px;align-items:center}.ph-logo{width:56px;height:56px;border-radius:16px;background:var(--soft);display:grid;place-items:center;color:var(--mk);font-size:23px}.pharmacy-card h3{font-size:16px;margin:0 0 4px}.ph-meta{font-size:10px;color:var(--muted)}.ph-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}.ph-stat strong{display:block;font-size:12px}.ph-stat span{font-size:9px;color:var(--muted)}.open{color:#17864d}.closed{color:#c54d47}.offers{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.offer{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.25s}.offer:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgba(25,67,72,.09)}.offer-media{height:190px;background:#fff;display:grid;place-items:center;padding:18px;position:relative}.dark-mode .offer-media{background:#252d31}.offer-media img{max-width:100%;max-height:150px;object-fit:contain}.offer-rx{position:absolute;top:12px;left:12px;border-radius:999px;padding:6px 9px;background:#dff4fa;color:#087a96;font-size:8px;font-weight:700}.offer-body{padding:15px}.offer-store{font-size:9px;color:var(--mk);font-weight:700;text-transform:uppercase}.offer h3{font-size:14px;line-height:1.35;margin:6px 0}.offer-price{font-size:18px;font-weight:700}.offer-old{font-size:10px;color:#9aa5a8;text-decoration:line-through;margin-left:5px}.offer-foot{display:flex;align-items:center;justify-content:space-between;margin-top:12px}.offer-foot span{font-size:9px;color:var(--muted)}.compare{font-size:9px;font-weight:700;color:var(--mk)}.empty{padding:35px;background:var(--card);border:1px dashed var(--line);border-radius:18px;color:var(--muted)}
@@media(max-width:991px){.pharmacies{grid-template-columns:1fr 1fr}.offers{grid-template-columns:1fr 1fr}.mk-search{grid-template-columns:150px 1fr 110px}}
@@media(max-width:575px){.mk-hero{padding:48px 0 64px}.mk-hero h1{font-size:40px}.mk-search{grid-template-columns:1fr}.mk-search button{height:48px}.pharmacies,.offers{grid-template-columns:1fr}.mk-section{padding:40px 0}.mk-head{align-items:flex-start;flex-direction:column}.ph-stats{grid-template-columns:1fr 1fr 1fr}}
</style>
}
<div class="market">
<section class="mk-hero"><div class="container"><div style="position:relative;z-index:2"><div style="font-size:11px;font-weight:700;letter-spacing:1px;margin-bottom:13px">PHARMACIES NEAR YOU</div><h1>Your pharmacy, delivered.</h1><p>Compare live prices and availability across trusted pharmacies, reserve prescription medicines, and choose the delivery option that works for you.</p>
<form class="mk-search" method="get" action="/Marketplace"><select name="city"><option selected>@Model.City</option></select><input name="q" value="@Model.Query" placeholder="Search medicine, category or pharmacy need..." autocomplete="off"/><button type="submit"><i class="fas fa-search"></i> Search</button></form>
<div class="mk-trust"><span><i class="fas fa-check-circle"></i> Verified pharmacies</span><span><i class="fas fa-box-open"></i> Live pharmacy stock</span><span><i class="fas fa-prescription"></i> Prescription-aware ordering</span><span><i class="fas fa-truck"></i> Delivery estimates</span></div></div></div></section>
<section class="mk-section"><div class="container"><div class="mk-head"><div><h2>Pharmacies near you</h2><p>Choose by rating, delivery time, price and availability.</p></div><span style="font-size:11px;color:var(--muted)">@Model.Pharmacies.Count verified pharmacies</span></div>
<div class="pharmacies">@foreach(var p in Model.Pharmacies){<a class="pharmacy-card" href="/Marketplace/Pharmacy/@p.PharmacyId"><div class="pharmacy-top"><div class="ph-logo"><i class="fas fa-clinic-medical"></i></div><div><h3>@p.Name</h3><div class="ph-meta"><i class="fas fa-map-marker-alt"></i> @p.Address</div></div></div><div class="ph-stats"><div class="ph-stat"><strong>★ @p.Rating</strong><span>@p.RatingCount ratings</span></div><div class="ph-stat"><strong>@p.DeliveryMinutes min</strong><span>Delivery</span></div><div class="ph-stat"><strong>@(p.DeliveryFee==0?"FREE":"$"+p.DeliveryFee.ToString("0.00"))</strong><span class="@(p.IsOpen?"open":"closed")">@(p.IsOpen?"Open now":"Closed")</span></div></div></a>}</div></div></section>
<section class="mk-section" style="padding-top:10px"><div class="container"><div class="mk-head"><div><h2>@(string.IsNullOrWhiteSpace(Model.Query)?"Popular near you":"Results for “"+Model.Query+"”")</h2><p>Same medicine, different pharmacies — compare before you choose.</p></div></div>
@if(Model.PopularOffers.Any()){<div class="offers">@foreach(var o in Model.PopularOffers){<div class="offer"><a href="/Marketplace/Compare/@o.ProductId"><div class="offer-media">@if(o.RequiresPrescription){<span class="offer-rx"><i class="fas fa-prescription"></i> Prescription</span>}<img src="@o.ImageUrl" alt="@o.ProductName" loading="lazy"/></div></a><div class="offer-body"><div class="offer-store">@o.PharmacyName</div><h3>@o.ProductName</h3><div><span class="offer-price">$@o.Price.ToString("0.00")</span>@if(o.CompareAtPrice.HasValue){<span class="offer-old">$@o.CompareAtPrice.Value.ToString("0.00")</span>}</div><div class="offer-foot"><span><i class="fas fa-bolt"></i> @o.DeliveryMinutes min · @o.Stock in stock</span><a class="compare" href="/Marketplace/Compare/@o.ProductId">Compare →</a></div></div></div>}</div>}else{<div class="empty">No matching medicines found in @Model.City. Try a shorter medicine name or browse a pharmacy directly.</div>}
</div></section></div>