@model PharmaCare.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Product Gallery";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
}

@section Styles{
<style>
.gallery-page{padding:28px 0 40px}.gallery-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px}.gallery-head h2{margin:0;font-weight:800}.gallery-head p{margin:6px 0 0;color:#6f7b80}.gallery-shell{background:#fff;border-radius:16px;box-shadow:0 8px 28px rgba(0,0,0,.06);padding:22px}.upload-zone{border:2px dashed #cfdad9;border-radius:14px;padding:26px;text-align:center;background:#fbfdfd}.upload-zone input{max-width:440px;margin:16px auto 0}.gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:20px}.gallery-card{border:1px solid #e4eceb;border-radius:14px;padding:12px;background:#fff;position:relative}.gallery-card.primary{border-color:#0d9488;box-shadow:0 0 0 3px rgba(13,148,136,.09)}.gallery-card img{width:100%;height:190px;object-fit:contain;border-radius:10px;background:#f7f9fa}.gallery-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px}.gallery-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.primary-badge{display:inline-flex;align-items:center;gap:5px;background:#e8f8f4;color:#0f766e;border-radius:999px;padding:5px 9px;font-size:11px;font-weight:700}.empty-state{text-align:center;padding:34px;color:#7d898e}.dark-mode .gallery-shell,.dark-mode .gallery-card{background:#20282c;color:#eef4f5}.dark-mode .upload-zone{background:#252f33;border-color:#3c4a4e}.dark-mode .gallery-card{border-color:#364448}@@media(max-width:991px){.gallery-grid{grid-template-columns:repeat(2,1fr)}}@@media(max-width:575px){.gallery-head{align-items:flex-start;flex-direction:column}.gallery-grid{grid-template-columns:1fr}.gallery-card img{height:220px}}
</style>
}

<div class="gallery-page">
    <div class="gallery-head">
        <div>
            <h2>Product Gallery</h2>
            <p>Manage up to 5 images for <strong>@Model.ProductName</strong>. Pick one primary image for cards and listings.</p>
        </div>
        <div>
            <a href="@Url.Action("Edit","Product",new{id=Model.ProductId})" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> Back to Product</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="gallery-shell">
        <form asp-action="UploadImages" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="upload-zone">
                <i class="far fa-images fa-2x text-info mb-2"></i>
                <h5 class="mb-1">Add product photos</h5>
                <p class="small text-muted mb-0">Choose multiple JPG/PNG images. Maximum 5 gallery images per product.</p>
                <input type="file" name="galleryFiles" accept="image/png,image/jpeg" multiple class="form-control-file" />
                <button class="btn btn-success mt-3" type="submit"><i class="fas fa-cloud-upload-alt mr-1"></i> Upload Images</button>
            </div>
        </form>

        @if (Model.ExistingImages.Any())
        {
            <div class="gallery-grid">
                @foreach (var image in Model.ExistingImages.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.DisplayOrder))
                {
                    <div class="gallery-card @(image.IsPrimary ? "primary" : "")">
                        <img src="@image.ImageUrl" alt="@Model.ProductName" />
                        <div class="gallery-meta">
                            <span class="small text-muted">Image #@(image.DisplayOrder + 1)</span>
                            @if (image.IsPrimary)
                            {
                                <span class="primary-badge"><i class="fas fa-star"></i> Primary</span>
                            }
                        </div>
                        <div class="gallery-actions">
                            @if (!image.IsPrimary)
                            {
                                <form asp-action="SetPrimaryImage" asp-route-id="@Model.ProductId" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="imageId" value="@image.ProductImageId" />
                                    <button class="btn btn-outline-info btn-sm" type="submit"><i class="fas fa-star mr-1"></i> Set Primary</button>
                                </form>
                            }
                            <form asp-action="DeleteGalleryImage" asp-route-id="@Model.ProductId" method="post" onsubmit="return confirm('Remove this image from the product gallery?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="imageId" value="@image.ProductImageId" />
                                <button class="btn btn-outline-danger btn-sm" type="submit"><i class="fas fa-trash mr-1"></i> Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state"><i class="far fa-images fa-2x mb-2"></i><div>No gallery images yet. The existing legacy product image will continue to be used until you upload gallery photos.</div></div>
        }
    </div>
</div>
