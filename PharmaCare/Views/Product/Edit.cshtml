@model PharmaCare.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Adminlayout.cshtml";
    var galleryCount = Model.ExistingImages?.Count ?? 0;
}

@section Styles{
<style>
:root{--pc:#0d9488;--pc-dark:#0f766e;--pc-soft:#ecfdf8;--ink:#17212b;--muted:#6b7785;--line:#e5eaf0;--surface:#fff;--surface-soft:#f8fafc;--danger:#dc3545;--shadow:0 10px 30px rgba(15,23,42,.07)}
.product-edit-page{max-width:1440px;margin:0 auto;padding:24px 4px 44px}.page-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}.page-title h1{font-size:28px;font-weight:800;color:var(--ink);margin:0 0 5px}.page-title p{margin:0;color:var(--muted);font-size:14px}.page-actions{display:flex;align-items:center;gap:9px}.back-btn,.storefront-btn{border-radius:10px;font-weight:700;padding:9px 14px}.storefront-btn{border:1px solid var(--pc);color:var(--pc);background:#fff;transition:.18s}.storefront-btn:hover{background:var(--pc);border-color:var(--pc);color:#fff;transform:translateY(-1px);box-shadow:0 8px 20px rgba(13,148,136,.14)}
.pc-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(330px,.8fr);gap:20px;align-items:start}.pc-card{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden;margin-bottom:18px}.pc-card-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px}.pc-card-head h3{font-size:17px;font-weight:800;color:var(--ink);margin:0}.pc-card-head p{font-size:12px;color:var(--muted);margin:4px 0 0}.pc-card-body{padding:20px}.section-kicker{font-size:11px;letter-spacing:.7px;text-transform:uppercase;color:var(--pc);font-weight:800;margin-bottom:14px}.form-control{border-radius:10px;min-height:44px;border-color:#d9e0e6}.form-control:focus{border-color:var(--pc);box-shadow:0 0 0 3px rgba(13,148,136,.12)}textarea.form-control{min-height:150px;resize:vertical}.field-help{font-size:11px;color:#87929d;margin-top:5px}.input-group-text{border-color:#d9e0e6;background:#f3f6f8;color:#5f6b76}.divider{height:1px;background:var(--line);margin:20px 0}
.core-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.price-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}.product-description{min-height:190px}
.switch-row{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:16px;border:1px solid var(--line);border-radius:13px;background:var(--surface-soft);margin-bottom:12px}.switch-copy strong{display:block;color:var(--ink)}.switch-copy span{display:block;color:var(--muted);font-size:12px;margin-top:3px}.switch{position:relative;display:inline-block;width:48px;height:26px;flex:none}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#cbd3d9;border-radius:999px;cursor:pointer;transition:.2s}.slider:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 4px rgba(0,0,0,.2)}.switch input:checked+.slider{background:var(--pc)}.switch input:checked+.slider:before{transform:translateX(22px)}
.advanced-card{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--surface)}.advanced-toggle{width:100%;border:0;background:transparent;padding:17px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:left;color:var(--ink);cursor:pointer}.advanced-toggle:hover{background:#fafcfd}.advanced-title{display:flex;align-items:center;gap:10px;font-weight:800}.advanced-title i{color:var(--pc)}.advanced-meta{display:block;font-size:11px;color:var(--muted);font-weight:400;margin-top:2px}.advanced-chevron{transition:.22s;color:#6b7785}.advanced-toggle[aria-expanded="true"] .advanced-chevron{transform:rotate(180deg)}.advanced-body{display:none;border-top:1px solid var(--line);padding:18px}.advanced-body.show{display:block}.advanced-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}.rx-note{display:none;margin-top:12px}.rx-note.show{display:block}
.gallery-card{position:sticky;top:88px}.image-drop{border:2px dashed #cfd8df;border-radius:16px;padding:18px;background:linear-gradient(180deg,#fff,#fbfdfe)}.drop-intro{text-align:center;padding:8px 5px 12px}.drop-icon{width:52px;height:52px;border-radius:14px;background:var(--pc-soft);color:var(--pc);display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:10px}.drop-intro h4{font-size:15px;font-weight:800;margin:0 0 5px;color:var(--ink)}.drop-intro p{font-size:12px;color:var(--muted);margin:0 0 10px}.gallery-count{font-size:12px;color:var(--muted);font-weight:700}.gallery-previews{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:16px}.gallery-preview-item{position:relative;border:1px solid var(--line);border-radius:13px;background:#fff;padding:8px;min-height:165px;display:flex;flex-direction:column;justify-content:center;transition:.18s}.gallery-preview-item:hover{transform:translateY(-2px);box-shadow:0 7px 18px rgba(15,23,42,.08)}.gallery-preview-item.primary{border-color:var(--pc);box-shadow:0 0 0 2px rgba(13,148,136,.08)}.gallery-preview-item img{width:100%;height:105px;object-fit:contain;border-radius:8px;background:#f8fafc}.primary-badge{position:absolute;left:8px;top:8px;background:var(--pc);color:#fff;font-size:10px;font-weight:800;padding:4px 8px;border-radius:999px;z-index:2}.gallery-preview-actions{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}.gallery-preview-actions form{margin:0;flex:1}.gallery-preview-actions .btn{width:100%;font-size:10px;padding:6px;border-radius:8px;font-weight:700}.delete-confirm{display:none;margin-top:8px;padding:9px;border:1px solid #f2c7cc;background:#fff5f6;border-radius:9px}.delete-confirm.show{display:block}.delete-confirm .small{display:block;color:#8b2530;margin-bottom:7px}.delete-confirm-actions{display:flex;gap:6px}.delete-confirm-actions .btn{flex:1;font-size:10px}.upload-inline{display:flex;align-items:center;justify-content:center;margin-top:10px}.upload-inline input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}.upload-picker{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 15px;border:1px solid #b9c8d2;border-radius:10px;background:#fff;color:var(--ink);font-weight:800;font-size:13px;cursor:pointer;transition:.18s}.upload-picker:hover{border-color:var(--pc);color:var(--pc);transform:translateY(-1px);box-shadow:0 7px 18px rgba(15,23,42,.07)}.upload-picker.busy{opacity:.65;pointer-events:none}.gallery-note{font-size:11px;color:#7b8792;text-align:center;margin-top:10px}.empty-gallery{text-align:center;padding:24px;color:#7b8589}
.action-panel{display:grid;gap:10px;margin-top:16px}.save-btn{border:0;border-radius:11px;background:var(--pc);color:#fff;font-weight:800;min-height:46px;transition:.18s}.save-btn:hover{background:var(--pc-dark);transform:translateY(-1px);box-shadow:0 8px 20px rgba(13,148,136,.2);color:#fff}.cancel-btn{border-radius:11px;font-weight:750;min-height:44px;display:flex;align-items:center;justify-content:center}.summary-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:13px}.summary-pill{border:1px solid var(--line);border-radius:10px;padding:9px;text-align:center;background:#fafcfd}.summary-pill strong{display:block;font-size:11px;color:var(--ink)}.summary-pill span{display:block;font-size:10px;color:var(--muted);margin-top:2px}
.dark-mode{--ink:#eef2f4;--muted:#9aa6b2;--line:#343b42;--surface:#1c1f22;--surface-soft:#24282c;--shadow:none}.dark-mode .pc-card,.dark-mode .advanced-card{background:var(--surface)}.dark-mode .form-control{background:#24282c;color:#eef2f4;border-color:#3b434a}.dark-mode .input-group-text{background:#2a2f33;color:#c6cdd3;border-color:#3b434a}.dark-mode .image-drop{background:#202428;border-color:#424b52}.dark-mode .gallery-preview-item{background:#24282c;border-color:#3b434a}.dark-mode .gallery-preview-item img{background:#1b1e21}.dark-mode .advanced-toggle:hover{background:#23272a}.dark-mode .summary-pill{background:#23272a}.dark-mode .delete-confirm{background:#351f22;border-color:#69353c}.dark-mode .delete-confirm .small{color:#ffb8c0}.dark-mode .upload-picker,.dark-mode .storefront-btn{background:#24282c;color:#5eead4;border-color:#2dd4bf}.dark-mode .storefront-btn:hover{background:#5eead4;color:#062c29}
@@media(max-width:1100px){.pc-grid{grid-template-columns:1fr}.gallery-card{position:static}.gallery-previews{grid-template-columns:repeat(3,minmax(0,1fr))}}
@@media(max-width:767px){.product-edit-page{padding:15px 0 28px}.page-head{align-items:flex-start;flex-direction:column}.page-actions{width:100%;display:grid;grid-template-columns:1fr 1fr}.page-title h1{font-size:24px}.core-row,.price-row,.advanced-grid{grid-template-columns:1fr}.pc-card{border-radius:14px}.pc-card-body{padding:16px}.gallery-previews{grid-template-columns:1fr 1fr}.summary-strip{grid-template-columns:1fr}.back-btn,.storefront-btn{width:100%;text-align:center}}
@@media(max-width:480px){.page-actions{grid-template-columns:1fr}.gallery-previews{grid-template-columns:1fr}.switch-row{align-items:flex-start}.image-drop{padding:13px}.pc-card-head{padding:15px 16px}}
</style>
}

<div class="product-edit-page">
    <div class="page-head">
        <div class="page-title"><h1>Edit Product</h1><p>Update the product and manage storefront images from the same workspace.</p></div>
        <div class="page-actions">
            <a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary back-btn js-inventory-back"><i class="fas fa-arrow-left mr-1"></i> Back to Inventory</a>
            <a href="@Url.Action("ShopSingle","FrontEnd",new{id=Model.ProductId})" class="btn storefront-btn" target="_blank" rel="noopener"><i class="fas fa-external-link-alt mr-1"></i> View Storefront</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
    @if (TempData["ErrorMessage"] != null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}

    <div class="pc-grid">
        <div>
            <form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" id="editProductForm">
                @Html.AntiForgeryToken()
                <input asp-for="ProductId" type="hidden"/>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <section class="pc-card">
                    <div class="pc-card-head"><div><h3>Product Details</h3><p>The customer-facing information for this product.</p></div><i class="fas fa-box-open text-muted"></i></div>
                    <div class="pc-card-body">
                        <div class="section-kicker">Core information</div>
                        <div class="form-group"><label asp-for="ProductName">Product Name</label><input asp-for="ProductName" class="form-control"/><span asp-validation-for="ProductName" class="text-danger small"></span></div>
                        <div class="core-row">
                            <div class="form-group"><label asp-for="CategoryID">Category</label><select asp-for="CategoryID" asp-items="Model.ListOfCategories" class="form-control"></select><span asp-validation-for="CategoryID" class="text-danger small"></span></div>
                            <div class="form-group"><label asp-for="Manufacturer">Manufacturer</label><input asp-for="Manufacturer" class="form-control" placeholder="Manufacturer or supplier brand"/><span asp-validation-for="Manufacturer" class="text-danger small"></span></div>
                        </div>
                        <div class="form-group mb-0"><label asp-for="Description">Product Description</label><textarea asp-for="Description" class="form-control product-description" placeholder="Describe strength, dosage form, pack size, intended use and relevant customer information."></textarea><div class="field-help">This description appears on the storefront product page.</div></div>
                    </div>
                </section>

                <section class="pc-card">
                    <div class="pc-card-head"><div><h3>Price, Stock & Availability</h3><p>Keep selling information accurate and current.</p></div><i class="fas fa-cubes text-muted"></i></div>
                    <div class="pc-card-body">
                        <div class="price-row">
                            <div class="form-group"><label asp-for="Price">Unit Price</label><div class="input-group"><div class="input-group-prepend"><span class="input-group-text">$</span></div><input asp-for="Price" type="number" min="0.01" step="0.01" class="form-control"/></div><span asp-validation-for="Price" class="text-danger small"></span></div>
                            <div class="form-group"><label asp-for="Stock">Current Stock</label><div class="input-group"><input asp-for="Stock" type="number" min="0" class="form-control"/><div class="input-group-append"><span class="input-group-text">units</span></div></div><span asp-validation-for="Stock" class="text-danger small"></span></div>
                            <div class="form-group"><label asp-for="ExpiryDate">Expiry Date</label><input asp-for="ExpiryDate" type="date" class="form-control"/><span asp-validation-for="ExpiryDate" class="text-danger small"></span></div>
                        </div>
                        <div class="field-help"><i class="fas fa-shield-alt text-warning mr-1"></i>Always verify expiry directly from manufacturer packaging.</div>
                        <div class="divider"></div>
                        <div class="switch-row"><div class="switch-copy"><strong>Active Product</strong><span>Visible to customers when stock and expiry rules allow it.</span></div><label class="switch"><input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")/><span class="slider"></span></label></div>
                        <div class="switch-row mb-0"><div class="switch-copy"><strong>Requires Prescription</strong><span>Enable this only for prescription-controlled medicines.</span></div><label class="switch"><input type="checkbox" name="RequiresPrescription" value="true" id="rxToggle" @(Model.RequiresPrescription ? "checked" : "")/><span class="slider"></span></label></div>
                    </div>
                </section>

                <section class="advanced-card mb-4">
                    <button type="button" class="advanced-toggle" id="advancedToggle" aria-expanded="false">
                        <span class="advanced-title"><i class="fas fa-sliders-h"></i><span>Advanced Settings<span class="advanced-meta">Internal stock identifiers, alerts and prescription instructions.</span></span></span>
                        <i class="fas fa-chevron-down advanced-chevron"></i>
                    </button>
                    <div class="advanced-body" id="advancedBody">
                        <div class="advanced-grid">
                            <div class="form-group"><label asp-for="SKU">SKU</label><input asp-for="SKU" class="form-control"/><div class="field-help">Internal stock code.</div><span asp-validation-for="SKU" class="text-danger small"></span></div>
                            <div class="form-group"><label asp-for="Barcode">Barcode</label><input asp-for="Barcode" class="form-control"/><div class="field-help">Barcode / GTIN for scanning.</div><span asp-validation-for="Barcode" class="text-danger small"></span></div>
                            <div class="form-group"><label asp-for="ReorderLevel">Low Stock Alert</label><input asp-for="ReorderLevel" type="number" min="0" class="form-control"/><div class="field-help">Warn when stock reaches this level.</div></div>
                        </div>
                        <div class="form-group rx-note" id="rxNote"><label asp-for="PrescriptionNote">Prescription Instructions</label><textarea asp-for="PrescriptionNote" rows="3" class="form-control" placeholder="Optional instructions shown to customers."></textarea></div>
                    </div>
                </section>
            </form>
        </div>

        <aside class="gallery-card">
            <section class="pc-card">
                <div class="pc-card-head"><div><h3>Product Gallery</h3><p>Manage the same storefront gallery used when creating products.</p></div><i class="far fa-images text-muted"></i></div>
                <div class="pc-card-body">
                    <div class="image-drop">
                        <div class="drop-intro"><span class="drop-icon"><i class="far fa-image"></i></span><h4>Product images</h4><p>Add up to 5 images. Choose the primary image for cards and listings.</p><div class="gallery-count">@galleryCount / 5 images</div></div>

                        @if(galleryCount < 5)
                        {
                            <form asp-action="UploadImages" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data" class="upload-inline" id="editGalleryUploadForm">
                                @Html.AntiForgeryToken()
                                <input id="editGalleryFiles" type="file" name="galleryFiles" accept="image/png,image/jpeg" multiple required/>
                                <label for="editGalleryFiles" class="upload-picker" id="editGalleryPicker"><i class="fas fa-plus"></i> Add image(s)</label>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info py-2 small mb-0">Maximum gallery size reached. Delete one image to add another.</div>
                        }

                        @if(Model.ExistingImages != null && Model.ExistingImages.Any())
                        {
                            <div class="gallery-previews">
                                @foreach(var image in Model.ExistingImages.OrderByDescending(x=>x.IsPrimary).ThenBy(x=>x.DisplayOrder))
                                {
                                    <div class="gallery-preview-item @(image.IsPrimary ? "primary" : "")">
                                        @if(image.IsPrimary){<span class="primary-badge"><i class="fas fa-star mr-1"></i>Primary</span>}
                                        <img src="@image.ImageUrl" alt="@Model.ProductName"/>
                                        <div class="gallery-preview-actions">
                                            @if(!image.IsPrimary)
                                            {
                                                <form asp-action="SetPrimaryImage" asp-route-id="@Model.ProductId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="imageId" value="@image.ProductImageId"/><button class="btn btn-outline-info" type="submit"><i class="fas fa-star mr-1"></i>Primary</button></form>
                                            }
                                            <button type="button" class="btn btn-outline-danger js-delete-image" data-target="delete-@image.ProductImageId"><i class="fas fa-trash mr-1"></i>Delete</button>
                                        </div>
                                        <div class="delete-confirm" id="delete-@image.ProductImageId">
                                            <span class="small">Remove this image from the product?</span>
                                            <div class="delete-confirm-actions">
                                                <form asp-action="DeleteGalleryImage" asp-route-id="@Model.ProductId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="imageId" value="@image.ProductImageId"/><button class="btn btn-danger" type="submit">Yes, delete</button></form>
                                                <button class="btn btn-light js-cancel-delete" type="button" data-target="delete-@image.ProductImageId">Cancel</button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-gallery"><i class="far fa-images fa-2x mb-2"></i><div>No product images yet.</div></div>
                        }
                        <div class="gallery-note">Choose Add image(s), select the files, and they upload immediately. Primary controls the storefront card image.</div>
                    </div>

                    <div class="summary-strip"><div class="summary-pill"><strong>5 max</strong><span>Gallery images</span></div><div class="summary-pill"><strong>Primary</strong><span>Choose anytime</span></div><div class="summary-pill"><strong>Storefront</strong><span>Live gallery</span></div></div>
                    <div class="action-panel">
                        <button class="btn save-btn" type="submit" form="editProductForm"><i class="fas fa-save mr-1"></i> Save Product Changes</button>
                        <a href="@Url.Action("Index","Product")" class="btn btn-outline-secondary cancel-btn js-inventory-back">Cancel</a>
                    </div>
                </div>
            </section>
        </aside>
    </div>
</div>

@section Scripts{
<partial name="_ValidationScriptsPartial"/>
<script>
(function(){
    const inventoryUrl='@Url.Action("Index","Product")';
    const editorUrl=window.location.href;
    if(!history.state || history.state.page!=='product-editor'){
        history.replaceState({page:'product-inventory-fallback'},'',inventoryUrl);
        history.pushState({page:'product-editor'},'',editorUrl);
    }
    window.addEventListener('popstate',()=>window.location.replace(inventoryUrl));
    document.querySelectorAll('.js-inventory-back').forEach(link=>link.addEventListener('click',e=>{e.preventDefault();history.back();}));

    const rx=document.getElementById('rxToggle');
    const note=document.getElementById('rxNote');
    const body=document.getElementById('advancedBody');
    const toggle=document.getElementById('advancedToggle');
    const uploadInput=document.getElementById('editGalleryFiles');
    const uploadForm=document.getElementById('editGalleryUploadForm');
    const uploadPicker=document.getElementById('editGalleryPicker');
    function setAdvanced(open){body.classList.toggle('show',open);toggle.setAttribute('aria-expanded',open?'true':'false');}
    function syncRx(){note.classList.toggle('show',rx.checked);if(rx.checked)setAdvanced(true);}
    toggle.addEventListener('click',()=>setAdvanced(!body.classList.contains('show')));
    rx.addEventListener('change',syncRx);
    syncRx();
    if(uploadInput && uploadForm){
        uploadInput.addEventListener('change',()=>{
            if(!uploadInput.files || !uploadInput.files.length)return;
            if(uploadPicker){uploadPicker.classList.add('busy');uploadPicker.innerHTML='<i class="fas fa-spinner fa-spin"></i> Uploading...';}
            uploadForm.submit();
        });
    }
    document.querySelectorAll('.js-delete-image').forEach(btn=>btn.addEventListener('click',()=>{document.getElementById(btn.dataset.target)?.classList.add('show');}));
    document.querySelectorAll('.js-cancel-delete').forEach(btn=>btn.addEventListener('click',()=>{document.getElementById(btn.dataset.target)?.classList.remove('show');}));
})();
</script>
}
