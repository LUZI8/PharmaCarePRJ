@{
    ViewData["Title"] = "Verify Email - PharmaCare";
    Layout = null;
    var email = ViewBag.Email as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css?family=Rubik:400,700|Crimson+Text:400,400i" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/AccountViewStyles/Login.css" />
    <link rel="icon" href="~/assets/favicon-32x32.png" type="image/png">
</head>
<body class="dark-mode">
    <div class="header">
        <div class="logo">
            <a href="/">PHARMACARE</a>
        </div>
        <div class="theme-toggle">
            <button id="theme-toggle-btn">
                <span class="sun-icon">☀️</span>
                <span class="moon-icon" style="display: none;">🌙</span>
            </button>
        </div>
    </div>

    <div class="login-container">
        <h2 class="form-title">Verify Your Email</h2>

        @if (ViewBag.InfoMessage != null)
        {
            <div class="error-message" style="background:#0d47a1;">@ViewBag.InfoMessage</div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""].Errors.Count > 0)
        {
            <div class="error-message">@ViewData.ModelState[""].Errors[0].ErrorMessage</div>
        }

        <p style="text-align:center;opacity:.8;margin-bottom:20px;">
            We sent a 6-digit code to <strong>@email</strong>.
        </p>

        <form method="post" action="@Url.Action("VerifyEmail", "Account")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" value="@email" />

            <div class="form-group">
                <label class="form-label" for="Code">Verification Code</label>
                <i class="fas fa-key form-icon"></i>
                <input type="text" class="form-control" id="Code" name="Code"
                       placeholder="Enter 6-digit code" inputmode="numeric" pattern="[0-9]{6}"
                       maxlength="6" autocomplete="one-time-code" required autofocus>
            </div>

            <button type="submit" class="btn">VERIFY</button>
        </form>

        <form method="post" action="@Url.Action("ResendVerificationCode", "Account")" style="margin-top:12px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" value="@email" />
            <button type="submit" class="btn register-btn">RESEND CODE</button>
        </form>

        <div style="text-align:center;margin-top:16px;">
            <a href="@Url.Action("Login", "Account")" class="forgot-password">Back to Sign In</a>
        </div>
    </div>

    <script src="~/assets/js/jquery-3.3.1.min.js"></script>
    <script src="~/assets/js/AccountViewScripts/Login.js "></script>
</body>
</html>
