@model PharmaCare.Models.User
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
<style>
.reset-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:28px 0 18px}.reset-head h2{font-weight:750;margin:0}.reset-head p{margin:5px 0 0;color:#6c757d}.reset-card{border:0;border-radius:12px;box-shadow:0 3px 14px rgba(0,0,0,.06);overflow:hidden}.reset-card .card-header{background:transparent;padding:17px 18px}.reset-card .card-body{padding:22px}.identity-card{border:1px solid #e8ecef;border-radius:10px;padding:14px;margin-bottom:18px}.identity-row{display:flex;justify-content:space-between;gap:14px;padding:6px 0}.identity-row span:first-child{color:#7a838b}.password-wrap{position:relative}.password-wrap .form-control{padding-right:42px;border-radius:8px}.password-toggle{position:absolute;right:12px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:#6c757d;cursor:pointer}.requirements{border:1px solid #e8ecef;border-radius:10px;padding:14px;margin-top:12px}.requirements-title{font-weight:700;font-size:12px;margin-bottom:8px}.req{font-size:12px;color:#7a838b;margin:5px 0}.req.ok{color:#28a745}.subtle{font-size:12px;color:#7a838b}.dark-mode .reset-card,.dark-mode .identity-card,.dark-mode .requirements{background:#1f1f1f}.dark-mode .identity-card,.dark-mode .requirements{border-color:#383838}.dark-mode .form-control{background:#262626;color:#eee;border-color:#444}@@media(max-width:767px){.reset-head{align-items:flex-start;flex-direction:column}}
</style>
}

<div class="reset-head">
    <div><h2>Reset Password</h2><p>Set a new password for this account securely.</p></div>
    <a href="@Url.Action("Details","Users",new{id=Model.UserId})" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i> User Details</a>
</div>

@if (TempData["SuccessMessage"] != null){<div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>}
@if (TempData["ErrorMessage"] != null){<div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>}

<div class="row justify-content-center"><div class="col-xl-8 col-lg-9">
<div class="card reset-card mb-4">
    <div class="card-header"><strong>Reset password for @Model.FirstName @Model.LastName</strong><div class="subtle">This immediately replaces the current password.</div></div>
    <div class="card-body">
        <div class="identity-card"><div class="identity-row"><span>User</span><strong>@Model.FirstName @Model.LastName</strong></div><div class="identity-row"><span>Email</span><strong>@Model.Email</strong></div><div class="identity-row"><span>User ID</span><strong>#@Model.UserId</strong></div></div>
        <form action="@Url.Action("ResetPassword","Users")" method="post" id="reset-password-form">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.UserId" />
            <div class="form-group"><label for="newPassword" class="font-weight-bold">New Password</label><div class="password-wrap"><input type="password" class="form-control" id="newPassword" name="newPassword" autocomplete="new-password" required/><button type="button" class="password-toggle" data-target="newPassword" aria-label="Show password"><i class="fas fa-eye"></i></button></div><div id="password-error" class="text-danger small mt-1"></div>
                <div class="requirements"><div class="requirements-title">Password requirements</div><div class="req" id="length-req"><i class="far fa-circle mr-1"></i>At least 8 characters</div><div class="req" id="uppercase-req"><i class="far fa-circle mr-1"></i>At least one uppercase letter</div><div class="req" id="special-req"><i class="far fa-circle mr-1"></i>At least one special character</div></div>
            </div>
            <div class="form-group mt-4"><label for="confirmPassword" class="font-weight-bold">Confirm New Password</label><div class="password-wrap"><input type="password" class="form-control" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required/><button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Show password"><i class="fas fa-eye"></i></button></div><div id="confirm-password-error" class="text-danger small mt-1"></div></div>
            <div class="alert alert-warning"><i class="fas fa-exclamation-triangle mr-1"></i><small>The user's current password will stop working as soon as this reset is saved.</small></div>
            <div class="d-flex flex-wrap" style="gap:8px"><button type="submit" class="btn btn-warning"><i class="fas fa-key mr-1"></i> Reset Password</button><a href="@Url.Action("Details","Users",new{id=Model.UserId})" class="btn btn-outline-secondary">Cancel</a></div>
        </form>
    </div>
</div>
</div></div>

@section Scripts {
<script>
(function(){const p=document.getElementById('newPassword'),c=document.getElementById('confirmPassword'),form=document.getElementById('reset-password-form');function mark(id,ok){const el=document.getElementById(id);el.classList.toggle('ok',ok);const i=el.querySelector('i');i.className=ok?'fas fa-check-circle mr-1':'far fa-circle mr-1';}function validate(){const v=p.value;mark('length-req',v.length>=8);mark('uppercase-req',/[A-Z]/.test(v));mark('special-req',/[^A-Za-z0-9]/.test(v));document.getElementById('confirm-password-error').textContent=c.value&&c.value!==v?'Passwords do not match.':'';}p.addEventListener('input',validate);c.addEventListener('input',validate);document.querySelectorAll('.password-toggle').forEach(b=>b.addEventListener('click',function(){const input=document.getElementById(this.dataset.target),show=input.type==='password';input.type=show?'text':'password';this.querySelector('i').className=show?'fas fa-eye-slash':'fas fa-eye';}));form.addEventListener('submit',function(e){const v=p.value,valid=v.length>=8&&/[A-Z]/.test(v)&&/[^A-Za-z0-9]/.test(v)&&v===c.value;if(!valid){e.preventDefault();document.getElementById('password-error').textContent='Please meet all password requirements before continuing.';}});})();
</script>
}
