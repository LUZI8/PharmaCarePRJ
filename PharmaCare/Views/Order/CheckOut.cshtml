@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    var user = ViewBag.User ?? new { };
    var cart = ViewBag.Cart ?? new { Items = new List<object>(), SubTotal = 0.0M, Tax = 0.0M, ShippingCost = 0.0M, Total = 0.0M };
    ViewBag.HideCategories = true;
}

@section Styles {
<style>
.checkout-page{--co-accent:#0f9d8f;--co-accent-dark:#08776d;--co-ink:#17212b;--co-muted:#71808d;--co-line:#e3eaee;--co-card:#fff;--co-soft:#f4f8f8;position:relative;background:linear-gradient(180deg,#f6fbfb 0,#fff 340px);padding:38px 0 72px;color:var(--co-ink);overflow:hidden}.checkout-page:before{content:"";position:absolute;width:430px;height:430px;border-radius:50%;right:-180px;top:-180px;background:radial-gradient(circle,rgba(15,157,143,.12),rgba(15,157,143,0) 70%);pointer-events:none}.checkout-shell{max-width:1240px;margin:0 auto;padding:0 22px;position:relative;z-index:1}.checkout-breadcrumb{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--co-muted);margin-bottom:18px}.checkout-breadcrumb a{color:var(--co-muted);text-decoration:none}.checkout-breadcrumb a:hover{color:var(--co-accent)}.checkout-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px;animation:coFade .45s ease both}.checkout-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;background:#eaf8f6;border:1px solid rgba(15,157,143,.2);color:var(--co-accent-dark);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.55px;margin-bottom:10px}.checkout-title{font-size:40px;line-height:1.08;font-weight:850;letter-spacing:-1px;margin:0 0 8px}.checkout-subtitle{font-size:15px;color:var(--co-muted);margin:0;max-width:680px}.checkout-steps{display:flex;gap:8px;align-items:center}.checkout-step{display:flex;align-items:center;gap:7px;padding:9px 11px;border:1px solid var(--co-line);border-radius:12px;background:#fff;color:var(--co-muted);font-size:11px;font-weight:750}.checkout-step.active{border-color:rgba(15,157,143,.25);background:#ecfaf8;color:var(--co-accent-dark)}.checkout-step i{width:18px;height:18px;border-radius:50%;background:#eef4f5;display:flex;align-items:center;justify-content:center;font-size:9px}.checkout-step.active i{background:var(--co-accent);color:#fff}.checkout-grid{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(360px,.82fr);gap:24px;align-items:start}.checkout-card{background:var(--co-card);border:1px solid var(--co-line);border-radius:20px;box-shadow:0 14px 38px rgba(15,23,42,.06);overflow:hidden;animation:coFade .5s ease both}.checkout-card-head{padding:20px 22px;border-bottom:1px solid var(--co-line);display:flex;align-items:center;gap:12px}.checkout-card-head .icon{width:40px;height:40px;border-radius:12px;background:#eaf8f6;color:var(--co-accent);display:grid;place-items:center;flex:none}.checkout-card-head h2{font-size:18px;font-weight:850;margin:0}.checkout-card-head p{font-size:12px;color:var(--co-muted);margin:3px 0 0}.checkout-body{padding:22px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{margin-bottom:16px}.field.full{grid-column:1/-1}.field label{display:block;font-size:12px;font-weight:800;color:var(--co-ink);margin-bottom:7px}.field label .req{color:#dc3545}.field .form-control{height:46px;border:1px solid #d8e2e7;border-radius:11px;background:#fff;padding:0 13px;font-size:14px;box-shadow:none!important;transition:.18s}.field textarea.form-control{height:112px;padding:12px 13px;resize:vertical}.field .form-control:focus{border-color:rgba(15,157,143,.7);box-shadow:0 0 0 3px rgba(15,157,143,.1)!important}.field .form-control[readonly]{background:#f5f7f8;color:#5f6c76}.field small{display:block;color:var(--co-muted);font-size:10.5px;margin-top:6px}.delivery-note{display:flex;gap:10px;align-items:flex-start;padding:13px 14px;border-radius:12px;background:#f7fbfb;border:1px solid #e1efed;color:#53656b;font-size:11px;line-height:1.5}.delivery-note i{color:var(--co-accent);margin-top:2px}.summary-wrap{position:sticky;top:96px}.summary-card{background:#0b3d3b;color:#fff;border-radius:20px;box-shadow:0 18px 42px rgba(5,63,60,.18);overflow:hidden;position:relative;animation:coFade .55s .05s ease both}.summary-card:before{content:"";position:absolute;width:210px;height:210px;border-radius:50%;right:-85px;top:-100px;background:rgba(45,212,191,.12)}.summary-head{position:relative;padding:22px 22px 16px;border-bottom:1px solid rgba(255,255,255,.11)}.summary-head h2{font-size:20px;font-weight:850;margin:0 0 4px}.summary-head p{font-size:12px;color:#b8d1cf;margin:0}.order-list{position:relative;padding:8px 22px 0}.order-item{display:flex;justify-content:space-between;gap:18px;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.09)}.order-item:last-child{border-bottom:0}.order-name{font-size:13px;color:#edf7f6;font-weight:700}.order-qty{font-size:11px;color:#9fc3bf;margin-left:5px}.order-price{font-size:13px;font-weight:800;white-space:nowrap}.totals{position:relative;padding:8px 22px 0}.total-row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:9px 0;color:#cfe0df;font-size:13px}.total-row strong{color:#fff}.total-row.shipping{padding-bottom:14px;border-bottom:1px solid rgba(255,255,255,.12)}.total-row.grand{padding:17px 0 15px;font-size:16px}.total-row.grand strong{font-size:28px;color:#5eead4}.free{color:#5eead4!important;font-weight:850}.payment-box{position:relative;margin:0 22px 16px;padding:15px;border:1px solid rgba(94,234,212,.28);background:rgba(255,255,255,.06);border-radius:14px}.payment-title{display:flex;align-items:center;gap:9px;font-size:13px;font-weight:850;color:#fff;margin-bottom:8px}.payment-title i{width:30px;height:30px;border-radius:9px;background:rgba(94,234,212,.12);display:grid;place-items:center;color:#5eead4}.payment-copy{font-size:11px;line-height:1.55;color:#bfd4d2;margin:0 0 12px}.payment-option-row{display:flex;align-items:center;gap:9px;padding:10px 11px;border-radius:10px;background:rgba(255,255,255,.06);font-size:12px}.payment-option-row input{accent-color:#19b7a8}.place-order-btn{width:calc(100% - 44px);margin:0 22px 12px;border:0;border-radius:12px;min-height:54px;background:#19b7a8;color:#fff;font-weight:850;font-size:14px;display:flex;align-items:center;justify-content:center;gap:9px;box-shadow:0 9px 22px rgba(25,183,168,.25);transition:.2s}.place-order-btn:hover{background:#23c9b9;transform:translateY(-2px)}.back-cart{display:flex;align-items:center;justify-content:center;gap:7px;color:#c4dbd8;text-decoration:none;font-weight:750;font-size:11px;padding:6px 0 18px}.back-cart:hover{color:#fff;text-decoration:none}.summary-trust{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 22px 20px}.summary-trust span{font-size:10px;color:#bdd3d1;display:flex;align-items:center;gap:6px}.summary-trust i{color:#5eead4}.checkout-perks{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}.co-perk{display:grid;grid-template-columns:42px minmax(0,1fr);gap:11px;align-items:center;padding:14px;background:#fff;border:1px solid var(--co-line);border-radius:15px;box-shadow:0 6px 18px rgba(15,23,42,.035)}.co-perk i{width:42px;height:42px;border-radius:12px;background:#eaf8f6;color:var(--co-accent);display:grid;place-items:center}.co-perk strong{display:block;font-size:12px}.co-perk span{display:block;font-size:10px;color:var(--co-muted);line-height:1.45;margin-top:2px}.checkout-error{border:1px solid #f3c4ca;background:#fff1f2;color:#9d2d38;border-radius:13px;padding:12px 14px;margin-bottom:18px;font-size:12px}.dark-mode .checkout-page{--co-ink:#eef4f4;--co-muted:#9ba8ad;--co-line:#2c3b3c;--co-card:#172122;background:linear-gradient(180deg,#101819,#121718 340px)}.dark-mode .checkout-step,.dark-mode .co-perk{background:#172122}.dark-mode .checkout-step.active{background:#173331}.dark-mode .field .form-control{background:#141d1e;border-color:#344445;color:#eef4f4}.dark-mode .field .form-control[readonly]{background:#1a2425;color:#aeb9bc}.dark-mode .delivery-note{background:#142021;border-color:#294041;color:#aebbbc}
@@keyframes coFade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@@media(max-width:991px){.checkout-grid{grid-template-columns:1fr}.summary-wrap{position:static}.checkout-steps{display:none}.checkout-perks{grid-template-columns:repeat(3,1fr)}}
@@media(max-width:767px){.checkout-page{padding:26px 0 48px}.checkout-shell{padding:0 15px}.checkout-title{font-size:32px}.checkout-grid{gap:18px}.checkout-body{padding:17px}.checkout-card-head{padding:17px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.checkout-perks{grid-template-columns:1fr}.summary-card{border-radius:17px}.summary-head,.order-list,.totals{padding-left:18px;padding-right:18px}.payment-box{margin-left:18px;margin-right:18px}.place-order-btn{width:calc(100% - 36px);margin-left:18px;margin-right:18px}.summary-trust{padding-left:18px;padding-right:18px}}
@@media(max-width:420px){.checkout-title{font-size:29px}.checkout-breadcrumb{display:none}.checkout-card-head .icon{width:36px;height:36px}.summary-trust{grid-template-columns:1fr}}
</style>
}

<section class="checkout-page">
    <div class="checkout-shell">
        <div class="checkout-breadcrumb">
            <a href="@Url.Action("Index","FrontEnd")">Home</a>
            <i class="fas fa-chevron-right" style="font-size:8px"></i>
            <a href="@Url.Action("Cart","FrontEnd")">Cart</a>
            <i class="fas fa-chevron-right" style="font-size:8px"></i>
            <span>Checkout</span>
        </div>

        <header class="checkout-hero">
            <div>
                <div class="checkout-kicker"><i class="fas fa-lock"></i> Secure checkout</div>
                <h1 class="checkout-title">Complete your order.</h1>
                <p class="checkout-subtitle">Confirm your delivery information, review your order, then place it securely.</p>
            </div>
            <div class="checkout-steps">
                <div class="checkout-step"><i class="fas fa-shopping-cart"></i> Cart</div>
                <div class="checkout-step active"><i class="fas fa-map-marker-alt"></i> Delivery</div>
                <div class="checkout-step"><i class="fas fa-check"></i> Done</div>
            </div>
        </header>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="checkout-error"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]</div>
        }

        <form asp-controller="Order" asp-action="PlaceOrder" method="post">
            @Html.AntiForgeryToken()
            <div class="checkout-grid">
                <div>
                    <section class="checkout-card">
                        <div class="checkout-card-head">
                            <div class="icon"><i class="fas fa-map-marker-alt"></i></div>
                            <div><h2>Delivery details</h2><p>Make sure the address and phone number are correct.</p></div>
                        </div>
                        <div class="checkout-body">
                            <div class="form-grid">
                                <div class="field">
                                    <label for="firstName">First name <span class="req">*</span></label>
                                    <input type="text" class="form-control" id="firstName" name="firstName" value="@(user?.FirstName ?? "")" readonly>
                                </div>
                                <div class="field">
                                    <label for="lastName">Last name <span class="req">*</span></label>
                                    <input type="text" class="form-control" id="lastName" name="lastName" value="@(user?.LastName ?? "")" readonly>
                                </div>
                                <div class="field full">
                                    <label for="shippingAddress">Full shipping address <span class="req">*</span></label>
                                    <input type="text" class="form-control" id="shippingAddress" name="shippingAddress" value="@(user?.Address ?? "")" placeholder="Street, building, floor and apartment" required>
                                    <small>Please enter the complete delivery address so the driver can reach you easily.</small>
                                </div>
                                <div class="field">
                                    <label for="city">City <span class="req">*</span></label>
                                    <input type="text" class="form-control" id="city" name="city" value="@(user?.City ?? "")" required>
                                </div>
                                <div class="field">
                                    <label for="phoneNumber">Phone <span class="req">*</span></label>
                                    <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber" value="@(user?.PhoneNumber ?? "")" required pattern="[0-9]{10,15}" title="Phone number must be between 10 and 15 digits" minlength="10" maxlength="15">
                                    <small>10–15 digits. Used only for delivery coordination.</small>
                                </div>
                                <div class="field full">
                                    <label for="email">Email address <span class="req">*</span></label>
                                    <input type="email" class="form-control" id="email" name="email" value="@(user?.Email ?? "")" readonly>
                                </div>
                                <div class="field full">
                                    <label for="orderNotes">Delivery notes <span style="font-weight:500;color:var(--co-muted)">(optional)</span></label>
                                    <textarea name="orderNotes" id="orderNotes" class="form-control" placeholder="Landmark, preferred delivery instructions, or anything we should know..."></textarea>
                                </div>
                            </div>
                            <div class="delivery-note"><i class="fas fa-info-circle"></i><span>Your contact and address details are used only to fulfill this order.</span></div>
                        </div>
                    </section>

                    <div class="checkout-perks">
                        <div class="co-perk"><i class="fas fa-lock"></i><div><strong>Secure checkout</strong><span>Your order information stays protected.</span></div></div>
                        <div class="co-perk"><i class="fas fa-box"></i><div><strong>Stock verified</strong><span>Inventory is checked before fulfillment.</span></div></div>
                        <div class="co-perk"><i class="fas fa-headset"></i><div><strong>Need help?</strong><span>Contact the pharmacy team before ordering.</span></div></div>
                    </div>
                </div>

                <aside class="summary-wrap">
                    <section class="summary-card">
                        <div class="summary-head"><h2>Your order</h2><p>Final review before you place it</p></div>
                        <div class="order-list">
                            @foreach (var item in cart.Items)
                            {
                                <div class="order-item">
                                    <div class="order-name">@item.ProductName <span class="order-qty">× @item.Quantity</span></div>
                                    <div class="order-price">$@item.Total.ToString("0.00")</div>
                                </div>
                            }
                        </div>
                        <div class="totals">
                            <div class="total-row"><span>Subtotal</span><strong>$@cart.SubTotal.ToString("0.00")</strong></div>
                            <div class="total-row"><span>Tax</span><strong>$@cart.Tax.ToString("0.00")</strong></div>
                            <div class="total-row shipping"><span>Shipping</span><strong>@if(cart.ShippingCost == 0){<span class="free">FREE</span>}else{<span>$@cart.ShippingCost.ToString("0.00")</span>}</strong></div>
                            <div class="total-row grand"><span>Total</span><strong>$@cart.Total.ToString("0.00")</strong></div>
                        </div>
                        <div class="payment-box">
                            <div class="payment-title"><i class="fas fa-money-bill-wave"></i> Cash on delivery</div>
                            <p class="payment-copy">Pay the delivery person when your order arrives. No online payment is required.</p>
                            <label class="payment-option-row" for="cashOnDelivery">
                                <input class="payment-option" type="radio" name="paymentMethod" id="cashOnDelivery" value="Cash on Delivery" checked>
                                <span>Use cash on delivery</span>
                            </label>
                        </div>
                        <button class="place-order-btn" type="submit" id="place-order-btn"><i class="fas fa-lock"></i> Place order <i class="fas fa-arrow-right"></i></button>
                        <a href="@Url.Action("Cart", "FrontEnd")" class="back-cart"><i class="fas fa-arrow-left"></i> Back to cart</a>
                        <div class="summary-trust"><span><i class="fas fa-shield-alt"></i> Secure checkout</span><span><i class="fas fa-check-circle"></i> Order reviewed</span></div>
                    </section>
                </aside>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/OrderViewScripts/CheckOut.js"></script>
}