@model List<MarketplacePrescriptionRequest>
@{
    ViewData["Title"] = "My Prescription Requests";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--r:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff}.dark-mode{--ink:#edf4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a}.req-page{background:#f7fbfa;color:var(--ink);min-height:100vh;padding:42px 0 70px}.dark-mode .req-page{background:#151a1d}.head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:22px}.head h1{font-size:29px;margin:0}.head p{font-size:10px;color:var(--muted);margin:5px 0 0}.req{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;margin-bottom:12px}.top{display:flex;justify-content:space-between;gap:15px;align-items:start}.no{font-size:13px;font-weight:700}.ph{font-size:10px;color:var(--r);margin-top:4px}.status{padding:6px 9px;border-radius:999px;background:#eaf8f6;color:#0c766c;font-size:8px;font-weight:700}.meta{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:15px;padding-top:14px;border-top:1px solid var(--line)}.meta span{display:block;font-size:8px;color:var(--muted);text-transform:uppercase;margin-bottom:4px}.meta strong{font-size:10px}.empty{padding:55px;text-align:center;background:var(--card);border:1px dashed var(--line);border-radius:18px;color:var(--muted)}
@@media(max-width:575px){.head{flex-direction:column;align-items:flex-start}.meta{grid-template-columns:1fr 1fr}.top{flex-direction:column}}
</style>
}
<div class="req-page"><div class="container"><div class="head"><div><h1>Prescription requests</h1><p>Pharmacy-specific reservation and verification requests.</p></div><a href="/Marketplace" style="font-size:10px;font-weight:700;color:var(--r)">Browse pharmacies →</a></div>@if(Model.Any()){@foreach(var r in Model){<div class="req"><div class="top"><div><div class="no">@r.RequestNumber</div><div class="ph">@r.Pharmacy.Name · @r.Product.ProductName</div></div><span class="status">@r.Status</span></div><div class="meta"><div><span>Requested</span><strong>@r.RequestedAt.ToString("MMM d, HH:mm")</strong></div><div><span>Quantity</span><strong>@r.Quantity</strong></div><div><span>Expires</span><strong>@r.ExpiresAt.ToString("MMM d, HH:mm")</strong></div><div><span>Contact</span><strong>@r.ContactPhone</strong></div></div></div>}}else{<div class="empty"><i class="fas fa-prescription" style="font-size:31px;color:var(--r)"></i><h2 style="font-size:20px;color:var(--ink);margin:12px 0 5px">No pharmacy requests yet</h2><div style="font-size:10px">Prescription requests you send from marketplace pharmacy offers will appear here.</div></div>}</div></div>