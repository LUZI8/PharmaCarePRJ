@model PharmaCare.Models.User
@{
    ViewData["Title"] = "Sign In - PharmaCare";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css?family=Rubik:400,500,600,700" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="icon" href="~/assets/favicon-32x32.png" type="image/png" />
    <style>
        :root{--accent:#0f9f92;--accent-2:#0b7f75;--ink:#132129;--muted:#70808b;--line:#e6ecef;--surface:#fff;--page:#f3f7f8;--soft:#eef8f6;--danger:#d9534f;--shadow:0 28px 70px rgba(22,45,54,.14)}
        *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:'Rubik',sans-serif;color:var(--ink)}body{background:var(--page);transition:.25s ease;color-scheme:light}
        body.dark-mode{--ink:#eef4f5;--muted:#91a0a8;--line:#303a3f;--surface:#20262a;--page:#111719;--soft:#18302d;--shadow:0 30px 90px rgba(0,0,0,.35);color-scheme:dark}
        a{text-decoration:none}.auth-shell{min-height:100vh;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(460px,.95fr);position:relative;overflow:hidden;background:var(--page)}
        .brand-panel{position:relative;padding:40px 54px 48px;background:linear-gradient(145deg,#0d8d82,#0b6f68 68%,#075a55);color:#fff;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}
        .brand-panel:before,.brand-panel:after{content:"";position:absolute;border-radius:50%;filter:blur(2px);opacity:.16;animation:floatBlob 9s ease-in-out infinite}.brand-panel:before{width:420px;height:420px;background:#fff;right:-160px;top:-120px}.brand-panel:after{width:300px;height:300px;background:#70efe2;left:-120px;bottom:-90px;animation-delay:-4s}
        @@keyframes floatBlob{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(18px,-20px,0) scale(1.06)}}
        .brand-top,.brand-copy,.brand-foot{position:relative;z-index:2}.brand-top{display:flex;align-items:center;justify-content:space-between}.brand-logo{display:flex;align-items:center;gap:12px;color:#fff;font-size:20px;font-weight:700;letter-spacing:.4px}.brand-icon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(12px)}
        .brand-copy{max-width:610px;animation:rise .7s ease both}.eyebrow{font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;opacity:.78;margin-bottom:18px}.brand-copy h1{font-size:clamp(40px,5vw,66px);line-height:1.04;margin:0 0 22px;font-weight:700;letter-spacing:-1.7px}.brand-copy p{font-size:17px;line-height:1.75;margin:0;max-width:560px;color:rgba(255,255,255,.82)}
        .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:34px}.benefit{padding:17px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.08);border-radius:16px;backdrop-filter:blur(10px)}.benefit i{font-size:17px;margin-bottom:10px}.benefit strong{display:block;font-size:13px;margin-bottom:4px}.benefit span{font-size:11px;color:rgba(255,255,255,.7);line-height:1.45}
        .brand-foot{font-size:11px;color:rgba(255,255,255,.62)}
        .form-panel{padding:34px 42px;display:flex;flex-direction:column;min-height:100vh;position:relative}.form-header{display:flex;justify-content:flex-end;align-items:center;gap:12px}.home-link,.theme-btn{height:42px;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:12px;display:inline-flex;align-items:center;justify-content:center;transition:.2s}.home-link{padding:0 14px;gap:8px;font-size:12px;font-weight:600}.theme-btn{width:42px;cursor:pointer}.home-link:hover,.theme-btn:hover{border-color:rgba(15,159,146,.45);color:var(--accent);transform:translateY(-1px)}
        .form-wrap{width:100%;max-width:480px;margin:auto;animation:rise .6s .08s ease both}.welcome-chip{display:inline-flex;align-items:center;gap:8px;background:var(--soft);color:var(--accent);font-size:11px;font-weight:700;padding:8px 11px;border-radius:999px;margin-bottom:18px}.form-wrap h2{font-size:36px;letter-spacing:-.8px;margin:0 0 8px}.lead{color:var(--muted);font-size:14px;line-height:1.65;margin:0 0 28px}
        .notice{padding:12px 14px;border-radius:12px;margin-bottom:16px;font-size:12px;line-height:1.5}.notice.success{background:rgba(25,135,84,.1);color:#198754;border:1px solid rgba(25,135,84,.18)}.notice.error{background:rgba(217,83,79,.09);color:var(--danger);border:1px solid rgba(217,83,79,.18)}
        .field{margin-bottom:18px}.field-label{display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:600;margin-bottom:8px}.input-wrap{position:relative}.input-wrap .field-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#92a0a8;font-size:14px}.control{width:100%;height:50px;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--ink);padding:0 44px 0 42px;outline:none;font:inherit;font-size:13px;transition:.2s}.control::placeholder{color:#a1acb2}.control:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(15,159,146,.1);transform:translateY(-1px)}.toggle-password{position:absolute;right:13px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:#8b989f;cursor:pointer;padding:5px}.field-error{font-size:11px;color:var(--danger);margin-top:6px}
        .remember-row{display:flex;justify-content:space-between;align-items:center;margin:4px 0 22px;font-size:12px}.remember{display:flex;align-items:center;gap:8px;color:var(--muted)}.remember input{accent-color:var(--accent)}.text-link{color:var(--accent);font-weight:600}.text-link:hover{color:var(--accent-2)}
        .primary-btn{width:100%;height:52px;border:0;border-radius:13px;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;font-weight:700;letter-spacing:.2px;cursor:pointer;box-shadow:0 12px 26px rgba(15,159,146,.24);transition:.22s}.primary-btn:hover{transform:translateY(-2px);box-shadow:0 16px 30px rgba(15,159,146,.29)}.primary-btn:active{transform:translateY(0)}
        .divider{display:flex;align-items:center;gap:12px;color:#a0abb1;font-size:11px;margin:22px 0}.divider:before,.divider:after{content:"";height:1px;background:var(--line);flex:1}.secondary-btn{height:50px;width:100%;border:1px solid var(--line);border-radius:13px;color:var(--ink);background:var(--surface);display:flex;align-items:center;justify-content:center;gap:8px;font-size:13px;font-weight:600;transition:.2s}.secondary-btn:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}
        .security-note{margin-top:24px;padding-top:18px;border-top:1px solid var(--line);display:flex;gap:10px;color:var(--muted);font-size:11px;line-height:1.5}.security-note i{color:var(--accent);margin-top:2px}.form-footer{text-align:center;color:var(--muted);font-size:10px;padding-top:18px}
        @@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
        @@media(max-width:1050px){.auth-shell{grid-template-columns:1fr}.brand-panel{display:none}.form-panel{min-height:100vh;padding:24px}.form-wrap{max-width:520px}.form-header{margin-bottom:20px}}
        @@media(max-width:575px){.form-panel{padding:20px 16px}.form-wrap h2{font-size:30px}.remember-row{align-items:flex-start;gap:12px}.home-link span{display:none}}
    </style>
</head>
<body>
<div class="auth-shell">
    <section class="brand-panel">
        <div class="brand-top">
            <a href="/" class="brand-logo"><span class="brand-icon"><i class="fas fa-prescription-bottle-alt"></i></span><span>PHARMACARE</span></a>
        </div>
        <div class="brand-copy">
            <div class="eyebrow">Your pharmacy, connected</div>
            <h1>Healthcare made simpler.</h1>
            <p>Sign in to manage orders, prescriptions and pharmacy services in one secure place designed around everyday care.</p>
            <div class="benefits">
                <div class="benefit"><i class="fas fa-shield-alt"></i><strong>Secure access</strong><span>Your account and pharmacy data stay protected.</span></div>
                <div class="benefit"><i class="fas fa-box-open"></i><strong>Easy ordering</strong><span>Track purchases and prescription items quickly.</span></div>
                <div class="benefit"><i class="fas fa-heartbeat"></i><strong>Built for care</strong><span>A focused experience for pharmacy customers.</span></div>
            </div>
        </div>
        <div class="brand-foot">PharmaCare · Amman, Jordan</div>
    </section>

    <section class="form-panel">
        <div class="form-header">
            <a class="home-link" href="/"><i class="fas fa-arrow-left"></i><span>Back to store</span></a>
            <button class="theme-btn" id="theme-toggle-btn" type="button" aria-label="Toggle theme"><i class="fas fa-moon"></i></button>
        </div>

        <div class="form-wrap">
            <div class="welcome-chip"><i class="fas fa-lock"></i> Secure sign in</div>
            <h2>Welcome back</h2>
            <p class="lead">Enter your account details to continue to PharmaCare.</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="notice success"><i class="fas fa-check-circle mr-1"></i> @TempData["SuccessMessage"]</div>
            }
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""].Errors.Count > 0)
            {
                <div class="notice error"><i class="fas fa-exclamation-circle mr-1"></i> @ViewData.ModelState[""].Errors[0].ErrorMessage</div>
            }

            <form method="post" action="@Url.Action("Login","Account")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <input type="hidden" name="Role" value="User" />

                <div class="field">
                    <div class="field-label"><label for="Email">Email address</label></div>
                    <div class="input-wrap">
                        <i class="fas fa-envelope field-icon"></i>
                        <input class="control" id="Email" name="Email" type="email" placeholder="name@example.com" value="@Model?.Email" autocomplete="email" required />
                    </div>
                    @if (ViewData.ModelState.ContainsKey("Email") && ViewData.ModelState["Email"].Errors.Count > 0){<div class="field-error">@ViewData.ModelState["Email"].Errors[0].ErrorMessage</div>}
                </div>

                <div class="field">
                    <div class="field-label"><label for="password-field">Password</label></div>
                    <div class="input-wrap">
                        <i class="fas fa-key field-icon"></i>
                        <input class="control" id="password-field" name="Password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                        <button class="toggle-password" id="password-toggle" type="button" aria-label="Show password"><i class="fas fa-eye"></i></button>
                    </div>
                    @if (ViewData.ModelState.ContainsKey("Password") && ViewData.ModelState["Password"].Errors.Count > 0){<div class="field-error">@ViewData.ModelState["Password"].Errors[0].ErrorMessage</div>}
                </div>

                <div class="remember-row">
                    <label class="remember"><input id="remember-me" type="checkbox" name="RememberMe" /> Remember me</label>
                    <a class="text-link" href="@Url.Action("ForgotPassword","Account")">Forgot password?</a>
                </div>

                <button class="primary-btn" type="submit">Sign in <i class="fas fa-arrow-right ml-2"></i></button>
                <div class="divider"><span>New to PharmaCare?</span></div>
                <a class="secondary-btn" href="@Url.Action("Register","Account")"><i class="fas fa-user-plus"></i> Create an account</a>
            </form>

            <div class="security-note"><i class="fas fa-shield-alt"></i><span>Your password is transmitted securely. PharmaCare never asks you to share verification codes outside the website.</span></div>
        </div>
        <div class="form-footer">© @DateTime.Now.Year PharmaCare. All rights reserved.</div>
    </section>
</div>
<script>
(function(){
 const body=document.body,btn=document.getElementById('theme-toggle-btn'),pass=document.getElementById('password-field'),toggle=document.getElementById('password-toggle');
 const saved=localStorage.getItem('pharmacare-theme'); if(saved==='dark'||(!saved&&window.matchMedia('(prefers-color-scheme: dark)').matches)) body.classList.add('dark-mode');
 function syncTheme(){btn.innerHTML=body.classList.contains('dark-mode')?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>';}
 syncTheme(); btn.addEventListener('click',()=>{body.classList.toggle('dark-mode');localStorage.setItem('pharmacare-theme',body.classList.contains('dark-mode')?'dark':'light');syncTheme();});
 toggle.addEventListener('click',()=>{const show=pass.type==='password';pass.type=show?'text':'password';toggle.innerHTML=show?'<i class="fas fa-eye-slash"></i>':'<i class="fas fa-eye"></i>';});
})();
</script>
</body>
</html>