@{
    ViewData["Title"] = "PharmaCare Home";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

@section Styles {
<style>
:root{--home-accent:#0d9488;--home-accent2:#0f766e;--home-ink:#142127;--home-muted:#6f7f88;--home-line:#e5ecee;--home-card:#fff;--home-bg:#f6faf9;--home-soft:#eaf8f6}
body.dark-mode{--home-ink:#eef5f6;--home-muted:#95a5aa;--home-line:#303b40;--home-card:#20272a;--home-bg:#151a1d;--home-soft:#183531}.home-page{background:var(--home-bg);color:var(--home-ink)}
.pc-hero{position:relative;min-height:700px;display:flex;align-items:center;overflow:hidden;background:linear-gradient(100deg,rgba(9,37,43,.92) 0%,rgba(9,61,64,.82) 46%,rgba(9,61,64,.25) 100%),url('/assets/images/bg.jpg') center/cover no-repeat;color:#fff;padding:64px 0 112px}.pc-hero:before{content:"";position:absolute;width:520px;height:520px;border-radius:50%;background:rgba(64,224,208,.12);left:-220px;bottom:-260px;animation:heroFloat 11s ease-in-out infinite}.pc-hero:after{content:"";position:absolute;width:360px;height:360px;border-radius:50%;border:1px solid rgba(255,255,255,.12);right:11%;top:-130px;animation:heroFloat 9s -3s ease-in-out infinite}.pc-hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to right,#000,transparent 80%)}@@keyframes heroFloat{0%,100%{transform:translate(0,0)}50%{transform:translate(18px,-20px)}}@@keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
.pc-hero .container{position:relative;z-index:2}.pc-hero-content{max-width:660px;animation:rise .75s ease both}.pc-eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border:1px solid rgba(255,255,255,.2);border-radius:999px;background:rgba(255,255,255,.08);font-size:11px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;margin-bottom:20px}.pc-hero h1{font-size:clamp(45px,6vw,74px);line-height:1.03;letter-spacing:-2px;font-weight:700;margin:0 0 18px}.pc-hero p{font-size:17px;line-height:1.8;color:rgba(255,255,255,.82);max-width:590px;margin:0 0 28px}.pc-hero-actions{display:flex;gap:12px;flex-wrap:wrap}.pc-hero-btn{height:52px;padding:0 20px;border-radius:13px;display:inline-flex;align-items:center;gap:9px;font-size:12px;font-weight:700;transition:.25s}.pc-hero-btn.primary{background:#12a89a;color:#fff;box-shadow:0 12px 28px rgba(18,168,154,.32)}.pc-hero-btn.secondary{border:1px solid rgba(255,255,255,.34);color:#fff;background:rgba(255,255,255,.06)}.pc-hero-btn:hover{transform:translateY(-2px);color:#fff}.pc-hero-trust{display:inline-flex;gap:18px;flex-wrap:wrap;margin-top:28px;padding:11px 14px;border:1px solid rgba(255,255,255,.14);border-radius:14px;background:rgba(5,35,39,.18);backdrop-filter:blur(8px);color:rgba(255,255,255,.88);font-size:11px;position:relative;z-index:3}.pc-hero-trust span{display:flex;align-items:center;gap:7px;white-space:nowrap}.pc-hero-trust i{color:#66e2d6}
.pc-section{padding:78px 0}.pc-section.soft{background:var(--home-card)}.pc-section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:30px}.pc-kicker{font-size:10px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:var(--home-accent);margin-bottom:8px}.pc-section h2{font-size:34px;letter-spacing:-.8px;margin:0;color:var(--home-ink)}.pc-section-sub{font-size:13px;color:var(--home-muted);max-width:520px;line-height:1.7;margin:7px 0 0}.pc-text-link{color:var(--home-accent);font-size:12px;font-weight:700;white-space:nowrap}.pc-text-link:hover{color:var(--home-accent2)}
.pc-benefits{margin-top:-30px;position:relative;z-index:4}.pc-benefit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.pc-benefit{background:var(--home-card);border:1px solid var(--home-line);border-radius:18px;padding:21px;box-shadow:0 18px 45px rgba(20,52,59,.08);transition:.25s}.pc-benefit:hover{transform:translateY(-5px);box-shadow:0 24px 55px rgba(20,52,59,.12)}.pc-benefit-icon{width:42px;height:42px;border-radius:13px;background:var(--home-soft);color:var(--home-accent);display:grid;place-items:center;margin-bottom:14px}.pc-benefit h3{font-size:15px;margin:0 0 6px;color:var(--home-ink)}.pc-benefit p{font-size:11px;line-height:1.65;color:var(--home-muted);margin:0}
.pc-rx-banner{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;align-items:center;border-radius:24px;padding:34px 38px;background:linear-gradient(135deg,#102a30,#0d625e);color:#fff;overflow:hidden;position:relative}.pc-rx-banner:after{content:"Rx";position:absolute;right:24px;top:-55px;font-size:180px;font-weight:700;color:rgba(255,255,255,.045);line-height:1}.pc-rx-banner h3{font-size:28px;margin:0 0 10px}.pc-rx-banner p{font-size:12px;line-height:1.75;color:rgba(255,255,255,.75);margin:0;max-width:650px}.pc-rx-actions{display:flex;justify-content:flex-end;gap:10px;position:relative;z-index:2}.pc-rx-actions a{height:46px;padding:0 16px;border-radius:11px;display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700}.pc-rx-actions .rx-primary{background:#fff;color:#0d625e}.pc-rx-actions .rx-secondary{border:1px solid rgba(255,255,255,.28);color:#fff}
.pc-products{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.pc-product{background:var(--home-card);border:1px solid var(--home-line);border-radius:20px;overflow:hidden;transition:.25s;position:relative}.pc-product:hover{transform:translateY(-6px);box-shadow:0 22px 48px rgba(16,52,59,.11)}.pc-product-media{height:230px;display:grid;place-items:center;background:linear-gradient(180deg,#fff,#f6faf9);padding:24px;position:relative}.dark-mode .pc-product-media{background:linear-gradient(180deg,#252d31,#1d2427)}.pc-product-media img{max-height:180px;max-width:100%;object-fit:contain;transition:.3s}.pc-product:hover .pc-product-media img{transform:scale(1.04)}.pc-stock{position:absolute;top:14px;left:14px;padding:6px 9px;border-radius:999px;font-size:9px;font-weight:700;background:#e8f8ee;color:#18864b}.pc-stock.low{background:#fff4dc;color:#b97906}.pc-stock.out{background:#fde9e8;color:#c64742}.pc-product-body{padding:18px}.pc-product-category{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:var(--home-accent);font-weight:700;margin-bottom:6px}.pc-product h3{font-size:16px;line-height:1.35;margin:0 0 10px}.pc-product h3 a{color:var(--home-ink)}.pc-product-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px}.pc-price{font-weight:700;font-size:18px}.pc-cart-btn{height:38px;padding:0 13px;border:0;border-radius:10px;background:var(--home-accent);color:#fff;font-size:10px;font-weight:700;transition:.2s}.pc-cart-btn:hover{background:var(--home-accent2);transform:translateY(-1px)}.pc-cart-btn:disabled{opacity:.45;cursor:not-allowed}
.pc-care-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.pc-care-card{border:1px solid var(--home-line);border-radius:20px;padding:28px;background:var(--home-card);position:relative;overflow:hidden}.pc-care-card .num{font-size:56px;font-weight:700;color:rgba(13,148,136,.1);position:absolute;right:18px;top:8px}.pc-care-card i{width:44px;height:44px;border-radius:13px;background:var(--home-soft);color:var(--home-accent);display:grid;place-items:center;margin-bottom:18px}.pc-care-card h3{font-size:18px;margin:0 0 8px}.pc-care-card p{font-size:11px;line-height:1.7;color:var(--home-muted);margin:0}.pc-cta{padding:0 0 80px}.pc-cta-box{border-radius:25px;background:linear-gradient(135deg,#e9f8f5,#f8fbfa);border:1px solid #dcecea;padding:34px;display:flex;align-items:center;justify-content:space-between;gap:20px}.dark-mode .pc-cta-box{background:linear-gradient(135deg,#18312f,#20292c);border-color:#31403f}.pc-cta-box h3{font-size:25px;margin:0 0 6px}.pc-cta-box p{font-size:12px;color:var(--home-muted);margin:0}.pc-cta-box a{height:46px;padding:0 17px;border-radius:11px;background:var(--home-accent);color:#fff;display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700;white-space:nowrap}
.reveal{opacity:0;transform:translateY(26px);transition:.65s ease}.reveal.show{opacity:1;transform:none}
@@media(max-width:991px){.pc-benefit-grid{grid-template-columns:1fr 1fr}.pc-products{grid-template-columns:1fr 1fr}.pc-rx-banner{grid-template-columns:1fr}.pc-rx-actions{justify-content:flex-start}.pc-care-grid{grid-template-columns:1fr}.pc-hero{min-height:610px;padding:56px 0 92px}.pc-section{padding:62px 0}.pc-hero-trust{display:flex;width:fit-content}}@@media(max-width:575px){.pc-hero{min-height:590px;padding:46px 0 72px}.pc-hero h1{font-size:42px}.pc-hero p{font-size:14px}.pc-benefit-grid,.pc-products{grid-template-columns:1fr}.pc-benefits{margin-top:-20px}.pc-section-head{align-items:flex-start;flex-direction:column}.pc-section h2{font-size:29px}.pc-rx-banner{padding:27px 24px}.pc-rx-actions{flex-direction:column}.pc-cta-box{align-items:flex-start;flex-direction:column}.pc-hero-trust{gap:10px;padding:10px 12px}.pc-hero-trust span{white-space:normal}}
</style>
}

<div class="home-page">
    <section class="pc-hero">
        <div class="pc-hero-grid"></div>
        <div class="container">
            <div class="pc-hero-content">
                <div class="pc-eyebrow"><i class="fas fa-shield-alt"></i> Trusted pharmacy care in Amman</div>
                <h1>Healthcare essentials, without the extra steps.</h1>
                <p>Shop everyday pharmacy products, manage prescription reservations, and keep track of your orders from one secure place.</p>
                <div class="pc-hero-actions">
                    <a href="@Url.Action("Shop","FrontEnd")" class="pc-hero-btn primary"><i class="fas fa-shopping-bag"></i> Shop medicines</a>
                    <a href="@Url.Action("About","FrontEnd")" class="pc-hero-btn secondary">How PharmaCare works <i class="fas fa-arrow-right"></i></a>
                </div>
                <div class="pc-hero-trust"><span><i class="fas fa-check-circle"></i> Genuine products</span><span><i class="fas fa-lock"></i> Secure account</span><span><i class="fas fa-prescription"></i> Prescription controls</span></div>
            </div>
        </div>
    </section>

    <section class="pc-benefits">
        <div class="container"><div class="pc-benefit-grid">
            <div class="pc-benefit"><div class="pc-benefit-icon"><i class="fas fa-truck"></i></div><h3>Reliable delivery</h3><p>Fast local fulfillment with clear order status from checkout to delivery.</p></div>
            <div class="pc-benefit"><div class="pc-benefit-icon"><i class="fas fa-certificate"></i></div><h3>Trusted inventory</h3><p>Products are managed with stock and expiry controls directly by the pharmacy.</p></div>
            <div class="pc-benefit"><div class="pc-benefit-icon"><i class="fas fa-prescription-bottle-alt"></i></div><h3>Prescription ready</h3><p>Reserve eligible prescription medicine and track pickup status from your account.</p></div>
            <div class="pc-benefit"><div class="pc-benefit-icon"><i class="fas fa-headset"></i></div><h3>Customer support</h3><p>Questions about an order or product? Contact PharmaCare from the website anytime.</p></div>
        </div></div>
    </section>

    <section class="pc-section">
        <div class="container reveal">
            <div class="pc-rx-banner">
                <div><div class="pc-kicker" style="color:#65ded2">Prescription service</div><h3>Reserve prescription medicine before you visit.</h3><p>Prescription-only products are clearly marked. Reserve the item online, then complete the pharmacy verification process before pickup.</p></div>
                <div class="pc-rx-actions"><a class="rx-primary" href="@Url.Action("Shop","FrontEnd")"><i class="fas fa-search"></i> Browse medicines</a><a class="rx-secondary" href="@Url.Action("MyReservations","Prescription")"><i class="fas fa-clipboard-check"></i> My reservations</a></div>
            </div>
        </div>
    </section>

    <section class="pc-section soft">
        <div class="container reveal">
            <div class="pc-section-head"><div><div class="pc-kicker">Popular right now</div><h2>Recent pharmacy products</h2><p class="pc-section-sub">Quick access to recently added and frequently used everyday medicines.</p></div><a class="pc-text-link" href="@Url.Action("Shop","FrontEnd")">View all products <i class="fas fa-arrow-right"></i></a></div>
            <div class="pc-products">
                @if(ViewBag.FeaturedProducts != null && ViewBag.FeaturedProducts.Count > 0){
                    foreach(var product in ViewBag.FeaturedProducts){
                        <article class="pc-product">
                            <a class="pc-product-media" href="@Url.Action("ShopSingle","FrontEnd",new{id=product.ProductId})">
                                @if(product.Stock<=0){<span class="pc-stock out">Out of stock</span>}else if(product.Stock<10){<span class="pc-stock low">Low stock</span>}else{<span class="pc-stock">In stock</span>}
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl)?Url.Content("~/assets/images/product_01.png"):product.ImageUrl)" alt="@product.ProductName" />
                            </a>
                            <div class="pc-product-body"><div class="pc-product-category">@(product.Category?.CategoryName ?? "Pharmacy")</div><h3><a href="@Url.Action("ShopSingle","FrontEnd",new{id=product.ProductId})">@product.ProductName</a></h3><div class="pc-product-bottom"><span class="pc-price">$@product.Price.ToString("F2")</span><button class="pc-cart-btn btn-add-to-cart" data-id="@product.ProductId" data-name="@product.ProductName" data-price="@product.Price" @(product.Stock<=0?"disabled":"")><i class="fas fa-shopping-bag"></i> @(product.Stock>0?"Add":"Unavailable")</button></div></div>
                        </article>
                    }
                } else {<div class="pc-section-sub">No products are available right now.</div>}
            </div>
        </div>
    </section>

    <section class="pc-section">
        <div class="container reveal"><div class="pc-section-head"><div><div class="pc-kicker">Designed around real pharmacy workflows</div><h2>More than a simple online catalog.</h2><p class="pc-section-sub">PharmaCare connects shopping, prescriptions, account management and order tracking in one consistent experience.</p></div></div>
            <div class="pc-care-grid">
                <div class="pc-care-card"><span class="num">01</span><i class="fas fa-box-open"></i><h3>Order tracking that makes sense</h3><p>See whether an order is pending, processing, shipped or delivered without calling the pharmacy for an update.</p></div>
                <div class="pc-care-card"><span class="num">02</span><i class="fas fa-user-shield"></i><h3>Your pharmacy account in one place</h3><p>Manage profile information, review orders and access prescription reservations through your account.</p></div>
            </div>
        </div>
    </section>

    <section class="pc-cta"><div class="container reveal"><div class="pc-cta-box"><div><div class="pc-kicker">Ready when you are</div><h3>Find what you need from the pharmacy.</h3><p>Browse the current inventory and check availability before placing your order.</p></div><a href="@Url.Action("Shop","FrontEnd")">Explore the store <i class="fas fa-arrow-right"></i></a></div></div></section>
</div>

<div id="toast-notification" class="toast-notification"><div class="toast-content"><i class="fas fa-check-circle toast-icon"></i><div class="toast-text"><strong id="toast-title">Added to Cart!</strong><p id="toast-message">Product added successfully</p></div></div><button class="toast-close" onclick="hideToast()">&times;</button></div>

@section Scripts {
<script>
window.homeUrls={addToCart:'@Url.Action("AddToCart","Cart")'};
@if(TempData["RegistrationSuccess"]!=null){<text>window.registrationSuccess='@TempData["RegistrationSuccess"]';</text>}
(function(){const els=document.querySelectorAll('.reveal');const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('show');io.unobserve(e.target)}}),{threshold:.12});els.forEach(el=>io.observe(el));})();
</script>
<script src="~/assets/js/FrontEndViewScripts/HomePage.js"></script>
}
