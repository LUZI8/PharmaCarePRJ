@{
    ViewData["Title"] = "Reset Password - PharmaCare";
    Layout = null;
    var email = ViewBag.Email as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css?family=Rubik:400,500,600,700" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="icon" href="~/assets/favicon-32x32.png" type="image/png" />
    <style>
        :root{--accent:#0f9f92;--accent2:#0b7f75;--ink:#132129;--muted:#71818b;--line:#e3eaed;--surface:#fff;--page:#f2f7f7;--soft:#eaf7f5;--danger:#d9534f;--success:#198754;--info:#2f6fce;--shadow:0 30px 80px rgba(15,47,55,.14)}
        *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:'Rubik',sans-serif}body{background:var(--page);color:var(--ink);transition:.25s;color-scheme:light}body.dark-mode{--ink:#edf4f4;--muted:#96a5ab;--line:#303a3e;--surface:#202629;--page:#111719;--soft:#17302d;--shadow:0 32px 90px rgba(0,0,0,.38);color-scheme:dark}a{text-decoration:none}
        .shell{min-height:100vh;display:grid;grid-template-columns:minmax(410px,.82fr) minmax(0,1.18fr);overflow:hidden;background:var(--page)}.visual{position:relative;padding:42px 52px;background:linear-gradient(150deg,#12353a,#0a746d 70%,#0c8d83);color:#fff;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.visual:before,.visual:after{content:"";position:absolute;border-radius:50%;opacity:.14;animation:float 9s ease-in-out infinite}.visual:before{width:430px;height:430px;background:#fff;left:-200px;top:-170px}.visual:after{width:340px;height:340px;background:#6ce9dc;right:-150px;bottom:-120px;animation-delay:-4s}.grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(to bottom,transparent,black 18%,black 82%,transparent)}@@keyframes float{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(16px,-18px) scale(1.06)}}@@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
        .brand,.hero,.foot{position:relative;z-index:2}.brand{display:flex;align-items:center;gap:12px;color:#fff;font-weight:700;font-size:20px}.brand-icon{width:43px;height:43px;border-radius:13px;display:grid;place-items:center;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.17)}.hero{max-width:530px;animation:rise .65s ease both}.mini{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;opacity:.72;margin-bottom:17px}.hero h1{font-size:clamp(38px,4.4vw,58px);line-height:1.06;letter-spacing:-1.3px;margin:0 0 18px}.hero p{font-size:16px;line-height:1.75;color:rgba(255,255,255,.82);margin:0}.checks{margin-top:32px;display:grid;gap:12px}.check{display:flex;gap:12px;align-items:flex-start;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.12)}.check:last-child{border-bottom:0}.check i{width:31px;height:31px;border-radius:9px;display:grid;place-items:center;background:rgba(255,255,255,.12)}.check strong{display:block;font-size:12px;margin-bottom:3px}.check span{font-size:10px;color:rgba(255,255,255,.68)}.foot{font-size:11px;color:rgba(255,255,255,.6)}
        .form-side{min-width:0;min-height:100vh;padding:28px 40px;display:flex;flex-direction:column;overflow:hidden}.topbar{display:flex;justify-content:flex-end;gap:10px}.top-link,.theme{height:42px;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:12px;display:inline-flex;align-items:center;justify-content:center;transition:.2s}.top-link{padding:0 14px;gap:8px;font-size:12px;font-weight:600}.theme{width:42px;cursor:pointer}.top-link:hover,.theme:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}
        .card{width:100%;max-width:620px;min-width:0;margin:auto;animation:rise .6s .08s ease both}.chip{display:inline-flex;align-items:center;gap:8px;background:var(--soft);color:var(--accent);padding:8px 11px;border-radius:999px;font-size:11px;font-weight:700;margin-bottom:17px}.card h2{font-size:34px;line-height:1.1;letter-spacing:-.7px;margin:0 0 9px}.lead{font-size:14px;line-height:1.65;color:var(--muted);margin:0 0 18px}.email-pill{display:flex;align-items:center;gap:10px;width:max-content;max-width:100%;padding:9px 12px;border-radius:11px;background:var(--surface);border:1px solid var(--line);font-size:12px;color:var(--ink);margin-bottom:20px}.email-pill i{color:var(--accent)}.email-pill span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:420px}.notice{padding:12px 14px;border-radius:12px;margin-bottom:16px;font-size:12px;line-height:1.5}.notice.info{background:rgba(47,111,206,.09);border:1px solid rgba(47,111,206,.18);color:var(--info)}.notice.error{background:rgba(217,83,79,.09);border:1px solid rgba(217,83,79,.18);color:var(--danger)}
        .section-title{font-size:10px;text-transform:uppercase;letter-spacing:1.1px;font-weight:700;color:var(--muted);margin:20px 0 10px}.otp{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px;width:100%;max-width:100%;overflow:hidden}.digit{display:block;width:100%;min-width:0;max-width:100%;height:54px;padding:0;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);text-align:center;font-size:21px;font-weight:700;outline:none;transition:.2s}.digit:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(15,159,146,.1);transform:translateY(-1px)}.digit.filled{background:var(--soft);border-color:rgba(15,159,146,.45)}
        .form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{min-width:0}.field label{display:block;font-size:11px;font-weight:600;margin-bottom:7px}.input-wrap{position:relative;min-width:0}.field-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#8f9da4}.control{width:100%;min-width:0;height:50px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);padding:0 42px;font:inherit;font-size:13px;outline:none;transition:.2s}.control:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(15,159,146,.1);transform:translateY(-1px)}.toggle{position:absolute;right:11px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:#8b989f;cursor:pointer;padding:5px}.meter{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:9px}.meter span{height:4px;border-radius:99px;background:var(--line);transition:.2s}.meter span.on{background:var(--accent)}.reqs{display:flex;gap:12px;flex-wrap:wrap;margin-top:8px}.req{font-size:10px;color:var(--muted);display:flex;align-items:center;gap:5px}.req.ok{color:var(--success)}
        .primary{margin-top:18px;width:100%;height:54px;border:0;border-radius:14px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-weight:700;cursor:pointer;box-shadow:0 12px 28px rgba(15,159,146,.25);transition:.22s}.primary:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(15,159,146,.3)}.secondary{width:100%;height:48px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);font-weight:600;cursor:pointer;transition:.2s;margin-top:10px}.secondary:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}.secondary:disabled{opacity:.55;cursor:not-allowed;transform:none}.bottom{text-align:center;color:var(--muted);font-size:11px;margin-top:10px}.footer{text-align:center;color:var(--muted);font-size:10px;padding-top:14px}
        @@media(max-width:1100px){.shell{grid-template-columns:1fr}.visual{display:none}.form-side{padding:24px}.card{max-width:680px}.topbar{margin-bottom:18px}}@@media(max-width:680px){.form-side{padding:18px 15px}.form-grid{grid-template-columns:1fr}.card h2{font-size:29px}.otp{gap:6px}.digit{height:48px;font-size:18px;border-radius:10px}.reqs{display:grid;gap:5px}.top-link span{display:none}}@@media(max-width:420px){.otp{gap:5px}.digit{height:44px;font-size:17px}}
    </style>
</head>
<body>
<div class="shell">
    <section class="visual">
        <div class="grid"></div>
        <a href="/" class="brand"><span class="brand-icon"><i class="fas fa-prescription-bottle-alt"></i></span><span>PHARMACARE</span></a>
        <div class="hero">
            <div class="mini">Secure password reset</div>
            <h1>Create a new password in one protected step.</h1>
            <p>Use the six-digit code from your email, then choose a strong password that you have not used elsewhere.</p>
            <div class="checks">
                <div class="check"><i class="fas fa-clock"></i><div><strong>Code expires after 15 minutes</strong><span>Request a new one if the current code is no longer valid.</span></div></div>
                <div class="check"><i class="fas fa-fingerprint"></i><div><strong>Code is single-purpose</strong><span>It can only be used to complete this password recovery flow.</span></div></div>
                <div class="check"><i class="fas fa-lock"></i><div><strong>Use a unique password</strong><span>Combine length, uppercase letters and special characters.</span></div></div>
            </div>
        </div>
        <div class="foot">Password reset · PharmaCare</div>
    </section>

    <section class="form-side">
        <div class="topbar">
            <a class="top-link" href="@Url.Action("ForgotPassword","Account")"><i class="fas fa-arrow-left"></i><span>Start over</span></a>
            <button id="theme-toggle" class="theme" type="button" aria-label="Toggle theme"><i class="fas fa-moon"></i></button>
        </div>
        <div class="card">
            <div class="chip"><i class="fas fa-key"></i> Reset access</div>
            <h2>Set your new password</h2>
            <p class="lead">Enter the six-digit code sent to:</p>
            <div class="email-pill"><i class="fas fa-envelope"></i><span>@email</span></div>

            @if (ViewBag.InfoMessage != null)
            {
                <div class="notice info"><i class="fas fa-info-circle"></i> @ViewBag.InfoMessage</div>
            }
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""].Errors.Count > 0)
            {
                <div class="notice error"><i class="fas fa-exclamation-circle"></i> @ViewData.ModelState[""].Errors[0].ErrorMessage</div>
            }

            <form id="reset-form" method="post" action="@Url.Action("ResetPassword","Account")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Email" value="@email" />
                <input type="hidden" id="Code" name="Code" />

                <div class="section-title">Reset code</div>
                <div class="otp">
                    @for (var i = 0; i < 6; i++)
                    {
                        <input class="digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="one-time-code" aria-label="Digit @(i + 1)" />
                    }
                </div>

                <div class="section-title">New password</div>
                <div class="form-grid">
                    <div class="field">
                        <label for="NewPassword">Password</label>
                        <div class="input-wrap"><i class="fas fa-lock field-icon"></i><input class="control" id="NewPassword" name="NewPassword" type="password" placeholder="Create a strong password" autocomplete="new-password" required /><button class="toggle" type="button" data-target="NewPassword"><i class="fas fa-eye"></i></button></div>
                    </div>
                    <div class="field">
                        <label for="ConfirmPassword">Confirm password</label>
                        <div class="input-wrap"><i class="fas fa-check-circle field-icon"></i><input class="control" id="ConfirmPassword" name="ConfirmPassword" type="password" placeholder="Repeat your password" autocomplete="new-password" required /><button class="toggle" type="button" data-target="ConfirmPassword"><i class="fas fa-eye"></i></button></div>
                    </div>
                </div>
                <div class="meter"><span></span><span></span><span></span></div>
                <div class="reqs"><div id="r-len" class="req"><i class="fas fa-circle"></i> 8+ characters</div><div id="r-up" class="req"><i class="fas fa-circle"></i> uppercase letter</div><div id="r-sp" class="req"><i class="fas fa-circle"></i> special character</div><div id="r-match" class="req"><i class="fas fa-circle"></i> passwords match</div></div>
                <button class="primary" type="submit">Reset password <i class="fas fa-arrow-right"></i></button>
            </form>

            <form method="post" action="@Url.Action("ResendPasswordResetCode","Account")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Email" value="@email" />
                <button class="secondary" id="resend-btn" type="submit"><i class="fas fa-redo-alt"></i> Send a new reset code</button>
            </form>
            <div class="bottom" id="resend-note">You can request a new code if this one expires.</div>
        </div>
        <div class="footer">© @DateTime.Now.Year PharmaCare. Secure password reset.</div>
    </section>
</div>
<script>
(function(){
 const body=document.body,theme=document.getElementById('theme-toggle'),digits=[...document.querySelectorAll('.digit')],hidden=document.getElementById('Code'),form=document.getElementById('reset-form'),pwd=document.getElementById('NewPassword'),confirm=document.getElementById('ConfirmPassword'),meter=[...document.querySelectorAll('.meter span')],resend=document.getElementById('resend-btn'),note=document.getElementById('resend-note');
 const saved=localStorage.getItem('pharmacare-theme');if(saved==='dark'||(!saved&&matchMedia('(prefers-color-scheme: dark)').matches))body.classList.add('dark-mode');function syncTheme(){theme.innerHTML=body.classList.contains('dark-mode')?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>'}syncTheme();theme.addEventListener('click',()=>{body.classList.toggle('dark-mode');localStorage.setItem('pharmacare-theme',body.classList.contains('dark-mode')?'dark':'light');syncTheme()});
 function syncCode(){hidden.value=digits.map(x=>x.value).join('');digits.forEach(x=>x.classList.toggle('filled',!!x.value))}digits.forEach((input,i)=>{input.addEventListener('input',()=>{input.value=input.value.replace(/\D/g,'').slice(0,1);syncCode();if(input.value&&i<5)digits[i+1].focus()});input.addEventListener('keydown',e=>{if(e.key==='Backspace'&&!input.value&&i>0)digits[i-1].focus()});input.addEventListener('paste',e=>{const v=(e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'').slice(0,6);if(v){e.preventDefault();v.split('').forEach((c,j)=>{if(digits[j])digits[j].value=c});syncCode();digits[Math.min(v.length,6)-1].focus()}})});
 document.querySelectorAll('.toggle').forEach(btn=>btn.addEventListener('click',()=>{const el=document.getElementById(btn.dataset.target),show=el.type==='password';el.type=show?'text':'password';btn.innerHTML=show?'<i class="fas fa-eye-slash"></i>':'<i class="fas fa-eye"></i>'}));
 function setReq(id,ok){document.getElementById(id).classList.toggle('ok',ok)}function validatePwd(){const v=pwd.value,len=v.length>=8,up=/[A-Z]/.test(v),sp=/[^A-Za-z0-9]/.test(v),match=v&&v===confirm.value;setReq('r-len',len);setReq('r-up',up);setReq('r-sp',sp);setReq('r-match',match);const score=[len,up,sp].filter(Boolean).length;meter.forEach((m,i)=>m.classList.toggle('on',i<score))}pwd.addEventListener('input',validatePwd);confirm.addEventListener('input',validatePwd);
 form.addEventListener('submit',e=>{syncCode();if(hidden.value.length!==6){e.preventDefault();digits.find(x=>!x.value)?.focus()}});digits[0]?.focus();
 let sec=30;resend.disabled=true;const timer=setInterval(()=>{sec--;note.textContent=sec>0?`You can request a new code in ${sec}s.`:'Need another code? You can resend it now.';if(sec<=0){clearInterval(timer);resend.disabled=false}},1000);
})();
</script>
</body>
</html>
