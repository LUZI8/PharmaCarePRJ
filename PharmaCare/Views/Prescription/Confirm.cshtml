@model PharmaCare.ViewModels.PrescriptionConfirmViewModel
@{
    ViewData["Title"] = "Confirm Prescription Reservation";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    var prescriptionError = TempData["ErrorMessage"]?.ToString();
    if (string.Equals(prescriptionError, "Your cart is empty!", StringComparison.OrdinalIgnoreCase))
    {
        prescriptionError = null;
    }
}

@section Styles {
<style>
.rx-confirm{--a:#0f9d8f;--ad:#0b5a54;--ink:#17212b;--muted:#71808d;--line:#dfe8eb;background:linear-gradient(180deg,#f3fbfa 0,#fff 58%);padding:42px 0 70px;color:var(--ink)}
.rx-shell{max-width:1120px;margin:auto;padding:0 22px}.rx-head{margin-bottom:24px}.rx-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;background:#e7f8f5;color:#08776d;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.5px}.rx-head h1{font-size:38px;font-weight:900;letter-spacing:-.8px;margin:12px 0 7px}.rx-head p{color:var(--muted);font-size:14px;margin:0}
.rx-notice{display:grid;grid-template-columns:44px 1fr;gap:14px;padding:18px;border:1px solid #f1d485;background:#fff9e8;border-radius:16px;margin-bottom:22px}.rx-notice i{width:44px;height:44px;border-radius:12px;background:#fff0b5;color:#a36b00;display:grid;place-items:center}.rx-notice h2{font-size:16px;font-weight:900;margin:0 0 5px}.rx-notice p{font-size:12px;color:#7a6750;margin:0 0 8px}.rx-notice ul{margin:0;padding-left:18px;color:#574a3a;font-size:12px;line-height:1.65}
.rx-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,.88fr);gap:22px;align-items:start}.rx-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 12px 34px rgba(15,23,42,.055);overflow:hidden}.rx-card-head{padding:18px 20px;border-bottom:1px solid var(--line)}.rx-card-head h2{font-size:18px;font-weight:900;margin:0}.rx-card-head span{font-size:11px;color:var(--muted)}.rx-body{padding:20px}.rx-field{margin-bottom:16px}.rx-field:last-child{margin-bottom:0}.rx-field label{display:block;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.45px;margin-bottom:7px;color:#54616c}.rx-field input{height:48px;border:1px solid #d6e0e3;border-radius:11px;padding:0 13px;width:100%;background:#fff;color:var(--ink)}.rx-field input[disabled]{background:#f4f7f8;color:#596772}.rx-field small{display:block;color:#87939c;font-size:10px;margin-top:6px}
.rx-product{display:grid;grid-template-columns:1fr auto;gap:12px;padding:13px 0;border-bottom:1px solid #edf1f3}.rx-product strong{font-size:14px}.rx-price{font-size:18px;font-weight:900;color:var(--a)}.rx-badge{display:inline-flex;margin-left:7px;padding:4px 7px;border-radius:999px;background:#e6f8fb;color:#0b8090;font-size:9px;font-weight:900;text-transform:uppercase}.rx-info{display:grid;grid-template-columns:40px 1fr;gap:11px;padding:14px;border:1px solid #e5ecef;border-radius:13px;margin-top:13px}.rx-info i{width:40px;height:40px;border-radius:11px;background:#eaf8f6;color:var(--a);display:grid;place-items:center}.rx-info small{display:block;color:#87939c;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.45px;margin-bottom:3px}.rx-info strong{font-size:12px;line-height:1.45}.rx-btn{width:100%;min-height:52px;border:0;border-radius:12px;background:linear-gradient(135deg,#16b5a5,#0f9d8f);color:#fff;font-size:14px;font-weight:900;margin-top:18px;box-shadow:0 10px 24px rgba(15,157,143,.2);transition:.2s}.rx-btn:hover{transform:translateY(-2px);filter:brightness(1.04)}.rx-back{display:flex;justify-content:center;margin-top:10px}.rx-back a{color:#6d7a84;font-size:11px;font-weight:800;text-decoration:none}.rx-back a:hover{color:var(--a)}
.dark-mode .rx-confirm{--ink:#edf5f4;--muted:#9ca8ad;--line:#2c3b3c;background:#111819}.dark-mode .rx-card{background:#172122}.dark-mode .rx-field input{background:#11191a;border-color:#334344;color:#edf5f4}.dark-mode .rx-field input[disabled]{background:#151e1f}.dark-mode .rx-info{border-color:#2d3c3d}
@@media(max-width:900px){.rx-grid{grid-template-columns:1fr}}@@media(max-width:600px){.rx-confirm{padding:30px 0 50px}.rx-shell{padding:0 15px}.rx-head h1{font-size:31px}.rx-notice{grid-template-columns:1fr}.rx-notice i{width:38px;height:38px}.rx-body{padding:16px}.rx-card{border-radius:16px}}
</style>
}

<section class="rx-confirm">
<div class="rx-shell">
    <div class="rx-head">
        <div class="rx-kicker"><i class="fas fa-prescription-bottle-alt"></i> Prescription pickup</div>
        <h1>Confirm your reservation.</h1>
        <p>Review your contact details and pickup information before reserving this medicine.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(prescriptionError))
    {
        <div class="alert alert-danger">@prescriptionError</div>
    }

    <div class="rx-notice">
        <i class="fas fa-file-medical"></i>
        <div>
            <h2>Bring a valid prescription when you collect your medicine.</h2>
            <p>This reservation holds the item for you; it does not complete a medicine sale online.</p>
            <ul>
                <li>Your reservation expires on <strong>@Model.ExpiryDate.ToString("MMM dd, yyyy")</strong>.</li>
                <li>If it is not collected in time, the reserved stock returns to inventory.</li>
                <li>Payment is completed at the pharmacy after prescription verification.</li>
            </ul>
        </div>
    </div>

    <form method="post" action="@Url.Action("ConfirmReservation", "Prescription")" id="reservationForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="productId" value="@Model.Product.ProductId" />
        <input type="hidden" name="quantity" value="@Model.Quantity" />

        <div class="rx-grid">
            <section class="rx-card">
                <div class="rx-card-head"><h2>Your details</h2><span>Used only to contact you about this pickup</span></div>
                <div class="rx-body">
                    <div class="rx-field">
                        <label for="phone_number">Contact phone number *</label>
                        <input type="tel" id="phone_number" name="phoneNumber" value="@Model.User.PhoneNumber" required pattern="[0-9]{9,15}" maxlength="15" minlength="9" inputmode="numeric" />
                        <small>Enter 9–15 digits. We’ll use this number if the pharmacy needs to contact you.</small>
                        <div class="invalid-feedback">Please enter a valid phone number.</div>
                    </div>
                    <div class="rx-field"><label>First name</label><input type="text" value="@Model.User.FirstName" disabled /></div>
                    <div class="rx-field"><label>Last name</label><input type="text" value="@Model.User.LastName" disabled /></div>
                    <div class="rx-field"><label>Email address</label><input type="email" value="@Model.User.Email" disabled /></div>
                </div>
            </section>

            <aside class="rx-card">
                <div class="rx-card-head"><h2>Reservation summary</h2><span>Final review before confirmation</span></div>
                <div class="rx-body">
                    <div class="rx-product">
                        <div><strong>@Model.Product.ProductName</strong>@if(Model.Product.RequiresPrescription){<span class="rx-badge">Prescription</span>}<div style="font-size:11px;color:#84919a;margin-top:4px;">Quantity: @Model.Quantity</div></div>
                        <div class="rx-price">$@Model.TotalPrice.ToString("0.00")</div>
                    </div>
                    <div class="rx-info"><i class="far fa-clock"></i><div><small>Reservation expires</small><strong>@Model.ExpiryDate.ToString("dddd, MMMM dd, yyyy")</strong></div></div>
                    <div class="rx-info"><i class="fas fa-map-marker-alt"></i><div><small>Pickup location</small><strong>PharmaCare Main Store<br />Almadina Almonaora St, Amman, Jordan</strong></div></div>
                    <div class="rx-info"><i class="fas fa-money-bill-wave"></i><div><small>Payment</small><strong>Pay at the pharmacy after prescription verification</strong></div></div>
                    <button type="submit" class="rx-btn"><i class="fas fa-check-circle mr-2"></i> Confirm reservation</button>
                    <div class="rx-back"><a href="@Url.Action("ShopSingle", "FrontEnd", new { id = Model.Product.ProductId })"><i class="fas fa-arrow-left mr-1"></i> Back to medicine</a></div>
                </div>
            </aside>
        </div>
    </form>
</div>
</section>

@section Scripts {
<script>
(function(){
    var phone=document.getElementById('phone_number');
    var form=document.getElementById('reservationForm');
    if(!phone||!form)return;
    function clean(){phone.value=phone.value.replace(/[^0-9]/g,'').slice(0,15);var ok=/^\d{9,15}$/.test(phone.value);phone.classList.toggle('is-valid',ok);phone.classList.toggle('is-invalid',!ok&&phone.value.length>0);return ok;}
    phone.addEventListener('input',clean);
    form.addEventListener('submit',function(e){if(!clean()){e.preventDefault();phone.focus();phone.classList.add('is-invalid');}});
})();
</script>
}