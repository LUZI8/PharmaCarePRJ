@model PharmaCare.Models.Order
@{
    ViewData["Title"] = "Order Details";
    var userRole = ViewBag.UserRole as string ?? "Customer";
    var isStaff = userRole == "Admin" || userRole == "Pharmacist";
    Layout = isStaff ? "~/Views/Shared/_Adminlayout.cshtml" : "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.IsLoggedIn = true;
    ViewBag.UserName = Context.Session.GetString("UserName") ?? "User";
    ViewBag.AdminName = Context.Session.GetString("UserName") ?? "Admin";
    ViewBag.HideCategories = false;

    var statusClass = (Model.Status ?? "").ToLower() switch
    {
        "pending" => "warning",
        "processing" => "info",
        "shipped" => "primary",
        "delivered" => "success",
        "cancelled" => "danger",
        _ => "secondary"
    };

    var itemsSubtotal = Model.OrderItems?.Sum(i => i.Price * i.Quantity) ?? 0m;
    var shipping = Model.TotalAmount > 50 ? 0m : 5.99m;
    var tax = Model.TotalAmount - itemsSubtotal - shipping;
    if (tax < 0) { tax = 0; }

    var statusStep = (Model.Status ?? "").ToLower() switch
    {
        "pending" => 1,
        "processing" => 2,
        "shipped" => 3,
        "delivered" => 4,
        _ => 0
    };
}

@section Styles {
<style>
.order-page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin:28px 0 20px}.order-page-head h2{font-weight:750;margin:0;letter-spacing:-.4px}.order-page-head p{color:#6c757d;margin:5px 0 0}.admin-order-card{border:0;border-radius:14px;box-shadow:0 3px 16px rgba(0,0,0,.065);overflow:hidden}.admin-order-card .card-header{background:transparent;padding:18px 20px;border-bottom:1px solid #edf0f2}.admin-order-card .card-body{padding:20px}.order-overview-bar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.order-number-meta{font-size:12px;color:#7a838b;margin-top:4px}.status-badge-lg{font-size:12px;padding:7px 11px;border-radius:8px}.detail-tile{border:1px solid #e8ecef;border-radius:12px;padding:17px;height:100%;background:#fff}.detail-title{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:#6c757d;font-weight:750;margin-bottom:12px}.detail-row{display:grid;grid-template-columns:minmax(85px,.7fr) minmax(0,1.5fr);gap:14px;padding:8px 0;border-bottom:1px solid #f0f2f4;align-items:start}.detail-row:last-child{border-bottom:0}.detail-row .label{color:#7b838b;font-size:13px}.detail-row .value{text-align:right;font-weight:600;overflow-wrap:anywhere}.workflow{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:4px}.workflow-step{position:relative;text-align:center;padding-top:34px;font-size:12px;color:#8a9299}.workflow-step:before{content:"";position:absolute;top:11px;left:0;right:0;height:3px;background:#e8ecef}.workflow-step:first-child:before{left:50%}.workflow-step:last-child:before{right:50%}.workflow-dot{position:absolute;top:3px;left:50%;transform:translateX(-50%);width:19px;height:19px;border-radius:50%;background:#dce1e5;border:4px solid #fff;box-shadow:0 0 0 1px #dce1e5;z-index:2}.workflow-step.done,.workflow-step.current{color:#212529;font-weight:700}.workflow-step.done:before,.workflow-step.current:before{background:#0d9488}.workflow-step.done .workflow-dot,.workflow-step.current .workflow-dot{background:#0d9488;box-shadow:0 0 0 1px #0d9488}.workflow-step.current .workflow-dot{width:22px;height:22px;top:1px}.order-table thead th{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#66707a;border-top:0}.order-table td,.order-table th{vertical-align:middle;padding:14px 16px}.summary-box{margin-left:auto;width:360px;max-width:100%;padding:18px 20px}.summary-row{display:flex;justify-content:space-between;padding:8px 0;color:#66707a}.summary-row.total{border-top:1px solid #e8ecef;margin-top:5px;padding-top:14px;color:inherit;font-size:19px;font-weight:750}.muted-note{font-size:12px;color:#7a838b}.payment-paid{color:#28a745}.payment-unpaid{color:#e0a800}.clear-btn{display:inline-flex;align-items:center;gap:7px;font-weight:700;border-radius:9px;padding:8px 13px}.clear-btn.back{background:#f8f9fa;border:1px solid #cfd5da;color:#495057}.clear-btn.back:hover{background:#eef1f3;color:#212529}.clear-btn.update{background:#198754;border-color:#198754;color:#fff;box-shadow:0 2px 6px rgba(25,135,84,.18)}.clear-btn.update:hover{background:#157347;border-color:#146c43;color:#fff}.clear-btn.cancel{background:#fff;border:1px solid #cfd5da;color:#495057}.clear-btn.confirm{background:#198754;border:1px solid #198754;color:#fff;min-width:170px;justify-content:center}.dark-mode .admin-order-card,.dark-mode .detail-tile{background:#1f1f1f}.dark-mode .admin-order-card .card-header,.dark-mode .detail-row,.dark-mode .summary-row.total{border-color:#343434}.dark-mode .detail-tile{border-color:#383838}.dark-mode .detail-row .label,.dark-mode .muted-note,.dark-mode .order-number-meta{color:#aaa}.dark-mode .workflow-step.done,.dark-mode .workflow-step.current{color:#eee}.dark-mode .workflow-step:before{background:#444}.dark-mode .workflow-step.done:before,.dark-mode .workflow-step.current:before{background:#14a89a}.dark-mode .clear-btn.back,.dark-mode .clear-btn.cancel{background:#262626;color:#ddd;border-color:#444}@@media(max-width:767px){.order-page-head{align-items:flex-start;flex-direction:column}.workflow{font-size:10px}.detail-row{grid-template-columns:1fr}.detail-row .value{text-align:left}.summary-box{width:100%}.clear-btn{width:100%;justify-content:center}.order-overview-bar>div:last-child{width:100%;display:flex;gap:8px;flex-wrap:wrap}}
</style>
}

<div class="order-page-head">
    <div>
        <h2>Order #@Model.OrderNumber</h2>
        <p>@(isStaff ? "Review fulfillment, payment, customer and delivery information." : "Review your order, payment and delivery information.")</p>
    </div>
    <a href="@(isStaff ? Url.Action("ManageOrders","Order") : Url.Action("Index","Order"))" class="btn clear-btn back">
        <i class="fas fa-arrow-left"></i> @(isStaff ? "Back to Order Management" : "Back to My Orders")
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]<button type="button" class="close" data-dismiss="alert">&times;</button></div>
}

<div class="card admin-order-card mb-4">
    <div class="card-header order-overview-bar">
        <div>
            <strong>Order Overview</strong>
            <div class="order-number-meta"><i class="far fa-calendar-alt mr-1"></i>Placed @Model.OrderDate.ToString("MMM dd, yyyy 'at' HH:mm") · Internal ID #@Model.OrderId</div>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge badge-@statusClass status-badge-lg mr-2">@Model.Status</span>
            @if (isStaff && Model.Status != "Delivered" && Model.Status != "Cancelled")
            {
                <button class="btn clear-btn update" data-toggle="modal" data-target="#updateStatusModal"><i class="fas fa-sync-alt"></i> Change Order Status</button>
            }
        </div>
    </div>
    @if (Model.Status != "Cancelled")
    {
        <div class="card-body pb-3">
            <div class="workflow">
                <div class="workflow-step @(statusStep > 1 ? "done" : statusStep == 1 ? "current" : "")"><span class="workflow-dot"></span>Pending</div>
                <div class="workflow-step @(statusStep > 2 ? "done" : statusStep == 2 ? "current" : "")"><span class="workflow-dot"></span>Processing</div>
                <div class="workflow-step @(statusStep > 3 ? "done" : statusStep == 3 ? "current" : "")"><span class="workflow-dot"></span>Shipped</div>
                <div class="workflow-step @(statusStep == 4 ? "current" : "")"><span class="workflow-dot"></span>Delivered</div>
            </div>
        </div>
    }
</div>

<div class="row mb-4">
    <div class="col-lg-4 mb-3 mb-lg-0"><div class="detail-tile"><div class="detail-title"><i class="fas fa-user mr-1"></i> Customer</div><div class="detail-row"><span class="label">Name</span><span class="value">@Model.User?.FirstName @Model.User?.LastName</span></div><div class="detail-row"><span class="label">Email</span><span class="value">@Model.User?.Email</span></div><div class="detail-row"><span class="label">Phone</span><span class="value">@Model.PhoneNumber</span></div></div></div>
    <div class="col-lg-4 mb-3 mb-lg-0"><div class="detail-tile"><div class="detail-title"><i class="fas fa-map-marker-alt mr-1"></i> Shipping</div><div class="detail-row"><span class="label">Address</span><span class="value">@Model.ShippingAddress</span></div><div class="detail-row"><span class="label">City</span><span class="value">@Model.City</span></div><div class="detail-row"><span class="label">Quantity</span><span class="value">@(Model.OrderItems?.Sum(i => i.Quantity) ?? 0) item(s)</span></div></div></div>
    <div class="col-lg-4"><div class="detail-tile"><div class="detail-title"><i class="fas fa-credit-card mr-1"></i> Payment</div><div class="detail-row"><span class="label">Method</span><span class="value">@Model.PaymentMethod</span></div><div class="detail-row"><span class="label">Status</span><span class="value @(Model.IsPaid ? "payment-paid" : "payment-unpaid")">@(Model.IsPaid ? "Paid" : "Not Paid")</span></div>@if (Model.PaidAt.HasValue){<div class="detail-row"><span class="label">Paid at</span><span class="value">@Model.PaidAt.Value.ToString("MMM dd, yyyy HH:mm")</span></div>}@if (Model.DeliveredAt.HasValue){<div class="detail-row"><span class="label">Delivered</span><span class="value">@Model.DeliveredAt.Value.ToString("MMM dd, yyyy HH:mm")</span></div>}</div></div>
</div>

<div class="card admin-order-card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center"><div><strong>Order Items</strong><div class="muted-note">@(Model.OrderItems?.Count ?? 0) product line(s)</div></div><div class="font-weight-bold">$@Model.TotalAmount.ToString("0.00")</div></div>
    <div class="table-responsive"><table class="table order-table mb-0"><thead><tr><th>Product</th><th>Unit Price</th><th>Quantity</th><th class="text-right">Line Total</th></tr></thead><tbody>@foreach (var item in Model.OrderItems ?? new List<PharmaCare.Models.OrderItem>()){<tr><td><strong>@item.ProductName</strong></td><td>$@item.Price.ToString("0.00")</td><td>@item.Quantity</td><td class="text-right"><strong>$@((item.Price * item.Quantity).ToString("0.00"))</strong></td></tr>}</tbody></table></div>
    <div class="summary-box"><div class="summary-row"><span>Items subtotal</span><span>$@itemsSubtotal.ToString("0.00")</span></div><div class="summary-row"><span>Tax</span><span>$@tax.ToString("0.00")</span></div><div class="summary-row"><span>Shipping</span><span>@(shipping == 0 ? "Free" : "$" + shipping.ToString("0.00"))</span></div><div class="summary-row total"><span>Total</span><span>$@Model.TotalAmount.ToString("0.00")</span></div></div>
</div>

<div class="mb-4">
    <span class="muted-note"><i class="fas fa-shield-alt mr-1"></i>@(isStaff ? "Administrative order view" : "Secure order details")</span>
</div>

@if (isStaff && Model.Status != "Delivered" && Model.Status != "Cancelled")
{
    <div class="modal fade" id="updateStatusModal" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><form asp-controller="Order" asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<div class="modal-header"><div><h5 class="modal-title mb-0">Change Order Status</h5><small class="text-muted">Current status: @Model.Status</small></div><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input type="hidden" name="orderId" value="@Model.OrderId"/><input type="hidden" name="returnUrl" value="ManageOrders"/><div class="form-group mb-0"><label>Next Status</label><select name="status" class="form-control">@if (Model.Status == "Pending"){<option value="Processing">Processing</option><option value="Cancelled">Cancelled</option>}else if (Model.Status == "Processing"){<option value="Shipped">Shipped</option><option value="Cancelled">Cancelled</option>}else if (Model.Status == "Shipped"){<option value="Delivered">Delivered</option>}</select><small class="form-text text-muted">Status changes follow the normal fulfillment sequence.</small></div></div><div class="modal-footer"><button type="button" class="btn clear-btn cancel" data-dismiss="modal"><i class="fas fa-times"></i> Cancel</button><button type="submit" class="btn clear-btn confirm"><i class="fas fa-check"></i> Confirm Status Change</button></div></form></div></div></div>
}
