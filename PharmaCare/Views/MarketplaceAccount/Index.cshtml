@model MarketplaceAccountViewModel
@{
    ViewData["Title"] = "Marketplace Account";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--a:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#eef4f5;--muted:#9aa8ad;--line:#303b40;--card:#20272a;--soft:#183531}.account-market{min-height:100vh;background:#f7fbfa;color:var(--ink);padding:38px 0 70px}.dark-mode .account-market{background:#151a1d}.head h1{font-size:29px;margin:0}.head p{font-size:10px;color:var(--muted);margin:5px 0 20px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:20px}.card h2{font-size:17px;margin:0 0 14px}.addr{border:1px solid var(--line);border-radius:14px;padding:13px;margin-bottom:9px}.addr-top{display:flex;justify-content:space-between;gap:10px}.label{font-size:11px;font-weight:700}.default{font-size:7px;font-weight:700;background:var(--soft);color:var(--a);padding:5px 7px;border-radius:99px}.addr p,.note p{font-size:9px;color:var(--muted);line-height:1.6;margin:5px 0}.delete{border:0;background:none;color:#b24a45;font-size:8px;padding:0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.form-grid input,.form-grid textarea{border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);padding:0 10px;font-size:9px}.form-grid input{height:39px}.form-grid textarea{min-height:70px;padding-top:10px;grid-column:1/-1}.full{grid-column:1/-1}.save{height:42px;border:0;border-radius:11px;background:var(--a);color:#fff;font-size:9px;font-weight:700;grid-column:1/-1}.note{border-top:1px solid var(--line);padding:12px 0}.note:first-of-type{border-top:0}.note.unread{background:var(--soft);border-radius:11px;padding:11px;margin-bottom:7px;border:0}.note strong{font-size:10px}.note-time{font-size:8px;color:var(--muted)}.read-all{border:0;background:transparent;color:var(--a);font-size:8px;font-weight:700}.flash{padding:10px;border-radius:10px;background:var(--soft);color:var(--a);font-size:9px;margin-bottom:12px}
@@media(max-width:850px){.grid{grid-template-columns:1fr}}@@media(max-width:520px){.account-market{padding-top:22px}.card{padding:15px}.form-grid{grid-template-columns:1fr}.full,.form-grid textarea,.save{grid-column:1}.head h1{font-size:25px}}
</style>
}
<div class="account-market"><div class="container"><div class="head"><h1>Delivery profile</h1><p>Manage complete delivery addresses and keep up with marketplace order notifications.</p></div>@if(TempData["AccountMessage"]!=null){<div class="flash">@TempData["AccountMessage"]</div>}<div class="grid">
<section class="card"><h2>Saved addresses</h2>@foreach(var a in Model.Addresses){<div class="addr"><div class="addr-top"><span class="label">@a.Label</span>@if(a.IsDefault){<span class="default">DEFAULT</span>}</div><p>@a.Street@if(!string.IsNullOrWhiteSpace(a.Building)){<text>, Building @a.Building</text>}<br/>@a.Area, @a.City@if(!string.IsNullOrWhiteSpace(a.Landmark)){<br/><text>Near @a.Landmark</text>}</p><form method="post" action="/MarketplaceAccount/DeleteAddress">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.CustomerAddressId"/><button class="delete">Delete</button></form></div>}
<h2 style="margin-top:22px">Add address</h2><form method="post" action="/MarketplaceAccount/SaveAddress" class="form-grid">@Html.AntiForgeryToken()<input name="Label" placeholder="Label: Home / Work" value="Home"/><input name="City" placeholder="City" value="Amman"/><input name="Area" placeholder="Area"/><input name="Street" placeholder="Street"/><input name="Building" placeholder="Building"/><input name="Floor" placeholder="Floor"/><input name="Apartment" placeholder="Apartment"/><input name="Landmark" placeholder="Landmark"/><textarea name="DeliveryInstructions" placeholder="Delivery instructions"></textarea><label class="full" style="font-size:9px"><input type="checkbox" name="IsDefault" value="true" style="height:auto;margin-right:6px"/>Make this my default address</label><button class="save">Save address</button></form></section>
<section class="card"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Notifications (@Model.UnreadNotifications unread)</h2>@if(Model.UnreadNotifications>0){<form method="post" action="/MarketplaceAccount/MarkAllRead">@Html.AntiForgeryToken()<button class="read-all">Mark all read</button></form>}</div>@if(Model.Notifications.Any()){@foreach(var n in Model.Notifications){<div class="note @(!n.IsRead?"unread":"")"><strong>@n.Title</strong><p>@n.Message</p><div class="note-time">@n.CreatedAt.ToString("MMM d, HH:mm") @if(!string.IsNullOrWhiteSpace(n.ActionUrl)){<text> · <a href="@n.ActionUrl" style="color:var(--a);font-weight:700">Open</a></text>}</div></div>}}else{<p style="font-size:10px;color:var(--muted)">No marketplace notifications yet.</p>}</section>
</div></div></div>