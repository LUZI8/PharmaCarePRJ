@model PharmacyPortalViewModel
@{
    ViewData["Title"] = "Pharmacy Portal";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var pharmacies = ViewBag.Pharmacies as List<Pharmacy> ?? new List<Pharmacy>();
}
<style>
.portal{padding:24px}.portal-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:20px}.portal-head h1{font-size:28px;margin:0}.muted{font-size:10px;color:#728188}.switcher select{height:40px;border:1px solid #dfe8ea;border-radius:10px;padding:0 12px}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.kpi,.card{background:#fff;border:1px solid #e4ecee;border-radius:16px}.dark-mode .kpi,.dark-mode .card{background:#20272a;border-color:#354047;color:#eef4f5}.kpi{padding:18px}.kpi i{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:#eaf8f6;color:#0d9488;margin-bottom:12px}.kpi strong{font-size:23px;display:block}.two{display:grid;grid-template-columns:1.3fr .7fr;gap:14px;margin-top:14px}.card{padding:18px}.card h2{font-size:16px;margin:0 0 14px}.order{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #edf1f2;font-size:10px}.order:first-of-type{border-top:0}.status-form{display:flex;gap:6px}.status-form select{height:34px;border:1px solid #dfe8ea;border-radius:8px;font-size:9px;padding:0 7px}.status-form button{height:34px;border:0;border-radius:8px;background:#0d9488;color:#fff;font-size:8px;font-weight:700;padding:0 10px}.stock-row{padding:11px 0;border-top:1px solid #edf1f2}.stock-row:first-of-type{border-top:0}.stock-row strong{font-size:10px;display:block}.stock-form{display:grid;grid-template-columns:70px 90px 70px;gap:6px;margin-top:7px}.stock-form input{height:32px;border:1px solid #dfe8ea;border-radius:8px;padding:0 7px;font-size:9px}.stock-form button{border:0;border-radius:8px;background:#173f43;color:#fff;font-size:8px;font-weight:700}.empty{font-size:10px;color:#829097;padding:15px 0}
@@media(max-width:900px){.kpis{grid-template-columns:1fr 1fr}.two{grid-template-columns:1fr}.order{grid-template-columns:1fr}.status-form{flex-wrap:wrap}}
@@media(max-width:520px){.portal{padding:15px}.portal-head{align-items:flex-start;flex-direction:column}.kpis{grid-template-columns:1fr 1fr}.kpi{padding:14px}.kpi strong{font-size:20px}.stock-form{grid-template-columns:1fr 1fr}.stock-form button{height:34px;grid-column:1/-1}}
</style>
<div class="portal"><div class="portal-head"><div><div class="muted">MULTI-PHARMACY OPERATIONS</div><h1>@Model.Pharmacy.Name</h1><div class="muted">Live orders, fulfillment and pharmacy-specific inventory.</div></div>@if(pharmacies.Any()){<form class="switcher" method="get"><select name="pharmacyId" onchange="this.form.submit()">@foreach(var p in pharmacies){if(p.PharmacyId==Model.Pharmacy.PharmacyId){<option value="@p.PharmacyId" selected>@p.Name</option>}else{<option value="@p.PharmacyId">@p.Name</option>}}</select></form>}</div>
<div class="kpis"><div class="kpi"><i class="fas fa-receipt"></i><strong>@Model.PendingOrders</strong><span class="muted">New marketplace orders</span></div><div class="kpi"><i class="fas fa-box"></i><strong>@Model.PreparingOrders</strong><span class="muted">Accepted / preparing</span></div><div class="kpi"><i class="fas fa-coins"></i><strong>$@Model.RevenueToday.ToString("0.00")</strong><span class="muted">Marketplace revenue today</span></div><div class="kpi"><i class="fas fa-pills"></i><strong>@Model.ActiveProducts</strong><span class="muted">Available pharmacy products</span></div></div>
<div class="two"><section class="card"><h2>Order queue</h2>@if(Model.Orders.Any()){@foreach(var o in Model.Orders){<div class="order"><div><strong>@o.OrderNumber</strong><div class="muted">@o.OrderDate.ToString("MMM d, HH:mm") · @o.Items.Sum(x=>x.Quantity) item(s) · $@o.TotalAmount.ToString("0.00")</div></div><span style="font-size:9px;font-weight:700">@o.Status</span><form method="post" action="/PharmacyPortal/UpdateStatus" class="status-form">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@o.MarketplaceOrderId"/><select name="status"><option>Pending</option><option>Accepted</option><option>Preparing</option><option>Out for Delivery</option><option>Delivered</option><option>Cancelled</option></select><button>Update</button></form></div>}}else{<div class="empty">No marketplace orders yet.</div>}</section><aside class="card"><h2>Low-stock pharmacy offers</h2>@if(Model.LowStock.Any()){@foreach(var p in Model.LowStock){<div class="stock-row"><strong>@p.Product.ProductName</strong><div class="muted">Reorder at @p.ReorderLevel · currently @p.Stock</div><form method="post" action="/PharmacyPortal/UpdateStock" class="stock-form">@Html.AntiForgeryToken()<input type="hidden" name="pharmacyProductId" value="@p.PharmacyProductId"/><input type="number" name="stock" min="0" value="@p.Stock"/><input type="number" step="0.01" min="0.01" name="price" value="@p.Price"/><button>Save</button></form></div>}}else{<div class="empty">Stock levels look healthy.</div>}</aside></div></div>