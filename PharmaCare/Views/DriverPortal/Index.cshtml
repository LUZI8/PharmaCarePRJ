@model PharmaCare.Controllers.DriverPortalViewModel
@{
    ViewData["Title"] = "Driver Portal";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}
@section Styles{
<style>
:root{--d:#0d9488;--ink:#152126;--muted:#718087;--line:#e5edef;--card:#fff;--soft:#eef9f7}.dark-mode{--ink:#eef4f5;--muted:#98a7ac;--line:#303b40;--card:#20272a;--soft:#183531}.driver-page{min-height:100vh;background:#f7fbfa;color:var(--ink);padding:34px 0 70px}.dark-mode .driver-page{background:#151a1d}.driver-head{background:linear-gradient(135deg,#0b3d42,#0d9488);color:#fff;border-radius:22px;padding:26px;margin-bottom:18px}.driver-head h1{font-size:28px;margin:0}.driver-head p{font-size:10px;color:rgba(255,255,255,.75);margin:6px 0 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px}.card h2{font-size:16px;margin:0 0 13px}.delivery{border:1px solid var(--line);border-radius:14px;padding:13px;margin-bottom:10px}.delivery strong{font-size:11px}.meta{font-size:9px;color:var(--muted);line-height:1.6;margin-top:5px}.actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.actions button{border:0;border-radius:9px;background:var(--d);color:#fff;height:34px;padding:0 10px;font-size:8px;font-weight:700}.actions button.secondary{background:#173f43}.actions input{height:34px;border:1px solid var(--line);border-radius:9px;padding:0 8px;font-size:8px;min-width:150px}.claim{width:100%;height:36px;border:0;border-radius:9px;background:var(--d);color:#fff;font-size:8px;font-weight:700;margin-top:9px}.flash{padding:10px;border-radius:10px;background:#fde9e8;color:#a83e39;font-size:9px;margin-bottom:12px}.empty{font-size:10px;color:var(--muted);padding:15px 0}
@@media(max-width:850px){.grid{grid-template-columns:1fr}}@@media(max-width:520px){.driver-page{padding-top:18px}.driver-head{border-radius:16px;padding:20px}.driver-head h1{font-size:24px}.card{padding:14px}.actions{display:grid;grid-template-columns:1fr 1fr}.actions input{grid-column:1/-1;width:100%}.actions button{width:100%}}
</style>
}
<div class="driver-page"><div class="container">@if(TempData["DriverError"]!=null){<div class="flash">@TempData["DriverError"]</div>}<section class="driver-head"><div style="font-size:9px;font-weight:700;letter-spacing:1px;margin-bottom:7px">MOBILE DELIVERY WORKSPACE</div><h1>Driver Portal</h1><p>Claim ready deliveries, confirm pharmacy pickup, start delivery and complete the order from any phone browser.</p></section><div class="grid">
<section class="card"><h2>Ready to claim</h2>@if(Model.AvailableOrders.Any()){@foreach(var o in Model.AvailableOrders){<div class="delivery"><strong>@o.OrderNumber · @o.Pharmacy.Name</strong><div class="meta">Pickup: @o.Pharmacy.Address<br/>Deliver to: @o.ShippingAddress, @o.City<br/>Total: $@o.TotalAmount.ToString("0.00")</div><form method="post" action="/DriverPortal/Claim">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@o.MarketplaceOrderId"/><button class="claim">Accept delivery</button></form></div>}}else{<div class="empty">No unassigned ready orders right now.</div>}</section>
<section class="card"><h2>My active deliveries</h2>@if(Model.Assignments.Any()){@foreach(var a in Model.Assignments){<div class="delivery"><strong>@a.MarketplaceOrder.OrderNumber · @a.MarketplaceOrder.Pharmacy.Name</strong><div class="meta">Status: @a.Status<br/>Customer address: @a.MarketplaceOrder.ShippingAddress, @a.MarketplaceOrder.City<br/>Phone: @a.MarketplaceOrder.PhoneNumber</div><form method="post" action="/DriverPortal/Update" class="actions">@Html.AntiForgeryToken()<input type="hidden" name="assignmentId" value="@a.MarketplaceDeliveryAssignmentId"/><button name="action" value="Arrived">Arrived</button><button name="action" value="PickedUp">Picked up</button><button name="action" value="StartDelivery">Start delivery</button><button name="action" value="Delivered">Delivered</button><input name="problemNote" placeholder="Problem details"/><button class="secondary" name="action" value="Problem">Report problem</button></form></div>}}else{<div class="empty">You have no active deliveries.</div>}</section>
</div></div></div>