@model PharmaCare.Models.User
@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
    ViewBag.IsLoggedIn = true;
    ViewBag.UserName = Model.FirstName + " " + Model.LastName;
    ViewBag.HideCategories = false;
}

@section Styles {
<style>
.account-page{--teal:#0f9d8f;--teal-dark:#0a655c;--ink:#17212b;--muted:#71808d;--line:#dfe8ea;background:linear-gradient(180deg,#f4fbfa 0,#fff 44%);padding:42px 0 72px;color:var(--ink)}
.account-shell{max-width:1180px;margin:0 auto;padding:0 22px}.account-head{margin-bottom:22px}.account-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;background:#e7f8f5;color:#08776d;font-size:11px;font-weight:900;letter-spacing:.55px;text-transform:uppercase;margin-bottom:10px}.account-title{font-size:38px;font-weight:900;letter-spacing:-1.1px;margin:0 0 7px}.account-subtitle{margin:0;color:var(--muted);font-size:14px}.account-grid{display:grid;grid-template-columns:280px minmax(0,1fr);gap:22px;align-items:start}.account-nav,.account-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 14px 38px rgba(15,23,42,.06);overflow:hidden}.account-nav-head{padding:19px 18px;background:linear-gradient(135deg,#0b756c,#0f9d8f);color:#fff}.account-nav-head strong{display:block;font-size:17px}.account-nav-head span{display:block;font-size:11px;opacity:.8;margin-top:3px}.account-nav-links{padding:10px}.account-nav-links a{display:flex;align-items:center;gap:11px;min-height:46px;padding:0 13px;border-radius:12px;color:#44515b;text-decoration:none;font-size:13px;font-weight:800;transition:.2s}.account-nav-links a i{width:18px;text-align:center;color:#78858d}.account-nav-links a:hover{background:#f2f8f7;color:var(--teal-dark);text-decoration:none}.account-nav-links a.active{background:#e8f8f5;color:#08776d}.account-nav-links a.active i{color:var(--teal)}
.account-card-head{padding:22px 24px;border-bottom:1px solid var(--line)}.account-card-head h2{margin:0 0 5px;font-size:23px;font-weight:900}.account-card-head p{margin:0;color:var(--muted);font-size:12px}.account-form{padding:24px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:11px;font-weight:900;color:#52606a;text-transform:uppercase;letter-spacing:.45px}.field .form-control{min-height:48px;border:1px solid #d9e3e5;border-radius:12px;padding:10px 13px;background:#fff;color:var(--ink);box-shadow:none;transition:.2s}.field textarea.form-control{min-height:112px;resize:vertical}.field .form-control:focus{border-color:#6bc9be;box-shadow:0 0 0 3px rgba(15,157,143,.1)}.text-danger{font-size:11px}.form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}.btn-save,.btn-cancel{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 17px;border-radius:11px;font-size:12px;font-weight:900;text-decoration:none;border:1px solid transparent;transition:.2s}.btn-save{background:var(--teal);color:#fff;box-shadow:0 8px 18px rgba(15,157,143,.18)}.btn-save:hover{background:#0b887d;color:#fff;transform:translateY(-1px)}.btn-cancel{background:#fff;color:#56636d;border-color:#ccd8db}.btn-cancel:hover{background:#f6f9fa;color:#27333b;text-decoration:none}.account-toast{margin-bottom:16px;border-radius:13px;padding:12px 14px;font-size:12px;font-weight:800}.account-toast.success{background:#e8f8ed;color:#16773d;border:1px solid #c8ead4}.account-toast.error{background:#fff0f1;color:#b73240;border:1px solid #f2c7cc}
.dark-mode .account-page{--ink:#edf5f4;--muted:#9ca8ad;--line:#2b3b3c;background:#111819}.dark-mode .account-nav,.dark-mode .account-card{background:#172122}.dark-mode .account-nav-links a{color:#d7e0df}.dark-mode .account-nav-links a:hover{background:#1d2b2c}.dark-mode .account-nav-links a.active{background:#143331;color:#7de0d4}.dark-mode .field label{color:#b9c3c6}.dark-mode .field .form-control{background:#121c1d;border-color:#2b3b3c;color:#edf5f4}.dark-mode .btn-cancel{background:#172122;border-color:#425153;color:#d7e0df}
@@media(max-width:860px){.account-grid{grid-template-columns:1fr}.account-nav-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.account-nav-head{display:none}.account-nav-links a{justify-content:center;text-align:center}}
@@media(max-width:620px){.account-page{padding:30px 0 54px}.account-shell{padding:0 14px}.account-title{font-size:30px}.account-nav-links{grid-template-columns:1fr 1fr}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.account-form,.account-card-head{padding:18px}.form-actions{flex-direction:column}.btn-save,.btn-cancel{width:100%}}
</style>
}

<section class="account-page">
    <div class="account-shell">
        <header class="account-head">
            <div class="account-kicker"><i class="fas fa-user-edit"></i> Account settings</div>
            <h1 class="account-title">Edit profile</h1>
            <p class="account-subtitle">Keep your contact and delivery details accurate for faster checkout and reservation updates.</p>
        </header>

        @if (TempData["SuccessMessage"] != null){<div class="account-toast success"><i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]</div>}
        @if (TempData["ErrorMessage"] != null){<div class="account-toast error"><i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]</div>}

        <div class="account-grid">
            <aside class="account-nav">
                <div class="account-nav-head"><strong>Account menu</strong><span>Everything in one place</span></div>
                <nav class="account-nav-links">
                    <a href="@Url.Action("Profile", "Account")"><i class="fas fa-user"></i><span>Profile</span></a>
                    <a class="active" href="@Url.Action("EditProfile", "Account")"><i class="fas fa-user-edit"></i><span>Edit profile</span></a>
                    <a href="@Url.Action("ChangePassword", "Account")"><i class="fas fa-key"></i><span>Password</span></a>
                    <a href="@Url.Action("Index", "Order")"><i class="fas fa-shopping-bag"></i><span>My orders</span></a>
                    <a href="@Url.Action("MyReservations", "Prescription")"><i class="fas fa-prescription-bottle-alt"></i><span>Reservations</span></a>
                </nav>
            </aside>

            <main class="account-card">
                <div class="account-card-head"><h2>Your information</h2><p>These details are used for checkout, delivery and prescription contact.</p></div>
                <form asp-action="EditProfile" method="post" class="account-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-grid">
                        <div class="field"><label asp-for="FirstName">First name</label><input asp-for="FirstName" class="form-control" required /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                        <div class="field"><label asp-for="LastName">Last name</label><input asp-for="LastName" class="form-control" required /><span asp-validation-for="LastName" class="text-danger"></span></div>
                        <div class="field full"><label asp-for="Email">Email address</label><input asp-for="Email" class="form-control" required type="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
                        <div class="field"><label asp-for="PhoneNumber">Phone number</label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
                        <div class="field"><label asp-for="City">City</label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger"></span></div>
                        <div class="field full"><label asp-for="Address">Full address</label><textarea asp-for="Address" class="form-control" rows="4" placeholder="Street, building, floor, apartment and nearby landmark"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
                    </div>

                    <input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="Role" /><input type="hidden" asp-for="Password" /><input type="hidden" asp-for="DateCreated" /><input type="hidden" asp-for="IsActive" />
                    <div class="form-actions"><a href="@Url.Action("Profile", "Account")" class="btn-cancel"><i class="fas fa-times"></i> Cancel</a><button type="submit" class="btn-save"><i class="fas fa-save"></i> Save changes</button></div>
                </form>
            </main>
        </div>
    </div>
</section>