@model PharmaCare.Models.PrescriptionReservation
@{
    ViewData["Title"] = "Reservation Complete";
    Layout = "~/Views/Shared/_FrontendLayout.cshtml";
}

@section Styles {
<style>
.rx-done{--a:#0f9d8f;--ad:#0b5a54;--ink:#17212b;--muted:#71808d;--line:#e0e9ec;background:linear-gradient(180deg,#f3fbfa 0,#fff 58%);padding:46px 0 72px;color:var(--ink)}
.rx-done-shell{max-width:1040px;margin:auto;padding:0 22px}.rx-done-hero{text-align:center;max-width:720px;margin:0 auto 28px}.rx-done-icon{width:84px;height:84px;border-radius:26px;margin:0 auto 18px;background:linear-gradient(135deg,#25bf8b,#0f9d8f);color:#fff;display:grid;place-items:center;font-size:36px;box-shadow:0 15px 36px rgba(15,157,143,.24)}.rx-done-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;background:#e8f8f5;color:#08776d;border-radius:999px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.5px}.rx-done-hero h1{font-size:42px;font-weight:900;letter-spacing:-1px;margin:12px 0 8px}.rx-done-hero p{color:var(--muted);font-size:15px;margin:0}
.rx-done-layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(310px,.72fr);gap:22px;align-items:start}.rx-done-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 12px 34px rgba(15,23,42,.06);overflow:hidden}.rx-done-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:12px}.rx-done-head h2{font-size:18px;font-weight:900;margin:0}.rx-done-code{font-size:11px;color:#08776d;font-weight:900;background:#e8f8f5;padding:7px 10px;border-radius:999px}.rx-done-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:18px 20px}.rx-done-box{background:#fbfdfd;border:1px solid #e8eef0;border-radius:14px;padding:14px}.rx-done-box small{display:block;color:#8a97a0;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.45px;margin-bottom:6px}.rx-done-box strong{font-size:14px;overflow-wrap:anywhere}.rx-alert{display:grid;grid-template-columns:38px 1fr;gap:11px;margin:0 20px 20px;padding:14px;border-radius:13px;background:#fff7dc;border:1px solid #f0d57f;color:#6d5821}.rx-alert i{width:38px;height:38px;border-radius:10px;background:#ffebad;display:grid;place-items:center;color:#a36b00}.rx-alert strong{display:block;font-size:12px;margin-bottom:3px}.rx-alert span{display:block;font-size:11px;line-height:1.45}
.rx-next{background:#0b4a45;color:#fff;border-radius:20px;padding:22px;box-shadow:0 18px 44px rgba(11,74,69,.2);position:sticky;top:96px}.rx-next h2{font-size:20px;font-weight:900;margin:0 0 7px}.rx-next>p{color:#bdd3d0;font-size:12px;line-height:1.5;margin-bottom:17px}.rx-steps{display:grid;gap:9px}.rx-step{display:grid;grid-template-columns:36px 1fr;gap:11px;align-items:center;padding:8px 0}.rx-step-num{width:34px;height:34px;border-radius:10px;background:rgba(94,234,212,.14);color:#64eadb;display:grid;place-items:center;text-align:center;font-size:12px;font-weight:900;line-height:1}.rx-step strong{display:block;font-size:13px;margin-bottom:2px}.rx-step span{display:block;color:#bdd3d0;font-size:10.5px;line-height:1.4}.rx-actions{display:grid;gap:9px;margin-top:16px}.rx-link{min-height:48px;border-radius:11px;display:flex;align-items:center;justify-content:center;gap:8px;font-size:13px;font-weight:900;text-decoration:none;transition:.2s}.rx-link.primary{background:#20bfaa;color:#fff}.rx-link.secondary{border:1px solid rgba(255,255,255,.28);color:#fff}.rx-link:hover{transform:translateY(-2px);text-decoration:none;color:#fff}.rx-note{font-size:10px;color:#bdd3d0;margin-top:13px}
.dark-mode .rx-done{--ink:#edf5f4;--muted:#9ca8ad;--line:#2c3b3c;background:#111819}.dark-mode .rx-done-card{background:#172122}.dark-mode .rx-done-box{background:#121c1d;border-color:#2d3b3c}
@@media(max-width:900px){.rx-done-layout{grid-template-columns:1fr}.rx-next{position:static}}@@media(max-width:600px){.rx-done{padding:32px 0 52px}.rx-done-shell{padding:0 15px}.rx-done-hero h1{font-size:33px}.rx-done-grid{grid-template-columns:1fr}.rx-done-head{align-items:flex-start;flex-direction:column}.rx-done-card,.rx-next{border-radius:16px}}
</style>
}

<section class="rx-done">
<div class="rx-done-shell">
    <div class="rx-done-hero">
        <div class="rx-done-icon"><i class="fas fa-check"></i></div>
        <div class="rx-done-kicker"><i class="fas fa-prescription-bottle-alt"></i> Reservation confirmed</div>
        <h1>Your medicine is reserved.</h1>
        <p>We’ve held the prescription item for pickup. Keep your reservation number and bring a valid prescription with you.</p>
    </div>

    <div class="rx-done-layout">
        <section class="rx-done-card">
            <div class="rx-done-head">
                <h2>Reservation details</h2>
                <span class="rx-done-code">#@Model.ReservationNumber</span>
            </div>
            <div class="rx-done-grid">
                <div class="rx-done-box"><small>Medication</small><strong>@Model.Product.ProductName</strong></div>
                <div class="rx-done-box"><small>Quantity</small><strong>@Model.Quantity</strong></div>
                <div class="rx-done-box"><small>Amount due at pharmacy</small><strong>$@((Model.Product.Price * Model.Quantity).ToString("0.00"))</strong></div>
                <div class="rx-done-box"><small>Reserved on</small><strong>@Model.ReservationDate.ToString("MMM dd, yyyy")</strong></div>
                <div class="rx-done-box"><small>Pickup before</small><strong>@Model.ExpiryDate.ToString("MMM dd, yyyy")</strong></div>
                <div class="rx-done-box"><small>Pickup location</small><strong>PharmaCare Main Store</strong></div>
            </div>
            <div class="rx-alert">
                <i class="fas fa-file-medical"></i>
                <div><strong>Prescription required at pickup</strong><span>Please bring the original valid prescription. The pharmacy will verify it before the medicine is released.</span></div>
            </div>
        </section>

        <aside class="rx-next">
            <h2>What happens next?</h2>
            <p>Your reservation is active. Here’s the pickup flow.</p>
            <div class="rx-steps">
                <div class="rx-step"><span class="rx-step-num">1</span><div><strong>Medicine is held</strong><span>The reserved quantity is kept aside for you.</span></div></div>
                <div class="rx-step"><span class="rx-step-num">2</span><div><strong>Bring your prescription</strong><span>Visit the pharmacy before @Model.ExpiryDate.ToString("MMM dd").</span></div></div>
                <div class="rx-step"><span class="rx-step-num">3</span><div><strong>Verification & payment</strong><span>The pharmacy verifies the prescription, then payment is completed in store.</span></div></div>
            </div>
            <div class="rx-actions">
                <a class="rx-link primary" href="@Url.Action("MyReservations", "Prescription")"><i class="fas fa-clipboard-list"></i> View my reservations <i class="fas fa-arrow-right"></i></a>
                <a class="rx-link secondary" href="@Url.Action("Shop", "FrontEnd")"><i class="fas fa-shopping-bag"></i> Continue shopping</a>
            </div>
            <div class="rx-note"><i class="fas fa-info-circle"></i> Keep reservation #@Model.ReservationNumber for reference.</div>
        </aside>
    </div>
</div>
</section>